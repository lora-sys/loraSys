---
import { getCurrentFocusSummary } from '@/data/current-focus'
import { withBasePath } from '@/i18n/site'
import { profile, projects } from '@/data/profile'
import { homepageFeatured } from '@/data/project-curation'
import { demoByRepo } from '@/data/project-demos'
import syncReport from '@/data/sync-report.json'

import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import ContactOutro from '@/components/home/ContactOutro.astro'
import EvidenceBadge from '@/components/layout/EvidenceBadge.astro'
import HeroScene from '@/components/lora/HeroScene.astro'
import LoraExpressionPicker from '@/components/lora/LoraExpressionPicker.astro'
import PersonalShowcase from '@/components/lora/PersonalShowcase.astro'
import LeadProjectStage from '@/components/projects/LeadProjectStage.astro'
import ProjectCard from '@/components/projects/ProjectCard.astro'
import ProjectDemo from '@/components/projects/ProjectDemo.astro'

const allPosts = sortMDByDate(await getBlogCollection())
const latestPostDate = allPosts[0]?.data?.publishDate
  ? new Intl.DateTimeFormat('zh-CN', { month: 'long', day: 'numeric', timeZone: 'UTC' }).format(
      new Date(allPosts[0].data.publishDate)
    )
  : null
const allSelectedProjects = projects.filter((project) => project.featured)
const featuredProjects = homepageFeatured(allSelectedProjects)
const [leadProject, ...supportingProjects] = featuredProjects
const recentPosts = allPosts.slice(0, 3)
const focusSummary = getCurrentFocusSummary('zh-CN')
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '')
const demoFor = (project: (typeof projects)[number]) => demoByRepo[project.repository ?? '']
---

<PageLayout
  meta={{
    title: 'Lora · 个人网站',
    description: 'Lora 的个人网站，收录作品、技术文章、最近在做的事、书影音与联系方式。'
  }}
  highlightColor='#d99a33'
>
  <main class='home-page'>
    <section class='home-hero' aria-labelledby='home-title'>
      <div class='hero-copy'>
        <p class='eyebrow'>Lora · 学生开发者 · 西安</p>
        <h1 id='home-title'>构建一切，<br />学习一切。</h1>
        <p class='hero-description'>做项目，写文章，也保留一点生活。</p>
        <div class='hero-actions' aria-label='开始探索'>
          <a class='primary-action' href='#work'>
            看作品 <span class='hero-action-arrow' aria-hidden='true'>↘</span>
          </a>
          <a class='secondary-action' href='#writing'
            >最近写了什么 <span class='hero-action-arrow' aria-hidden='true'>→</span>
          </a
          >
        </div>
      </div>
      <div class='hero-visual'>
        <HeroScene locale='zh-CN' />
      </div>
      <a class='scroll-cue' href='#work' aria-label='向下查看精选作品'
        ><span aria-hidden='true'></span>向下探索</a
      >
    </section>

    <div class='home-flow'>
      <section id='work' class='home-section' aria-labelledby='work-title'>
        <header class='section-heading'>
          <div>
            <p class='eyebrow'>精选作品</p>
            <h2 id='work-title'>几个想分享的项目。</h2>
          </div>
          <a class='text-link' href={`${baseUrl}/projects`}
            >查看全部 {allSelectedProjects.length} 个作品 <span aria-hidden='true'>↗</span></a
          >
          <div class='section-meta'>
            <EvidenceBadge kind='verified' /><time datetime={syncReport.syncedAt.slice(0, 10)}
              >同步于 {
                new Intl.DateTimeFormat('zh-CN', {
                  month: 'long',
                  day: 'numeric',
                  timeZone: 'UTC'
                }).format(new Date(syncReport.syncedAt))
              }</time
            >
          </div>
        </header>
        {leadProject && <LeadProjectStage project={leadProject} locale='zh-CN' />}
        <div class='supporting-work'>
          {
            supportingProjects.map((project) => (
              <ProjectCard {project} variant='featured' lens compact compactLocale='zh-CN'>
                {demoFor(project) && <ProjectDemo kind={demoFor(project)!} slot='demo' />}
              </ProjectCard>
            ))
          }
        </div>
      </section>

      <section id='writing' class='home-section' aria-labelledby='writing-title'>
        <header class='section-heading'>
          <div>
            <p class='eyebrow'>构建笔记</p>
            <h2 id='writing-title'>最近写了什么。</h2>
          </div>
          <a class='text-link' href={`${baseUrl}/blog`}>全部写作 <span aria-hidden='true'>↗</span></a>
          {
            latestPostDate && (
              <div class='section-meta'>
                <>
                  <EvidenceBadge kind='field-note' />
                  <time>最新 {latestPostDate}</time>
                </>
              </div>
            )
          }
        </header>
        {
          recentPosts.length > 0 ? (
            <ul class='writing-list'>
              {recentPosts.map((post) => (
                <PostPreview post={post} class='writing-item' />
              ))}
            </ul>
          ) : (
            <p class='empty-note'>还没有公开文章。</p>
          )
        }
      </section>

      <section id='now' class='home-section' aria-labelledby='now-title'>
        <header class='section-heading'>
          <div>
            <p class='eyebrow'>最近</p>
            <h2 id='now-title'>最近在忙什么。</h2>
          </div>
          <a class='text-link' href={`${baseUrl}/now`}>查看完整近况 <span aria-hidden='true'>↗</span></a>
        </header>
        <div class='focus-grid'>
          {
            focusSummary.map((item, index) => (
              <article class='focus-item'>
                <>
                  <span>0{index + 1}</span>
              <h3>{item.href ? <a href={withBasePath(item.href)}>{item.title}</a> : item.title}</h3>
                  <p>{item.description}</p>
                </>
              </article>
            ))
          }
        </div>
      </section>

      <section id='about' class='home-section home-about' aria-labelledby='about-title'>
        <header class='section-heading'>
          <div>
            <p class='eyebrow'>关于我</p>
            <h2 id='about-title'>你好，我是 Lora。</h2>
          </div>
          <a class='text-link' href={`${baseUrl}/about`}>更多关于我 <span aria-hidden='true'>↗</span></a>
        </header>
        <div class='about-content'>
          <div>
            <p>{profile.summary[0]}</p>
            <p>这里持续收录我的作品、文章、近况和工作之外的兴趣。</p>
            <a class='text-link' href={`${baseUrl}/resume`}>查看简历 <span aria-hidden='true'>↗</span></a>
          </div>
          <LoraExpressionPicker locale='zh-CN' />
        </div>
      </section>

      <section class='home-section' aria-label='动漫与收藏'>
        <PersonalShowcase />
      </section>

      <div id='contact' class='contact-anchor'>
        <ContactOutro />
      </div>
    </div>
  </main>
</PageLayout>

<style>
  .home-page {
    width: 100%;
  }
  .home-hero {
    position: relative;
    display: grid;
    width: min(100%, 80rem);
    min-height: calc(100svh - 3.5rem);
    grid-template-columns: minmax(0, 0.96fr) minmax(0, 1.04fr);
    align-items: center;
    gap: 0;
    margin-inline: auto;
    padding: 3rem clamp(1rem, 4vw, 2.5rem) 4.5rem;
  }
  .hero-copy {
    position: relative;
    z-index: 2;
    transform: translateY(-1rem);
  }
  .home-hero :global(.hero-scene) {
    width: 100%;
    max-width: none;
    transform: none;
  }
  .hero-visual {
    position: relative;
    min-width: 0;
  }
  .eyebrow {
    margin: 0;
    color: hsl(var(--field-amber-strong));
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.08em;
  }
  .home-hero h1 {
    margin: 1.15rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(4.3rem, 6vw, 6rem);
    font-weight: 650;
    letter-spacing: -0.06em;
    line-height: 0.98;
    text-wrap: balance;
  }
  .hero-description {
    max-width: 30rem;
    margin: 1.4rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: clamp(1rem, 1.8vw, 1.25rem);
    line-height: 1.65;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.8rem;
  }
  .primary-action,
  .secondary-action {
    position: relative;
    display: inline-flex;
    min-height: 3.15rem;
    align-items: center;
    gap: 0.45rem;
    border-radius: 999px;
    padding: 0.7rem 1.05rem;
    font-size: 0.82rem;
    font-weight: 650;
    text-decoration: none;
    transition:
      transform 160ms ease,
      background-color 160ms ease,
      border-color 160ms ease;
  }
  .primary-action {
    border: 1px solid hsl(var(--field-ink));
    background: hsl(var(--field-ink));
    color: hsl(var(--field-paper));
  }
  .secondary-action {
    border: 1px solid hsl(var(--border));
    background: hsl(var(--background) / 0.65);
    color: hsl(var(--foreground));
  }
  .primary-action:hover,
  .secondary-action:hover {
    transform: translateY(-2px);
  }
  .secondary-action:hover {
    border-color: hsl(var(--field-amber) / 0.75);
  }
  .scroll-cue {
    position: absolute;
    bottom: 1.2rem;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.69rem;
    text-decoration: none;
    transform: translateX(-50%);
  }
  .scroll-cue span {
    width: 0.42rem;
    height: 0.42rem;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
  }
  .home-flow {
    display: grid;
    width: min(100%, 70rem);
    gap: clamp(4.5rem, 10vw, 7.5rem);
    margin: 0 auto;
    padding: 1rem clamp(1rem, 4vw, 2.5rem) 4rem;
  }
  .home-section,
  .contact-anchor {
    scroll-margin-top: 5.5rem;
  }
  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 0.8rem 1.5rem;
    margin-bottom: 1.4rem;
  }
  .section-heading h2 {
    max-width: 25ch;
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4vw, 2.75rem);
    font-weight: 640;
    letter-spacing: -0.045em;
    line-height: 1.08;
    text-wrap: balance;
  }
  .text-link {
    color: hsl(var(--muted-foreground));
    font-size: 0.76rem;
    font-weight: 620;
    text-decoration: none;
  }
  .text-link:hover,
  .text-link:focus-visible {
    color: hsl(var(--foreground));
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }
  .section-meta {
    display: flex;
    grid-column: 1 / -1;
    align-items: center;
    gap: 0.5rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.67rem;
  }
  .supporting-work {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  .writing-list {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .writing-item {
    display: grid;
    gap: 0.35rem;
    border-top: 1px solid hsl(var(--border));
    padding-top: 1rem;
  }
  .writing-item time {
    color: hsl(var(--muted-foreground));
    font-size: 0.67rem;
  }
  .writing-item h3 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 650;
  }
  .writing-item h3 a {
    color: hsl(var(--foreground));
    text-decoration: none;
  }
  .writing-item h3 a:hover,
  .writing-item h3 a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }
  .writing-item p,
  .focus-item p,
  .about-content p {
    max-width: 48rem;
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.84rem;
    line-height: 1.7;
  }
  .empty-note {
    border-top: 1px solid hsl(var(--border));
    padding-top: 1rem;
    color: hsl(var(--muted-foreground));
  }
  .focus-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .focus-item {
    border-top: 1px solid hsl(var(--border));
    padding-top: 0.9rem;
  }
  .focus-item > span {
    color: hsl(var(--field-amber-strong));
    font-family: ui-monospace, monospace;
    font-size: 0.67rem;
  }
  .focus-item h3 {
    margin: 0.45rem 0;
    font-size: 1rem;
    font-weight: 650;
  }
  .focus-item h3 a {
    color: inherit;
  }
  .about-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 18rem);
    align-items: center;
    gap: 2rem;
    border-block: 1px solid hsl(var(--border));
    padding: 1.4rem 0;
  }
  .about-content > div {
    display: grid;
    gap: 0.8rem;
  }
  .contact-outro {
    display: grid;
    gap: 0.7rem;
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius-lg);
    padding: clamp(1.4rem, 4vw, 2.4rem);
    background: hsl(var(--card));
  }
  .contact-outro h2 {
    max-width: 20ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 5vw, 2.6rem);
    font-weight: 640;
    letter-spacing: -0.04em;
    line-height: 1.04;
  }
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 0.6rem;
  }
  @media (min-width: 901px) and (max-width: 1200px) {
    .home-hero :global(.hero-scene) { width:100%; transform:none; }
  }
  @media (max-width: 900px) {
    .home-hero {
      min-height: calc(100svh - 3.5rem);
      grid-template-columns: 1fr;
      align-content: center;
      gap: 0.7rem;
      padding: 3.5rem 1.1rem 4.5rem;
    }
    .hero-copy {
      transform: none;
    }
    .home-hero :global(.hero-scene) {
      width: min(86vw, 23rem);
      transform: translate(-0.25rem, 0);
    }
    .hero-visual {
      width: 100%;
    }
    .home-hero h1 {
      font-size: clamp(2.8rem, 11vw, 4rem);
    }
    .hero-description {
      margin-top: 0.9rem;
    }
    .hero-actions {
      margin-top: 1.2rem;
    }
    .scroll-cue {
      bottom: 0.8rem;
    }
    .supporting-work,
    .focus-grid {
      grid-template-columns: 1fr;
    }
    .section-heading {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .section-meta {
      grid-column: auto;
    }
    .about-content {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .primary-action,
    .secondary-action {
      transition: none;
    }
    .hero-action-reaction--hover {
      display: none;
    }
    .hero-action-reaction--base {
      transition: none;
      transform: none;
    }
    .primary-action:hover .hero-action-reaction--base,
    .primary-action:focus-visible .hero-action-reaction--base,
    .primary-action:active .hero-action-reaction--base,
    .secondary-action:hover .hero-action-reaction--base,
    .secondary-action:focus-visible .hero-action-reaction--base,
    .secondary-action:active .hero-action-reaction--base {
      opacity: 1;
      transform: none;
    }
    .primary-action:hover .hero-action-arrow,
    .primary-action:focus-visible .hero-action-arrow,
    .primary-action:active .hero-action-arrow,
    .secondary-action:hover .hero-action-arrow,
    .secondary-action:focus-visible .hero-action-arrow,
    .secondary-action:active .hero-action-arrow {
      opacity: 1;
    }
    .primary-action:hover,
    .secondary-action:hover {
      transform: none;
    }
  }
</style>
