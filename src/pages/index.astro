---
import { Image } from 'astro:assets'
import { profile, projects } from '@/data/profile'
import { anime, favorites } from '@/data/showcase'
import { socialLinks } from '@/data/social'

import { Quote } from 'astro-pure/advanced'
import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import SocialIcon from '@/components/contact/SocialIcon.astro'
import ContactOutro from '@/components/home/ContactOutro.astro'
import CurrentFocus from '@/components/home/CurrentFocus.astro'
import ContentPulse from '@/components/home/ContentPulse.astro'
import CreatorHub from '@/components/home/CreatorHub.astro'
import LatestSignals from '@/components/home/LatestSignals.astro'
import Section from '@/components/home/Section.astro'
import ContributionGraph from '@/components/lora/ContributionGraph.astro'
import ExternalContributions from '@/components/lora/ExternalContributions.astro'
import ShowcaseCarousel from '@/components/lora/ShowcaseCarousel.astro'
import ProjectCard from '@/components/projects/ProjectCard.astro'
import config from '@/site-config'
import type { ContentFeedItem } from '@/data/content-feed'
import { currentFocus } from '@/data/current-focus'
import { getContentIntelligenceSummary } from '@/data/content-intelligence'
import { getProjectStories } from '@/data/project-stories'
import syncReport from '@/data/sync-report.json'

const MAX_POSTS = 5
const allPosts = sortMDByDate(await getBlogCollection())
const recentPosts = allPosts.slice(0, MAX_POSTS)
const featuredProjects = projects.filter((project) => project.featured).slice(0, 4)
const [leadProject, ...supportingProjects] = featuredProjects

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)
const avatarSource = images[config.logo.src]
if (!avatarSource) throw new Error(`Missing homepage avatar: ${config.logo.src}`)
const latestPost = recentPosts[0]
const signalDate = (date: Date) =>
  new Intl.DateTimeFormat('en-US', { month: 'short', day: '2-digit', timeZone: 'UTC' }).format(date)
const signals = [
  ...(latestPost
    ? [
        {
          type: 'Writing',
          date: signalDate(latestPost.data.updatedDate ?? latestPost.data.publishDate),
          title: latestPost.data.title,
          href: `/blog/${latestPost.id}`
        }
      ]
    : []),
  {
    type: 'Project',
    date: 'Jun 2026',
    title: 'Building TradingOS and an AI Company OS',
    href: '/projects'
  },
  {
    type: 'Note',
    date: 'Dec 2025',
    title: '多智能体系统的涌现行为',
    href: '/notes'
  },
  {
    type: 'Now',
    date: 'Jul 2026',
    title: 'Exploring reliable agent infrastructure',
    href: '/now'
  }
]
const heroSocials = socialLinks.filter((link) =>
  ['GitHub', 'LinkedIn', 'X', 'Email'].includes(link.name)
)
const creatorChannels = socialLinks.filter((link) =>
  ['Bilibili', '知乎', '小红书', 'YouTube'].includes(link.name)
)
const linkedRepositories = new Set(
  projects
    .filter((project) => getProjectStories(project.repository).length > 0)
    .map((project) => project.repository)
)
const contentSummary = getContentIntelligenceSummary({
  projects,
  writingDates: allPosts.map((post) => new Date(post.data.updatedDate ?? post.data.publishDate)),
  linkedRepositories
})
const formatPulseDate = (date: Date | null) => (date ? signalDate(date) : '—')
const githubProjectBreakdown = syncReport.sources.github.projectBreakdown as Record<string, number>
const latestContent: ContentFeedItem[] = [
  ...recentPosts.slice(0, 3).map((post) => ({
    kind: 'Writing' as const,
    title: post.data.title,
    meta: signalDate(post.data.updatedDate ?? post.data.publishDate),
    href: `/blog/${post.id}`
  })),
  ...featuredProjects.slice(0, 2).map((project) => ({
    kind: 'Project' as const,
    title: project.title,
    meta: project.source,
    href: `/projects#${project.repository}`,
    relation: project.status === 'building' ? 'Building now' : 'Selected project'
  }))
]
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#659EB9'>
  <main class='home-shell'>
    <section class='hero animate' aria-labelledby='home-title'>
      <div class='portrait-wrap'>
        <Image
          src={avatarSource()}
          alt={config.logo.alt || 'Lora'}
          class='portrait'
          width={152}
          height={152}
          loading='eager'
          fetchpriority='high'
        />
        <button class='availability' type='button' title='Open to thoughtful collaboration' data-agent-trace-trigger>
          <i></i> Open to collaborate
        </button>
      </div>
      <div class='hero-copy'>
        <span class='kicker'>{profile.role} · {profile.location}</span>
        <h1 id='home-title'>Building evolving agents, tools, and ambitious systems.</h1>
        <p>{profile.summary[0]}</p>
        <div class='hero-actions'>
          <a
            class='primary-action'
            href='/projects'
            data-interaction='primary_cta'
            data-destination='projects'
            >Explore projects <span aria-hidden='true'>→</span></a
          >
          <a href='/contact' data-interaction='primary_cta' data-destination='contact'>
            Let&apos;s connect
          </a>
        </div>
        <nav class='social-rail' aria-label='Primary social profiles'>
          {
            heroSocials.map((link) => (
              <a
                href={link.href}
                target={link.href.startsWith('http') ? '_blank' : undefined}
                data-interaction='social_profile'
                data-destination={link.name}
                rel={link.href.startsWith('http') ? 'me noopener noreferrer' : undefined}
                aria-label={`${link.name}: ${link.handle}`}
                data-tooltip={link.name}
                style={`--brand:${link.brand}`}
              >
                <SocialIcon name={link.icon} class='size-5' />
              </a>
            ))
          }
        </nav>
      </div>
    </section>

    <section class='trail-picker' aria-labelledby='trail-title'>
      <div class='trail-heading'><span class='kicker'>Choose a trail</span><h2 id='trail-title'>Start where your curiosity is.</h2><p>Three short paths into the work, the thinking, or a possible collaboration.</p></div>
      <div class='trail-grid'>
        <a href='/projects' class='trail-card'><span>01 · Build</span><strong>See what I&apos;m building</strong><small>Projects, themes, sources, and evidence.</small><b aria-hidden='true'>→</b></a>
        <a href='/blog/ai-engineering-harness' class='trail-card'><span>02 · Think</span><strong>Read a representative story</strong><small>How AI work becomes verifiable engineering.</small><b aria-hidden='true'>→</b></a>
        <a href='/contact' class='trail-card'><span>03 · Connect</span><strong>Start a thoughtful collaboration</strong><small>Tell me what you are trying to make.</small><b aria-hidden='true'>→</b></a>
      </div>
    </section>

    <div id='content' class='animate content-flow'>
      <Section title='Latest Signals'>
        <LatestSignals {signals} />
      </Section>

      <CurrentFocus focus={currentFocus} />

      {
        leadProject && (
          <Section title='Featured Project'>
            <ProjectCard project={leadProject} variant='lead' lens />
          </Section>
        )
      }

      <Section title='Selected Projects'>
        <div class='selected-projects'>
          {supportingProjects.map((project) => <ProjectCard {project} variant='featured' lens />)}
        </div>
        <Button
          title='Explore all projects'
          class='w-fit self-end'
          href='/projects'
          variant='ahead'
        />
      </Section>

      {
        recentPosts.length > 0 && (
          <Section title='Latest Writing'>
            <ul class='posts-list'>
              {recentPosts.map((post) => (
                <PostPreview post={post} />
              ))}
            </ul>
            <Button
              title='Browse all writing'
              class='w-fit self-end'
              href='/blog'
              variant='ahead'
            />
          </Section>
        )
      }

      <Section title='Creator Hub'>
        <CreatorHub channels={creatorChannels} items={latestContent} />
      </Section>

      <div id='content-pulse'>
        <Section title='Content Pulse'>
          <ContentPulse
            writingCount={allPosts.length}
            projectCount={featuredProjects.length}
            linkedProjectCount={contentSummary.linkedProjectCount}
            storyGapCount={contentSummary.storyGapCount}
            storyCoveragePercent={contentSummary.storyCoveragePercent}
          personalProjectCount={githubProjectBreakdown['lora-sys'] ?? 0}
          labProjectCount={githubProjectBreakdown.ACAMLab ?? 0}
          latestWritingDate={formatPulseDate(contentSummary.latestWritingDate)}
          latestProjectDate={formatPulseDate(contentSummary.latestProjectDate)}
          channelCount={creatorChannels.length}
          nextStoryTitle={contentSummary.topOpportunity?.title ?? 'No open Story gap'}
          nextStoryFormat={contentSummary.topOpportunity?.format ?? '—'}
          nextStorySource={contentSummary.topOpportunity?.source === 'ACAMLab' ? 'ACAMLab' : 'lora-sys'}
          nextStoryHref={contentSummary.topOpportunity ? `/projects#${contentSummary.topOpportunity.repository}` : '/projects'}
          syncedAt={syncReport.syncedAt}
          githubProjects={syncReport.sources.github.projects}
          githubPullRequests={syncReport.sources.github.pullRequests}

          />
        </Section>
      </div>

      <Section title='Open Source'>
        <div class='footprint'>
          <div><strong>{projects.length}</strong><span>projects documented</span></div>
          <div><strong>{allPosts.length}</strong><span>technical essays</span></div>
          <div>
            <strong>{new Set(projects.flatMap((project) => project.technologies)).size}</strong
            ><span>tools in practice</span>
          </div>
        </div>
        <p class='section-copy'>
          I build in public when I can: agent infrastructure, full-stack products, developer tools,
          and experiments across AI and Web3.
        </p>
      </Section>

      <div id='contributions'>
        <Section title='Contributions'>
          <ContributionGraph compact />
          <ExternalContributions />
        </Section>
      </div>

      <Section title='Latest Notes'>
        <div class='note-preview'>
          <a href='/notes'
            ><time>2025-12</time><strong>多智能体系统的涌现行为</strong><span
              >AI Agents · Research</span
            ></a
          >
          <a href='/notes'
            ><time>2025-11</time><strong>Monad 并行 EVM 性能基准</strong><span
              >Web3 · Benchmark</span
            ></a
          >
          <a href='/notes'
            ><time>2025-10</time><strong>Vercel AI SDK v3 迁移经验</strong><span>Frontend · AI</span
            ></a
          >
        </div>
        <Button title='Read all notes' class='w-fit self-end' href='/notes' variant='ahead' />
      </Section>

      <Section title='Beyond Code'>
        <ShowcaseCarousel
          id='anime'
          title='Anime Archive'
          eyebrow='Stories that stay with me'
          items={anime}
        />
        <ShowcaseCarousel
          id='favorites'
          title='Favorites'
          eyebrow='Books, films, music & ideas'
          items={favorites}
        />
      </Section>

      <ContactOutro />
    </div>
    <Quote class='mt-14' />
  </main>
  <dialog class='agent-trace' data-agent-trace aria-labelledby='agent-trace-title'>
    <button type='button' class='trace-close' data-agent-trace-close aria-label='Close Agent Trace'>×</button>
    <span class='kicker'>Hidden protocol · 03</span><h2 id='agent-trace-title'>A small trace of how I build.</h2>
    <div class='trace-steps'><span>Observe</span><i>→</i><span>Plan</span><i>→</i><span>Build</span><i>→</i><span>Verify</span></div>
    <p>Good systems do not stop at “it works”. They leave evidence behind.</p>
  </dialog>
  <script>
    const traceTrigger=document.querySelector<HTMLButtonElement>('[data-agent-trace-trigger]');const trace=document.querySelector<HTMLDialogElement>('[data-agent-trace]');const closeTrace=document.querySelector<HTMLButtonElement>('[data-agent-trace-close]');let taps=0;let reset:number|undefined;
    traceTrigger?.addEventListener('click',()=>{taps+=1;clearTimeout(reset);reset=window.setTimeout(()=>{taps=0},900);if(taps>=3){trace?.showModal();taps=0}});closeTrace?.addEventListener('click',()=>trace?.close());trace?.addEventListener('click',event=>{if(event.target===trace)trace.close()});
  </script>
</PageLayout>

<style>
  .home-shell {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
  }
  .hero {
    display: grid;
    width: min(100%, 58rem);
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 5vw, 3.5rem);
    margin: 2.5rem auto 5rem;
    padding-block: clamp(1rem, 4vw, 3rem);
  }
  .portrait-wrap {
    position: relative;
  }
  :global(.portrait) {
    width: clamp(7rem, 14vw, 9.5rem);
    height: clamp(7rem, 14vw, 9.5rem);
    border: 1px solid hsl(var(--border));
    border-radius: 50%;
    padding: 0.28rem;
    object-fit: cover;
    box-shadow: 0 24px 60px -42px hsl(var(--foreground) / 0.7);
  }
  .trail-picker{display:grid;gap:1rem;border-block:1px solid hsl(var(--border));padding-block:1.5rem}.trail-heading{display:grid;gap:.35rem;max-width:38rem}.trail-heading h2{margin:0;font-size:clamp(1.4rem,3.2vw,2.2rem);letter-spacing:-.05em}.trail-heading p{margin:0;color:hsl(var(--muted-foreground));font-size:.84rem;line-height:1.6}.trail-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.65rem}.trail-card{position:relative;display:grid;gap:.35rem;min-height:8.5rem;border:1px solid hsl(var(--border));border-radius:.85rem;padding:1rem;color:hsl(var(--foreground));text-decoration:none;background:hsl(var(--card));transition:transform 180ms cubic-bezier(.23,1,.32,1),border-color 180ms ease,background 180ms ease}.trail-card:hover,.trail-card:focus-visible{transform:translateY(-3px);border-color:hsl(var(--foreground)/.45);background:hsl(var(--muted)/.5);outline:2px solid hsl(var(--ring));outline-offset:2px}.trail-card span{color:hsl(var(--muted-foreground));font-size:.65rem;letter-spacing:.1em;text-transform:uppercase}.trail-card strong{max-width:20ch;font-size:.94rem;font-weight:600}.trail-card small{max-width:26ch;color:hsl(var(--muted-foreground));font-size:.72rem;line-height:1.45}.trail-card b{position:absolute;right:1rem;bottom:1rem;font-weight:400}.availability{
    position: absolute;
    bottom: -0.7rem;
    left: 50%;
    display: flex;
    width: max-content;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    padding: 0.36rem 0.62rem;
    background: hsl(var(--background));
    color: hsl(var(--muted-foreground));
    font-size: 0.66rem;
    box-shadow: 0 8px 22px -18px hsl(var(--foreground));
    transform: translateX(-50%);
  }
  .availability:active{transform:translateX(-50%) scale(.97)}.availability:focus-visible{outline:2px solid hsl(var(--ring));outline-offset:3px}.availability i {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 3px rgb(34 197 94 / 0.12);
  }
  .hero-copy {
    min-width: 0;
  }
  .kicker {
    color: hsl(var(--muted-foreground));
    font-size: 0.7rem;
    font-weight: 620;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  h1 {
    max-width: 17ch;
    margin-top: 0.75rem;
    font-size: clamp(2.1rem, 6vw, 4.15rem);
    font-weight: 570;
    letter-spacing: -0.055em;
    line-height: 0.98;
    text-wrap: balance;
  }
  .hero-copy > p {
    max-width: 42rem;
    margin-top: 1.2rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.9rem;
    line-height: 1.7;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1.3rem;
  }
  .hero-actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    padding: 0.58rem 0.85rem;
    color: hsl(var(--foreground));
    font-size: 0.78rem;
    text-decoration: none;
    transition:
      background 180ms ease,
      transform 180ms ease;
  }
  .hero-actions a:hover,
  .hero-actions a:focus-visible {
    background: hsl(var(--muted));
    transform: translateY(-1px);
  }
  .hero-actions .primary-action {
    border-color: hsl(var(--foreground));
    background: hsl(var(--foreground));
    color: hsl(var(--background));
  }
  .hero-actions .primary-action:hover,
  .hero-actions .primary-action:focus-visible {
    background: hsl(var(--foreground) / 0.86);
  }
  .social-rail {
    display: flex;
    gap: 0.42rem;
    margin-top: 1rem;
  }
  .social-rail a {
    position: relative;
    display: grid;
    width: 2.1rem;
    height: 2.1rem;
    place-items: center;
    border-radius: 50%;
    color: hsl(var(--muted-foreground));
    transition:
      background 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }
  .social-rail a::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: calc(100% + 0.4rem);
    left: 50%;
    border: 1px solid hsl(var(--border));
    border-radius: 0.4rem;
    padding: 0.22rem 0.42rem;
    background: hsl(var(--foreground));
    color: hsl(var(--background));
    font-size: 0.62rem;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 0.2rem);
    transition:
      opacity 150ms ease,
      transform 150ms ease;
  }
  .social-rail a:hover,
  .social-rail a:focus-visible {
    background: color-mix(in srgb, var(--brand) 10%, transparent);
    color: var(--brand);
    transform: translateY(-1px);
  }
  .social-rail a:hover::after,
  .social-rail a:focus-visible::after {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .content-flow {
    display: flex;
    width: min(100%, 58rem);
    flex-direction: column;
    gap: 5rem;
  }
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .section-copy {
    margin-top: 0.65rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.86rem;
    line-height: 1.65;
  }
  .selected-projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .footprint {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid hsl(var(--border));
  }
  .footprint div {
    display: grid;
    gap: 0.12rem;
    padding: 1rem;
    border-right: 1px solid hsl(var(--border));
  }
  .footprint div:last-child {
    border-right: 0;
  }
  .footprint strong {
    font-size: 1.55rem;
    font-weight: 570;
    font-variant-numeric: tabular-nums;
  }
  .footprint span {
    color: hsl(var(--muted-foreground));
    font-size: 0.7rem;
  }
  .note-preview {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .note-preview a {
    display: grid;
    gap: 0.35rem;
    min-height: 8.6rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.9rem;
    padding: 0.9rem;
    color: hsl(var(--foreground));
    text-decoration: none;
    transition:
      background 180ms ease,
      transform 180ms ease;
  }
  .note-preview a:hover,
  .note-preview a:focus-visible {
    background: hsl(var(--muted));
    transform: translateY(-2px);
  }
  .note-preview time,
  .note-preview span {
    color: hsl(var(--muted-foreground));
    font-size: 0.68rem;
  }
  .note-preview strong {
    font-size: 0.9rem;
    font-weight: 580;
    line-height: 1.45;
  }
  .note-preview span {
    margin-top: auto;
  }
  @media (max-width: 780px) {
    .note-preview {
      grid-template-columns: 1fr;
    }
    .note-preview a {
      min-height: 0;
    }
  }
  .agent-trace{width:min(92vw,32rem);border:1px solid hsl(var(--border));border-radius:1rem;padding:1.25rem;background:hsl(var(--background));color:hsl(var(--foreground));box-shadow:0 24px 80px hsl(var(--foreground)/.2)}.agent-trace::backdrop{background:hsl(var(--foreground)/.5);backdrop-filter:blur(4px)}.trace-close{float:right;border:0;background:transparent;color:inherit;font-size:1.4rem;cursor:pointer}.agent-trace h2{margin:.5rem 0;font-size:1.5rem;letter-spacing:-.04em}.agent-trace p{color:hsl(var(--muted-foreground));line-height:1.6}.trace-steps{display:flex;flex-wrap:wrap;align-items:center;gap:.45rem;margin:1.2rem 0}.trace-steps span{border:1px solid hsl(var(--border));border-radius:999px;padding:.4rem .65rem;font-size:.72rem}.trace-steps i{color:hsl(var(--muted-foreground));font-style:normal}@media (max-width:760px){.trail-grid{grid-template-columns:1fr}.trail-card{min-height:auto;padding-right:2.5rem}}@media (max-width: 620px) {
    .hero {
      grid-template-columns: 1fr;
      margin-block: 1.5rem 4rem;
      text-align: center;
    }
    .portrait-wrap {
      width: max-content;
      margin-inline: auto;
    }
    h1 {
      margin-inline: auto;
    }
    .hero-copy > p {
      margin-inline: auto;
    }
    .hero-actions,
    .social-rail {
      justify-content: center;
    }
    .content-flow {
      gap: 4rem;
    }
    .selected-projects {
      grid-template-columns: 1fr;
    }
    .footprint {
      grid-template-columns: 1fr;
    }
    .footprint div {
      grid-template-columns: 3.5rem 1fr;
      align-items: baseline;
      border-right: 0;
      border-bottom: 1px solid hsl(var(--border));
    }
    .footprint div:last-child {
      border-bottom: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-actions a,
    .social-rail a,
    .social-rail a::after,
    .note-preview a,
    .trail-card {
      transition: none;
    }
    .hero-actions a:hover,
    .hero-actions a:focus-visible,
    .social-rail a:hover,
    .social-rail a:focus-visible,
    .note-preview a:hover,
    .note-preview a:focus-visible,
    .trail-card:hover,
    .trail-card:focus-visible {
      transform: none;
    }
  }
</style>
