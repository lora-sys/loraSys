---
import { projects, profile } from '@/data/profile'

import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import SocialIcon from '@/components/contact/SocialIcon.astro'
import ContactOutro from '@/components/home/ContactOutro.astro'
import PersonalShowcase from '@/components/lora/PersonalShowcase.astro'
import ResumePreview from '@/components/resume/ResumePreview.astro'
import ProjectCard from '@/components/projects/ProjectCard.astro'
import HeroScene from '@/components/lora/HeroScene.astro'
import HomeSectionNav from '@/components/lora/HomeSectionNav.astro'
import HapticsToggle from '@/components/lora/HapticsToggle.astro'
import LoraVisual from '@/components/lora/LoraVisual.astro'
import ScrollProgressRail from '@/components/lora/ScrollProgressRail.astro'
import ProjectDemo from '@/components/projects/ProjectDemo.astro'
import { socialLinks } from '@/data/social'
import { demoByRepo } from '@/data/project-demos'
import { getCurrentFocusSummary } from '@/data/current-focus'
import { homepageFeatured } from '@/data/project-curation'
import syncReport from '@/data/sync-report.json'

const allPosts = sortMDByDate(await getBlogCollection())
const latestPostDate = allPosts[0]?.data?.publishDate ? new Intl.DateTimeFormat('zh-CN', { month: 'long', day: 'numeric', timeZone: 'UTC' }).format(new Date(allPosts[0].data.publishDate)) : null
const allSelectedProjects = projects.filter((project) => project.featured)
const featuredProjects = homepageFeatured(allSelectedProjects)
const [leadProject, ...supportingProjects] = featuredProjects
const recentPosts = allPosts.slice(0, 3)

const heroSocials = socialLinks.filter((link) =>
  ['GitHub', 'LinkedIn', 'X', 'Email'].includes(link.name)
)
const focusSummary = getCurrentFocusSummary('zh-CN')

const sectionNav = [
  { id: 'about', label: '关于我' },
  { id: 'work', label: '作品' },
  { id: 'writing', label: '笔记' },
  { id: 'now', label: '最近' },
  { id: 'personal-signals', label: '收藏' },
  { id: 'contact', label: '联系' }
]

// 保留原有微演示映射，Zhihu Threads 使用已有项目封面与案例入口。
const demoFor = (project: (typeof projects)[number]) => demoByRepo[project.repository ?? '']
---

<PageLayout
  meta={{
    title: 'Lora · 个人网站',
    description: 'Lora 的个人网站，收录作品、技术文章、最近在做的事、书影音与联系方式。'
  }}
  highlightColor='#d99a33'
>
  <main class='v2-home'>
    <div class='grid-paper' aria-hidden='true'></div>
    <div class='ambient-field' aria-hidden='true'>
      <span class='ambient-stamp ambient-stamp--verified'><LoraVisual asset='stampVerified' /></span>
      <span class='ambient-stamp ambient-stamp--experiment'><LoraVisual asset='stampExperiment' /></span>
      <span class='ambient-stamp ambient-stamp--contribution'><LoraVisual asset='stampContribution' /></span>
    </div>
    <ScrollProgressRail />

    <section class='manifesto' aria-labelledby='home-title' data-field-notes-hero>
      <div class='manifesto-head'>
        <p class='eyebrow'>Lora · 学生开发者 · 西安</p>
        <a class='availability' href='/contact' title='联系 Lora'><i></i> 欢迎交流 <span aria-hidden='true'>↗</span></a>
      </div>
      <div class='manifesto-stage'>
        <h1 id='home-title' class='display-statement'>构建一切，<br />学习一切。</h1>
        <p class='statement-en'>做项目，写文章，也保留一点生活。</p>
        <div class='hero-scene-float'>
          <HeroScene />
        </div>
        <div class='field-note field-note--build' aria-hidden='true'>
          <LoraVisual asset='stampVerified' priority /><span>真实构建</span>
        </div>
        <div class='field-note field-note--learn' aria-hidden='true'>
          <LoraVisual asset='stampExperiment' /><span>保持实验</span>
        </div>
      </div>
      <p class='manifesto-lede'>
        这里放我做过的项目、写下的技术文章、最近在学的东西，也留一点书、音乐和生活兴趣。
      </p>
      <div class='hero-actions' aria-label='开始探索'>
        <a class='primary-action tactile-action' href='#work' data-magnetic>先看作品 <span aria-hidden='true'>↘</span></a>
        <a class='tactile-action' href='#writing'>最近写了什么 <span aria-hidden='true'>→</span></a>
      </div>
      <div class='hero-foot'>
        <div class='hero-signals' aria-label='个人入口'>
          <span class='hero-signal-kicker'>快速入口</span>
          <a href='/contact'>联系我 <span aria-hidden='true'>↗</span></a>
          <ResumePreview triggerLabel='查看简历' />
        </div>
        <HapticsToggle />
        <nav class='social-rail' aria-label='主要社交主页'>
          {
            heroSocials.map((link) => (
              <a
                href={link.href}
                target={link.href.startsWith('http') ? '_blank' : undefined}
                rel={link.href.startsWith('http') ? 'me noopener noreferrer' : undefined}
                aria-label={`${link.name}: ${link.handle}`}
                data-tooltip={link.name}
                style={`--brand:${link.brand}`}
              >
                <SocialIcon name={link.icon} class='size-5' />
              </a>
            ))
          }
        </nav>
      </div>
    </section>

    <HomeSectionNav items={sectionNav} />

    <div class='v2-flow'>
      <section id='about' class='v2-section home-about' aria-labelledby='about-title'>
        <header class='section-heading'>
          <span class='section-index' aria-hidden='true'>00</span>
          <div class='section-heading-copy'>
            <p class='eyebrow'>关于我</p>
            <h2 id='about-title'>你好，我是 Lora。</h2>
          </div>
          <a class='text-link' href='/about'>更多关于我 <span aria-hidden='true'>↗</span></a>
        </header>
        <div class='home-about-grid'>
          <div class='home-about-copy'>
            <p>{profile.summary[0]}</p>
            <p>这个网站是我的长期个人主页。作品、文章、最近在做的事、简历和工作之外的兴趣都会持续更新在这里。</p>
            <div class='home-about-links'>
              <a href='/resume'>看简历 <span aria-hidden='true'>→</span></a>
              <a href='/now'>看最近在做什么 <span aria-hidden='true'>→</span></a>
              <a href='/contact'>联系我 <span aria-hidden='true'>→</span></a>
            </div>
          </div>
          <div class='home-about-portrait'><LoraVisual asset='avatar' alt='Lora 的角色头像' /></div>
        </div>
      </section>

      <section id='work' class='v2-section' aria-labelledby='work-title'>
        <header class='section-heading'>
          <span class='section-index' aria-hidden='true'>01</span>
          <div class='section-heading-copy'>
            <p class='eyebrow'>精选作品</p>
            <h2 id='work-title'>先看这几个我最想分享的项目。</h2>
          </div>
          <a class='text-link' href='/projects'>查看全部 {allSelectedProjects.length} 个作品 <span aria-hidden='true'>↗</span></a>
          <div class='section-meta'><span class='archive-badge archive-badge--verified'>已验证</span><time datetime={syncReport.syncedAt.slice(0,10)}>同步于 {new Intl.DateTimeFormat('zh-CN', { month: 'long', day: 'numeric', timeZone: 'UTC' }).format(new Date(syncReport.syncedAt))}</time></div>
        </header>
        <LoraVisual asset='projectsMap' class='section-scene section-scene--wide' />
        {
          leadProject && (
            <div class='lead-work'>
              <ProjectCard project={leadProject} variant='lead' lens compact compactLocale='zh-CN'>
                {demoFor(leadProject) && <ProjectDemo kind={demoFor(leadProject)!} slot='demo' />}
              </ProjectCard>
              <p class='work-rationale'><b>第一次来可以从这里开始。</b> 每个项目都能继续进入源码、项目说明或相关文章；完整作品在作品页按主题整理。</p>
            </div>
          )
        }
        <div class='supporting-work'>
          {supportingProjects.map((project) => (
            <ProjectCard {project} variant='featured' lens compact compactLocale='zh-CN'>
              {demoFor(project) && <ProjectDemo kind={demoFor(project)!} slot='demo' />}
            </ProjectCard>
          ))}
        </div>
      </section>

      <section id='writing' class='v2-section' aria-labelledby='writing-title'>
        <header class='section-heading'>
          <span class='section-index' aria-hidden='true'>02</span>
          <div class='section-heading-copy'>
            <p class='eyebrow'>构建笔记</p>
            <h2 id='writing-title'>最近写了什么。</h2>
          </div>
          <a class='text-link' href='/blog'>全部写作 <span aria-hidden='true'>↗</span></a>
          {latestPostDate && <div class='section-meta'><span class='archive-badge archive-badge--field'>现场记录</span><time>最新 {latestPostDate}</time></div>}
        </header>
        <LoraVisual asset='readingMarker' class='section-scene' />
        {
          recentPosts.length > 0 && (
            <ul class='writing-list'>
              {recentPosts.map((post, index) => (
                <Fragment>
                  <PostPreview post={post} class={index === 0 ? 'writing-item writing-item--lead' : 'writing-item'} />
                  {index === 0 && <li class='writing-reason'>第一次来？可以先读最新一篇，再进入完整写作目录。</li>}
                </Fragment>
              ))}
            </ul>
          )
        }
      </section>

      <section id='now' class='v2-section' aria-labelledby='now-title'>
        <header class='section-heading'>
          <span class='section-index' aria-hidden='true'>03</span>
          <div class='section-heading-copy'>
            <p class='eyebrow'>正在构建</p>
            <h2 id='now-title'>最近在忙什么。</h2>
          </div>
          <a class='text-link' href='/now'>查看完整近况 <span aria-hidden='true'>↗</span></a>
        </header>
        <LoraVisual asset='nowWorkbench' class='section-scene section-scene--wide' />
        <div class='focus-grid'>
          {focusSummary.map((item, index) => <article class='focus-item'><span>0{index + 1}</span><h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3><p>{item.description}</p></article>)}
        </div>
      </section>

      <section id='personal-signals' class='v2-section' aria-label='工作之外'>
        <PersonalShowcase />
      </section>

      <div id='contact' class='contact-anchor'>
        <ContactOutro />
      </div>
    </div>
    <blockquote class='site-quote'><p>Build systems that learn.</p></blockquote>
  </main>

  <script>
    const magnetic = document.querySelector<HTMLElement>('[data-magnetic]')
    const finePointer = matchMedia('(hover: hover) and (pointer: fine)')
    const resetMagnetic = () => {
      magnetic?.style.setProperty('--magnetic-x', '0px')
      magnetic?.style.setProperty('--magnetic-y', '0px')
    }
    magnetic?.addEventListener('pointermove', (event) => {
      if (!finePointer.matches || !magnetic || matchMedia('(prefers-reduced-motion: reduce)').matches) return
      const rect = magnetic.getBoundingClientRect()
      const pullX = Math.max(-7, Math.min(7, (event.clientX - rect.left - rect.width / 2) * 0.14))
      const pullY = Math.max(-7, Math.min(7, (event.clientY - rect.top - rect.height / 2) * 0.14))
      magnetic.style.setProperty('--magnetic-x', `${pullX.toFixed(2)}px`)
      magnetic.style.setProperty('--magnetic-y', `${pullY.toFixed(2)}px`)
    })
    magnetic?.addEventListener('pointerleave', resetMagnetic)
  </script>
</PageLayout>

<style>
  #home-title { font-family: ui-sans-serif, system-ui, "PingFang SC", "Microsoft YaHei", sans-serif; }
  .v2-home {
    position: relative;
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
  }

  /* 格纹纸：首页叙事的地板，向下淡出交给内容。 */
  .grid-paper {
    position: absolute;
    z-index: 0;
    top: 0;
    left: 0;
    width: 100%;
    height: min(165vh, 105rem);
    background-image:
      radial-gradient(circle at 14% 7%, hsl(var(--field-amber) / 0.10), transparent 21rem),
      radial-gradient(circle at 88% 22%, hsl(var(--field-teal) / 0.06), transparent 19rem),
      linear-gradient(hsl(var(--field-ink) / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, hsl(var(--field-ink) / 0.045) 1px, transparent 1px);
    background-size: 2.4rem 2.4rem;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, black 55%, transparent);
    mask-image: linear-gradient(to bottom, black 55%, transparent);
  }

  .site-quote {
    position: relative;
    z-index: 1;
    width: min(100%, 70rem);
    margin: 3.5rem auto 0;
    border-top: 1px solid hsl(var(--border));
    padding: 1.15rem clamp(0.35rem, 2vw, 1.25rem) 0;
    color: hsl(var(--muted-foreground));
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.72rem;
  }
  .site-quote p { margin: 0; }

  /* 宣言 hero：开放版面，大字即主角，角色从右侧咬合文字。 */
  .manifesto {
    position: relative;
    z-index: 1;
    width: min(100%, 70rem);
    margin-top: clamp(2.5rem, 7vw, 5.5rem);
    padding-inline: clamp(0.35rem, 2vw, 1.25rem);
  }
  .manifesto-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .availability {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid hsl(var(--border) / 0.9);
    border-radius: 999px;
    padding: 0.3rem 0.65rem;
    background: hsl(var(--background) / 0.8);
    color: hsl(var(--muted-foreground));
    font-size: 0.66rem;
    font-weight: 640;
    text-decoration: none;
    transition:
      color var(--motion-base) ease,
      border-color var(--motion-base) ease,
      transform var(--motion-quick) var(--motion-spring);
  }
  .availability i {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: hsl(var(--field-teal));
  }
  .availability:hover {
    color: hsl(var(--foreground));
    border-color: hsl(var(--field-amber) / 0.6);
    transform: translateY(-1px);
  }
  .availability:focus-visible {
    color: hsl(var(--foreground));
    border-color: hsl(var(--field-amber) / 0.6);
    box-shadow: 0 0 0 3px hsl(var(--field-amber) / 0.3);
  }

  .manifesto-stage {
    position: relative;
    margin-top: clamp(1.4rem, 4vw, 2.6rem);
  }
  .manifesto-stage .display-statement {
    position: relative;
    z-index: 2;
    margin: 0;
    color: hsl(var(--foreground));
  }
  .statement-en {
    position: relative;
    z-index: 2;
    max-width: 30rem;
    margin: clamp(0.9rem, 2vw, 1.3rem) 0 0;
    color: hsl(var(--muted-foreground));
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 1.8vw, 1.25rem);
    font-weight: 620;
    letter-spacing: 0.005em;
  }
  .hero-scene-float {
    position: absolute;
    z-index: 1;
    top: 50%;
    right: clamp(-2.5rem, -1vw, 0.5rem);
    width: min(38vw, 29rem);
    transform: translateY(-54%);
  }
  .field-note {
    position: absolute;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    border: 1px solid hsl(var(--border) / 0.78);
    border-radius: 999px;
    padding: 0.22rem 0.5rem 0.22rem 0.25rem;
    background: hsl(var(--background) / 0.84);
    box-shadow: 0 12px 28px -24px hsl(var(--foreground) / 0.65);
    font-size: 0.57rem;
    font-weight: 690;
    letter-spacing: 0.04em;
    pointer-events: none;
  }
  .field-note :global(.lora-visual) {
    width: 1.65rem;
    height: 1.65rem;
    border-radius: 50%;
    object-fit: cover;
  }
  .field-note--build {
    top: -0.9rem;
    right: clamp(11rem, 30vw, 24rem);
  }
  .field-note--learn {
    right: clamp(6rem, 17vw, 14rem);
    bottom: -0.6rem;
  }

  .manifesto-lede {
    max-width: 34rem;
    margin: clamp(1.5rem, 4vw, 2.4rem) 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.95rem;
    line-height: 1.75;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }
  .primary-action,
  .hero-actions > a:not(.primary-action) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border-radius: 999px;
    padding: 0.62rem 1.05rem;
    font-size: 0.78rem;
    font-weight: 640;
    letter-spacing: 0.01em;
    text-decoration: none;
  }
  .primary-action {
    border: 1px solid hsl(var(--field-ink) / 0.9);
    background: hsl(var(--field-ink));
    color: hsl(var(--field-paper));
  }
  .primary-action:hover {
    box-shadow: 0 14px 30px -20px hsl(var(--field-ink) / 0.8);
  }
  .hero-actions > a:not(.primary-action) {
    border: 1px solid hsl(var(--border));
    color: hsl(var(--foreground));
    background: hsl(var(--background) / 0.7);
  }
  .hero-actions > a:not(.primary-action):hover {
    border-color: hsl(var(--field-amber) / 0.7);
  }

  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.9rem 1.5rem;
    margin-top: 2rem;
    border-top: 1px dashed hsl(var(--border) / 0.9);
    padding-top: 1.1rem;
  }
  .hero-signals {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem 0.7rem;
  }
  .hero-signal-kicker {
    color: hsl(var(--muted-foreground));
    font-size: 0.6rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .hero-signals > a {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    color: hsl(var(--muted-foreground));
    font-size: 0.7rem;
    font-weight: 620;
    text-decoration: none;
  }
  .hero-signals > a:hover,
  .hero-signals > a:focus-visible {
    color: hsl(var(--foreground));
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }
  .social-rail {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .social-rail a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.15rem;
    height: 2.15rem;
    border: 1px solid hsl(var(--border) / 0.8);
    border-radius: 999px;
    background: hsl(var(--background) / 0.72);
    color: hsl(var(--muted-foreground));
    transition:
      color var(--motion-base) ease,
      border-color var(--motion-base) ease,
      background-color var(--motion-base) ease,
      transform var(--motion-quick) var(--motion-spring);
  }
  .social-rail a:hover,
  .social-rail a:focus-visible {
    color: var(--brand, hsl(var(--foreground)));
    border-color: color-mix(in srgb, var(--brand, hsl(var(--foreground))) 42%, transparent);
    background: color-mix(in srgb, var(--brand, hsl(var(--foreground))) 9%, transparent);
    transform: translateY(-1px);
  }

  /* 滚动叙事区块：编号大字 + 统一节奏。 */
  .v2-flow {
    position: relative;
    z-index: 1;
    display: flex;
    width: min(100%, 70rem);
    flex-direction: column;
    gap: var(--section-gap);
    margin-top: var(--section-gap);
    padding-inline: clamp(0.35rem, 2vw, 1.25rem);
  }
  .v2-section {
    scroll-margin-top: 5.5rem;
  }
  .section-heading {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 1rem;
  }
  .section-heading-copy {
    position: relative;
    z-index: 1;
  }
  .section-heading h2 {
    max-width: 22ch;
    margin: 0.5rem 0 0;
    color: hsl(var(--foreground));
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 680;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }
  .section-index {
    position: absolute;
    top: -1.4rem;
    right: -0.4rem;
    z-index: 0;
    color: transparent;
    font-family: var(--font-display);
    font-size: clamp(4rem, 9vw, 6.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    pointer-events: none;
    -webkit-text-stroke: 1.5px hsl(var(--field-ink) / 0.2);
    text-stroke: 1.5px hsl(var(--field-ink) / 0.2);
  }
  .text-link {
    position: relative;
    z-index: 1;
    color: hsl(var(--muted-foreground));
    font-size: 0.72rem;
    font-weight: 620;
    text-decoration: none;
    transition: color var(--motion-base) ease;
  }
  .text-link:hover,
  .text-link:focus-visible {
    color: hsl(var(--foreground));
  }
  .section-scene {
    width: min(100%, 18rem);
    max-height: 13rem;
    margin: -1rem 0 1.25rem auto;
    object-fit: contain;
  }
  .section-scene--wide {
    width: min(100%, 26rem);
    max-height: 15rem;
  }
  .lead-work {
    display: grid;
    gap: 0.8rem;
  }
  .work-rationale {
    max-width: 44rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.8rem;
    line-height: 1.7;
  }
  .work-rationale b {
    color: hsl(var(--foreground));
    font-weight: 680;
  }
  .supporting-work {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  .writing-list {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .writing-item {
    position: relative;
    border-block-end: 1px solid hsl(var(--border));
    padding: 0.35rem 0;
    transition:
      background var(--motion-base) ease,
