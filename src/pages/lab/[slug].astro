---
import { labEntries, type LabEntry } from '@/data/lab'

import PageLayout from '@/layouts/CommonPage.astro'

export function getStaticPaths() {
  return labEntries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }))
}

interface Props {
  entry: LabEntry
}
const { entry } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const headings = [
  { depth: 2, slug: 'question', text: '问题' },
  { depth: 2, slug: 'implementation', text: '实现与可检查依据' },
  { depth: 2, slug: 'result', text: '结果' },
  { depth: 2, slug: 'limits', text: '记录边界' },
  { depth: 2, slug: 'source', text: '源码与项目入口' }
]
---

<PageLayout title={entry.title} {headings} view>
  <p class='eyebrow'>{entry.eyebrow} · {entry.project}</p>
  <p class='lead'>{entry.summary}</p>

  <h2 id='question'>问题</h2>
  <blockquote>{entry.question}</blockquote>

  <h2 id='implementation'>实现与可检查依据</h2>
  <p>{entry.summary}</p>
  <div class='not-prose technology-list' aria-label='使用的技术栈'>
    {entry.technologies.map((technology) => <span>{technology}</span>)}
  </div>
  <p class='evidence-note'>
    本页提供技术栈和项目源码作为检查入口。记录中没有测试设置、运行输出或独立测量数据。
  </p>

  <h2 id='result'>结果</h2>
  <p>{entry.result}</p>

  <h2 id='limits'>记录边界</h2>
  <p>
    本页只整理已有的问题、摘要、结果说明、技术栈和链接。它不提供测试过程或线上效果证明。实现状态以仓库当前内容为准。
  </p>

  <h2 id='source'>源码与项目入口</h2>
  <p>查看 <strong>{entry.project}</strong> 的源仓库；有独立演示网站时，也可以直接打开。</p>
  <div class='not-prose actions'>
    <a class='primary' href={entry.source} target='_blank' rel='noopener noreferrer'
      >查看源码 <span aria-hidden='true'>↗</span></a
    >
    {
      entry.website && (
        <a href={entry.website} target='_blank' rel='noopener noreferrer'>
          打开演示网站 <span aria-hidden='true'>↗</span>
        </a>
      )
    }
    <a href={`${base}/lab`}>返回实验室</a>
  </div>
</PageLayout>

<style>
  .eyebrow {
    margin-bottom: 0.45rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.73rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .lead {
    font-size: 1.08rem;
    line-height: 1.7;
  }
  .technology-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1.25rem 0 2rem;
  }
  .technology-list span {
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    padding: 0.25rem 0.62rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.72rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1.15rem;
  }
  .actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.65rem;
    padding: 0.55rem 0.8rem;
    color: hsl(var(--foreground));
    font-size: 0.78rem;
    text-decoration: none;
    transition:
      background 0.2s,
      transform 0.2s;
  }
  .actions a:hover {
    background: hsl(var(--muted));
    transform: translateY(-1px);
  }
  .actions .primary {
    border-color: hsl(var(--foreground));
    background: hsl(var(--foreground));
    color: hsl(var(--background));
  }
  @media (prefers-reduced-motion: reduce) {
    .actions a {
      transition: none;
    }
    .actions a:hover {
      transform: none;
    }
  }
</style>
