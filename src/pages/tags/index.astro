---
import { getBlogCollection, getUniqueTagsWithCount } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'

const posts = (await getBlogCollection()).filter(({ data }) => !data.draft)
const tags = getUniqueTagsWithCount(posts)

const meta = {
  description: '按标签浏览公开长文。短笔记、项目和实验记录保留各自的浏览入口。',
  title: '文章标签'
}
---

<PageLayout {meta}>
  <main class='tags-page'>
    <header class='tags-heading'>
      <p class='eyebrow'>写作目录</p>
      <h1>文章标签</h1>
      <p>这里的标签只来自公开长文。短笔记、项目和实验记录使用各自的分类与目录。</p>
      <span>{tags.length} 个标签 · {posts.length} 篇文章</span>
    </header>

    {
      tags.length > 0 ? (
        <ul class='tag-grid'>
          {tags.map(([tag, count]) => (
            <li>
              <a href={`/tags/${encodeURIComponent(tag)}`}>
                <span>#{tag}</span>
                <small>{count} 篇</small>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class='empty-state'>暂时没有已发布文章标签。</p>
      )
    }
  </main>
</PageLayout>

<style>
  .tags-page {
    max-width: 58rem;
    margin-inline: auto;
  }
  .tags-heading {
    margin-bottom: 2rem;
  }
  .eyebrow {
    margin: 0 0 0.4rem;
    color: hsl(var(--field-amber-strong));
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 6vw, 3.4rem);
    line-height: 1.12;
  }
  .tags-heading > p:not(.eyebrow) {
    max-width: 48rem;
    margin: 0.75rem 0 0.4rem;
    color: hsl(var(--muted-foreground));
    line-height: 1.7;
  }
  .tags-heading > span {
    color: hsl(var(--muted-foreground));
    font-size: 0.76rem;
  }
  .tag-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 1.25rem;
    margin: 0;
    padding: 0;
    border-top: 1px solid hsl(var(--border));
    list-style: none;
  }
  .tag-grid li {
    min-width: 0;
    border-bottom: 1px solid hsl(var(--border));
  }
  .tag-grid a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.65rem;
    min-height: 3.2rem;
    padding: 0.85rem 0.1rem;
    color: hsl(var(--foreground));
    text-decoration: none;
  }
  .tag-grid a:hover span,
  .tag-grid a:focus-visible span {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .tag-grid small {
    flex: none;
    color: hsl(var(--muted-foreground));
    font-size: 0.7rem;
  }
  .empty-state {
    color: hsl(var(--muted-foreground));
  }
  @media (max-width: 760px) {
    .tag-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 480px) {
    .tag-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
