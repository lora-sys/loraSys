---
import { projects } from '@/data/projects'
import { socialLinks } from '@/data/social'
import contributionSnapshot from '@/data/external-contributions.json'
import syncReport from '@/data/sync-report.json'

import PageLayout from '@/layouts/BaseLayout.astro'
import CollectionPageJsonLd from '@/components/seo/CollectionPageJsonLd.astro'
import ContentDirectory, { type DirectoryItem } from '@/components/projects/ContentDirectory.astro'
import ContentGraph from '@/components/projects/ContentGraph.astro'
import ProjectCard from '@/components/projects/ProjectCard.astro'
import ProjectDemo from '@/components/projects/ProjectDemo.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import ThemeRoadmap from '@/components/projects/ThemeRoadmap.astro'
import HapticsToggle from '@/components/lora/HapticsToggle.astro'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { getProjectStories } from '@/data/project-stories'
import { getContentOpportunities } from '@/data/content-intelligence'
import { getThemeRoadmap } from '@/data/theme-roadmap'
import { demoByRepo } from '@/data/project-demos'

const selectedWork = projects
  .filter((project) => project.featuredRank !== undefined)
  .sort((left, right) => (left.featuredRank ?? 99) - (right.featuredRank ?? 99))
const [leadProject, ...supportingProjects] = selectedWork
const graphProjects = projects.filter((project) => getProjectStories(project.repository).length > 0)
const linkedRepositories = new Set(graphProjects.map((project) => project.repository))
const contentOpportunities = getContentOpportunities({ projects, linkedRepositories })
const allPosts = sortMDByDate(await getBlogCollection())
const themeRoadmap = getThemeRoadmap(
  projects,
  allPosts.map((post) => ({ id: post.id, title: post.data.title }))
)
const creatorChannels = socialLinks.filter((link) => ['YouTube', 'Bilibili', '知乎', '小红书'].includes(link.name))
const contributionAllowlist = new Set((contributionSnapshot.allowlist ?? []).map((repository) => repository.toLowerCase()))
const selectedContributions = contributionSnapshot.contributions.filter(
  (contribution) => contributionAllowlist.size === 0 || contributionAllowlist.has(contribution.repository.toLowerCase())
)
const contributionSyncDate = syncReport.snapshots?.contributions ?? contributionSnapshot.lastUpdated
const contributionWarningCount = (syncReport.warnings?.length ?? 0) + (contributionSnapshot.warnings?.length ?? 0)

const demoFor = (project: (typeof projects)[number]) => demoByRepo[project.repository]
const formatDirectoryDate = (date: Date) =>
  new Intl.DateTimeFormat('zh-CN', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(date)
const directoryItems: DirectoryItem[] = [
  ...allPosts.map((post) => ({
    kind: 'Writing' as const,
    title: post.data.title,
    meta: formatDirectoryDate(post.data.updatedDate ?? post.data.publishDate),
    href: `/blog/${post.id}`,
    source: 'lora-sys' as const,
    detail: post.data.language === 'zh-CN' ? '中文长文' : '英文原文'
  })),
  ...creatorChannels.map((channel) => ({
    kind: 'Channel' as const,
    title: channel.name,
    meta: channel.handle,
    href: channel.href,
    source: 'External' as const,
    detail: channel.description
  })),
  ...selectedContributions.map((contribution) => ({
    kind: 'Contribution' as const,
    title: contribution.repository,
    meta: contribution.label,
    href: contribution.repositoryUrl,
    source: 'External' as const,
    detail: `${contribution.pullRequests.length} PR${contribution.pullRequests.length === 1 ? '' : 's'} · ${contribution.note}`
  })),
  ...graphProjects.map((project) => ({
    kind: 'Project' as const,
    title: project.title,
    meta: project.source === 'ACAMLab' ? 'ACAMLab' : 'lora-sys',
    href: `/projects#${project.repository}`,
    source: project.source === 'ACAMLab' ? ('ACAMLab' as const) : ('lora-sys' as const),
    detail: `${({building:'构建中',active:'持续维护',archived:'已归档'}[project.status])} · ${getProjectStories(project.repository).length} 条内容链接`
  }))
]
---

<PageLayout
  meta={{
    title: '作品',
    description: 'Lora 的精选构建：AI Agent、开发者工具、全栈产品与公开证据。'
  }}
  highlightColor='#d99a33'
>
  <Fragment slot='head'>
    <CollectionPageJsonLd
      name='作品'
      description='Lora 的精选构建：AI Agent、开发者工具、全栈产品与公开证据。'
    />
  </Fragment>
  <main class='work-page' id='content'>
    <header class='work-hero'>
      <p class='eyebrow'>精选作品</p>
      <div class='hero-grid'>
        <h1>Agent 系统、开发者工具与公开实验。</h1>
        <div class='hero-copy'>
          <p>查看项目说明、源码、演示与构建笔记。</p>
          <p class='hero-note'>完整项目和外部贡献保留在下方档案中，可按关键词、来源和状态筛选。</p>
        </div>
      </div>
    </header>

    <section class='selected-work' aria-labelledby='selected-work-title'>
      <header class='section-heading'>
        <div><p class='eyebrow'>{selectedWork.length} 个项目</p><h2 id='selected-work-title'>精选作品</h2></div>
        <div class='heading-side'>
          <span>产品、仓库与相关记录</span>
          <HapticsToggle />
        </div>
      </header>
      {
        leadProject && (
          <div class='lead-work'>
            <ProjectCard project={leadProject} variant='lead' priority lens anchor>
              {demoFor(leadProject) && <ProjectDemo kind={demoFor(leadProject)} slot='demo' />}
            </ProjectCard>
            <p>查看产品能力、运行记录、仓库与关联笔记。</p>
          </div>
        )
      }
      <div class='supporting-work'>
        {supportingProjects.map((project) => (
          <ProjectCard {project} variant='featured' lens anchor>
            {demoFor(project) && <ProjectDemo kind={demoFor(project)} slot='demo' />}
          </ProjectCard>
        ))}
      </div>
    </section>

    <aside class='work-principle'>
      <span>Case guide</span>
      <p>每个案例从一个具体产品问题出发：可观测性、评测、视觉证据、工程协作或多智能体模拟。</p>
      <a href='/blog'>查看相关笔记 <span aria-hidden='true'>→</span></a>
    </aside>

    <details class='work-archive' id='archive' data-work-archive>
      <summary class='tactile-action'><span><b>展开完整档案</b><small>查看全部同步项目、贡献关系、内容路线与筛选工具</small></span><em data-archive-state aria-live='polite'>目录已收起</em><i aria-hidden='true'>+</i></summary>
      <div class='archive-content'>
        <ContentGraph projects={graphProjects} />
        <ContentDirectory
          items={directoryItems}
          opportunities={contentOpportunities}
          audit={{
            status: syncReport.status,
            syncedAt: contributionSyncDate,
            allowlistCount: contributionAllowlist.size,
            contributionCount: selectedContributions.length,
            warningCount: contributionWarningCount
          }}
        />
        <ThemeRoadmap themes={themeRoadmap} />
        <ProjectSection {projects} />
      </div>
    </details>

    <aside class='project-outro' aria-labelledby='project-outro-title'>
      <div><p>交流与合作</p><h2 id='project-outro-title'>有一个值得认真构建的想法？</h2></div>
      <a class='tactile-action' href='/contact'>联系我 <span aria-hidden='true'>→</span></a>
    </aside>
  </main>
</PageLayout>

<script>
  const archive = document.querySelector<HTMLDetailsElement>('[data-work-archive]')
  const archiveState = archive?.querySelector<HTMLElement>('[data-archive-state]')
  const updateArchiveState = () => {
    if (!archiveState || !archive) return
    archiveState.textContent = archive.open ? '目录已展开' : '目录已收起'
  }
  archive?.addEventListener('toggle', updateArchiveState)
  updateArchiveState()
</script>

<style>
  .work-page { display:flex; width:min(100%,70rem); flex-direction:column; gap:clamp(2rem,5vw,3rem); margin:0 auto; padding:0 0 2rem; }
  .work-hero { display:grid; gap:.65rem; }
  .eyebrow,.project-outro p { margin:0; color:hsl(var(--muted-foreground)); font-size:.66rem; font-weight:650; letter-spacing:.1em; text-transform:uppercase; }
  .hero-grid { display:grid; grid-template-columns:minmax(0,1.2fr) minmax(16rem,.8fr); align-items:end; gap:1.5rem; }
  h1 { max-width:18ch; margin:0; font-size:clamp(1.9rem,4.6vw,3.5rem); font-weight:570; letter-spacing:-.03em; line-height:1.12; text-wrap:balance; }
  .hero-copy { display:grid; gap:.7rem; }
  .hero-copy p { margin:0; color:hsl(var(--muted-foreground)); font-size:.88rem; line-height:1.65; }
  .hero-copy .hero-note { border-inline-start:2px solid hsl(var(--field-amber)); padding-inline-start:.85rem; font-size:.8rem; }
  .selected-work { display:grid; gap:1rem; }
  .section-heading { display:flex; align-items:end; justify-content:space-between; gap:1rem; }
  .section-heading h2 { margin:.25rem 0 0; font-size:clamp(1.4rem,2.5vw,1.9rem); font-weight:580; letter-spacing:-.03em; }
  .heading-side { display:flex; align-items:center; gap:1rem; font-size:.75rem; color:hsl(var(--muted-foreground)); }
  .lead-work { display:grid; gap:.7rem; }
  .lead-work>p { margin:0; color:hsl(var(--muted-foreground)); font-size:.78rem; line-height:1.6; }
  .supporting-work { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; }
  .work-principle { display:grid; grid-template-columns:10rem minmax(0,1fr) auto; align-items:center; gap:1.25rem; border-block:1px solid hsl(var(--border)); padding-block:1.5rem; }
  .work-principle span { color:hsl(var(--field-amber)); font-size:.62rem; font-weight:680; letter-spacing:.12em; }
  .work-principle p { max-width:45ch; margin:0; font-size:1rem; font-weight:560; letter-spacing:-.025em; line-height:1.35; }
  .work-principle a { color:hsl(var(--foreground)); font-size:.72rem; font-weight:620; text-decoration:none; white-space:nowrap; }
  .work-principle a:hover,.work-principle a:focus-visible { text-decoration:underline; text-underline-offset:.22rem; }
  .work-archive { border-block:1px solid hsl(var(--border)); scroll-margin-top:5.5rem; }
  .work-archive summary { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding-block:1.25rem; cursor:pointer; list-style:none; }
  .work-archive summary em { margin-left:auto; color:hsl(var(--muted-foreground)); font-size:.65rem; font-style:normal; letter-spacing:.04em; white-space:nowrap; }
  .work-archive summary::-webkit-details-marker { display:none; }
  .work-archive summary span { display:grid; gap:.35rem; }
  .work-archive summary b { font-size:1rem; font-weight:620; }
  .work-archive summary small { color:hsl(var(--muted-foreground)); font-size:.73rem; }
  .work-archive summary i { display:grid; width:2rem; height:2rem; place-items:center; border:1px solid hsl(var(--border)); border-radius:50%; font-size:1.15rem; font-style:normal; transition:transform 180ms ease; }
  .work-archive[open] summary i { transform:rotate(45deg); }
  .archive-content { display:flex; flex-direction:column; gap:clamp(4rem,8vw,7rem); padding:1rem 0 clamp(2rem,5vw,4rem); }
  .project-outro { display:flex; align-items:flex-end; justify-content:space-between; gap:2rem; border-block:1px solid hsl(var(--border)); padding-block:clamp(1.5rem,4vw,2.5rem); }
  .project-outro h2 { max-width:22ch; margin:.35rem 0 0; font-size:clamp(1.45rem,4vw,2.35rem); font-weight:580; letter-spacing:-.04em; line-height:1.08; text-wrap:balance; }
  .project-outro a { display:inline-flex; min-height:2.75rem; flex:none; align-items:center; gap:.5rem; border:1px solid hsl(var(--foreground)); border-radius:999px; padding:.58rem .9rem; background:hsl(var(--foreground)); color:hsl(var(--background)); font-size:.75rem; font-weight:650; text-decoration:none; transition:opacity 180ms ease,transform 180ms ease; }
  .project-outro a:hover,.project-outro a:focus-visible { opacity:.88; transform:translateY(-1px); }
  @media(max-width:820px) {
    .hero-grid { grid-template-columns:1fr; align-items:start; gap:.75rem; }
    .hero-copy { max-width:38rem; }
    .supporting-work { grid-template-columns:1fr; }
    .work-principle { grid-template-columns:1fr; align-items:start; }
    .work-principle a { white-space:normal; }
    .lead-work :global([data-project-media]) { min-height:0; max-height:11rem; aspect-ratio:16/7; }
  }
  @media(max-width:580px) {
    h1 { font-size:clamp(1.9rem,8.5vw,2.6rem); }
    .section-heading,.project-outro { align-items:flex-start; flex-direction:column; gap:.65rem; }
    .heading-side { flex-wrap:wrap; gap:.5rem; }
    .work-archive summary em { margin-left:0; }
    .project-outro { gap:1.25rem; }
  }
  @media(prefers-reduced-motion:reduce) {
    .work-archive summary i,.project-outro a { transition:none; }
    .project-outro a:hover,.project-outro a:focus-visible { transform:none; }
  }
</style>
