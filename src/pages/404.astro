---
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import LoraVisual from '@/components/lora/LoraVisual.astro'

const meta = {
  description: 'Not found',
  title: '404'
}
---

<PageLayout {meta} noindex>
  <main class='notfound'>
    <LoraVisual asset='wayfinding404' class='notfound-scene' />
    <div class='notfound-copy'>
      <p class='eyebrow'>Route not found · 路径中断</p>
      <h1 class='notfound-index' aria-label='404，页面不存在'>404</h1>
      <p class='notfound-lede'>这个页面不存在，或者链接已经失效。Mochi 检查过了，路的尽头没有东西。</p>
      <div class='notfound-actions'>
        <Button title='返回首页' href='/' variant='ahead' />
        <a class='notfound-alt' href='/projects'>先看作品 <span aria-hidden='true'>→</span></a>
      </div>
    </div>
  </main>
</PageLayout>

<style>
  .notfound {
    display: grid;
    align-items: center;
    justify-items: center;
    gap: clamp(1.5rem, 5vw, 3rem);
    max-width: 60rem;
    margin-inline: auto;
    padding-block: clamp(2.5rem, 7vw, 5rem);
    text-align: center;
  }
  .notfound-scene {
    width: min(100%, 30rem);
    object-fit: contain;
  }
  .notfound-copy {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
  }
  .notfound-index {
    margin: 0;
    color: transparent;
    font-family: var(--font-display);
    font-size: clamp(5rem, 18vw, 9rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.05em;
    -webkit-text-stroke: 2px hsl(var(--field-ink) / 0.34);
  }
  .notfound-lede {
    max-width: 30rem;
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.92rem;
    line-height: 1.75;
  }
  .notfound-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    margin-top: 0.5rem;
  }
  .notfound-alt {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    padding: 0.55rem 0.95rem;
    color: hsl(var(--foreground));
    font-size: 0.76rem;
    font-weight: 640;
    text-decoration: none;
    transition:
      border-color var(--motion-base) ease,
      transform var(--motion-quick) var(--motion-spring);
  }
  .notfound-alt:hover,
  .notfound-alt:focus-visible {
    border-color: hsl(var(--field-amber) / 0.7);
    transform: translateY(-1px);
  }
  @media (min-width: 760px) {
    .notfound {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      text-align: left;
    }
    .notfound-copy {
      justify-items: start;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .notfound-alt {
      transition: none;
    }
    .notfound-alt:hover {
      transform: none;
    }
  }
</style>
