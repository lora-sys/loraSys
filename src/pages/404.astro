---
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'

const meta = {
  description: 'Not found',
  title: '404'
}
---

<PageLayout {meta} noindex>
  <main class='px-4 py-10 text-center sm:px-6 lg:px-8'>
    <h1 class='block text-7xl font-bold sm:text-9xl'>404</h1>
    <p class='mt-3 text-muted-foreground'>这个页面不存在，或者链接已经失效。</p>
    <p class='text-lg'>返回首页，继续浏览作品、笔记和公开记录。</p>
    <Button title='返回首页' href='/' variant='ahead' class='mt-5' />
  </main>
</PageLayout>
