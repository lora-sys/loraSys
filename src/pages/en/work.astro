---
import { projects } from '@/data/profile'
import { withBasePath } from '@/i18n/site'
import { demoByRepo } from '@/data/project-demos'

import PageLayout from '@/layouts/BaseLayout.astro'
import HapticsToggle from '@/components/lora/HapticsToggle.astro'
import LeadProjectStage from '@/components/projects/LeadProjectStage.astro'
import ProjectCard from '@/components/projects/ProjectCard.astro'
import ProjectDemo from '@/components/projects/ProjectDemo.astro'

const selectedRepositories = [
  'Glassbox-Agent-Harness',
  'zhihu-threads',
  'skills',
  'AgentArena',
  'trustops',
  'mossguard'
]
const selectedWork = selectedRepositories.flatMap((repository) => {
  const project = projects.find((item) => item.repository === repository)
  return project ? [project] : []
})
const [leadProject, ...supportingProjects] = selectedWork
const demoFor = (project: (typeof projects)[number]) => demoByRepo[project.repository]
---

<PageLayout
  lang='en-US'
  meta={{
    title: 'Work',
    description:
      'Projects by Lora: personal agents, learning products, developer tools, hackathon builds, and open-source experiments.'
  }}

>
  <main class='work-page'>
    <header class='work-hero'>
      <p class='eyebrow'>Work archive</p>
      <div class='hero-grid'>
        <h1>A few projects I've built.</h1>
        <p class='hero-copy'>Personal agents, learning tools, developer projects, and open-source experiments.</p>
      </div>
    </header>

    {
      leadProject && (
        <section class='selected-work' aria-labelledby='selected-work-heading'>
          <header class='section-heading'>
            <div>
              <>
                <p class='eyebrow'>{selectedWork.length} projects</p>
                <h2 id='selected-work-heading'>Featured work</h2>
              </>
            </div>
            <HapticsToggle locale='en-US' />
          </header>
          <LeadProjectStage
            project={leadProject}
            locale='en-US'
            hideRationale
            anchor
            priority
          />
          {supportingProjects.length > 0 && (
            <div class='supporting-work'>
              {supportingProjects.map((project) => (
                <ProjectCard {project} variant='featured' lens={false} compact compactLocale='en-US' anchor>
                  {demoFor(project) && (
                    <ProjectDemo kind={demoFor(project)!} locale='en-US' slot='demo' />
                  )}
                </ProjectCard>
              ))}
            </div>
          )}
        </section>
      )
    }

    <aside class='archive-link'>
      <div>
        <strong>Looking for the full archive?</strong><p>
          The complete directory includes every synced project and contribution.
        </p>
      </div>
      <a href={withBasePath('/projects#archive')}>Browse the project archive <span aria-hidden='true'>↗</span></a>
    </aside>
  </main>
</PageLayout>

<style>
  .work-page {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
  }
  .work-hero {
    display: grid;
    gap: 0.7rem;
    border-block: 1px solid hsl(var(--border));
    padding-block: clamp(1rem, 3vw, 1.8rem);
  }
  .eyebrow {
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.66rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr);
    align-items: end;
    gap: 1.5rem;
  }
  h1 {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(1.9rem, 4.6vw, 3.5rem);
    font-weight: 570;
    letter-spacing: -0.03em;
    line-height: 1.12;
    text-wrap: balance;
  }
  .hero-copy {
    display: grid;
    justify-items: start;
    gap: 0.7rem;
  }
  .hero-copy p {
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.88rem;
    line-height: 1.65;
  }
  .selected-work {
    display: grid;
    gap: 1.4rem;
  }
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }
  .section-heading h2 {
    margin: 0.25rem 0 0;
    font-size: clamp(1.4rem, 2.5vw, 1.9rem);
    font-weight: 580;
    letter-spacing: -0.03em;
  }
  .section-heading > span {
    color: hsl(var(--muted-foreground));
    font-size: 0.75rem;
  }
  .supporting-work {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .archive-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    border-block: 1px solid hsl(var(--border));
    padding-block: 1.3rem;
  }
  .archive-link strong {
    font-size: 0.95rem;
    font-weight: 620;
  }
  .archive-link p {
    margin: 0.3rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.75rem;
    line-height: 1.55;
  }
  .archive-link > a {
    flex: none;
    color: hsl(var(--foreground));
    font-size: 0.75rem;
    font-weight: 620;
    text-decoration: none;
  }
  .archive-link > a:hover,
  .archive-link > a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.22rem;
  }
  @media (max-width: 760px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }
    .supporting-work {
      grid-template-columns: 1fr;
    }
    .section-heading {
      align-items: start;
      flex-direction: column;
    }
  }
  @media (max-width: 540px) {
    .archive-link {
      align-items: start;
      flex-direction: column;
      gap: 0.7rem;
    }
  }
</style>
