---
import { projects } from '@/data/profile'
import PageLayout from '@/layouts/BaseLayout.astro'
import ProjectCard from '@/components/projects/ProjectCard.astro'
import ProjectDemo from '@/components/projects/ProjectDemo.astro'
import HapticsToggle from '@/components/lora/HapticsToggle.astro'

const featured = projects.filter((project) => project.featured)

const demoByRepo: Record<string, 'timeline' | 'pipeline' | 'terminal'> = {
  AgentArena: 'timeline',
  'ai-engineering-harness': 'pipeline',
  'Glassbox-Agent-Harness': 'terminal'
}
const demoFor = (project: (typeof projects)[number]) => demoByRepo[project.repository]
---

<PageLayout
  lang='en-US'
  meta={{ title: 'Work', description: 'Selected AI agent systems, developer tools, and public experiments by Lora.' }}
  highlightColor='#d99a33'
>
  <main class='work-page'>
    <header>
      <p>Selected work</p>
      <h1>Agent systems, developer tools, and public experiments.</h1>
      <span>Explore project notes, source code, demos, and contribution records.</span>
      <div class='header-toggle'><HapticsToggle locale='en-US' /></div>
    </header>
    <section aria-labelledby='selected-work-heading'>
      <h2 id='selected-work-heading' class='sr-only'>Selected projects</h2>
      {featured.map((project, index) => (
        <div class:list={['case', { lead: index === 0 }]}>
          <ProjectCard {project} variant={index === 0 ? 'lead' : 'featured'} lens anchor>
            {demoFor(project) && <ProjectDemo kind={demoFor(project)!} locale='en-US' slot='demo' />}
          </ProjectCard>
        </div>
      ))}
    </section>
    <aside><strong>Looking for the complete project archive?</strong><a href='/projects'>Browse the full archive in Chinese ↗</a></aside>
  </main>
</PageLayout>

<style>
  .work-page { display:grid; min-width:0; grid-template-columns:minmax(0,1fr); gap:clamp(1.5rem,4vw,2.5rem); }
  header { display:grid; min-width:0; max-width:70rem; gap:.65rem; }
  header p { margin:0; color:hsl(var(--field-amber)); font-size:.67rem; font-weight:680; letter-spacing:.1em; text-transform:uppercase; }
  h1 { max-width:25ch; margin:0; font-size:clamp(1.9rem,4.6vw,3.5rem); font-weight:580; letter-spacing:-.03em; line-height:1.12; }
  header span { max-width:60ch; color:hsl(var(--muted-foreground)); line-height:1.65; }
  .header-toggle { display:flex; flex-wrap:wrap; align-items:center; gap:.4rem .7rem; }
  section { display:grid; min-width:0; grid-template-columns:minmax(0,1fr); gap:1rem; }
  .case { min-width:0; width:100%; }
  .case:not(.lead) { max-width:58rem; margin-left:auto; }
  aside { display:flex; min-width:0; justify-content:space-between; gap:1rem; border-block:1px solid hsl(var(--border)); padding:1rem 0; font-size:.78rem; }
  aside a { color:hsl(var(--foreground)); text-decoration:none; }
  aside a:hover { text-decoration:underline; }
  @media(max-width:820px) { .lead :global([data-project-media]) { min-height:0; max-height:11rem; aspect-ratio:16/7; } }
  @media(max-width:640px) { aside { flex-direction:column; } }
</style>
