---
import { projects } from '@/data/profile'
import PageLayout from '@/layouts/BaseLayout.astro'
import ProjectCard from '@/components/projects/ProjectCard.astro'
import ProjectDemo from '@/components/projects/ProjectDemo.astro'
import HapticsToggle from '@/components/lora/HapticsToggle.astro'
import LoraVisual from '@/components/lora/LoraVisual.astro'
import { demoByRepo } from '@/data/project-demos'

const selectedRepositories = [
  'Glassbox-Agent-Harness',
  'zhihu-threads',
  'skills',
  'AgentArena',
  'trustops',
  'mossguard'
]
const featured = selectedRepositories.flatMap((repository) => {
  const project = projects.find((item) => item.repository === repository)
  return project ? [project] : []
})
const demoFor = (project: (typeof projects)[number]) => demoByRepo[project.repository]
---

<PageLayout
  lang='en-US'
  meta={{ title: 'Work', description: 'Projects by Lora: personal agents, learning products, developer tools, hackathon builds, and open-source experiments.' }}
  highlightColor='#d99a33'
>
  <main class='work-page'>
    <header class='work-hero'>
      <LoraVisual asset='projectsMap' class='work-hero-visual' />
      <p>Selected work</p>
      <h1>A few projects I've built.</h1>
      <span>Personal agents, learning products, developer tools, hackathon builds, and open-source experiments. Each project links to its source, notes, or supporting evidence.</span>
      <div class='header-toggle'><HapticsToggle locale='en-US' /></div>
    </header>
    <section aria-labelledby='selected-work-heading'>
      <h2 id='selected-work-heading' class='sr-only'>Selected projects</h2>
      {featured.map((project, index) => (
        <div class:list={['case', { lead: index === 0 }]}>
          <ProjectCard {project} variant={index === 0 ? 'lead' : 'featured'} lens anchor>
            {demoFor(project) && <ProjectDemo kind={demoFor(project)!} locale='en-US' slot='demo' />}
          </ProjectCard>
        </div>
      ))}
    </section>
    <aside>
      <strong>Want the complete archive?</strong>
      <a href='/projects'>Browse every project and contribution ↗</a>
    </aside>
  </main>
</PageLayout>

<style>
  .work-page { display:grid; min-width:0; grid-template-columns:minmax(0,1fr); gap:clamp(1.5rem,4vw,2.5rem); }
  .work-hero { position:relative; isolation:isolate; display:grid; min-width:0; max-width:70rem; min-height:15rem; align-content:end; gap:.65rem; overflow:hidden; border-block:1px solid hsl(var(--border)); padding-block:clamp(1.25rem,4vw,2.4rem); }
  .work-hero-visual { position:absolute; z-index:-1; top:-18%; right:-7%; width:min(56%,34rem); opacity:.17; transform:rotate(1.5deg); pointer-events:none; }
  header p { margin:0; color:hsl(var(--field-amber)); font-size:.67rem; font-weight:680; letter-spacing:.1em; text-transform:uppercase; }
  h1 { max-width:25ch; margin:0; font-size:clamp(1.9rem,4.6vw,3.5rem); font-weight:580; letter-spacing:-.03em; line-height:1.12; }
  header span { max-width:60ch; color:hsl(var(--muted-foreground)); line-height:1.65; }
  .header-toggle { display:flex; flex-wrap:wrap; align-items:center; gap:.4rem .7rem; }
  section { display:grid; min-width:0; grid-template-columns:minmax(0,1fr); gap:1rem; }
  .case { min-width:0; width:100%; }
  .case:not(.lead) { max-width:58rem; margin-left:auto; }
  aside { display:flex; min-width:0; justify-content:space-between; gap:1rem; border-block:1px solid hsl(var(--border)); padding:1rem 0; font-size:.78rem; }
  aside a { color:hsl(var(--foreground)); text-decoration:none; }
  aside a:hover,aside a:focus-visible { text-decoration:underline; text-underline-offset:.2rem; }
  @media(max-width:820px) { .work-hero-visual{top:1rem;right:-8rem;width:24rem;opacity:.11}.lead :global([data-project-media]) { min-height:0; max-height:11rem; aspect-ratio:16/7; } }
  @media(max-width:640px) { aside { flex-direction:column; } }
  @media(prefers-reduced-motion:reduce){.work-hero-visual{transform:none}}
</style>
