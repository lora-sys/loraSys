---
import { friendLinks } from '@/data/links'

import PageLayout from '@/layouts/BaseLayout.astro'
import FriendConstellation from '@/components/links/FriendConstellation.astro'

const active = friendLinks.filter((link) => link.status === 'active')
---

<PageLayout
  lang='en-US'
  meta={{
    title: 'Links',
    description: 'A small constellation of verified, reciprocal connections around Lora’s work.'
  }}
  highlightColor='#d99a33'
>
  <main class='links-page'>
    <header>
      <p>LINKS</p><h1>Friends and their sites.</h1><span
        >This page shows confirmed reciprocal links and explains how to suggest a connection.</span>
    </header><FriendConstellation links={friendLinks} /><section id='apply-links'>
      <div>
        <small>STATUS</small><strong
          >{active.length} confirmed {active.length === 1 ? 'link' : 'links'}</strong>
      </div><p>
        Send your site name, URL, description and avatar if you would like to exchange links.
      </p><a href='mailto:lorasys@outlook.com?subject=Friend%20link%20application'
        >Apply by email ↗</a>
    </section><a class='back' href='/links'>Friends page in Chinese ↗</a>
  </main>
</PageLayout>
<style>
  .links-page {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }
  header {
    display: grid;
    gap: 0.75rem;
    padding-block: clamp(1rem, 4vw, 3rem);
  }
  header p,
  small {
    color: hsl(var(--field-amber));
    font-size: 0.67rem;
    font-weight: 680;
    letter-spacing: 0.13em;
  }
  h1 {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 5.5rem);
    font-weight: 580;
    letter-spacing: -0.068em;
    line-height: 0.93;
  }
  header span {
    max-width: 57ch;
    color: hsl(var(--muted-foreground));
    line-height: 1.7;
  }
  section {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 2rem;
    align-items: end;
    border-block: 1px solid hsl(var(--border));
    padding: 1rem 0;
  }
  section div {
    display: grid;
    gap: 0.3rem;
  }
  section strong {
    font-size: 0.85rem;
  }
  section p {
    max-width: 44ch;
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.78rem;
    line-height: 1.6;
  }
  section a,
  .back {
    color: hsl(var(--foreground));
    font-size: 0.72rem;
  }
  @media (max-width: 700px) {
    section {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
