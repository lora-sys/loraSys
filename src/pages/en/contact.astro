---
import PageLayout from '@/layouts/BaseLayout.astro'
import { socialLinks } from '@/data/social'

const channels = socialLinks.filter((link) => ['Email', 'GitHub', 'LinkedIn', 'X'].includes(link.name))
---

<PageLayout lang='en-US' meta={{ title: 'Contact', description: 'Start a conversation with Lora about agent systems, open source, and product experiments.' }} highlightColor='#54c7b7'>
  <main class='contact-page'><header><p>CONTACT</p><h1>Have an ambitious system worth making real?</h1><span>Tell me what you are trying to build, investigate, or improve. The most useful conversations begin with a real constraint.</span><a class='primary' href='mailto:lorasys@outlook.com'>Start a conversation ↗</a></header><section>{channels.map((channel) => <a href={channel.href} target={channel.href.startsWith('http') ? '_blank' : undefined} rel={channel.href.startsWith('http') ? 'noopener noreferrer' : undefined}><strong>{channel.name}</strong><span>{channel.handle}</span><i>↗</i></a>)}</section><a class='back' href='/contact'>查看中文联系页 ↗</a></main>
</PageLayout>
<style>.contact-page{display:grid;gap:clamp(2rem,5vw,4rem)}header{display:grid;max-width:56rem;gap:.85rem;padding-block:clamp(1rem,5vw,4rem)}header p{margin:0;color:hsl(173 60% 38%);font-size:.67rem;font-weight:680;letter-spacing:.13em}h1{max-width:16ch;margin:0;font-size:clamp(2.8rem,7vw,6.5rem);font-weight:580;letter-spacing:-.075em;line-height:.9}header span{max-width:55ch;color:hsl(var(--muted-foreground));line-height:1.7}.primary{width:max-content;border-radius:999px;padding:.7rem .95rem;background:hsl(173 60% 36%);color:#fff;font-size:.76rem;text-decoration:none}section{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem}section a{display:grid;grid-template-columns:1fr auto;gap:.25rem;border:1px solid hsl(var(--border));border-radius:.9rem;padding:1rem;color:hsl(var(--foreground));text-decoration:none;transition:transform 180ms ease,border-color 180ms ease}section a:hover,section a:focus-visible{border-color:hsl(173 60% 38%);transform:translateY(-2px)}section span{color:hsl(var(--muted-foreground));font-size:.75rem}section i{grid-row:1/3;grid-column:2;font-style:normal}.back{color:hsl(var(--foreground));font-size:.75rem}@media(max-width:640px){section{grid-template-columns:1fr}}@media(prefers-reduced-motion:reduce){section a{transition:none}section a:hover,section a:focus-visible{transform:none}}</style>
