---
import { Image } from 'astro:assets'
import { socialLinks } from '@/data/social'

import PageLayout from '@/layouts/BaseLayout.astro'
import CopyAction from '@/components/layout/CopyAction.astro'
import correspondence from '@/assets/lora-visual/v2/lora-v2-contact-correspondence.webp'

const channels = socialLinks.filter((link) =>
  ['Email', 'GitHub', 'LinkedIn', 'X'].includes(link.name)
)
---

<PageLayout
  lang='en-US'
  meta={{
    title: 'Contact',
    description:
      'Say hello to Lora about projects, open source, learning, content, or a concrete technical problem.'
  }}
  highlightColor='#d99a33'
>
  <main class='contact-page'>
    <header>
      <p>CONTACT</p><h1>Want to talk?</h1><span
        >Projects, engineering, open source, learning, or just a hello are all welcome. A little
        context is enough to start.</span
      ><a class='primary' href='mailto:lorasys@outlook.com'>Send an email ↗</a><Image
        src={correspondence}
        alt=''
        aria-hidden='true'
        class='contact-visual'
        widths={[360, 560, 720]}
        sizes='(min-width: 700px) 18rem, 75vw'
        loading='eager'
        fetchpriority='high'
      />
    </header><section>
      {
        channels.map((channel) => (
          <a
            href={channel.href}
            target={channel.href.startsWith('http') ? '_blank' : undefined}
            rel={channel.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            <>
              <strong>{channel.name}</strong>
              <span>{channel.handle}</span>
              <i>↗</i>
            </>
          </a>
        ))
      }
    </section>
    <div class='email-copy'>
      <span>lorasys@outlook.com</span><CopyAction
        value='lorasys@outlook.com'
        label='Copy email'
        locale='en-US'
      />
    </div>
    <a class='back' href='/contact'>Contact page in Chinese ↗</a>
  </main>
</PageLayout>
<style>
  .email-copy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--field-paper));
  }
  .contact-page {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }
  header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(11rem, 0.6fr);
    max-width: 58rem;
    gap: 0.85rem 2rem;
    align-items: center;
    border-block: 1px solid hsl(var(--border));
    padding-block: clamp(1rem, 5vw, 3rem);
  }
  header p,
  header h1,
  header span,
  header .primary {
    grid-column: 1;
  }
  header p {
    margin: 0;
    color: hsl(var(--field-amber));
    font-size: 0.67rem;
    font-weight: 680;
    letter-spacing: 0.13em;
  }
  h1 {
    max-width: 16ch;
    margin: 0;
    font-size: clamp(2.8rem, 7vw, 6.5rem);
    font-weight: 580;
    letter-spacing: -0.075em;
    line-height: 0.9;
  }
  header span {
    max-width: 55ch;
    color: hsl(var(--muted-foreground));
    line-height: 1.7;
  }
  .contact-visual {
    grid-column: 2;
    grid-row: 1/5;
    width: 100%;
    max-height: 18rem;
    object-fit: contain;
  }
  .primary {
    width: max-content;
    border-radius: 999px;
    padding: 0.7rem 0.95rem;
    background: hsl(var(--foreground));
    color: hsl(var(--background));
    font-size: 0.76rem;
    text-decoration: none;
  }
  section {
    display: grid;
    grid-template-columns: 1fr;
    max-width: 58rem;
  }
  section a {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr) auto;
    gap: 0.5rem;
    border-top: 1px solid hsl(var(--border));
    padding: 1rem 0.2rem;
    color: hsl(var(--foreground));
    text-decoration: none;
    transition: padding 180ms ease;
  }
  section a:hover,
  section a:focus-visible {
    padding-inline: 0.6rem;
  }
  section span {
    color: hsl(var(--muted-foreground));
    font-size: 0.75rem;
  }
  section i {
    font-style: normal;
  }
  .back {
    color: hsl(var(--foreground));
    font-size: 0.75rem;
  }
  @media (max-width: 640px) {
    header {
      grid-template-columns: 1fr;
    }
    .contact-visual {
      grid-column: 1;
      grid-row: auto;
      width: min(75vw, 18rem);
      justify-self: center;
    }
    section a {
      grid-template-columns: 1fr auto;
    }
    section a span {
      grid-column: 1;
    }
    section a i {
      grid-column: 2;
      grid-row: 1/3;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    section a {
      transition: none;
    }
    section a:hover,
    section a:focus-visible {
      padding-inline: 0.2rem;
    }
  }
</style>
