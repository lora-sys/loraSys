---
import PageLayout from '@/layouts/BaseLayout.astro'
import { currentFocus, getCurrentFocusSections } from '@/data/current-focus'

const sections = getCurrentFocusSections('en-US')
const reviewed = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC'
}).format(new Date(`${currentFocus.reviewedAt}T00:00:00Z`))
---

<PageLayout lang='en-US' meta={{ title: 'Now', description: 'What Lora is building, learning, reading, and listening to now.' }} highlightColor='#d99a33'>
  <main class='now-page'>
    <header>
      <p>NOW</p>
      <h1>A public snapshot of where my attention is going.</h1>
      <span>Reviewed {reviewed}. Updated when the work meaningfully changes, not on every commit.</span>
    </header>
    <section>
      {sections.map((item, index) => <article><span>0{index + 1} · {item.category.toUpperCase()}</span><h2>{item.title}</h2><ul>{item.items.map((line) => <li>{line}</li>)}</ul><small>{item.frequency}</small></article>)}
    </section>
    <a class='back' href='/now'>Read the Chinese update</a>
  </main>
</PageLayout>
<style>.now-page{display:grid;gap:2rem}header{display:grid;gap:.75rem;padding-block:clamp(1rem,4vw,3rem)}header p,article>span{color:hsl(var(--field-amber));font-size:.67rem;font-weight:680;letter-spacing:.12em}h1{max-width:16ch;margin:0;font-size:clamp(2.6rem,6vw,5.7rem);font-weight:580;letter-spacing:-.07em;line-height:.92}header span{max-width:52ch;color:hsl(var(--muted-foreground));line-height:1.7}section{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-top:1px solid hsl(var(--border))}article{min-height:14rem;border-right:1px solid hsl(var(--border));border-bottom:1px solid hsl(var(--border));padding:1.35rem}article:nth-child(even){border-right:0}h2{margin:1.1rem 0 .6rem;font-size:1.2rem}article ul{display:grid;gap:.45rem;margin:0;padding-left:1rem;color:hsl(var(--muted-foreground));font-size:.8rem;line-height:1.65}article small{display:block;margin-top:1rem;color:hsl(var(--muted-foreground));font-size:.66rem}.back{width:max-content;color:hsl(var(--foreground));font-size:.75rem}@media(max-width:640px){section{grid-template-columns:1fr}article,article:nth-child(even){border-right:0}}</style>
