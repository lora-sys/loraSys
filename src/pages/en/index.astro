---
import '@/assets/styles/home.css'

import { getCurrentFocusSummary } from '@/data/current-focus'
import { projects } from '@/data/profile'
import { homepageFeatured } from '@/data/project-curation'
import { withBasePath } from '@/i18n/site'

import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import HomeIntro from '@/components/home/HomeIntro.astro'
import LoraExpressionPicker from '@/components/lora/LoraExpressionPicker.astro'
import PersonalShowcase from '@/components/lora/PersonalShowcase.astro'
import LeadProjectStage from '@/components/projects/LeadProjectStage.astro'
import ProjectCard from '@/components/projects/ProjectCard.astro'
import { recentEnglishArticles } from '@/utils/article-translations'

const allPosts = sortMDByDate(await getBlogCollection())
const recentPosts = recentEnglishArticles(
  allPosts.filter((post) => post.data.contentType !== 'news')
)
const allFeatured = projects.filter((project) => project.featured)
const featured = homepageFeatured(allFeatured)
const [leadProject, ...supportingProjects] = featured
const nowItems = getCurrentFocusSummary('en-US')
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<PageLayout
  lang='en-US'
  meta={{
    title: 'Lora · Personal site',
    description:
      "Lora's personal site for projects, writing, what I'm doing now, personal interests, and ways to get in touch."
  }}
>
  <main class='home-page'>
    <HomeIntro locale='en-US' />

    <div class='home-flow'>
      <section id='work' class='home-section' aria-labelledby='work-title'>
        <header class='section-heading'>
          <div>
            <p class='eyebrow'>Selected work</p>
            <h2 id='work-title'>Work in the making.</h2>
          </div>
          <a class='text-link' href={`${baseUrl}/en/work`}
            >All selected work <span aria-hidden='true'>↗</span></a
          >
        </header>
        {leadProject && <LeadProjectStage project={leadProject} locale='en-US' priority />}
        <div class='supporting-work'>
          {
            supportingProjects.map((project) => (
              <ProjectCard
                {project}
                variant='featured'
                lens={false}
                compact
                compactLocale='en-US'
              />
            ))
          }
        </div>
      </section>

      <section id='writing' class='home-section' aria-labelledby='writing-title'>
        <header class='section-heading'>
          <div>
            <p class='eyebrow'>Writing</p>
            <h2 id='writing-title'>Notes from the process.</h2>
          </div>
          <a class='text-link' href={`${baseUrl}/en/writing`}
            >All writing <span aria-hidden='true'>↗</span></a
          >
        </header>
        {
          recentPosts.length > 0 ? (
            <ul class='writing-list'>
              {recentPosts.map((post) => (
                <li class='writing-item'>
                  <time datetime={post.data.publishDate.toISOString()}>
                    {post.data.publishDate.toLocaleDateString('en-US', {
                      month: 'short',
                      day: 'numeric',
                      year: 'numeric'
                    })}
                  </time>
                  <h3 lang={post.data.language ?? 'zh-CN'}>
                    <a href={withBasePath(`/blog/${post.id}`)}>
                      {post.data.title}
                      <span aria-hidden='true'>↗</span>
                    </a>
                  </h3>
                  <p lang={post.data.language ?? 'zh-CN'}>{post.data.description}</p>
                  <span class='article-language'>
                    {post.data.translationOf ? 'English translation' : 'English original'}
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <p class='empty-note'>No English articles are published yet.</p>
          )
        }
      </section>

      <section id='now' class='home-section' aria-labelledby='now-title'>
        <header class='section-heading'>
          <div>
            <p class='eyebrow'>Now</p>
            <h2 id='now-title'>What I've been up to lately.</h2>
          </div>
          <a class='text-link' href={`${baseUrl}/en/now`}
            >See the full update <span aria-hidden='true'>↗</span></a
          >
        </header>
        <div class='focus-grid'>
          {
            nowItems.map((item, index) => (
              <article class='focus-item'>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <h3>
                  {item.href ? <a href={withBasePath(item.href)}>{item.title}</a> : item.title}
                </h3>
                <p>{item.description}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section id='about' class='home-section home-about' aria-labelledby='about-title'>
        <header class='section-heading'>
          <div>
            <p class='eyebrow'>About</p>
            <h2 id='about-title'>Hi, I'm Lora.</h2>
          </div>
          <a class='text-link' href={`${baseUrl}/en/about`}
            >More about me <span aria-hidden='true'>↗</span></a
          >
        </header>
        <div class='about-content'>
          <div>
            <p>
              I'm a student developer working mostly on AI agents, full-stack products, and the
              infrastructure around them. I like turning an idea into something people can open,
              use, and inspect.
            </p>
            <p>
              This site keeps my projects, writing, current interests, and a few things I enjoy
              outside engineering.
            </p>
            <a class='text-link' href={`${baseUrl}/en/resume`}
              >View résumé <span aria-hidden='true'>↗</span></a
            >
          </div>
          <LoraExpressionPicker locale='en-US' />
        </div>
      </section>

      <section class='home-section' aria-label='Anime and favorites'>
        <PersonalShowcase locale='en-US' />
      </section>

      <div id='contact' class='contact-anchor'>
        <div class='contact-outro'>
          <p class='eyebrow'>Contact</p>
          <h2>Want to say hello or talk about a project?</h2>
          <div class='contact-actions'>
            <a class='primary-action' href={withBasePath('/en/contact')}
              >Write a message <span aria-hidden='true'>→</span></a
            >
            <a class='text-link' href={withBasePath('/contact')}
              >中文联系页 <span aria-hidden='true'>↗</span></a
            >
          </div>
        </div>
      </div>
    </div>
  </main>
</PageLayout>

<style>
  .home-page {
    width: 100%;
  }
  .home-flow {
    display: grid;
    width: min(100%, 70rem);
    gap: clamp(4.5rem, 10vw, 7.5rem);
    margin: 0 auto;
    padding: 1rem clamp(1rem, 4vw, 2.5rem) 4rem;
  }
  .home-section,
  .contact-anchor {
    scroll-margin-top: 5.5rem;
  }
  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 0.8rem 1.5rem;
    margin-bottom: 1.4rem;
  }
  .section-heading h2 {
    max-width: 25ch;
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4vw, 2.75rem);
    font-weight: 640;
    letter-spacing: -0.045em;
    line-height: 1.08;
  }
  .text-link {
    color: hsl(var(--muted-foreground));
    font-size: 0.76rem;
    font-weight: 620;
    text-decoration: none;
  }
  .text-link:hover,
  .text-link:focus-visible {
    color: hsl(var(--foreground));
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }
  .supporting-work {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  .writing-list {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .writing-item {
    display: grid;
    gap: 0.35rem;
    border-top: 1px solid hsl(var(--border));
    padding-top: 1rem;
  }
  .writing-item time,
  .article-language {
    color: hsl(var(--muted-foreground));
    font-size: 0.67rem;
  }
  .writing-item h3 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 650;
  }
  .writing-item h3 a {
    color: hsl(var(--foreground));
    text-decoration: none;
  }
  .writing-item h3 a:hover,
  .writing-item h3 a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }
  .writing-item p,
  .focus-item p,
  .about-content p {
    max-width: 48rem;
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.84rem;
    line-height: 1.7;
  }
  .empty-note {
    border-top: 1px solid hsl(var(--border));
    padding-top: 1rem;
    color: hsl(var(--muted-foreground));
  }
  .focus-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .focus-item {
    border-top: 1px solid hsl(var(--border));
    padding-top: 0.9rem;
  }
  .focus-item > span {
    color: hsl(var(--field-amber-strong));
    font-family: ui-monospace, monospace;
    font-size: 0.67rem;
  }
  .focus-item h3 {
    margin: 0.45rem 0;
    font-size: 1rem;
    font-weight: 650;
  }
  .focus-item h3 a {
    color: inherit;
  }
  .about-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 18rem);
    align-items: center;
    gap: 2rem;
    border-block: 1px solid hsl(var(--border));
    padding: 1.4rem 0;
  }
  .about-content > div {
    display: grid;
    gap: 0.8rem;
  }
  .contact-outro {
    display: grid;
    gap: 0.7rem;
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius-lg);
    padding: clamp(1.4rem, 4vw, 2.4rem);
    background: hsl(var(--card));
  }
  .contact-outro h2 {
    max-width: 20ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 5vw, 2.6rem);
    font-weight: 640;
    letter-spacing: -0.04em;
    line-height: 1.04;
  }
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 0.6rem;
  }

  @media (max-width: 900px) {
    .supporting-work,
    .focus-grid {
      grid-template-columns: 1fr;
    }
    .section-heading {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .about-content {
      grid-template-columns: 1fr;
    }
  }
</style>
