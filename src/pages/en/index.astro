---
import { Image } from 'astro:assets'
import { projects } from '@/data/profile'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import PersonalShowcase from '@/components/lora/PersonalShowcase.astro'
import ProjectCard from '@/components/projects/ProjectCard.astro'
import config from '@/site-config'

const allPosts = sortMDByDate(await getBlogCollection())
const englishPosts = allPosts.filter((post) => post.data.language === 'en-US').slice(0, 3)
const featured = projects.filter((project) => project.featured).slice(0, 3)
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/*.{jpeg,jpg,png,gif,avif,webp}')
const avatarSource = images[config.logo.src]
if (!avatarSource) throw new Error(`Missing homepage avatar: ${config.logo.src}`)
---

<PageLayout lang='en-US' meta={{ title: 'Lora · AI Agent Builder', description: 'AI agent infrastructure, developer tools, experiments, and public evidence built by Lora.' }} highlightColor='#54c7b7'>
  <main class='en-home'>
    <section class='hero'>
      <Image src={avatarSource()} alt='Lora portrait' width={152} height={152} loading='eager' fetchpriority='high' />
      <div>
        <p>AI AGENT DEVELOPER · XI’AN, CHINA</p>
        <h1>I turn ambitious agent ideas into systems that can run, be checked, and improve.</h1>
        <span>I design agent infrastructure, full-stack tools, and public evidence for systems that need to hold up in real work.</span>
        <div class='actions'><a class='primary' href='#work'>Explore selected work ↘</a><a href='#writing'>Read build notes →</a></div>
      </div>
    </section>
    <div class='flow'>
      <section id='work'><header><p>SELECTED WORK</p><h2>Agent systems, developer tools, and experiments in progress.</h2><a href='/en/work'>All work ↗</a></header><div class='work-grid'>{featured.map((project) => <ProjectCard {project} variant='featured' lens />)}</div></section>
      <section id='writing'><header><p>BUILD NOTES</p><h2>Notes on agent infrastructure, multimodal tools, and product experiments.</h2><a href='/en/writing'>All writing ↗</a></header><div class='writing-grid'>{englishPosts.map((post) => <article><time>{post.data.publishDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time><h3><a href={`/en/writing/${post.id}`}>{post.data.title}</a></h3><p>{post.data.description}</p><a href={`/en/writing/${post.id}`}>Read note ↗</a></article>)}</div></section>
      <section id='now' class='now'><header><p>NOW</p><h2>Building reliable agent infrastructure in public.</h2><a href='/en/now'>Full now page ↗</a></header><div><span>01</span><strong>Make runs observable.</strong><p>Turn experiments into inspectable systems, clear evidence, and useful next steps.</p></div><div><span>02</span><strong>AgentArena</strong><p>Bring real tasks, review, evidence, and replayable judgment into one agent system.</p></div></section>
      <PersonalShowcase locale='en-US' />
    </div>
  </main>
</PageLayout>

<style>
.en-home{display:grid;gap:clamp(4rem,10vw,8rem)}.hero{display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;gap:clamp(2rem,7vw,5rem);padding:clamp(1rem,4vw,3rem) 0}.hero img{width:clamp(8rem,16vw,10rem);height:clamp(8rem,16vw,10rem);border:1px solid hsl(var(--border));border-radius:50%;padding:.3rem;object-fit:cover}.hero p,header p{margin:0;color:hsl(173 60% 38%);font-size:.66rem;font-weight:680;letter-spacing:.12em}.hero h1{max-width:16ch;margin:.8rem 0 0;font-size:clamp(2.5rem,6vw,5.2rem);font-weight:590;letter-spacing:-.065em;line-height:.94}.hero span{display:block;max-width:48rem;margin-top:1.3rem;color:hsl(var(--muted-foreground));font-size:.92rem;line-height:1.7}.actions{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:1.35rem}.actions a,header>a{display:inline-flex;border:1px solid hsl(var(--border));border-radius:999px;padding:.58rem .8rem;color:hsl(var(--foreground));font-size:.72rem;text-decoration:none}.actions .primary{border-color:hsl(173 60% 36%);background:hsl(173 60% 36%);color:#fff}.flow{display:grid;gap:clamp(4.5rem,10vw,8rem)}section header{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem;align-items:end;margin-bottom:1.35rem}header h2{max-width:22ch;margin:.45rem 0 0;font-size:clamp(1.7rem,4vw,3rem);font-weight:570;letter-spacing:-.055em;line-height:1.04}.work-grid,.writing-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.writing-grid article{display:grid;min-height:14rem;border-top:1px solid hsl(var(--border));padding-top:1rem}.writing-grid time{color:hsl(var(--muted-foreground));font-size:.65rem}.writing-grid h3{margin:.65rem 0 0;font-size:1.1rem;line-height:1.2}.writing-grid h3 a,.writing-grid>a{color:hsl(var(--foreground));text-decoration:none}.writing-grid p{margin:.65rem 0;color:hsl(var(--muted-foreground));font-size:.76rem;line-height:1.6}.writing-grid article>a{align-self:end;font-size:.7rem}.now{display:grid;grid-template-columns:1fr 1fr;gap:1rem;border-block:1px solid hsl(var(--border));padding-block:1.3rem}.now header{grid-column:1/-1}.now>div{border-top:1px solid hsl(var(--border));padding-top:1rem}.now span{color:hsl(173 60% 38%);font-size:.66rem}.now strong{display:block;margin-top:.5rem}.now p{color:hsl(var(--muted-foreground));font-size:.78rem;line-height:1.6}@media(max-width:760px){.hero{grid-template-columns:1fr;text-align:center}.hero img{margin:auto}.hero h1,.hero span{margin-inline:auto}.actions{justify-content:center}section header{grid-template-columns:1fr}.work-grid,.writing-grid,.now{grid-template-columns:1fr}.now header{grid-column:auto}}
</style>
