---
import { getCurrentFocusSummary } from '@/data/current-focus'
import { withBasePath } from '@/i18n/site'
import { projects } from '@/data/profile'
import { homepageFeatured } from '@/data/project-curation'
import { demoByRepo } from '@/data/project-demos'

import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import HeroScene from '@/components/lora/HeroScene.astro'
import LoraExpressionPicker from '@/components/lora/LoraExpressionPicker.astro'
import PersonalShowcase from '@/components/lora/PersonalShowcase.astro'
import LeadProjectStage from '@/components/projects/LeadProjectStage.astro'
import ProjectCard from '@/components/projects/ProjectCard.astro'
import ProjectDemo from '@/components/projects/ProjectDemo.astro'

const allPosts = sortMDByDate(await getBlogCollection())
const recentPosts = allPosts.slice(0, 3)
const allFeatured = projects.filter((project) => project.featured)
const featured = homepageFeatured(allFeatured)
const [leadProject, ...supportingProjects] = featured
const nowItems = getCurrentFocusSummary('en-US')
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '')
const demoFor = (project: (typeof projects)[number]) => demoByRepo[project.repository ?? '']
---

<PageLayout
  lang='en-US'
  meta={{
    title: 'Lora · Personal site',
    description:
      "Lora's personal site for projects, writing, what I'm doing now, personal interests, and ways to get in touch."
  }}
  highlightColor='#d99a33'
>
  <main class='home-page'>
    <section class='home-hero' aria-labelledby='home-title'>
      <div class='hero-copy'>
        <p class='eyebrow'>Lora · Student developer · Xi'an, China</p>
        <h1 id='home-title'>Build everything.<br />Learn everything.</h1>
        <p class='hero-description'>Build things, write about them, keep a life outside code.</p>
        <div class='hero-actions' aria-label='Start exploring'>
          <a class='primary-action' href='#work'>
            See my work <span class='hero-action-arrow' aria-hidden='true'>↘</span>
          </a>
          <a class='secondary-action' href='#writing'
            >Recent writing <span class='hero-action-arrow' aria-hidden='true'>→</span>
          </a
          >
        </div>
      </div>
      <div class='hero-visual'>
        <HeroScene locale='en-US' />
      </div>
      <a class='scroll-cue' href='#work' aria-label='Scroll down to selected work'
        ><span aria-hidden='true'></span>Explore below</a
      >
    </section>

    <div class='home-flow'>
      <section id='work' class='home-section' aria-labelledby='work-title'>
        <header class='section-heading'>
          <div>
            <p class='eyebrow'>Selected work</p>
            <h2 id='work-title'>A few projects I'd show you first.</h2>
          </div>
          <a class='text-link' href={`${baseUrl}/en/work`}
            >All selected work <span aria-hidden='true'>↗</span></a
          >
        </header>
        {leadProject && <LeadProjectStage project={leadProject} locale='en-US' />}
        <div class='supporting-work'>
          {
            supportingProjects.map((project) => (
              <ProjectCard {project} variant='featured' lens compact compactLocale='en-US'>
                {demoFor(project) && (
                  <ProjectDemo kind={demoFor(project)!} locale='en-US' slot='demo' />
                )}
              </ProjectCard>
            ))
          }
        </div>
      </section>

      <section id='writing' class='home-section' aria-labelledby='writing-title'>
        <header class='section-heading'>
          <div>
            <p class='eyebrow'>Writing</p>
            <h2 id='writing-title'>Things I've written recently.</h2>
          </div>
          <a class='text-link' href={`${baseUrl}/en/writing`}>All writing <span aria-hidden='true'>↗</span></a>
        </header>
        {
          recentPosts.length > 0 ? (
            <ul class='writing-list'>
              {recentPosts.map((post) => (
                <li class='writing-item'>
                  <time datetime={post.data.publishDate.toISOString()}>
                    {post.data.publishDate.toLocaleDateString('en-US', {
                      month: 'short',
                      day: 'numeric',
                      year: 'numeric'
                    })}
                  </time>
                  <h3 lang={post.data.language ?? 'zh-CN'}>
                    <a href={withBasePath(`/blog/${post.id}`)}>{post.data.title}</a>
                  </h3>
                  <p lang={post.data.language ?? 'zh-CN'}>{post.data.description}</p>
                  <span class='article-language'>{post.data.language === 'en-US' ? 'English' : 'Chinese'} original</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class='empty-note'>No public writing yet.</p>
          )
        }
      </section>

      <section id='now' class='home-section' aria-labelledby='now-title'>
        <header class='section-heading'>
          <div>
            <p class='eyebrow'>Now</p>
            <h2 id='now-title'>What I've been up to lately.</h2>
          </div>
          <a class='text-link' href={`${baseUrl}/en/now`}
            >See the full update <span aria-hidden='true'>↗</span></a
          >
        </header>
        <div class='focus-grid'>
          {
            nowItems.map((item, index) => (
              <article class='focus-item'>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <h3>{item.href ? <a href={withBasePath(item.href)}>{item.title}</a> : item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section id='about' class='home-section home-about' aria-labelledby='about-title'>
        <header class='section-heading'>
          <div>
            <p class='eyebrow'>About</p>
            <h2 id='about-title'>Hi, I'm Lora.</h2>
          </div>
          <a class='text-link' href={`${baseUrl}/en/about`}>More about me <span aria-hidden='true'>↗</span></a>
        </header>
        <div class='about-content'>
          <div>
            <p>
              I'm a student developer working mostly on AI agents, full-stack products, and the
              infrastructure around them. I like turning an idea into something people can open,
              use, and inspect.
            </p>
            <p>
              This site keeps my projects, writing, current interests, and a few things I enjoy
              outside engineering.
            </p>
            <a class='text-link' href={`${baseUrl}/en/resume`}>View résumé <span aria-hidden='true'>↗</span></a>
          </div>
          <LoraExpressionPicker locale='en-US' />
        </div>
      </section>

      <section class='home-section' aria-label='Anime and favorites'>
        <PersonalShowcase locale='en-US' />
      </section>

      <div id='contact' class='contact-anchor'>
        <div class='contact-outro'>
          <p class='eyebrow'>Contact</p>
          <h2>Want to say hello or talk about a project?</h2>
          <div class='contact-actions'>
            <a class='primary-action' href={withBasePath('/en/contact')}
              >Write a message <span aria-hidden='true'>→</span></a
            >
            <a class='text-link' href={withBasePath('/contact')}>中文联系页 <span aria-hidden='true'>↗</span></a>
          </div>
        </div>
      </div>
    </div>
  </main>
</PageLayout>

<style>
  .home-page {
    width: 100%;
  }
  .home-hero {
    position: relative;
    display: grid;
    width: min(100%, 80rem);
    min-height: calc(100svh - 3.5rem);
    grid-template-columns: minmax(0, 0.96fr) minmax(0, 1.04fr);
    align-items: center;
    gap: 0;
    margin-inline: auto;
    padding: 3rem clamp(1rem, 4vw, 2.5rem) 4.5rem;
  }
  .hero-copy {
    position: relative;
    z-index: 1;
    transform: translateY(-5vh);
  }
  .home-hero :global(.hero-scene) {
    width: 112%;
    max-width: none;
    transform: translate(-4%, -8vh);
  }
  .hero-visual {
    position: relative;
    min-width: 0;
  }
  .eyebrow {
    margin: 0;
    color: hsl(var(--field-amber-strong));
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.08em;
  }
  .home-hero h1 {
    margin: 1.15rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 4.2vw, 3.5rem);
    font-weight: 650;
    letter-spacing: -0.06em;
    line-height: 0.98;
    text-wrap: balance;
  }
  .hero-description {
    max-width: 30rem;
    margin: 1.4rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: clamp(1rem, 1.8vw, 1.25rem);
    line-height: 1.65;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.8rem;
  }
  .primary-action,
  .secondary-action {
    position: relative;
    display: inline-flex;
    min-height: 3.15rem;
    align-items: center;
    gap: 0.45rem;
    border-radius: 999px;
    padding: 0.7rem 1.05rem;
    font-size: 0.82rem;
    font-weight: 650;
    text-decoration: none;
    transition:
      transform 160ms ease,
      background-color 160ms ease,
      border-color 160ms ease;
  }
  .primary-action {
    border: 1px solid hsl(var(--field-ink));
    background: hsl(var(--field-ink));
    color: hsl(var(--field-paper));
  }
  .secondary-action {
    border: 1px solid hsl(var(--border));
    background: hsl(var(--background) / 0.65);
    color: hsl(var(--foreground));
  }
  .primary-action:hover,
  .secondary-action:hover {
    transform: translateY(-2px);
  }
  .secondary-action:hover {
    border-color: hsl(var(--field-amber) / 0.75);
  }
  .scroll-cue {
    position: absolute;
    bottom: 1.2rem;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.69rem;
    text-decoration: none;
    transform: translateX(-50%);
  }
  .scroll-cue span {
    width: 0.42rem;
    height: 0.42rem;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
  }
  .home-flow {
    display: grid;
    width: min(100%, 70rem);
    gap: clamp(4.5rem, 10vw, 7.5rem);
    margin: 0 auto;
    padding: 1rem clamp(1rem, 4vw, 2.5rem) 4rem;
  }
  .home-section,
  .contact-anchor {
    scroll-margin-top: 5.5rem;
  }
  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 0.8rem 1.5rem;
    margin-bottom: 1.4rem;
  }
  .section-heading h2 {
    max-width: 25ch;
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4vw, 2.75rem);
    font-weight: 640;
    letter-spacing: -0.045em;
    line-height: 1.08;
  }
  .text-link {
    color: hsl(var(--muted-foreground));
    font-size: 0.76rem;
    font-weight: 620;
    text-decoration: none;
  }
  .text-link:hover,
  .text-link:focus-visible {
    color: hsl(var(--foreground));
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }
  .supporting-work {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  .writing-list {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .writing-item {
    display: grid;
    gap: 0.35rem;
    border-top: 1px solid hsl(var(--border));
    padding-top: 1rem;
  }
  .writing-item time,
  .article-language {
    color: hsl(var(--muted-foreground));
    font-size: 0.67rem;
  }
  .writing-item h3 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 650;
  }
  .writing-item h3 a {
    color: hsl(var(--foreground));
    text-decoration: none;
  }
  .writing-item h3 a:hover,
  .writing-item h3 a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }
  .writing-item p,
  .focus-item p,
  .about-content p {
    max-width: 48rem;
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.84rem;
    line-height: 1.7;
  }
  .empty-note {
    border-top: 1px solid hsl(var(--border));
    padding-top: 1rem;
    color: hsl(var(--muted-foreground));
  }
  .focus-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .focus-item {
    border-top: 1px solid hsl(var(--border));
    padding-top: 0.9rem;
  }
  .focus-item > span {
    color: hsl(var(--field-amber-strong));
    font-family: ui-monospace, monospace;
    font-size: 0.67rem;
  }
  .focus-item h3 {
    margin: 0.45rem 0;
    font-size: 1rem;
    font-weight: 650;
  }
  .focus-item h3 a {
    color: inherit;
  }
  .about-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 18rem);
    align-items: center;
    gap: 2rem;
    border-block: 1px solid hsl(var(--border));
    padding: 1.4rem 0;
  }
  .about-content > div {
    display: grid;
    gap: 0.8rem;
  }
  .contact-outro {
    display: grid;
    gap: 0.7rem;
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius-lg);
    padding: clamp(1.4rem, 4vw, 2.4rem);
    background: hsl(var(--card));
  }
  .contact-outro h2 {
    max-width: 20ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 5vw, 2.6rem);
    font-weight: 640;
    letter-spacing: -0.04em;
    line-height: 1.04;
  }
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 0.6rem;
  }
  @media (max-width: 760px) {
    .home-hero {
      min-height: calc(100svh - 3.5rem);
      grid-template-columns: 1fr;
      align-content: center;
      gap: 0.7rem;
      padding: 3.5rem 1.1rem 4.5rem;
    }
    .hero-copy {
      transform: none;
    }
    .home-hero :global(.hero-scene) {
      width: min(86vw, 23rem);
      transform: translate(-0.25rem, 0);
    }
    .hero-visual {
      width: 100%;
    }
    .home-hero h1 {
      font-size: clamp(2.35rem, 8vw, 3.3rem);
    }
    .hero-description {
      margin-top: 0.9rem;
    }
    .hero-actions {
      margin-top: 1.2rem;
    }
    .scroll-cue {
      bottom: 0.8rem;
    }
    .supporting-work,
    .focus-grid {
      grid-template-columns: 1fr;
    }
    .section-heading {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .about-content {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .primary-action,
    .secondary-action {
      transition: none;
    }
    .hero-action-reaction--hover {
      display: none;
    }
    .hero-action-reaction--base {
      transition: none;
      transform: none;
    }
    .primary-action:hover .hero-action-reaction--base,
    .primary-action:focus-visible .hero-action-reaction--base,
    .primary-action:active .hero-action-reaction--base,
    .secondary-action:hover .hero-action-reaction--base,
    .secondary-action:focus-visible .hero-action-reaction--base,
    .secondary-action:active .hero-action-reaction--base {
      opacity: 1;
      transform: none;
    }
    .primary-action:hover .hero-action-arrow,
    .primary-action:focus-visible .hero-action-arrow,
    .primary-action:active .hero-action-arrow,
    .secondary-action:hover .hero-action-arrow,
    .secondary-action:focus-visible .hero-action-arrow,
    .secondary-action:active .hero-action-arrow {
      opacity: 1;
    }
    .primary-action:hover,
    .secondary-action:hover {
      transform: none;
    }
  }
</style>
