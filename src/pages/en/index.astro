---
import { projects } from '@/data/profile'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import PersonalShowcase from '@/components/lora/PersonalShowcase.astro'
import ProjectCard from '@/components/projects/ProjectCard.astro'
import ResumePreview from '@/components/resume/ResumePreview.astro'
import HeroScene from '@/components/lora/HeroScene.astro'
import LoraVisual from '@/components/lora/LoraVisual.astro'

const allPosts = sortMDByDate(await getBlogCollection())
const englishPosts = allPosts.filter((post) => post.data.language === 'en-US').slice(0, 3)
const featured = projects.filter((project) => project.featured).slice(0, 3)
---

<PageLayout lang='en-US' meta={{ title: 'Lora · Personal site', description: 'Lora&apos;s personal site for projects, writing, current work, and personal interests.' }} highlightColor='#d99a33'>
  <main class='en-home'>
    <section class='hero' data-field-notes-hero>
      <HeroScene />
      <div>
        <p>LORA · AI AGENT DEVELOPER · XI’AN, CHINA</p>
        <h1>Projects, notes, and the things I&apos;m learning.</h1>
        <strong class='hero-slogan'><small>PERSONAL SITE · 01</small>Work, notes, and interests.</strong>
        <span>I&apos;m Lora, an AI Agent developer in Xi&apos;an. This is where I keep my projects, writing, and a few stories, sounds, and ideas I return to.</span>
        <div class='actions'><a class='primary' href='#work'>See selected work ↘</a><a href='#writing'>Read a recent note →</a></div>
        <div class='hero-signals'><a href='/en/contact'>Get in touch ↗</a><ResumePreview lang='en-US' triggerLabel='Preview résumé' /></div>
      </div>
    </section>
    <div class='flow'>
      <section id='work'><header><p>SELECTED WORK</p><h2>Three places to start.</h2><a href='/en/work'>All work ↗</a></header><LoraVisual asset='projectsMap' class='section-scene' /><div class='work-grid'>{featured.map((project) => <ProjectCard {project} variant='featured' lens compact compactLocale='en-US' />)}</div></section>
      <section id='writing'><header><p>RECENT WRITING</p><h2>Notes on building, learning, and making things work.</h2><a href='/en/writing'>All writing ↗</a></header><LoraVisual asset='readingMarker' class='section-scene' /><div class='writing-grid'>{englishPosts.map((post) => <article><time>{post.data.publishDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time><h3><a href={`/en/writing/${post.id}`}>{post.data.title}</a></h3><p>{post.data.description}</p><a href={`/en/writing/${post.id}`}>Read note ↗</a></article>)}</div></section>
      <section id='now' class='now'><header><p>NOW</p><h2>What I&apos;m working on and learning next.</h2><a href='/en/now'>Full now page ↗</a></header><div><span>01</span><strong>AgentArena</strong><p>A project for turning real tasks and review into a clearer working loop.</p></div><div><span>02</span><strong>Developer tools</strong><p>Small tools that make building and collaborating easier.</p></div></section>
      <PersonalShowcase locale='en-US' />
    </div>
  </main>
</PageLayout>

<style>
.en-home{display:grid;gap:clamp(4rem,10vw,8rem)}.hero{display:grid;grid-template-columns:minmax(19rem,.9fr) minmax(0,1.1fr);align-items:center;gap:clamp(2rem,5vw,4rem);padding:clamp(1rem,4vw,3rem);border:1px solid hsl(var(--border));border-radius:1.5rem;background:linear-gradient(145deg,hsl(var(--field-paper)),hsl(var(--field-warm)/.8))}.hero p,header p{margin:0;color:hsl(var(--field-amber-strong));font-size:.66rem;font-weight:680;letter-spacing:.12em}.hero h1{max-width:16ch;margin:.8rem 0 0;font-size:clamp(2.5rem,6vw,5.2rem);font-weight:590;letter-spacing:-.065em;line-height:.94}.hero-slogan{display:flex;align-items:center;gap:.56rem;width:max-content;max-width:100%;margin-top:1.05rem;border:1px solid hsl(var(--field-amber)/.55);border-radius:.8rem;padding:.45rem .72rem .45rem .48rem;background:linear-gradient(110deg,hsl(var(--field-amber)/.12),hsl(var(--background)/.82) 55%);font-size:clamp(.82rem,1.6vw,.98rem);font-weight:720;letter-spacing:-.025em}.hero-slogan small{border-radius:.42rem;padding:.25rem .42rem;background:hsl(var(--field-amber)/.18);color:hsl(var(--field-amber-strong));font-size:.53rem;font-weight:760;letter-spacing:.08em}.hero-signals{display:flex;align-items:center;flex-wrap:wrap;gap:.45rem .7rem;margin-top:1rem}.hero-signals>a{display:inline-flex;min-height:2rem;align-items:center;color:hsl(var(--muted-foreground));font-size:.68rem;font-weight:620;text-decoration:none}.hero-signals>a:hover,.hero-signals>a:focus-visible{color:hsl(var(--foreground));text-decoration:underline;text-underline-offset:.2rem}.hero-signals :global(.resume-preview-trigger){min-height:2rem;padding:.33rem .58rem;font-size:.68rem}.hero span{display:block;max-width:48rem;margin-top:1.3rem;color:hsl(var(--muted-foreground));font-size:.92rem;line-height:1.7}.actions{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:1.35rem}.actions a,header>a{display:inline-flex;border:1px solid hsl(var(--border));border-radius:999px;padding:.58rem .8rem;color:hsl(var(--foreground));font-size:.72rem;text-decoration:none}.actions .primary{border-color:hsl(var(--field-amber-strong));background:hsl(var(--field-amber-strong));color:#fff}.flow{display:grid;gap:clamp(4.5rem,10vw,8rem)}section header{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem;align-items:end;margin-bottom:1.35rem}header h2{max-width:22ch;margin:.45rem 0 0;font-size:clamp(1.7rem,4vw,3rem);font-weight:570;letter-spacing:-.055em;line-height:1.04}.section-scene{width:min(100%,25rem);max-height:14rem;margin:-1rem 0 1rem auto;object-fit:contain}.work-grid,.writing-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.writing-grid article{display:grid;min-height:14rem;border-top:1px solid hsl(var(--border));padding-top:1rem}.writing-grid time{color:hsl(var(--muted-foreground));font-size:.65rem}.writing-grid h3{margin:.65rem 0 0;font-size:1.1rem;line-height:1.2}.writing-grid h3 a,.writing-grid>a{color:hsl(var(--foreground));text-decoration:none}.writing-grid p{margin:.65rem 0;color:hsl(var(--muted-foreground));font-size:.76rem;line-height:1.6}.writing-grid article>a{align-self:end;font-size:.7rem}.now{display:grid;grid-template-columns:1fr 1fr;gap:1rem;border-block:1px solid hsl(var(--border));padding-block:1.3rem}.now header{grid-column:1/-1}.now>div{border-top:1px solid hsl(var(--border));padding-top:1rem}.now span{color:hsl(var(--field-amber-strong));font-size:.66rem}.now strong{display:block;margin-top:.5rem}.now p{color:hsl(var(--muted-foreground));font-size:.78rem;line-height:1.6}@media(max-width:760px){.hero{grid-template-columns:1fr;text-align:center}.hero h1,.hero span,.hero-slogan{margin-inline:auto}.actions,.hero-signals{justify-content:center}section header{grid-template-columns:1fr}.section-scene{margin-inline:auto}.work-grid,.writing-grid,.now{grid-template-columns:1fr}.now header{grid-column:auto}}
</style>
