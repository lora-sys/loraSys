---
import { projects } from '@/data/profile'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import PersonalShowcase from '@/components/lora/PersonalShowcase.astro'
import ProjectCard from '@/components/projects/ProjectCard.astro'
import ProjectDemo from '@/components/projects/ProjectDemo.astro'
import ResumePreview from '@/components/resume/ResumePreview.astro'
import HeroScene from '@/components/lora/HeroScene.astro'
import HomeSectionNav from '@/components/lora/HomeSectionNav.astro'
import HapticsToggle from '@/components/lora/HapticsToggle.astro'
import LoraVisual from '@/components/lora/LoraVisual.astro'
import ScrollProgressRail from '@/components/lora/ScrollProgressRail.astro'
import SocialIcon from '@/components/contact/SocialIcon.astro'
import { socialLinks } from '@/data/social'

const allPosts = sortMDByDate(await getBlogCollection())
const englishPosts = allPosts.filter((post) => post.data.language === 'en-US').slice(0, 3)
const featured = projects.filter((project) => project.featured).slice(0, 3)

const heroSocials = socialLinks.filter((link) =>
  ['GitHub', 'LinkedIn', 'X', 'Email'].includes(link.name)
)

const demoByRepo: Record<string, 'timeline' | 'pipeline' | 'terminal'> = {
  AgentArena: 'timeline',
  'ai-engineering-harness': 'pipeline',
  'Glassbox-Agent-Harness': 'terminal'
}
const demoFor = (project: (typeof projects)[number]) => demoByRepo[project.repository]

const sectionNav = [
  { id: 'work', label: 'Work' },
  { id: 'writing', label: 'Notes' },
  { id: 'now', label: 'Now' },
  { id: 'personal-signals', label: 'Favorites' },
  { id: 'contact', label: 'Contact' }
]

const nowItems = [
  {
    title: 'AgentArena',
    description: 'A project for turning real tasks and review into a clearer working loop.'
  },
  {
    title: 'Zhihu Threads',
    description: 'Choose source excerpts and build a learning thread with follow-up questions and self-tests.',
    href: '/en/projects/zhihu-threads'
  },
  {
    title: 'Learning',
    description: 'Agent infrastructure, multimodal tooling, and clearer writing.'
  }
]
---

<PageLayout
  lang='en-US'
  meta={{
    title: 'Lora · Personal site',
    description: 'Lora&apos;s personal site for projects, writing, current work, and personal interests.'
  }}
  highlightColor='#d99a33'
>
  <main class='en-home'>
    <div class='grid-paper' aria-hidden='true'></div>
    <ScrollProgressRail />

    <section class='manifesto' aria-labelledby='en-title' data-field-notes-hero>
      <div class='manifesto-head'>
        <p class='eyebrow'>Lora · AI Agent developer · Xi&apos;an, China</p>
        <a class='availability' href='/en/contact' title='Contact Lora'><i></i> Open to talk <span aria-hidden='true'>↗</span></a>
      </div>
      <div class='manifesto-stage'>
        <h1 id='en-title' class='display-statement' lang='en'>Build everything.<br />Learn everything.</h1>
        <p class='statement-zh'>Build, test, and write it down.</p>
        <div class='hero-scene-float'>
          <HeroScene />
        </div>
      </div>
      <p class='manifesto-lede'>
        Agent systems, developer tools, build notes, and a few interests outside the workbench —
        all on one desk.
      </p>
      <div class='hero-actions' aria-label='Start exploring'>
        <a class='primary-action tactile-action' href='#work' data-magnetic>See selected work <span aria-hidden='true'>↘</span></a>
        <a class='tactile-action' href='#writing'>Read a recent note <span aria-hidden='true'>→</span></a>
      </div>
      <div class='hero-foot'>
        <div class='hero-signals' aria-label='Personal links'>
          <span class='hero-signal-kicker'>Personal links</span>
          <a href='/en/contact'>Get in touch <span aria-hidden='true'>↗</span></a>
          <ResumePreview lang='en-US' triggerLabel='Preview résumé' />
        </div>
        <HapticsToggle locale='en-US' />
        <nav class='social-rail' aria-label='Primary social profiles'>
          {
            heroSocials.map((link) => (
              <a
                href={link.href}
                target={link.href.startsWith('http') ? '_blank' : undefined}
                rel={link.href.startsWith('http') ? 'me noopener noreferrer' : undefined}
                aria-label={`${link.name}: ${link.handle}`}
                data-tooltip={link.name}
                style={`--brand:${link.brand}`}
              >
                <SocialIcon name={link.icon} class='size-5' />
              </a>
            ))
          }
        </nav>
      </div>
    </section>

    <HomeSectionNav items={sectionNav} />

    <div class='v2-flow'>
      <section id='work' class='v2-section' aria-labelledby='en-work-title'>
        <header class='section-heading'>
          <span class='section-index' aria-hidden='true'>01</span>
          <div class='section-heading-copy'>
            <p class='eyebrow'>Selected Work</p>
            <h2 id='en-work-title'>Three places to start.</h2>
          </div>
          <a class='text-link' href='/en/work'>All work <span aria-hidden='true'>↗</span></a>
        </header>
        <LoraVisual asset='projectsMap' class='section-scene section-scene--wide' />
        {
          featured[0] && (
            <div class='lead-work'>
              <ProjectCard project={featured[0]} variant='lead' lens compact compactLocale='en-US'>
                {demoFor(featured[0]) && <ProjectDemo kind={demoFor(featured[0])!} locale='en-US' slot='demo' />}
              </ProjectCard>
            </div>
          )
        }
        <div class='supporting-work'>
          {
            featured.slice(1).map((project) => (
              <ProjectCard {project} variant='featured' lens compact compactLocale='en-US'>
                {demoFor(project) && <ProjectDemo kind={demoFor(project)!} locale='en-US' slot='demo' />}
              </ProjectCard>
            ))
          }
        </div>
      </section>

      <section id='writing' class='v2-section' aria-labelledby='en-writing-title'>
        <header class='section-heading'>
          <span class='section-index' aria-hidden='true'>02</span>
          <div class='section-heading-copy'>
            <p class='eyebrow'>Recent Writing</p>
            <h2 id='en-writing-title'>Notes on building, learning, and making things work.</h2>
          </div>
          <a class='text-link' href='/en/writing'>All writing <span aria-hidden='true'>↗</span></a>
        </header>
        <LoraVisual asset='readingMarker' class='section-scene' />
        <ul class='writing-list'>
          {
            englishPosts.map((post) => (
              <li class='writing-item'>
                <time>{post.data.publishDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
                <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
                <p>{post.data.description}</p>
                <a class='text-link' href={`/blog/${post.id}`}>Read note <span aria-hidden='true'>↗</span></a>
              </li>
            ))
          }
        </ul>
      </section>

      <section id='now' class='v2-section' aria-labelledby='en-now-title'>
        <header class='section-heading'>
          <span class='section-index' aria-hidden='true'>03</span>
          <div class='section-heading-copy'>
            <p class='eyebrow'>Now</p>
            <h2 id='en-now-title'>What I&apos;m working on and learning next.</h2>
          </div>
          <a class='text-link' href='/en/now'>Full now page <span aria-hidden='true'>↗</span></a>
        </header>
        <div class='focus-grid'>
          {
            nowItems.map((item, index) => (
              <article class='focus-item'>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <h3>{'href' in item ? <a href={item.href}>{item.title}</a> : item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section id='personal-signals' class='v2-section' aria-label='Beyond the build log'>
        <PersonalShowcase locale='en-US' />
      </section>

      <div id='contact' class='contact-anchor'>
        <div class='contact-outro'>
          <p class='eyebrow'>Contact</p>
          <h2>Want to talk about something being built?</h2>
          <div class='contact-actions'>
            <a class='primary-action tactile-action' href='/en/contact'>Write a message <span aria-hidden='true'>→</span></a>
            <a class='text-link' href='/contact'>中文联系页 <span aria-hidden='true'>↗</span></a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script>
    const magnetic = document.querySelector<HTMLElement>('[data-magnetic]')
    const finePointer = matchMedia('(hover: hover) and (pointer: fine)')
    const resetMagnetic = () => {
      magnetic?.style.setProperty('--magnetic-x', '0px')
      magnetic?.style.setProperty('--magnetic-y', '0px')
    }
    magnetic?.addEventListener('pointermove', (event) => {
      if (!finePointer.matches || !magnetic || matchMedia('(prefers-reduced-motion: reduce)').matches) return
      const rect = magnetic.getBoundingClientRect()
      const pullX = Math.max(-7, Math.min(7, (event.clientX - rect.left - rect.width / 2) * 0.14))
      const pullY = Math.max(-7, Math.min(7, (event.clientY - rect.top - rect.height / 2) * 0.14))
      magnetic.style.setProperty('--magnetic-x', `${pullX.toFixed(2)}px`)
      magnetic.style.setProperty('--magnetic-y', `${pullY.toFixed(2)}px`)
    })
    magnetic?.addEventListener('pointerleave', resetMagnetic)
  </script>
</PageLayout>

<style>
  .en-home {
    position: relative;
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
  }
  .grid-paper {
    position: absolute;
    z-index: 0;
    top: 0;
    left: 0;
    width: 100%;
    height: min(165vh, 105rem);
    background-image:
      linear-gradient(hsl(var(--field-ink) / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, hsl(var(--field-ink) / 0.05) 1px, transparent 1px);
    background-size: 2.4rem 2.4rem;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, black 55%, transparent);
    mask-image: linear-gradient(to bottom, black 55%, transparent);
  }
  .en-home > :global(quote-component) {
    position: relative;
    z-index: 1;
  }
  .manifesto {
    position: relative;
    z-index: 1;
    width: min(100%, 70rem);
    margin-top: clamp(2.5rem, 7vw, 5.5rem);
    padding-inline: clamp(0.35rem, 2vw, 1.25rem);
  }
  .manifesto-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .availability {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid hsl(var(--border) / 0.9);
    border-radius: 999px;
    padding: 0.3rem 0.65rem;
    background: hsl(var(--background) / 0.8);
    color: hsl(var(--muted-foreground));
    font-size: 0.66rem;
    font-weight: 640;
    text-decoration: none;
    transition:
      color var(--motion-base) ease,
      border-color var(--motion-base) ease,
      transform var(--motion-quick) var(--motion-spring);
  }
  .availability i {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: hsl(var(--field-teal));
  }
  .availability:hover,
  .availability:focus-visible {
    color: hsl(var(--foreground));
    border-color: hsl(var(--field-amber) / 0.6);
    box-shadow: 0 0 0 3px hsl(var(--field-amber) / 0.3);
  }
  .manifesto-stage {
    position: relative;
    margin-top: clamp(1.4rem, 4vw, 2.6rem);
  }
  .manifesto-stage .display-statement {
    position: relative;
    z-index: 2;
    max-width: min(58%, 34rem);
    margin: 0;
    color: hsl(var(--foreground));
    letter-spacing: -0.025em;
    line-height: 1.0;
  }
  .statement-zh {
    position: relative;
    z-index: 2;
    max-width: 30rem;
    margin: clamp(0.9rem, 2vw, 1.3rem) 0 0;
    color: hsl(var(--muted-foreground));
    font-size: clamp(0.95rem, 1.8vw, 1.25rem);
    font-weight: 620;
  }
  .hero-scene-float {
    position: absolute;
    z-index: 1;
    top: 50%;
    right: clamp(-2.5rem, -1vw, 0.5rem);
    width: min(38vw, 29rem);
    transform: translateY(-54%);
  }
  .manifesto-lede {
    max-width: 34rem;
    margin: clamp(1.5rem, 4vw, 2.4rem) 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.95rem;
    line-height: 1.75;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }
  .primary-action,
  .hero-actions > a:not(.primary-action) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border-radius: 999px;
    padding: 0.62rem 1.05rem;
    font-size: 0.78rem;
    font-weight: 640;
    letter-spacing: 0.01em;
    text-decoration: none;
  }
  .primary-action {
    border: 1px solid hsl(var(--field-ink) / 0.9);
    background: hsl(var(--field-ink));
    color: hsl(var(--field-paper));
  }
  .primary-action:hover {
    box-shadow: 0 14px 30px -20px hsl(var(--field-ink) / 0.8);
  }
  .hero-actions > a:not(.primary-action) {
    border: 1px solid hsl(var(--border));
    color: hsl(var(--foreground));
    background: hsl(var(--background) / 0.7);
  }
  .hero-actions > a:not(.primary-action):hover {
    border-color: hsl(var(--field-amber) / 0.7);
  }
  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.9rem 1.5rem;
    margin-top: 2rem;
    border-top: 1px dashed hsl(var(--border) / 0.9);
    padding-top: 1.1rem;
  }
  .hero-signals {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem 0.7rem;
  }
  .hero-signal-kicker {
    color: hsl(var(--muted-foreground));
    font-size: 0.6rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .hero-signals > a {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    color: hsl(var(--muted-foreground));
    font-size: 0.7rem;
    font-weight: 620;
    text-decoration: none;
  }
  .hero-signals > a:hover,
  .hero-signals > a:focus-visible {
    color: hsl(var(--foreground));
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }
  .social-rail {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .social-rail a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.15rem;
    height: 2.15rem;
    border: 1px solid hsl(var(--border) / 0.8);
    border-radius: 999px;
    background: hsl(var(--background) / 0.72);
    color: hsl(var(--muted-foreground));
    transition:
      color var(--motion-base) ease,
      border-color var(--motion-base) ease,
      background-color var(--motion-base) ease,
      transform var(--motion-quick) var(--motion-spring);
  }
  .social-rail a:hover,
  .social-rail a:focus-visible {
    color: var(--brand, hsl(var(--foreground)));
    border-color: color-mix(in srgb, var(--brand, hsl(var(--foreground))) 42%, transparent);
    background: color-mix(in srgb, var(--brand, hsl(var(--foreground))) 9%, transparent);
    transform: translateY(-1px);
  }

  .v2-flow {
    position: relative;
    z-index: 1;
    display: flex;
    width: min(100%, 70rem);
    flex-direction: column;
    gap: var(--section-gap);
    margin-top: var(--section-gap);
    padding-inline: clamp(0.35rem, 2vw, 1.25rem);
  }
  .v2-section {
    scroll-margin-top: 5.5rem;
  }
  .section-heading {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 1rem;
  }
  .section-heading-copy {
    position: relative;
    z-index: 1;
  }
  .section-heading h2 {
    max-width: 22ch;
    margin: 0.5rem 0 0;
    color: hsl(var(--foreground));
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 680;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }
  .section-index {
    position: absolute;
    top: -1.4rem;
    right: -0.4rem;
    z-index: 0;
    color: transparent;
    font-family: var(--font-display);
    font-size: clamp(4rem, 9vw, 6.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    pointer-events: none;
    -webkit-text-stroke: 1.5px hsl(var(--field-ink) / 0.2);
    text-stroke: 1.5px hsl(var(--field-ink) / 0.2);
  }
  .text-link {
    position: relative;
    z-index: 1;
    color: hsl(var(--muted-foreground));
    font-size: 0.72rem;
    font-weight: 620;
    text-decoration: none;
    transition: color var(--motion-base) ease;
  }
  .text-link:hover,
  .text-link:focus-visible {
    color: hsl(var(--foreground));
  }
  .section-scene {
    width: min(100%, 18rem);
    max-height: 13rem;
    margin: -1rem 0 1.25rem auto;
    object-fit: contain;
  }
  .section-scene--wide {
    width: min(100%, 26rem);
    max-height: 15rem;
  }
  .supporting-work {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  .lead-work {
    display: grid;
    gap: 0.8rem;
  }
  .writing-list {
    display: grid;
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .writing-item {
    display: grid;
    gap: 0.35rem;
    border-top: 1px solid hsl(var(--border));
    padding-top: 1rem;
  }
  .writing-item time {
    color: hsl(var(--muted-foreground));
    font-size: 0.66rem;
    font-variant-numeric: tabular-nums;
  }
  .writing-item h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 660;
    letter-spacing: -0.02em;
  }
  .writing-item h3 a {
    color: hsl(var(--foreground));
    text-decoration: none;
  }
  .writing-item h3 a:hover,
  .writing-item h3 a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }
  .writing-item p {
    max-width: 46rem;
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.82rem;
    line-height: 1.65;
  }
  .focus-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .focus-item {
    border-top: 1px solid hsl(var(--border));
    padding-top: 1rem;
  }
  .focus-item span {
    color: hsl(var(--field-amber-strong));
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.66rem;
    font-weight: 640;
    letter-spacing: 0.1em;
  }
  .focus-item h3 {
    margin: 0.5rem 0 0;
    font-size: 1.02rem;
    font-weight: 660;
    letter-spacing: -0.02em;
  }
  .focus-item p {
    margin: 0.45rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.8rem;
    line-height: 1.65;
  }
  .contact-anchor {
    scroll-margin-top: 5.5rem;
  }
  .contact-outro {
    display: grid;
    gap: 0.7rem;
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius-lg);
    padding: clamp(1.4rem, 4vw, 2.4rem);
    background:
      radial-gradient(circle at 90% 10%, hsl(var(--primary) / 0.12), transparent 36%),
      hsl(var(--card));
  }
  .contact-outro h2 {
    max-width: 20ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 5vw, 2.6rem);
    font-weight: 640;
    letter-spacing: -0.04em;
    line-height: 1.04;
  }
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 0.6rem;
  }

  @media (max-width: 960px) {
    .hero-scene-float {
      position: static;
      width: min(100%, 25rem);
      margin: 1.4rem auto 0;
      transform: none;
    }
    .manifesto-stage {
      display: flex;
      flex-direction: column;
    }
  }
	@media (max-width: 760px) {
    .supporting-work {
      grid-template-columns: 1fr;
    }
    .section-scene,
    .section-scene--wide {
      width: min(100%, 22rem);
      margin-inline: auto;
    }
    .section-heading {
      grid-template-columns: 1fr;
    }
    .section-index {
      top: -2.4rem;
      font-size: clamp(3.2rem, 14vw, 4.5rem);
    }
    .focus-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .availability,
    .text-link,
    .social-rail a {
      transition: none;
    }
    .availability:hover,
    .social-rail a:hover {
      transform: none;
    }
  }
</style>
