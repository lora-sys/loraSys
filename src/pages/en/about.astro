---
import PageLayout from '@/layouts/BaseLayout.astro'
import { profile, projects } from '@/data/profile'
import { homepageFeatured } from '@/data/project-curation'
import { getCurrentFocusSummary } from '@/data/current-focus'
import ResumePreview from '@/components/resume/ResumePreview.astro'

const featured = homepageFeatured(projects.filter((project) => project.featured))
const focus = getCurrentFocusSummary('en-US')
const capabilities = [
  ['Agent systems', 'Identity, authorization, context, evaluation and reliable tool use.'],
  ['Product engineering', 'Turn ideas into interfaces, system boundaries, code and deployable products.'],
  ['Verification', 'Prefer source, tests, traces and explicit limits over unsupported claims.'],
  ['Building in public', 'Connect repositories, writing and external feedback so experiments remain reusable.']
]
---

<PageLayout lang='en-US' meta={{ title: 'About', description: 'About Lora, an AI agent developer and full-stack engineer building inspectable systems in public.' }} highlightColor='#d99a33'>
  <main class='about-page'>
    <header>
      <p>ABOUT</p>
      <h1>{profile.name}</h1>
      <span>{profile.role} · {profile.location}</span>
      <strong>I am a student developer working on AI agents, developer tools and full-stack products. I like turning an idea into something that can actually run, be inspected, and keep evolving.</strong>
    </header>

    <section>
      <h2>Direction</h2>
      <div>
        <p>I build agent infrastructure and product systems where the implementation, evidence and limits can be checked rather than merely announced.</p>
        <div class='resume-actions'>
          <a href='/en/work'>Explore work ↗</a>
          <ResumePreview lang='en-US' triggerLabel='Preview résumé' />
          <a href='/en/resume'>Résumé page ↗</a>
        </div>
      </div>
    </section>

    <section>
      <h2>How I work</h2>
      <div class='capabilities'>
        {capabilities.map(([title, detail], index) => <article><span>0{index + 1}</span><strong>{title}</strong><p>{detail}</p></article>)}
      </div>
    </section>

    <section>
      <h2>Current work</h2>
      <div class='current-work'>
        {focus.map((item) => <article><h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3><p>{item.description}</p></article>)}
      </div>
    </section>

    <section>
      <h2>Representative projects</h2>
      <div class='project-links'>
        {featured.map((project) => <a href={`/en/work#${project.repository}`}><strong>{project.title}</strong><span>{project.technologies.slice(0, 3).join(' · ')}</span><b aria-hidden='true'>↗</b></a>)}
      </div>
    </section>

    <section>
      <h2>Records</h2>
      <div>
        <p>Education, skills and formal project history live in the résumé. Public appearances and hackathon records are kept in a separate archive instead of being duplicated here.</p>
        <div class='record-actions'>
          <a href='/en/resume'>Résumé ↗</a>
          <a href='/talks'>Public activity archive in Chinese ↗</a>
          <a href='/en/now'>Now ↗</a>
        </div>
      </div>
    </section>

    <a href='/about'>Read the About page in Chinese ↗</a>
  </main>
</PageLayout>
<style>
.about-page{display:grid;gap:clamp(2rem,5vw,4rem)}header{display:grid;gap:.75rem;padding-block:clamp(1rem,4vw,3rem)}header p{margin:0;color:hsl(var(--field-amber));font-size:.67rem;font-weight:680;letter-spacing:.13em}h1{margin:0;font-size:clamp(3rem,8vw,7rem);font-weight:580;letter-spacing:-.075em;line-height:.88}header span,header strong{max-width:58ch;color:hsl(var(--muted-foreground));font-size:.9rem;font-weight:400;line-height:1.7}header strong{color:hsl(var(--foreground))}section{display:grid;grid-template-columns:13rem 1fr;gap:2rem;border-top:1px solid hsl(var(--border));padding-top:1.25rem}h2{margin:0;font-size:.8rem;text-transform:uppercase;letter-spacing:.1em}section p{max-width:58ch;margin:0;color:hsl(var(--muted-foreground));line-height:1.75}.resume-actions,.record-actions{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1rem}.resume-actions>a,.record-actions>a{display:inline-flex;min-height:2.2rem;align-items:center;border:1px solid hsl(var(--border));border-radius:999px;padding:.42rem .68rem;color:hsl(var(--foreground));font-size:.72rem;text-decoration:none}.capabilities,.current-work,.project-links{display:grid;gap:.7rem}.capabilities{grid-template-columns:repeat(2,minmax(0,1fr))}.capabilities article,.current-work article{border-top:1px solid hsl(var(--border));padding-top:.8rem}.capabilities span{color:hsl(var(--field-amber));font-size:.64rem}.capabilities strong{display:block;margin-top:.45rem}.capabilities p,.current-work p{margin-top:.35rem;font-size:.78rem;line-height:1.6}.current-work{grid-template-columns:repeat(3,minmax(0,1fr))}.current-work h3{margin:0;font-size:.95rem}.current-work h3 a{color:hsl(var(--foreground));text-decoration:none}.project-links a{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr) auto;gap:.8rem;align-items:center;border-bottom:1px solid hsl(var(--border));padding:.7rem .1rem;color:hsl(var(--foreground));text-decoration:none}.project-links span{color:hsl(var(--muted-foreground));font-size:.7rem}.project-links b{font-weight:400}.about-page>a{color:hsl(var(--foreground));font-size:.75rem}@media(max-width:760px){section{grid-template-columns:1fr;gap:.8rem}.capabilities,.current-work{grid-template-columns:1fr}}@media(max-width:520px){.project-links a{grid-template-columns:1fr auto}.project-links span{grid-column:1}.project-links b{grid-column:2;grid-row:1/3}}
</style>
