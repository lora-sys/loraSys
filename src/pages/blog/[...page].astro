---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { featuredPostIds } from '@/data/featured-posts'

import { getBlogCollection } from 'astro-pure/server'
import BlogListing from '@/components/blog/BlogListing.astro'
import config from '@/site-config'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  const collections = (await getBlogCollection()).sort(
    (left, right) => right.data.publishDate.valueOf() - left.data.publishDate.valueOf()
  )
  const featuredPosts = featuredPostIds
    .map((id) => collections.find((post) => post.id === id))
    .filter((post): post is CollectionEntry<'blog'> => Boolean(post))
  const articles = collections.filter((post) => post.data.contentType !== 'news')
  const news = collections.filter((post) => post.data.contentType === 'news')
  return paginate(articles, {
    pageSize: config.content.blogPageSize,
    props: {
      collectionsCount: articles.length,
      featuredPosts,
      newsPosts: news.slice(0, 3),
      newsCount: news.length
    }
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'blog'>>
  collectionsCount: number
  featuredPosts: CollectionEntry<'blog'>[]
  newsPosts: CollectionEntry<'blog'>[]
  newsCount: number
}

const { page, collectionsCount, featuredPosts, newsPosts, newsCount } = Astro.props
---

<BlogListing {page} {collectionsCount} {featuredPosts} {newsPosts} {newsCount} />
