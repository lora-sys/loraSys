---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { featuredPostIds } from '@/data/featured-posts'

import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import BlogListing from '@/components/blog/BlogListing.astro'
import config from '@/site-config'

export const prerender = true

type SupportedLanguage = 'zh-CN' | 'en-US'

export const getStaticPaths = (async ({ paginate }) => {
  const collections = sortMDByDate(await getBlogCollection())
  const supportedLanguages = ['zh-CN', 'en-US'] as const

  return supportedLanguages.flatMap((language) => {
    const filtered = collections.filter((post) => post.data.language === language)
    const featuredPosts = featuredPostIds
      .map((id) => filtered.find((post) => post.id === id || post.data.translationOf === id))
      .filter((post): post is CollectionEntry<'blog'> => Boolean(post))
    const articles = filtered.filter((post) => post.data.contentType !== 'news')
    const news = filtered.filter((post) => post.data.contentType === 'news')
    return paginate(articles, {
      pageSize: config.content.blogPageSize,
      params: { language },
      props: {
        activeLanguage: language,
        collectionsCount: articles.length,
        featuredPosts,
        newsPosts: news.slice(0, 3),
        newsCount: news.length
      }
    })
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'blog'>>
  collectionsCount: number
  featuredPosts: CollectionEntry<'blog'>[]
  activeLanguage: SupportedLanguage
  newsPosts: CollectionEntry<'blog'>[]
  newsCount: number
}

const { page, collectionsCount, featuredPosts, activeLanguage, newsPosts, newsCount } = Astro.props
---

<BlogListing {page} {collectionsCount} {featuredPosts} {activeLanguage} {newsPosts} {newsCount} />
