---
import { type CollectionEntry, render } from 'astro:content'

import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import PostLayout from '@/layouts/BlogPost.astro'
import ArticleQuote from '@/components/blog/mdx/ArticleQuote.astro'
import ArticleTable from '@/components/blog/mdx/ArticleTable.astro'
import Callout from '@/components/blog/mdx/Callout.astro'
import ComparePanel from '@/components/blog/mdx/ComparePanel.astro'
import DataChart from '@/components/blog/mdx/DataChart.astro'
import KeyPoints from '@/components/blog/mdx/KeyPoints.astro'
import OptionTabs from '@/components/blog/mdx/OptionTabs.astro'
import ProcessSteps from '@/components/blog/mdx/ProcessSteps.astro'
import StatStrip from '@/components/blog/mdx/StatStrip.astro'

export const prerender = true

export async function getStaticPaths() {
  const posts = sortMDByDate(await getBlogCollection())
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post, posts }
  }))
}

type Props = {
  post: CollectionEntry<'blog'>
  posts: CollectionEntry<'blog'>[]
}

const { post, posts } = Astro.props
const mdxComponents = {
  blockquote: ArticleQuote,
  table: ArticleTable,
  Callout,
  ComparePanel,
  DataChart,
  KeyPoints,
  OptionTabs,
  ProcessSteps,
  StatStrip
}
const { Content, headings, remarkPluginFrontmatter } = await render(post)
---

<PostLayout {post} {posts} {headings} {remarkPluginFrontmatter}>
  <div class='reading-progress' aria-hidden='true'><i data-reading-progress></i></div>
  <Content components={mdxComponents} />
  <script>
    const progress = document.querySelector<HTMLElement>('[data-reading-progress]')
    const article = document.getElementById('content')
    let progressFrame = 0

    const updateReadingProgress = () => {
      progressFrame = 0
      if (!progress || !article) return
      const articleTop = window.scrollY + article.getBoundingClientRect().top
      const start = articleTop - window.innerHeight * 0.28
      const end = articleTop + article.offsetHeight - window.innerHeight * 0.58
      const distance = Math.max(1, end - start)
      const value = Math.min(1, Math.max(0, (window.scrollY - start) / distance))
      progress.style.transform = 'scaleX(' + value + ')'
    }

    const requestReadingProgress = () => {
      if (progressFrame) return
      progressFrame = requestAnimationFrame(updateReadingProgress)
    }

    window.addEventListener('scroll', requestReadingProgress, { passive: true })
    window.addEventListener('resize', requestReadingProgress)
    updateReadingProgress()
  </script>
</PostLayout>
<style>.reading-progress{position:fixed;top:0;left:0;right:0;z-index:50;height:2px;background:transparent;pointer-events:none}.reading-progress i{display:block;width:100%;height:100%;background:hsl(var(--primary));transform:scaleX(0);transform-origin:left;will-change:transform}</style>
