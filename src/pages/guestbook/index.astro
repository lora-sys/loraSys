---
import { Image } from 'astro:assets'

import BaseLayout from '@/layouts/BaseLayout.astro'
import GiscusGuestbook from '@/components/community/GiscusGuestbook.astro'
import CollectionPageJsonLd from '@/components/seo/CollectionPageJsonLd.astro'
import guestbookPostcard from '@/assets/lora-visual/v2/lora-v2-guestbook-postcard.webp'
---

<BaseLayout
  lang='zh-CN'
  meta={{
    title: '留言板 · Lora',
    description:
      '在 Lora 的公开留言板留下对 AI Agent、开源构建、作品或文章的想法。留言通过 GitHub Discussions 公开管理。'
  }}
>
  <Fragment slot='head'
    ><CollectionPageJsonLd
      name='留言板 · Lora'
      description='在 Lora 的公开留言板留下对 AI Agent、开源构建、作品或文章的想法。'
    /></Fragment
  >
  <main class='guestbook-page'>
    <section class='guestbook-hero'>
      <p>公开来信</p>
      <h1>给这里留一张明信片。</h1>
      <p>
        可以聊作品、文章或你正在做的东西。留言由 GitHub Discussions 承载，登录 GitHub 后即可参与。
      </p>
      <Image
        src={guestbookPostcard}
        alt=''
        aria-hidden='true'
        class='guestbook-visual'
        widths={[360, 560, 720]}
        sizes='(min-width: 700px) 18rem, 75vw'
        loading='eager'
        fetchpriority='high'
      />
    </section>
    <GiscusGuestbook />
  </main>
</BaseLayout>

<style>
  .guestbook-page {
    max-width: 58rem;
    margin: 0 auto;
    padding: clamp(2rem, 7vw, 5rem) 0 2rem;
  }
  .guestbook-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(10rem, 0.5fr);
    align-items: center;
    gap: 0.5rem 2rem;
    max-width: 58rem;
    border-bottom: 1px solid hsl(var(--border));
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .guestbook-hero > p:first-child {
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.62rem;
    font-weight: 720;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .guestbook-hero h1 {
    margin: 0.8rem 0 0;
    font-size: clamp(2.2rem, 7vw, 4.6rem);
    letter-spacing: -0.065em;
    line-height: 0.94;
    text-wrap: balance;
  }
  .guestbook-hero > p:last-of-type {
    max-width: 58ch;
    margin: 1rem 0 0;
    color: hsl(var(--muted-foreground));
    line-height: 1.8;
  }
  .guestbook-hero > p,
  .guestbook-hero > h1 {
    grid-column: 1;
  }
  .guestbook-visual {
    grid-column: 2;
    grid-row: 1/4;
    width: 100%;
    max-height: 17rem;
    object-fit: contain;
  }
  @media (max-width: 700px) {
    .guestbook-hero {
      grid-template-columns: 1fr;
    }
    .guestbook-visual {
      grid-column: 1;
      grid-row: auto;
      width: min(80vw, 18rem);
      justify-self: center;
    }
  }
</style>
