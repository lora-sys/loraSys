---
import { PFSearch } from 'astro-pure/components/pages'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import { integ } from '@/site-config'

const meta = {
  description: 'Search projects, writing, notes, lab work, and the public story.',
  title: 'Search'
}
---

<PageLayout {meta}>
  <Button title='Back' href='/blog' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>Search</h1>
    </div>

    <div id='content' class='animate'>
      {
        integ.pagefind ? (
          <>
            <p class='search-intro'>Search the site for projects, writing, notes, lab work, contributions, and the ideas connecting them.</p>
            <div class='search-shell'><PFSearch /></div>
            <div class='search-help'><span>No luck?</span><a href='/projects'>Explore projects</a><a href='/contact'>Start a conversation</a></div>
          </>
        ) : (
          <p>Pagefind is disabled.</p>
        )
      }
    </div>
  </main>
</PageLayout>
<style>.search-intro{max-width:38rem;color:hsl(var(--muted-foreground));line-height:1.7}.search-shell{margin-top:1.25rem}.search-help{display:flex;flex-wrap:wrap;gap:.6rem 1rem;margin-top:1.2rem;color:hsl(var(--muted-foreground));font-size:.75rem}.search-help a{color:hsl(var(--foreground));text-underline-offset:.2em}.search-shell :global(.pagefind-ui__search-input){border-radius:.6rem}.search-shell :global(.pagefind-ui__result){transition:transform 160ms cubic-bezier(.23,1,.32,1),background 160ms ease}.search-shell :global(.pagefind-ui__result:hover){transform:translateX(3px);background:hsl(var(--muted)/.45)}@media(prefers-reduced-motion:reduce){.search-shell :global(.pagefind-ui__result){transition:none}.search-shell :global(.pagefind-ui__result:hover){transform:none}}</style>
