---
import { PFSearch } from 'astro-pure/components/pages'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import { Image } from 'astro:assets'
import { integ } from '@/site-config'
import searchEmptyMochi from '@/assets/lora-visual/v2/search-empty-mochi.webp'

const meta = {
  description: 'Search projects, writing, notes, lab work, and the public story.',
  title: 'Search'
}
---

<PageLayout {meta}>
  <Button title='Back' href='/blog' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>搜索</h1>
    </div>

    <div id='content' class='animate'>
      {
        integ.pagefind ? (
          <>
            <p class='search-intro'>Search the site for projects, writing, notes, lab work, contributions, and the ideas connecting them.</p>
            <div class='search-shell'><PFSearch /></div>
            <div class='search-help'><span>No luck?</span><a href='/projects'>Explore projects</a><a href='/contact'>Start a conversation</a></div>
          </>
        ) : (
          <p>Pagefind is disabled.</p>
        )
      }
      <div class='search-empty-custom' hidden aria-hidden='true'>
        <Image src={searchEmptyMochi} alt='' aria-hidden='true' class='search-empty-visual' widths={[480, 760]} sizes='(max-width: 640px) 60vw, 20rem' loading='lazy' />
        <div class='search-empty-copy'>
          <p class='eyebrow'>Field notes · 检索</p>
          <h2>换个词试试</h2>
          <p>Mochi 翻遍了卡片盒，没找到完全匹配的记录。</p>
          <div class='search-empty-links'>
            <a href='/projects'>看看作品</a>
            <a href='/blog'>浏览笔记</a>
          </div>
        </div>
      </div>
    </div>
  </main>
</PageLayout>
<script>
  (() => {
    const shell = document.querySelector('.search-shell')
    const custom = document.querySelector('.search-empty-custom')
    const pagefindNoResult = () => document.querySelector('.pagefind-ui__no-result')
    const refresh = () => {
      const hasResults = !!document.querySelector('.pagefind-ui__result')
      if (!hasResults && custom) {
        (custom as HTMLElement).hidden = false
        pagefindNoResult()?.remove()
      } else if (custom) {
        (custom as HTMLElement).hidden = true
      }
    }
    if (!shell || !custom) return
    shell.addEventListener('search:done', refresh)
    shell.addEventListener('input', () => setTimeout(refresh, 350))
  })()
</script>
<style>.search-intro{max-width:38rem;color:hsl(var(--muted-foreground));line-height:1.7}.search-shell{margin-top:1.25rem}.search-help{display:flex;flex-wrap:wrap;gap:.6rem 1rem;margin-top:1.2rem;color:hsl(var(--muted-foreground));font-size:.75rem}.search-help a{color:hsl(var(--foreground));text-underline-offset:.2em}.search-shell :global(.pagefind-ui__search-input){border-radius:.6rem}.search-shell :global(.pagefind-ui__result){transition:transform 160ms cubic-bezier(.23,1,.32,1),background 160ms ease}.search-shell :global(.pagefind-ui__result:hover){transform:translateX(3px);background:hsl(var(--muted)/.45)}@media(prefers-reduced-motion:reduce){.search-shell :global(.pagefind-ui__result){transition:none}.search-shell :global(.pagefind-ui__result:hover){transform:none}}
.search-empty-custom{display:grid;gap:1rem;margin-top:2rem;padding:1.1rem;border:1px dashed hsl(var(--border));border-radius:1rem;background:hsl(var(--card)/.55);grid-template:auto 1fr / auto 1fr}.search-empty-visual{grid-row:1/3;width:8rem;height:auto;border-radius:.6rem;border:1px solid hsl(var(--border)/.5)}.search-empty-copy{display:grid;gap:.3rem}.search-empty-copy h2{margin:0;font-size:clamp(1.1rem,2vw,1.35rem)}.search-empty-copy p{margin:0;color:hsl(var(--muted-foreground));font-size:.8rem;line-height:1.55}.search-empty-links{display:flex;gap:.6rem;margin-top:.35rem}.search-empty-links a{display:inline-flex;align-items:center;gap:.2rem;min-height:2.2rem;padding:.35rem .7rem;border:1px solid hsl(var(--border));border-radius:.55rem;background:hsl(var(--background)/.7);color:hsl(var(--foreground));font-size:.72rem;font-weight:620;text-decoration:none}@media(max-width:640px){.search-empty-custom{grid-template:auto 1fr / 1fr}.search-empty-visual{grid-row:auto;width:5rem}}@media(prefers-reduced-motion:reduce){.search-empty-custom *{transition:none}}</style>
