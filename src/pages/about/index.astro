---
import { Button, Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ContributionGraph from '@/components/lora/ContributionGraph.astro'
import { hackathons, profile } from '@/data/profile'

const headings = [
  { depth: 2, slug: 'education', text: 'Education' },
  { depth: 2, slug: 'skills', text: 'Skills' },
  { depth: 2, slug: 'hackathons', text: 'Hackathons' },
  { depth: 2, slug: 'social', text: 'Elsewhere' }
]
---

<PageLayout title='About' {headings}>
  <p class='text-lg font-medium'>{profile.role}</p>
  <p>{profile.summary}</p>
  <p>{profile.location} · <a href={`mailto:${profile.email}`}>{profile.email}</a></p>
  <div class='not-prose flex flex-wrap gap-3 my-6'>
    <Button title='Download résumé' href='/resume.pdf' target='_blank' variant='ahead' />
    <Button title='View projects' href='/projects' variant='ahead' />
  </div>
  <div class='not-prose my-10'><ContributionGraph /></div>

  <h2 id='education'>Education</h2>
  {profile.education.map((item) => <p><strong><a href={item.href} target='_blank'>{item.school}</a></strong><br />{item.degree} · {item.period}</p>)}

  <h2 id='skills'>Skills</h2>
  <div class='not-prose flex flex-wrap gap-2'>
    {profile.skills.map((skill) => <span class='rounded-full border bg-background px-3 py-1 text-sm text-muted-foreground'>{skill}</span>)}
  </div>

  <h2 id='hackathons'>Hackathons</h2>
  <Timeline events={hackathons.map(([title, date, content, href]) => ({ date, content: `<strong>${title}</strong> — ${content}${href ? ` <a href="${href}" target="_blank">Source ↗</a>` : ''}` }))} />

  <h2 id='social'>Elsewhere</h2>
  <ul>{profile.social.map(([name, href]) => <li><a href={href} target='_blank'>{name} ↗</a></li>)}</ul>
  <p>This site is built with Astro and Astro Theme Pure, and deployed as a static GitHub Pages site.</p>
</PageLayout>
