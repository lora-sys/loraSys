---
import { Image } from 'astro:assets'
import journeyFragment from '@/assets/field-notes/journey-fragment.webp'
import hackathonFieldPass from '@/assets/field-notes/expansion/about-hackathon-field-pass.webp'
import { hackathons, profile, projects } from '@/data/profile'
import { socialLinks } from '@/data/social'

import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import SocialGrid from '@/components/contact/SocialGrid.astro'
import ContributionGraph from '@/components/lora/ContributionGraph.astro'
import CredentialsArchive from '@/components/about/CredentialsArchive.astro'
import ResumePreview from '@/components/resume/ResumePreview.astro'

const headings = [
  { depth: 2, slug: 'direction', text: 'Current direction' },
  { depth: 2, slug: 'capabilities', text: 'Capabilities' },
  { depth: 2, slug: 'open-source', text: 'Open source' },
  { depth: 2, slug: 'education', text: 'Education' },
  { depth: 2, slug: 'credentials-title', text: 'Credentials' },
  { depth: 2, slug: 'hackathons', text: 'Hackathons' },
  { depth: 2, slug: 'contributions', text: 'Contributions' },
  { depth: 2, slug: 'elsewhere', text: 'Elsewhere' }
]
const capabilityGroups = [
  {
    label: 'Agent systems',
    tools: 'Python · TypeScript · MCP',
    description:
      'Multi-agent workflows, context engineering, evaluation harnesses, and reliable tool execution.'
  },
  {
    label: 'Product engineering',
    tools: 'Astro · React · Next.js',
    description:
      'Taking an idea through interface design, application architecture, implementation, and deployment.'
  },
  {
    label: 'Research to software',
    tools: 'Prototypes · Systems · Validation',
    description:
      'Translating research questions into software that people can run, inspect, and improve.'
  },
  {
    label: 'Open building',
    tools: 'GitHub · Hackathons · Web3',
    description:
      'Learning through public projects, short feedback loops, technical collaboration, and shipped demos.'
  }
]
const openSourceProjects = projects.slice(0, 6)
---

<PageLayout title='About' {headings}>
  <div class='not-prose about-lead'>
    <Image src={journeyFragment} alt='' aria-hidden='true' class='journey-fragment' widths={[360, 560, 720]} sizes='(min-width: 1024px) 18rem, 45vw' loading='lazy' />
    <span class='eyebrow'>{profile.role}</span>
    <p>我喜欢把还停留在讨论里的想法，推进成可以运行、可以体验、也可以继续演化的系统。</p>
    <div class='lead-meta'>
      <span><Icon name='location' class='size-4' /> {profile.location}</span>
      <a href='/now'><span class='status-dot'></span> What I&apos;m doing now</a>
    </div>
  </div>

  <h2 id='direction'>Current direction</h2>
  {profile.summary.map((paragraph) => <p>{paragraph}</p>)}
  <div class='not-prose about-actions'>
    <div class='about-actions-primary'>
      <Button title='Explore projects' href='/projects' variant='ahead' />
      <ResumePreview triggerLabel='在线预览简历' />
      <Button title='Contact me' href='/contact' variant='ahead' />
    </div>
    <div class='about-actions-secondary'>
      <a class='about-resume tactile-action' href='/resume'>查看简历页面 <span aria-hidden='true'>↗</span></a>
      <a class='about-resume tactile-action' href='/resume.pdf' download>下载 PDF <span aria-hidden='true'>↓</span></a>
    </div>
  </div>

  <h2 id='capabilities'>Capabilities</h2>
  <p>技术栈是手段。下面这些，是我目前真正持续投入并用项目验证的能力方向。</p>
  <div class='not-prose capability-list'>
    {
      capabilityGroups.map((group, index) => (
        <article>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3>{group.label}</h3>
            <small>{group.tools}</small>
          </div>
          <p>{group.description}</p>
        </article>
      ))
    }
  </div>

  <h2 id='open-source'>Open source</h2>
  <p>这些项目记录了我最近的主要建设方向。完整项目、截图和可用链接都在 Projects 页面。</p>
  <div class='not-prose project-index'>
    {
      openSourceProjects.map((project) => {
        const source = project.links.find((link) => link.type === 'source')
        return (
          <a
            class='tactile-action'
            href={source?.href || '/projects'}
            target={source ? '_blank' : undefined}
            rel={source ? 'noopener noreferrer' : undefined}
          >
            <span class:list={['project-status', { active: project.active }]} />
            <strong>{project.title}</strong>
            <small>{project.technologies.slice(0, 3).join(' · ')}</small>
            <span aria-hidden='true'>↗</span>
          </a>
        )
      })
    }
  </div>
  <p><a href='/projects'>View the complete project archive →</a></p>

  <h2 id='education'>Education</h2>
  {
    profile.education.map((item) => (
      <a class='not-prose education' href={item.href} target='_blank' rel='noopener noreferrer'>
        <img
          src={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${item.logo.replace(/^\//, '')}`}
          alt={`${item.school} logo`}
          width='68'
          height='68'
        />
        <span>
          <strong>{item.school}</strong>
          <small>{item.degree}</small>
          <small>{item.period}</small>
        </span>
        <b aria-hidden='true'>↗</b>
      </a>
    ))
  }

  <CredentialsArchive />

  <h2 id='hackathons'>Hackathons</h2>
  <div class='not-prose hackathon-intro'>
    <p>黑客松是我快速学习、验证产品假设并和不同背景的开发者协作的地方。</p>
    <Image src={hackathonFieldPass} alt='' aria-hidden='true' class='hackathon-pass' widths={[320, 480, 640]} sizes='(min-width: 900px) 15rem, 36vw' loading='lazy' />
  </div>
  <div class='not-prose timeline'>
    {
      hackathons.map((item) => (
        <article class:list={{ planned: item.status === 'planned' }}>
          <div class='dot' />
          <div>
            <div class='event-meta'>
              <>
                <time>{item.date}</time>
                <span>{item.location}</span>
              </>
            </div>
            <h3>{item.title}</h3>
            {item.status === 'planned' && <span class='event-status'>即将参加</span>}
            <p>{item.content}</p>
            {item.href && (
              <a href={item.href} target='_blank' rel='noopener noreferrer'>
                Source ↗
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>

  <h2 id='contributions'>Contributions</h2>
  <p>持续提交比单次冲刺更接近我理解的建设过程：小步验证、留下证据、再继续推进。</p>
  <div class='not-prose contribution-wrap'><ContributionGraph /></div>

  <h2 id='elsewhere'>Elsewhere</h2>
  <p>不同平台承载不同密度的内容，也可以直接通过 Contact 页面开始一段对话。</p>
  <div class='not-prose social-wrap'><SocialGrid links={socialLinks} compact /></div>
  <p>
    This site is built with Astro and Astro Theme Pure, and deployed as a static GitHub Pages site.
  </p>
</PageLayout>

<style>
  .about-lead {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-bottom: 3rem;
    border-block: 1px solid hsl(var(--border));
    padding-block: clamp(1.3rem, 5vw, 2.2rem);
  }
  .journey-fragment {
    position: absolute;
    z-index: -1;
    top: -2.8rem;
    right: -3rem;
    width: clamp(9rem, 26vw, 17rem);
    height: auto;
    opacity: 0.2;
    transform: rotate(2.5deg);
    pointer-events: none;
  }
  .eyebrow {
    color: hsl(var(--muted-foreground));
    font-size: 0.67rem;
    font-weight: 650;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .about-lead > p {
    max-width: 20ch;
    margin-top: 0.7rem;
    font-size: clamp(1.7rem, 6vw, 3.15rem);
    font-weight: 560;
    letter-spacing: -0.05em;
    line-height: 1.08;
    text-wrap: balance;
  }
  .lead-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.1rem;
    margin-top: 1.2rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.74rem;
  }
  .lead-meta span,
  .lead-meta a {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
  }
  .lead-meta a {
    color: hsl(var(--foreground));
    text-decoration: none;
  }
  .status-dot,
  .project-status {
    width: 0.43rem;
    height: 0.43rem;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 3px rgb(34 197 94 / 0.12);
  }
  .about-actions {
    display: grid;
    gap: 0.55rem;
    margin-block: 1.4rem 3rem;
  }
  .about-actions-primary,
  .about-actions-secondary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .about-actions-secondary {
    padding-left: 0.15rem;
  }
  .about-resume{display:inline-flex;align-items:center;gap:.35rem;color:hsl(var(--muted-foreground));font-size:.74rem;text-decoration:none;transition:color 180ms ease,transform 180ms ease}.about-resume:hover,.about-resume:focus-visible{color:hsl(var(--foreground));transform:translateY(-1px);outline:none;text-decoration:underline;text-underline-offset:.22em}
  .capability-list {
    margin-block: 1.3rem 3rem;
    border-top: 1px solid hsl(var(--border));
  }
  .capability-list article {
    display: grid;
    grid-template-columns: 2rem minmax(10rem, 0.8fr) minmax(0, 1.2fr);
    gap: 0.8rem;
    border-bottom: 1px solid hsl(var(--border));
    padding-block: 1rem;
  }
  .capability-list article > span,
  .capability-list small {
    color: hsl(var(--muted-foreground));
    font-size: 0.68rem;
  }
  .capability-list h3 {
    font-size: 0.93rem;
    font-weight: 620;
  }
  .capability-list article > div {
    display: grid;
    gap: 0.18rem;
  }
  .capability-list p {
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.78rem;
    line-height: 1.55;
  }
  .project-index {
    display: grid;
    margin-block: 1.3rem 1rem;
    border-top: 1px solid hsl(var(--border));
  }
  .project-index a {
    display: grid;
    grid-template-columns: auto minmax(8rem, 0.7fr) minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid hsl(var(--border));
    padding: 0.78rem 0.2rem;
    color: hsl(var(--foreground));
    text-decoration: none;
    transition: padding 180ms ease;
  }
  .project-index a:hover,
  .project-index a:focus-visible {
    padding-inline: 0.55rem;
    outline: none;
  }
  .project-index strong {
    font-size: 0.82rem;
    font-weight: 580;
  }
  .project-index small,
  .project-index a > span:last-child {
    color: hsl(var(--muted-foreground));
    font-size: 0.68rem;
  }
  .education {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    margin-block: 1.3rem 3rem;
    border: 1px solid hsl(var(--border));
    border-radius: 1rem;
    padding: 1rem;
    color: hsl(var(--foreground));
    text-decoration: none;
    transition:
      background 180ms ease,
      transform 180ms ease;
  }
  .education:hover,
  .education:focus-visible {
    background: hsl(var(--muted));
    transform: translateY(-1px);
  }
  .education img {
    border-radius: 0.8rem;
    background: white;
    object-fit: contain;
  }
  .education > span {
    display: grid;
    gap: 0.18rem;
  }
  .education small,
  .education b {
    color: hsl(var(--muted-foreground));
    font-size: 0.72rem;
  }
  .education b {
    font-weight: 400;
  }
  .hackathon-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(7rem, 16vw, 11rem);
    align-items: center;
    gap: 1rem;
    margin-block: 0.8rem 1.2rem;
    border-block: 1px solid hsl(var(--border));
    padding-block: 0.75rem;
  }
  .hackathon-intro p {
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.82rem;
    line-height: 1.65;
  }
  .hackathon-pass {
    justify-self: end;
    width: 100%;
    max-width: 10.5rem;
    height: auto;
    opacity: 0.82;
    transform: rotate(1.5deg);
    pointer-events: none;
  }
  .timeline {
    display: grid;
    gap: 0;
    margin-block: 1.3rem 3rem;
  }
  .timeline article {
    position: relative;
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    gap: 0.7rem;
    padding-bottom: 1.7rem;
  }
  .timeline article::before {
    content: '';
    position: absolute;
    top: 0.75rem;
    bottom: -0.2rem;
    left: 0.25rem;
    width: 1px;
    background: hsl(var(--border));
  }
  .timeline article:last-child::before {
    display: none;
  }
  .dot {
    z-index: 1;
    width: 0.55rem;
    height: 0.55rem;
    margin-top: 0.4rem;
    border-radius: 50%;
    background: hsl(var(--primary));
    box-shadow: 0 0 0 4px hsl(var(--background));
  }
  .timeline article.planned .dot {
    border: 1px solid hsl(173 60% 42%);
    background: hsl(var(--background));
    box-shadow: 0 0 0 4px hsl(var(--background)), 0 0 0 5px hsl(173 60% 42% / 0.18);
  }
  .event-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.72rem;
  }
  .timeline h3 {
    margin: 0.22rem 0;
    font-size: 0.95rem;
  }
  .event-status {
    display: inline-flex;
    margin: 0.1rem 0 0.34rem;
    border: 1px solid hsl(173 60% 42% / 0.45);
    border-radius: 999px;
    padding: 0.16rem 0.4rem;
    color: hsl(173 60% 30%);
    font-size: 0.6rem;
    font-weight: 680;
    letter-spacing: 0.05em;
  }
  .timeline p {
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.82rem;
  }
  .timeline a {
    font-size: 0.76rem;
  }
  .contribution-wrap,
  .social-wrap {
    margin-block: 1.3rem 3rem;
  }
  @media (max-width: 600px) {
    .journey-fragment { top: -1rem; right: -2.5rem; width: 10rem; opacity: 0.14; }
    .capability-list article {
      grid-template-columns: 1.5rem minmax(0, 1fr);
    }
    .capability-list article > p {
      grid-column: 2;
    }
    .project-index a {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }
    .project-index small {
      display: none;
    }
    .hackathon-intro { grid-template-columns: minmax(0, 1fr) 6.5rem; }
    .hackathon-pass { max-width: 6.5rem; opacity: 0.7; }
    .event-meta {
      display: grid;
      gap: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-index a,
    .education,
    .about-resume {
      transition: none;
    }
    .education:hover,
    .education:focus-visible,
    .about-resume:hover,
    .about-resume:focus-visible,
    .journey-fragment,
    .hackathon-pass {
      transform: none;
    }
  }
</style>
