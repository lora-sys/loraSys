---
import { Image } from 'astro:assets'
import journeyFragment from '@/assets/lora-visual/v2/lora-v2-about-journey.webp'
import { profileZh as profile, projects } from '@/data/profile'
import { homepageFeatured } from '@/data/project-curation'
import { socialLinks } from '@/data/social'
import { getCurrentFocusSections } from '@/data/current-focus'

import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import SocialGrid from '@/components/contact/SocialGrid.astro'
import ContributionGraph from '@/components/lora/ContributionGraph.astro'
import ResumePreview from '@/components/resume/ResumePreview.astro'

const headings = [
  { depth: 2, slug: 'direction', text: '当前方向' },
  { depth: 2, slug: 'capabilities', text: '怎么工作' },
  { depth: 2, slug: 'open-source', text: '正在构建' },
  { depth: 2, slug: 'records', text: '履历与公开记录' },
  { depth: 2, slug: 'contributions', text: '公开贡献' },
  { depth: 2, slug: 'personal', text: '工作之外' },
  { depth: 2, slug: 'elsewhere', text: '其他平台' }
]
const capabilityGroups = [
  {
    label: '智能体系统',
    tools: 'Python · TypeScript · MCP',
    description: '先把动作、权限、上下文和证据边界说清楚，再扩展 Agent 能力。'
  },
  {
    label: '产品工程',
    tools: 'Astro · React · Next.js',
    description: '把需求落到可以运行、部署、检查和继续迭代的产品，而不是停在原型描述。'
  },
  {
    label: '验证习惯',
    tools: '测试 · 追踪 · 公开证据',
    description: '尽量让关键结论有源码、测试、运行记录或明确的限制说明可以追溯。'
  },
  {
    label: '公开构建',
    tools: 'GitHub · 写作 · 社区',
    description: '把项目、笔记和外部反馈连起来，让一次实验能沉淀成下一次构建的输入。'
  }
]
const openSourceProjects = homepageFeatured(projects.filter((project) => project.featured))
const personalNow = getCurrentFocusSections('zh-CN').filter((section) => ['reading', 'listening'].includes(section.id))
---

<PageLayout
  title='关于'
  heading='关于'
  description='关于 Lora：一名关注 AI Agent、开发者工具和全栈产品的学生开发者，以及他如何把想法推进成可检查的系统。'
  {headings}
>
  <div class='not-prose about-lead'>
    <Image src={journeyFragment} alt='' aria-hidden='true' class='journey-fragment' widths={[360, 560, 720]} sizes='(min-width: 1024px) 18rem, 45vw' loading='lazy' />
    <span class='eyebrow'>{profile.role}</span>
    <p>我喜欢把还停留在讨论里的想法，推进成可以运行、可以体验、也可以继续演化的系统。</p>
    <div class='lead-meta'>
      <span><Icon name='location' class='size-4' /> {profile.location}</span>
      <a href='/now'><span class='status-dot'></span> 正在做什么</a>
    </div>
  </div>

  <h2 id='direction'>当前方向</h2>
  {profile.summary.map((paragraph) => <p>{paragraph}</p>)}
  <div class='not-prose about-actions'>
    <Button title='查看作品' href='/projects' variant='ahead' />
    <ResumePreview triggerLabel='在线预览简历' />
    <Button title='联系我' href='/contact' variant='ahead' />
  </div>

  <h2 id='capabilities'>怎么工作</h2>
  <p>技术栈会变化，我更在意的是把问题拆清楚、留下验证证据，并让下一次修改不必重新猜一遍。</p>
  <div class='not-prose capability-list'>
    {
      capabilityGroups.map((group, index) => (
        <article>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3>{group.label}</h3>
            <small>{group.tools}</small>
          </div>
          <p>{group.description}</p>
        </article>
      ))
    }
  </div>

  <h2 id='open-source'>正在构建</h2>
  <p>这里只放当前最能代表方向的项目。完整仓库、状态、截图和外部贡献统一留在作品页。</p>
  <div class='not-prose project-index'>
    {
      openSourceProjects.map((project) => (
        <a class='tactile-action' href={`/projects#${project.repository}`}>
          <span class:list={['project-status', { active: project.active }]} />
          <strong>{project.title}</strong>
          <small>{project.technologies.slice(0, 3).join(' · ')}</small>
          <span aria-hidden='true'>↗</span>
        </a>
      ))
    }
  </div>
  <p><a href='/projects'>查看完整项目档案 →</a></p>

  <h2 id='records'>履历与公开记录</h2>
  <p>教育、技能、经历和正式项目说明以简历为准；公开活动与黑客松记录单独维护，不再在关于页重复一份。</p>
  <div class='not-prose record-links'>
    <a href='/resume'>
      <span>正式履历</span>
      <strong>简历页面</strong>
      <small>教育、技能、经历、重点项目与 PDF</small>
      <b aria-hidden='true'>↗</b>
    </a>
    <a href='/talks'>
      <span>公开记录</span>
      <strong>活动与黑客松</strong>
      <small>只记录有真实活动、源码或公开证据的经历</small>
      <b aria-hidden='true'>↗</b>
    </a>
  </div>

  <h2 id='contributions'>公开贡献</h2>
  <p>持续提交比单次冲刺更接近我理解的建设过程：小步验证、留下证据、再继续推进。</p>
  <div class='not-prose contribution-wrap'><ContributionGraph /></div>

  <h2 id='personal'>工作之外</h2>
  <p>网站也会留一点不和项目 KPI 有关的东西。最近在读什么、反复听什么，会跟着近况一起慢慢更新。</p>
  <div class='not-prose personal-now'>
    {personalNow.map((section) => (
      <article>
        <span>{section.category}</span>
        <h3>{section.title}</h3>
        <ul>{section.items.map((item) => <li>{item}</li>)}</ul>
      </article>
    ))}
  </div>

  <h2 id='elsewhere'>其他平台</h2>
  <p>不同平台承载不同密度的内容，也可以直接通过联系页开始一段对话。</p>
  <div class='not-prose social-wrap'><SocialGrid links={socialLinks} compact /></div>
  <p>本站使用 Astro 和 Astro Theme Pure，通过 GitHub Pages 发布静态页面。</p>
</PageLayout>

<style>
  .about-lead { position:relative; isolation:isolate; overflow:hidden; margin-bottom:3rem; border-block:1px solid hsl(var(--border)); padding-block:clamp(1.3rem,5vw,2.2rem); }
  .journey-fragment { position:absolute; z-index:-1; top:-2.8rem; right:-3rem; width:clamp(9rem,26vw,17rem); height:auto; opacity:.2; transform:rotate(2.5deg); pointer-events:none; }
  .eyebrow { color:hsl(var(--muted-foreground)); font-size:.67rem; font-weight:650; letter-spacing:.13em; text-transform:uppercase; }
  .about-lead>p { max-width:20ch; margin-top:.7rem; font-size:clamp(1.7rem,6vw,3.15rem); font-weight:560; letter-spacing:-.05em; line-height:1.08; text-wrap:balance; }
  .lead-meta { display:flex; flex-wrap:wrap; gap:.65rem 1.1rem; margin-top:1.2rem; color:hsl(var(--muted-foreground)); font-size:.74rem; }
  .lead-meta span,.lead-meta a { display:inline-flex; align-items:center; gap:.38rem; }
  .lead-meta a { color:hsl(var(--foreground)); text-decoration:none; }
  .status-dot,.project-status { width:.43rem; height:.43rem; border-radius:50%; background:hsl(var(--field-teal)); box-shadow:0 0 0 3px hsl(var(--field-teal)/.12); }
  .about-actions { display:flex; flex-wrap:wrap; gap:.55rem; margin-block:1.4rem 3rem; }
  .capability-list { margin-block:1.3rem 3rem; border-top:1px solid hsl(var(--border)); }
  .capability-list article { display:grid; grid-template-columns:2rem minmax(10rem,.8fr) minmax(0,1.2fr); gap:.8rem; border-bottom:1px solid hsl(var(--border)); padding-block:1rem; }
  .capability-list article>span,.capability-list small { color:hsl(var(--muted-foreground)); font-size:.68rem; }
  .capability-list h3 { margin:0; font-size:.93rem; font-weight:620; }
  .capability-list article>div { display:grid; gap:.18rem; }
  .capability-list p { margin:0; color:hsl(var(--muted-foreground)); font-size:.78rem; line-height:1.55; }
  .project-index { display:grid; margin-block:1.3rem 1rem; border-top:1px solid hsl(var(--border)); }
  .project-index a { display:grid; grid-template-columns:auto minmax(8rem,.7fr) minmax(0,1fr) auto; align-items:center; gap:.75rem; border-bottom:1px solid hsl(var(--border)); padding:.78rem .2rem; color:hsl(var(--foreground)); text-decoration:none; transition:padding 180ms ease; }
  .project-index a:hover,.project-index a:focus-visible { padding-inline:.55rem; outline:none; }
  .project-index strong { font-size:.82rem; font-weight:580; }
  .project-index small,.project-index a>span:last-child { color:hsl(var(--muted-foreground)); font-size:.68rem; }
  .record-links { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.8rem; margin-block:1.3rem 3rem; }
  .record-links a { display:grid; grid-template-columns:1fr auto; gap:.3rem 1rem; border:1px solid hsl(var(--border)); border-radius:1rem; padding:1rem; color:hsl(var(--foreground)); text-decoration:none; background:hsl(var(--card)); }
  .record-links a:hover,.record-links a:focus-visible { border-color:hsl(var(--field-amber)/.55); }
  .record-links span,.record-links small { color:hsl(var(--muted-foreground)); font-size:.68rem; }
  .record-links span { letter-spacing:.08em; text-transform:uppercase; }
  .record-links strong { grid-column:1; font-size:1rem; }
  .record-links small { grid-column:1; line-height:1.55; }
  .record-links b { grid-column:2; grid-row:1/4; align-self:center; font-weight:400; }
  .contribution-wrap,.social-wrap { margin-block:1.3rem 3rem; }
  .personal-now { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.75rem; margin-block:1.3rem 3rem; }
  .personal-now article { border:1px solid hsl(var(--border)); border-radius:1rem; padding:1rem; background:hsl(var(--card)); }
  .personal-now article>span { color:hsl(var(--field-amber)); font-size:.64rem; font-weight:680; letter-spacing:.1em; text-transform:uppercase; }
  .personal-now h3 { margin:.5rem 0 .55rem; font-size:1rem; }
  .personal-now ul { display:grid; gap:.35rem; margin:0; padding-left:1rem; color:hsl(var(--muted-foreground)); font-size:.78rem; line-height:1.55; }
  @media(max-width:700px){ .personal-now{grid-template-columns:1fr}.capability-list article{grid-template-columns:1.6rem 1fr}.capability-list article>p{grid-column:2}.record-links{grid-template-columns:1fr}.project-index a{grid-template-columns:auto 1fr auto}.project-index small{display:none} }
  @media(prefers-reduced-motion:reduce){ .journey-fragment{transform:none}.project-index a{transition:none} }
</style>
