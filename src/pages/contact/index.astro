---
import { primarySocialLinks, secondarySocialLinks } from '@/data/social'

import { Image } from 'astro:assets'
import { Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import contactCorrespondenceHero from '@/assets/lora-visual/v2/lora-v2-contact-correspondence.webp'
import CopyAction from '@/components/layout/CopyAction.astro'
import SocialLedger from '@/components/contact/SocialLedger.astro'

const email = 'lorasys@outlook.com'
const headings = [
  { depth: 2, slug: 'start-here', text: '联系方式' },
  { depth: 2, slug: 'good-conversations', text: '交流主题' },
  { depth: 2, slug: 'elsewhere', text: '其他平台' }
]
---

<PageLayout title='联系' heading='联系' {headings}>
  <div class='not-prose contact-intro'>
    <Image src={contactCorrespondenceHero} alt='' aria-hidden='true' class='contact-visual' widths={[768, 1152, 1536]} sizes='(min-width: 1024px) 48rem, 100vw' loading='eager' fetchpriority='high' />
    <span class='eyebrow'>联系与合作</span>
    <h2>你正在解决什么问题？</h2>
    <p>
      可以交流智能体、开发工具、开源项目或产品想法。请附上项目背景和你希望讨论的问题。
    </p>
    <a class='mail-cta tactile-action' href={`mailto:${email}`}>
      <Icon name='email' class='size-4' /> 发送邮件 <span aria-hidden='true'>→</span>
    </a>
  </div>

  <h2 id='start-here'>联系方式</h2>
  <p>
    新话题可以发邮件。已有仓库或问题记录的技术讨论，请在 GitHub 上继续。职业交流也可以通过 LinkedIn 联系。
  </p>
  <div class='not-prose primary-channels'>
    <SocialLedger links={primarySocialLinks} />
  </div>
  <div class='not-prose email-copy'>
    <div>
      <span>邮箱地址</span>
      <strong>{email}</strong>
    </div>
    <CopyAction value={email} label='复制邮箱' />
  </div>
  <div class='not-prose subscribe-card'>
    <div>
      <span class='eyebrow'>关注更新</span>
      <strong>通过 RSS 接收新文章与项目笔记。</strong>
    </div>
    <a class='tactile-action' href='/rss.xml' data-interaction='subscribe_feed'>订阅 RSS <span aria-hidden='true'>↗</span></a>
  </div>

  <h2 id='good-conversations'>交流主题</h2>
  <div class='not-prose conversation-grid'>
    <article>
      <span>01</span>
      <h3>智能体系统</h3>
      <p>
        多智能体流程、上下文管理、评测、工具调用与运行可靠性。
      </p>
    </article>
    <article>
      <span>02</span>
      <h3>开源协作</h3>
      <p>
        仓库协作、实现反馈和公开讨论。
      </p>
    </article>
    <article>
      <span>03</span>
      <h3>产品实验</h3>
      <p>确定使用场景，缩小实现范围，并验证产品是否解决问题。</p>
    </article>
  </div>
  <blockquote>
    第一封消息请说明项目用途、当前进展，以及希望一起检查的部分。
  </blockquote>

  <h2 id='elsewhere'>其他平台</h2>
  <p>
    不同平台分别记录短笔记、项目演示和长篇文章。
  </p>
  <div class='not-prose secondary-channels'>
    <SocialLedger links={secondarySocialLinks} startAt={primarySocialLinks.length + 1} />
  </div>


</PageLayout>

<style>
  .copy-toast{position:fixed;right:1rem;bottom:1rem;z-index:20;border:1px solid hsl(var(--border));border-radius:999px;padding:.55rem .75rem;background:hsl(var(--foreground));color:hsl(var(--background));font-size:.72rem;box-shadow:0 12px 30px hsl(var(--foreground)/.18)}
  .contact-intro {
    position: relative;
    overflow: hidden;
    margin-bottom: 3rem;
    border: 1px solid hsl(var(--border));
    border-radius: 1.15rem;
    padding: clamp(1.25rem, 5vw, 2.5rem);
    background:
      linear-gradient(145deg, transparent 42%, hsl(var(--primary) / 0.1)), hsl(var(--card));
  }
  .contact-visual {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.82;
    pointer-events: none;
  }
  .contact-intro > :not(.contact-visual) {
    position: relative;
    z-index: 1;
  }
  .eyebrow {
    color: hsl(var(--muted-foreground));
    font-size: 0.67rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .contact-intro h2 {
    position: relative;
    z-index: 1;
    max-width: 13ch;
    margin-top: 0.65rem;
    font-size: clamp(2rem, 7vw, 3.6rem);
    font-weight: 570;
    letter-spacing: -0.055em;
    line-height: 1;
  }
  .contact-intro p {
    position: relative;
    z-index: 1;
    max-width: 39rem;
    margin-top: 1rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.9rem;
    line-height: 1.7;
  }
  .mail-cta {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.15rem;
    border-radius: 999px;
    padding: 0.62rem 0.9rem;
    background: hsl(var(--foreground));
    color: hsl(var(--background));
    font-size: 0.78rem;
    text-decoration: none;
    transition: transform 180ms ease;
  }
  .mail-cta:hover,
  .mail-cta:focus-visible {
    transform: translateY(-1px);
  }
  .primary-channels,
  .secondary-channels {
    margin-block: 1.35rem 2rem;
  }
  .email-copy {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 3rem;
    border-block: 1px solid hsl(var(--border));
    padding-block: 0.9rem;
  }
  .email-copy > div {
    display: grid;
    gap: 0.08rem;
  }
  .email-copy > div span {
    color: hsl(var(--muted-foreground));
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .email-copy strong {
    font-size: 0.82rem;
    font-weight: 560;
  }
  .email-copy button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    padding: 0.5rem 0.75rem;
    background: hsl(var(--background));
    color: hsl(var(--foreground));
    font-size: 0.74rem;
    transition: background 180ms ease;
  }
  .email-copy button:hover,
  .email-copy button:focus-visible {
    background: hsl(var(--muted));
  }
  .conversation-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin-block: 1.35rem 2rem;
  }
  .subscribe-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 3rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.9rem;
    padding: 1rem;
    background: hsl(var(--card));
  }
  .subscribe-card > div {
    display: grid;
    gap: 0.35rem;
  }
  .subscribe-card .eyebrow {
    font-size: 0.62rem;
  }
  .subscribe-card strong {
    font-size: 0.84rem;
    font-weight: 580;
  }
  .subscribe-card a {
    flex: none;
    color: hsl(var(--foreground));
    font-size: 0.75rem;
    text-decoration: none;
  }
  .subscribe-card a:hover,
  .subscribe-card a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }
  .conversation-grid article {
    border-top: 1px solid hsl(var(--border));
    padding-top: 0.85rem;
  }
  .conversation-grid span {
    color: hsl(var(--muted-foreground));
    font-size: 0.65rem;
    font-variant-numeric: tabular-nums;
  }
  .conversation-grid h3 {
    margin-top: 0.6rem;
    font-size: 0.95rem;
    font-weight: 620;
  }
  .conversation-grid p {
    margin-top: 0.4rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.78rem;
    line-height: 1.55;
  }
  @media (max-width: 620px) {
    .contact-visual { object-position: 68% center; opacity: 0.62; }
    .conversation-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .email-copy {
      align-items: flex-start;
      flex-direction: column;
    }
    .subscribe-card {
      align-items: flex-start;
      flex-direction: column;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mail-cta {
      transition: none;
    }
    .mail-cta:hover,
    .mail-cta:focus-visible {
      transform: none;
    }
  }
</style>
