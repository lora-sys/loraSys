---
import { Image } from 'astro:assets'
import { primarySocialLinks, secondarySocialLinks } from '@/data/social'

import { Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import SocialLedger from '@/components/contact/SocialLedger.astro'
import CopyAction from '@/components/layout/CopyAction.astro'
import contactCorrespondenceHero from '@/assets/lora-visual/v2/lora-v2-contact-correspondence.webp'

const email = 'lorasys@outlook.com'
const headings = [
  { depth: 2, slug: 'start-here', text: '联系方式' },
  { depth: 2, slug: 'elsewhere', text: '其他平台' }
]
---

<PageLayout title='联系' heading='想聊点什么？' {headings}>
  <div class='not-prose contact-intro'>
    <Image
      src={contactCorrespondenceHero}
      alt=''
      aria-hidden='true'
      class='contact-visual'
      widths={[480, 768, 1152]}
      sizes='(max-width: 620px) 100vw, (max-width: 960px) 50vw, 31rem'
      loading='eager'
      fetchpriority='high'
    />
    <p>
      项目、技术、开源、学习、内容合作，或者只是打个招呼都可以。邮件里简单说一下你是谁、想聊什么就好。
    </p>
    <a class='mail-cta tactile-action' href={`mailto:${email}`}>
      <Icon name='email' class='size-4' /> 发送邮件 <span aria-hidden='true'>→</span>
    </a>
  </div>

  <h2 id='start-here'>联系方式</h2>
  <p>
    新话题最适合发邮件。已有仓库或 Issue 的技术讨论可以直接在 GitHub 继续，职业交流也可以通过
    LinkedIn 联系。
  </p>
  <div class='not-prose primary-channels'>
    <SocialLedger links={primarySocialLinks} />
  </div>
  <div class='not-prose email-copy'>
    <div>
      <span>邮箱地址</span>
      <strong>{email}</strong>
    </div>
    <CopyAction value={email} label='复制邮箱' />
  </div>
  <h2 id='elsewhere'>其他平台</h2>
  <p>不同平台分别记录短笔记、项目演示和长篇文章。</p>
  <div class='not-prose secondary-channels'>
    <SocialLedger links={secondarySocialLinks} startAt={primarySocialLinks.length + 1} />
  </div>
</PageLayout>

<style>
  .copy-toast {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 20;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    padding: 0.55rem 0.75rem;
    background: hsl(var(--foreground));
    color: hsl(var(--background));
    font-size: 0.72rem;
    box-shadow: 0 12px 30px hsl(var(--foreground) / 0.18);
  }
  .contact-intro {
    position: relative;
    min-height: 28rem;
    overflow: hidden;
    margin-bottom: 3rem;
    border: 1px solid hsl(var(--border));
    border-radius: 1.15rem;
    padding: clamp(1.25rem, 5vw, 2.5rem);
    padding-right: clamp(17rem, 39vw, 24rem);
    background:
      linear-gradient(145deg, transparent 42%, hsl(var(--primary) / 0.1)), hsl(var(--card));
  }
  .contact-visual {
    position: absolute;
    inset: 0 0 0 auto;
    z-index: 0;
    width: min(58%, 31rem);
    height: 100%;
    object-fit: cover;
    object-position: 56% center;
    opacity: 0.92;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to right, transparent 0, rgb(0 0 0 / 0.16) 9%, #000 30%);
    mask-image: linear-gradient(to right, transparent 0, rgb(0 0 0 / 0.16) 9%, #000 30%);
  }
  .contact-intro > :not(.contact-visual) {
    position: relative;
    z-index: 1;
  }
  .eyebrow {
    color: hsl(var(--muted-foreground));
    font-size: 0.67rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .contact-intro h2 {
    position: relative;
    z-index: 1;
    max-width: 11ch;
    margin-top: 0.65rem;
    font-size: clamp(2rem, 7vw, 3.6rem);
    font-weight: 570;
    letter-spacing: -0.055em;
    line-height: 1;
  }
  .contact-intro p {
    position: relative;
    z-index: 1;
    max-width: 34rem;
    margin-top: 1rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.9rem;
    line-height: 1.7;
  }
  .mail-cta {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.15rem;
    border-radius: 999px;
    padding: 0.62rem 0.9rem;
    background: hsl(var(--foreground));
    color: hsl(var(--background));
    font-size: 0.78rem;
    text-decoration: none;
    transition: transform 180ms ease;
  }
  .mail-cta:hover,
  .mail-cta:focus-visible {
    transform: translateY(-1px);
  }
  .primary-channels,
  .secondary-channels {
    margin-block: 1.35rem 2rem;
  }
  .email-copy {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 3rem;
    border-block: 1px solid hsl(var(--border));
    padding-block: 0.9rem;
  }
  .email-copy > div {
    display: grid;
    gap: 0.08rem;
  }
  .email-copy > div span {
    color: hsl(var(--muted-foreground));
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .email-copy strong {
    font-size: 0.82rem;
    font-weight: 560;
  }
  .email-copy button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    padding: 0.5rem 0.75rem;
    background: hsl(var(--background));
    color: hsl(var(--foreground));
    font-size: 0.74rem;
    transition: background 180ms ease;
  }
  .email-copy button:hover,
  .email-copy button:focus-visible {
    background: hsl(var(--muted));
  }
  .conversation-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin-block: 1.35rem 2rem;
  }
  .subscribe-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 3rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.9rem;
    padding: 1rem;
    background: hsl(var(--card));
  }
  .subscribe-card > div {
    display: grid;
    gap: 0.35rem;
  }
  .subscribe-card .eyebrow {
    font-size: 0.62rem;
  }
  .subscribe-card strong {
    font-size: 0.84rem;
    font-weight: 580;
  }
  .subscribe-card a {
    flex: none;
    color: hsl(var(--foreground));
    font-size: 0.75rem;
    text-decoration: none;
  }
  .subscribe-card a:hover,
  .subscribe-card a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }
  .conversation-grid article {
    border-top: 1px solid hsl(var(--border));
    padding-top: 0.85rem;
  }
  .conversation-grid span {
    color: hsl(var(--muted-foreground));
    font-size: 0.65rem;
    font-variant-numeric: tabular-nums;
  }
  .conversation-grid h3 {
    margin-top: 0.6rem;
    font-size: 0.95rem;
    font-weight: 620;
  }
  .conversation-grid p {
    margin-top: 0.4rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.78rem;
    line-height: 1.55;
  }
  @media (max-width: 900px) and (min-width: 621px) {
    .contact-intro {
      min-height: 26rem;
      padding-right: clamp(16rem, 43vw, 21rem);
    }
    .contact-visual {
      width: 54%;
      object-position: 58% center;
    }
  }
  @media (max-width: 620px) {
    .contact-intro {
      min-height: 0;
      padding: 1.25rem;
      padding-bottom: 17rem;
    }
    .contact-visual {
      inset: auto 0 0;
      width: 100%;
      height: 17rem;
      object-position: 58% center;
      opacity: 0.9;
      -webkit-mask-image: linear-gradient(
        to bottom,
        transparent 0,
        rgb(0 0 0 / 0.24) 11%,
        #000 34%
      );
      mask-image: linear-gradient(to bottom, transparent 0, rgb(0 0 0 / 0.24) 11%, #000 34%);
    }
    .contact-intro h2 {
      max-width: 10ch;
    }
    .conversation-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .email-copy {
      align-items: flex-start;
      flex-direction: column;
    }
    .subscribe-card {
      align-items: flex-start;
      flex-direction: column;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mail-cta {
      transition: none;
    }
    .mail-cta:hover,
    .mail-cta:focus-visible {
      transform: none;
    }
  }
  .contact-intro {
    min-height: 19rem;
    border: 0;
    border-block: 1px solid hsl(var(--border));
    border-radius: 0;
    background: transparent;
    padding: clamp(1rem, 4vw, 2rem) calc(min(48%, 24rem) + 1.5rem) clamp(1rem, 4vw, 2rem) 0;
  }
  .contact-intro p {
    margin: 0;
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: hsl(var(--foreground));
  }
  .contact-visual {
    width: min(48%, 24rem);
    object-fit: contain;
    mask-image: none;
    -webkit-mask-image: none;
  }
  .mail-cta {
    margin-top: 1.25rem;
  }
  @media (max-width: 620px) {
    .contact-intro {
      padding: 1.25rem 0 13rem;
    }
    .contact-visual {
      inset: auto 0 0;
      width: 100%;
      height: 12rem;
      object-fit: contain;
      opacity: 1;
      mask-image: none;
      -webkit-mask-image: none;
    }
  }

  .contact-intro {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    gap: 1.25rem;
    min-height: 0;
    padding: 1.5rem;
    overflow: visible;
    background: hsl(var(--field-paper));
  }
  .contact-visual {
    position: static;
    grid-column: 2;
    grid-row: 1 / 3;
    width: 100%;
    height: auto;
    max-height: 20rem;
    object-fit: contain;
    opacity: 1;
    mask-image: none;
    -webkit-mask-image: none;
  }
  .contact-intro > p,
  .contact-intro > .mail-cta {
    grid-column: 1;
    margin: 0;
  }
  .contact-intro > .mail-cta {
    justify-self: start;
    align-self: start;
  }
  .contact-intro > p {
    align-self: end;
  }
  @media (max-width: 620px) {
    .contact-intro {
      grid-template-columns: 1fr;
      padding: 1.1rem;
    }
    .contact-visual {
      grid-column: 1;
      grid-row: 3;
      max-height: 16rem;
      width: 100%;
      opacity: 1;
      mask-image: none;
      -webkit-mask-image: none;
    }
  }
</style>
