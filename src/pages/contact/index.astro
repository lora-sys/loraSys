---
import { primarySocialLinks, secondarySocialLinks } from '@/data/social'

import { Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import SocialGrid from '@/components/contact/SocialGrid.astro'

const email = 'lorasys@outlook.com'
const headings = [
  { depth: 2, slug: 'start-here', text: 'Start here' },
  { depth: 2, slug: 'good-conversations', text: 'Good conversations' },
  { depth: 2, slug: 'elsewhere', text: 'Elsewhere' }
]
---

<PageLayout title='Contact' {headings}>
  <div class='not-prose contact-intro'>
    <span class='eyebrow'>Contact / Collaboration</span>
    <h2>Let&apos;s build something ambitious.</h2>
    <p>
      I enjoy conversations about AI agents, developer infrastructure, open-source work, and product
      ideas with a real problem behind them. A little context goes a long way.
    </p>
    <a class='mail-cta' href={`mailto:${email}`}>
      <Icon name='email' class='size-4' /> Write an email <span aria-hidden='true'>→</span>
    </a>
  </div>

  <h2 id='start-here'>Start here</h2>
  <p>
    Email is best for a new conversation. GitHub is best when the context already lives in an issue
    or repository. LinkedIn works well for professional introductions.
  </p>
  <div class='not-prose primary-channels'>
    <SocialGrid links={primarySocialLinks} />
  </div>
  <div class='not-prose email-copy'>
    <div>
      <span>Email address</span>
      <strong>{email}</strong>
    </div>
    <button type='button' data-copy-email={email} aria-describedby='copy-status'>
      <Icon name='document' class='size-4' />
      <span>Copy email</span>
    </button>
    <span id='copy-status' class='sr-only' aria-live='polite'></span>
  </div>

  <h2 id='good-conversations'>Good conversations</h2>
  <div class='not-prose conversation-grid'>
    <article>
      <span>01</span>
      <h3>Agent systems</h3>
      <p>
        Multi-agent workflows, context engineering, evaluation, tooling, and reliable execution.
      </p>
    </article>
    <article>
      <span>02</span>
      <h3>Open source</h3>
      <p>
        Repository collaboration, implementation feedback, and ideas that benefit from being public.
      </p>
    </article>
    <article>
      <span>03</span>
      <h3>Product experiments</h3>
      <p>Turning an ambitious technical idea into a focused, testable, and useful product.</p>
    </article>
  </div>
  <blockquote>
    The best first message explains what you are building, why it matters, and where a second pair
    of eyes could help.
  </blockquote>

  <h2 id='elsewhere'>Elsewhere</h2>
  <p>
    Follow the medium that fits the kind of update you want—short notes, demos, or longer writing.
  </p>
  <div class='not-prose secondary-channels'>
    <SocialGrid links={secondarySocialLinks} />
  </div>

  <script>
    const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-email]')
    const copyStatus = document.querySelector<HTMLElement>('#copy-status')
    copyButton?.addEventListener('click', async () => {
      const email = copyButton.dataset.copyEmail
      if (!email) return
      try {
        await navigator.clipboard.writeText(email)
        const label = copyButton.querySelector('span')
        if (label) label.textContent = 'Copied'
        if (copyStatus) copyStatus.textContent = `Copied ${email} to clipboard`
        window.setTimeout(() => {
          if (label) label.textContent = 'Copy email'
        }, 1800)
      } catch {
        if (copyStatus) copyStatus.textContent = `Copy unavailable. Email address: ${email}`
      }
    })
  </script>
</PageLayout>

<style>
  .contact-intro {
    position: relative;
    overflow: hidden;
    margin-bottom: 3rem;
    border: 1px solid hsl(var(--border));
    border-radius: 1.15rem;
    padding: clamp(1.25rem, 5vw, 2.5rem);
    background:
      linear-gradient(145deg, transparent 42%, hsl(var(--primary) / 0.1)), hsl(var(--card));
  }
  .contact-intro::after {
    content: '@';
    position: absolute;
    right: -0.04em;
    bottom: -0.36em;
    color: hsl(var(--foreground) / 0.035);
    font-size: clamp(8rem, 25vw, 15rem);
    font-weight: 700;
    line-height: 1;
    pointer-events: none;
  }
  .eyebrow {
    color: hsl(var(--muted-foreground));
    font-size: 0.67rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .contact-intro h2 {
    position: relative;
    z-index: 1;
    max-width: 13ch;
    margin-top: 0.65rem;
    font-size: clamp(2rem, 7vw, 3.6rem);
    font-weight: 570;
    letter-spacing: -0.055em;
    line-height: 1;
  }
  .contact-intro p {
    position: relative;
    z-index: 1;
    max-width: 39rem;
    margin-top: 1rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.9rem;
    line-height: 1.7;
  }
  .mail-cta {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.15rem;
    border-radius: 999px;
    padding: 0.62rem 0.9rem;
    background: hsl(var(--foreground));
    color: hsl(var(--background));
    font-size: 0.78rem;
    text-decoration: none;
    transition: transform 180ms ease;
  }
  .mail-cta:hover,
  .mail-cta:focus-visible {
    transform: translateY(-1px);
  }
  .primary-channels,
  .secondary-channels {
    margin-block: 1.35rem 2rem;
  }
  .email-copy {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 3rem;
    border-block: 1px solid hsl(var(--border));
    padding-block: 0.9rem;
  }
  .email-copy > div {
    display: grid;
    gap: 0.08rem;
  }
  .email-copy > div span {
    color: hsl(var(--muted-foreground));
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .email-copy strong {
    font-size: 0.82rem;
    font-weight: 560;
  }
  .email-copy button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    padding: 0.5rem 0.75rem;
    background: hsl(var(--background));
    color: hsl(var(--foreground));
    font-size: 0.74rem;
    transition: background 180ms ease;
  }
  .email-copy button:hover,
  .email-copy button:focus-visible {
    background: hsl(var(--muted));
  }
  .conversation-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin-block: 1.35rem 2rem;
  }
  .conversation-grid article {
    border-top: 1px solid hsl(var(--border));
    padding-top: 0.85rem;
  }
  .conversation-grid span {
    color: hsl(var(--muted-foreground));
    font-size: 0.65rem;
    font-variant-numeric: tabular-nums;
  }
  .conversation-grid h3 {
    margin-top: 0.6rem;
    font-size: 0.95rem;
    font-weight: 620;
  }
  .conversation-grid p {
    margin-top: 0.4rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.78rem;
    line-height: 1.55;
  }
  @media (max-width: 620px) {
    .conversation-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .email-copy {
      align-items: flex-start;
      flex-direction: column;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mail-cta {
      transition: none;
    }
    .mail-cta:hover,
    .mail-cta:focus-visible {
      transform: none;
    }
  }
</style>
