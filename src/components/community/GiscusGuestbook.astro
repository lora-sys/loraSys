---
interface Props {
  lang?: 'zh-CN' | 'en-US'
}

const { lang = 'zh-CN' } = Astro.props
const copy = lang === 'en-US'
  ? {
      eyebrow: 'Public guestbook',
      title: 'Leave a note for the next build.',
      description: 'Messages are public and managed through GitHub Discussions. Sign in with GitHub to post, reply, or react.',
      fallback: 'Preparing the public guestbook…',
      loadingHelp: 'Sign in with GitHub when the discussion box is ready, or open the repository discussions directly.',
      fallbackLink: 'Open GitHub Discussions ↗',
      privacy: 'Your message will be published in the lora-sys/loraSys repository discussions.'
    }
  : {
      eyebrow: 'Public guestbook · 公开留言板',
      title: '留下一句话，给下一次构建。',
      description: '留言公开保存在 GitHub Discussions。使用 GitHub 登录后，可以留言、回复或添加反应。',
      fallback: '正在准备公开留言板…',
      loadingHelp: '讨论框准备完成后可使用 GitHub 登录参与，也可以直接打开仓库 Discussions。',
      fallbackLink: '打开 GitHub Discussions ↗',
      privacy: '留言会发布到 lora-sys/loraSys 仓库的公开 Discussions。'
    }
---

<section class='guestbook-shell' aria-labelledby='guestbook-title'>
  <header>
    <p>{copy.eyebrow}</p>
    <h2 id='guestbook-title'>{copy.title}</h2>
    <p class='guestbook-description'>{copy.description}</p>
  </header>

  <div class='giscus-frame' aria-live='polite'>
    <div class='giscus-loading'>
      <span class='giscus-skeleton' aria-hidden='true'><i></i><i></i><i></i></span>
      <div>
        <p>{copy.fallback}</p>
        <small>{copy.loadingHelp}</small>
        <a href='https://github.com/lora-sys/loraSys/discussions' target='_blank' rel='noopener noreferrer'>{copy.fallbackLink}</a>
      </div>
    </div>
    <script
      is:inline
      src='https://giscus.app/client.js'
      data-repo='lora-sys/loraSys'
      data-repo-id='R_kgDORZoeSQ'
      data-category='General'
      data-category-id='DIC_kwDORZoeSc4C9UW7'
      data-mapping='specific'
      data-term='loraSys public guestbook'
      data-strict='1'
      data-reactions-enabled='1'
      data-emit-metadata='0'
      data-input-position='top'
      data-theme='preferred_color_scheme'
      data-lang={lang === 'en-US' ? 'en' : 'zh-CN'}
      crossorigin='anonymous'
      async
    ></script>
  </div>

  <p class='guestbook-privacy'>{copy.privacy}</p>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.giscus-frame').forEach((frame) => {
    const observer = new MutationObserver(() => {
      if (frame.querySelector('iframe.giscus-frame')) {
        frame.querySelector('.giscus-loading')?.remove()
        observer.disconnect()
      }
    })
    observer.observe(frame, { childList: true, subtree: true })
  })
</script>

<style>
  .guestbook-shell {
    position: relative;
    isolation: isolate;
    padding: clamp(1.2rem, 4vw, 2.25rem);
    border: 1px solid hsl(var(--border));
    border-radius: 1rem;
    background:
      linear-gradient(120deg, hsl(var(--primary) / 0.075), transparent 38%),
      hsl(var(--card));
    box-shadow: 0 26px 62px -52px hsl(var(--foreground) / 0.68);
  }

  .guestbook-shell::before {
    position: absolute;
    top: 0;
    left: clamp(1.2rem, 4vw, 2.25rem);
    width: min(11rem, 38%);
    height: 2px;
    background: hsl(var(--primary));
    content: '';
  }

  .guestbook-shell header > p:first-child {
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.62rem;
    font-weight: 720;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .guestbook-shell h2 {
    max-width: 20ch;
    margin: 0.8rem 0 0;
    color: hsl(var(--foreground));
    font-size: clamp(1.35rem, 4vw, 2rem);
    letter-spacing: -0.04em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .guestbook-description {
    max-width: 60ch;
    margin: 0.8rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.84rem;
    line-height: 1.7;
  }

  .giscus-frame {
    min-height: 12rem;
    margin-top: 1.4rem;
  }

  .giscus-loading {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    align-items: start;
    gap: 0.8rem;
    min-height: 10rem;
    padding: 1rem;
    border: 1px dashed hsl(var(--border));
    border-radius: 0.75rem;
    background: hsl(var(--background) / 0.46);
  }

  .giscus-skeleton {
    display: grid;
    gap: 0.32rem;
    padding-top: 0.08rem;
  }

  .giscus-skeleton i {
    display: block;
    height: 0.28rem;
    border-radius: 999px;
    background: hsl(var(--muted));
  }

  .giscus-skeleton i:nth-child(2) { width: 74%; }
  .giscus-skeleton i:nth-child(3) { width: 48%; }

  .giscus-loading p,
  .giscus-loading small { display: block; }

  .giscus-loading p {
    margin: 0;
    color: hsl(var(--foreground));
    font-size: 0.78rem;
    font-weight: 620;
  }

  .giscus-loading small {
    max-width: 48ch;
    margin-top: 0.42rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.7rem;
    line-height: 1.55;
  }

  .giscus-loading a {
    display: inline-block;
    margin-top: 0.65rem;
    color: hsl(var(--foreground));
    font-size: 0.7rem;
    text-decoration: none;
  }

  .giscus-loading a:hover,
  .giscus-loading a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .giscus-frame :global(.giscus) {
    width: 100%;
  }

  .guestbook-privacy {
    margin: 1rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.68rem;
    line-height: 1.55;
  }

  @media (max-width: 480px) {
    .giscus-loading { grid-template-columns: 1.8rem minmax(0, 1fr); }
  }

  @media (prefers-reduced-motion: reduce) {
    .guestbook-shell {
      scroll-behavior: auto;
    }
  }
</style>
