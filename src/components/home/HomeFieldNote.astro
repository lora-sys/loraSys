---
import { Image } from 'astro:assets'

import readingSticker from '@/assets/lora-visual/v3/lora-icon-reading-v1.webp'

interface Props {
  date: string
  dateTime: string
  href: string
  title: string
  locale?: 'zh-CN' | 'en-US'
}

const { date, dateTime, href, title, locale = 'zh-CN' } = Astro.props
const isEnglish = locale === 'en-US'
---

<a class='home-field-note' href={href}>
  <span class='note-copy'>
    <span class='note-meta'>
      <span>{isEnglish ? 'LATEST FIELD NOTE' : '最新现场记录'}</span>
      <time datetime={dateTime}>{date}</time>
    </span>
    <strong class='note-title'>{title}</strong>
    <span class='note-action'
      >{isEnglish ? 'Read the note' : '打开这篇记录'} <span aria-hidden='true'>↗</span></span
    >
  </span>
  <Image
    class='note-sticker'
    src={readingSticker}
    alt=''
    aria-hidden='true'
    width={72}
    height={72}
    loading='eager'
    decoding='async'
  />
</a>

<style>
  .home-field-note {
    position: absolute;
    z-index: 3;
    top: 7%;
    right: 2%;
    display: grid;
    width: min(20rem, 82%);
    grid-template-columns: minmax(0, 1fr) 3.25rem;
    align-items: center;
    gap: 0.8rem;
    border: 1px solid hsl(var(--border));
    border-radius: 14px;
    background: hsl(var(--field-paper) / 0.97);
    box-shadow: 0 10px 24px hsl(var(--field-ink) / 0.1);
    color: hsl(var(--foreground));
    padding: 0.75rem 0.85rem;
    text-decoration: none;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }
  .home-field-note::after {
    position: absolute;
    right: 2.45rem;
    bottom: -0.42rem;
    width: 0.72rem;
    height: 0.72rem;
    transform: rotate(45deg);
    border-right: 1px solid hsl(var(--border));
    border-bottom: 1px solid hsl(var(--border));
    background: hsl(var(--field-paper));
    content: '';
  }
  .home-field-note:hover,
  .home-field-note:focus-visible {
    transform: translateY(-2px);
    border-color: hsl(var(--field-amber) / 0.75);
    box-shadow: 0 14px 28px hsl(var(--field-ink) / 0.13);
  }
  .home-field-note:focus-visible {
    outline: 2px solid hsl(var(--field-amber-strong));
    outline-offset: 3px;
  }
  .note-copy {
    display: grid;
    min-width: 0;
    gap: 0.32rem;
  }
  .note-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.55rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.055em;
    line-height: 1.3;
  }
  .note-meta > span {
    color: hsl(var(--field-amber-strong));
  }
  .note-title {
    display: -webkit-box;
    overflow: hidden;
    font-size: 0.78rem;
    font-weight: 650;
    line-height: 1.35;
    text-overflow: ellipsis;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .note-action {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.62rem;
    font-weight: 600;
  }
  .note-sticker {
    display: block;
    width: 3.25rem;
    height: 3.25rem;
    object-fit: contain;
  }
  @media (max-width: 760px) {
    .home-field-note {
      position: relative;
      top: auto;
      right: auto;
      width: min(19rem, 82vw);
      margin: 0 0.2rem 0.25rem auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-field-note {
      transition: none;
    }
  }
</style>
