---
import { randomUUID } from 'node:crypto'

interface Props {
  lang?: 'zh-CN' | 'en-US'
  triggerLabel?: string
  triggerClass?: string
}

const { lang = 'zh-CN', triggerLabel, triggerClass = '' } = Astro.props
const dialogId = `resume-preview-${randomUUID()}`
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const pdfPath = `${base}/resume.pdf`
const resumePath = `${base}${lang === 'en-US' ? '/en/resume' : '/resume'}`
const isResumePage = Astro.url.pathname.replace(/\/$/, '') === resumePath
const readingPath = isResumePage
  ? (lang === 'en-US' ? '#resume-highlights' : '#resume-education')
  : `${resumePath}#resume-title`
const copy = lang === 'en-US'
  ? {
      read: isResumePage ? 'Read profile below' : 'Read web résumé',
      trigger: triggerLabel?.includes('PDF') ? triggerLabel : 'Preview Chinese PDF',
      language: 'PDF original in Chinese',
      dialogLabel: 'Chinese résumé PDF preview',
      close: 'Close preview',
      open: 'Open Chinese PDF in a new tab',
      download: 'Download Chinese PDF',
      loading: 'This is the Chinese original. Use the web résumé for readable text on a small screen.'
    }
  : {
      read: isResumePage ? '阅读下方简历' : '阅读网页版简历',
      trigger: triggerLabel?.includes('PDF') ? triggerLabel : '预览中文 PDF',
      language: 'PDF 原件为中文',
      dialogLabel: '中文简历 PDF 预览',
      close: '关闭预览',
      open: '在新标签页打开中文 PDF',
      download: '下载中文 PDF',
      loading: '这是中文 PDF 原件。手机阅读可使用网页版，无需缩放。'
    }
---

<div class='resume-preview' data-resume-preview>
  <a class='resume-reading-link' data-resume-reading href={readingPath}>{copy.read}</a>
  <button class:list={['resume-preview-trigger', triggerClass]} type='button' data-resume-trigger aria-haspopup='dialog' aria-controls={dialogId} aria-describedby={`${dialogId}-language`}>
    {copy.trigger} <span aria-hidden='true'>↗</span>
  </button>
  <span class='resume-pdf-language' id={`${dialogId}-language`}>{copy.language}</span>

  <dialog id={dialogId} class='resume-preview-dialog' aria-label={copy.dialogLabel} data-resume-dialog>
    <div class='resume-preview-shell'>
      <header>
        <p>{copy.loading}</p>
        <div class='resume-preview-actions'>
          <a href={readingPath} data-resume-read-alternative>{copy.read}</a>
          <a href={pdfPath} target='_blank' rel='noopener noreferrer'>{copy.open} <span aria-hidden='true'>↗</span></a>
          <a href={pdfPath} download>{copy.download} <span aria-hidden='true'>↓</span></a>
          <button type='button' data-resume-close>{copy.close} <span aria-hidden='true'>×</span></button>
        </div>
      </header>
      <div class='resume-pdf-wrap'>
        <iframe title={copy.dialogLabel} data-resume-pdf data-resume-pdf-src={pdfPath} loading='lazy'></iframe>
      </div>
    </div>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-resume-preview]').forEach((preview) => {
    const dialog = preview.querySelector<HTMLDialogElement>('[data-resume-dialog]')
    const trigger = preview.querySelector<HTMLButtonElement>('[data-resume-trigger]')
    const close = preview.querySelector<HTMLButtonElement>('[data-resume-close]')
    const frame = preview.querySelector<HTMLIFrameElement>('[data-resume-pdf]')
    if (!dialog || !trigger || !close) return

    trigger.addEventListener('click', () => {
      if (dialog.open) return
      if (frame && !frame.getAttribute('src') && frame.dataset.resumePdfSrc) {
        frame.src = `${frame.dataset.resumePdfSrc}#view=FitH`
      }
      dialog.showModal()
      close.focus()
    })
    close.addEventListener('click', () => dialog.close())
    preview.querySelector('[data-resume-read-alternative]')?.addEventListener('click', () => dialog.close())
    dialog.addEventListener('click', (event) => {
      if (event.target !== dialog) return
      const rect = dialog.getBoundingClientRect()
      if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close()
    })
    dialog.addEventListener('close', () => trigger.focus())
  })
</script>

<style>
  .resume-preview { display:contents; }
  .resume-reading-link,.resume-preview-trigger {
    display:inline-flex; min-height:2.75rem; align-items:center; gap:.35rem;
    border:1px solid hsl(var(--border)); border-radius:999px; padding:.5rem .8rem;
    background:hsl(var(--background)); color:hsl(var(--foreground)); font:inherit;
    font-size:.8rem; font-weight:630; text-decoration:none; cursor:pointer;
    transition:border-color 170ms ease,background 170ms ease;
  }
  .resume-reading-link { background:hsl(var(--foreground)); color:hsl(var(--background)); border-color:hsl(var(--foreground)); }
  .resume-reading-link:hover,.resume-reading-link:focus-visible { outline:2px solid hsl(var(--field-amber)); outline-offset:3px; }
  .resume-preview-trigger:hover,.resume-preview-trigger:focus-visible { border-color:hsl(var(--foreground) / .4); background:hsl(var(--muted)); }
  .resume-pdf-language { align-self:center; color:hsl(var(--muted-foreground)); font-size:.75rem; line-height:1.5; }
  .resume-preview-dialog {
    width:min(94vw,72rem); max-width:none; height:min(92dvh,58rem); max-height:none;
    overflow:hidden; border:1px solid hsl(var(--border)); border-radius:1rem; padding:0;
    background:hsl(var(--background)); color:hsl(var(--foreground)); box-shadow:0 32px 100px -44px hsl(var(--foreground) / .86);
  }
  .resume-preview-dialog::backdrop { background:hsl(var(--foreground) / .52); backdrop-filter:blur(5px); }
  .resume-preview-shell { display:grid; height:100%; grid-template-rows:auto minmax(0,1fr); }
  .resume-preview-shell header { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:.8rem 1rem; border-bottom:1px solid hsl(var(--border)); }
  .resume-preview-shell header>p { max-width:34rem; margin:0; color:hsl(var(--muted-foreground)); font-size:.85rem; line-height:1.6; }
  .resume-preview-actions { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:.4rem; }
  .resume-preview-actions a,.resume-preview-actions button {
    display:inline-flex; min-height:2.75rem; align-items:center; gap:.25rem;
    border:1px solid hsl(var(--border)); border-radius:999px; padding:.4rem .7rem;
    background:hsl(var(--background)); color:hsl(var(--foreground)); font:inherit; font-size:.8rem; text-decoration:none; cursor:pointer;
  }
  .resume-preview-actions button { border-color:hsl(var(--foreground)); background:hsl(var(--foreground)); color:hsl(var(--background)); }
  .resume-pdf-wrap { position:relative; min-height:0; background:hsl(var(--muted)); }
  .resume-pdf-wrap iframe { width:100%; height:100%; border:0; }
  @media(max-width:680px) {
    .resume-preview-dialog { width:100vw; height:100dvh; border:0; border-radius:0; }
    .resume-preview-shell header { align-items:flex-start; flex-direction:column; }
    .resume-preview-actions { justify-content:flex-start; }
    :global(.resume-page p.resume-summary),
    :global(.resume-page .resume-grid .resume-card p),
    :global(.resume-page .resume-record p.resume-detail),
    :global(.resume-page .strengths li) { font-size:1rem; line-height:1.75; }
    :global(.resume-page .resume-hero h1) { line-height:1.15; }
    :global(.resume-page .resume-meta) { overflow-wrap:anywhere; }
  }
  @media(prefers-reduced-motion:reduce) {
    .resume-reading-link,.resume-preview-trigger { transition:none; }
  }
</style>
