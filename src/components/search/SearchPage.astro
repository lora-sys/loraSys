---
import { text } from '@/i18n/ui'

import PageLayout from '@/layouts/BaseLayout.astro'
import { integ } from '@/site-config'

import LocalSearch from './LocalSearch.astro'

interface Props {
  locale: 'zh-CN' | 'en-US'
}
const { locale } = Astro.props
const t = (zh: string, en: string) => text(locale, zh, en)
const work = locale === 'en-US' ? '/en/work' : '/projects'
const writing = locale === 'en-US' ? '/en/writing' : '/blog'
const intro = t(
  '搜索文章、项目、短笔记、实验记录和站点页面。按 / 可定位搜索框。',
  'Search writing, projects, short notes, experiments, and site pages. Press / to focus search.'
)
const contentTypes = [
  { id: 'all', zh: '全部', en: 'All' },
  { id: 'project', zh: '项目', en: 'Projects' },
  { id: 'article', zh: '文章', en: 'Articles' },
  { id: 'note', zh: '短笔记', en: 'Notes' },
  { id: 'lab', zh: '实验', en: 'Experiments' },
  { id: 'page', zh: '站点页面', en: 'Site pages' },
  { id: 'talk', zh: '活动', en: 'Talks' },
  { id: 'archive', zh: '归档', en: 'Archives' }
]
---

<PageLayout lang={locale} meta={{ title: t('搜索', 'Search'), description: intro }}>
  <main class='search-page'>
    <header class='search-heading'>
      <p class='eyebrow'>{t('站点目录', 'Site directory')}</p>
      <h1>{t('搜索', 'Search')}</h1>
      <p>{intro}</p>
    </header>

    {
      integ.pagefind ? (
        <div
          class='search-shell'
          data-search-shell
          data-base-url={import.meta.env.BASE_URL}
          data-locale={locale}
        >
          <div
            class='search-filters'
            role='group'
            aria-label={t('按内容类型筛选', 'Filter by content type')}
          >
            {contentTypes.map((kind) => (
              <button type='button' data-search-type={kind.id} aria-pressed={kind.id === 'all'}>
                {locale === 'en-US' ? kind.en : kind.zh}
              </button>
            ))}
          </div>
          <LocalSearch {locale} />
          <p class='filter-count' data-filter-count role='status' aria-live='polite' hidden>
            {t('正在更新结果数。', 'Updating the result count.')}
          </p>
        </div>
      ) : (
        <p class='search-unavailable' role='status'>
          {t(
            '本站暂未启用搜索。你可以从下方目录浏览内容。',
            'Search is unavailable. Browse the directories below.'
          )}
        </p>
      )
    }

    <nav class='search-help' aria-label={t('浏览其他内容', 'Browse other content')}>
      <a href={work}>{t('浏览作品', 'Explore projects')}</a>
      <a href={writing}>{t('浏览文章', 'Browse writing')}</a>
      <a href='/archives'>{t('查看内容归档', 'Browse the archive in Chinese')}</a>
      <a href={locale === 'en-US' ? '/search' : '/en/search'}
        >{t('切换搜索语言', 'Search in the other language')}</a
      >
    </nav>
  </main>
</PageLayout>

<script>
  type SearchKind = 'project' | 'article' | 'note' | 'lab' | 'page' | 'talk' | 'archive'
  const shell = document.querySelector<HTMLElement>('[data-search-shell]')

  if (shell) {
    const baseUrl = shell.dataset.baseUrl?.replace(/\/$/, '') ?? ''
    const isEnglish = shell.dataset.locale === 'en-US'
    const labels: Record<SearchKind, string> = isEnglish
      ? {
          project: 'Project',
          article: 'Article',
          note: 'Short note',
          lab: 'Experiment',
          page: 'Site page',
          talk: 'Talk',
          archive: 'Archive'
        }
      : {
          project: '项目',
          article: '文章',
          note: '短笔记',
          lab: '实验',
          page: '站点页面',
          talk: '活动',
          archive: '归档'
        }
    const filters = [...shell.querySelectorAll<HTMLButtonElement>('[data-search-type]')]
    const filterCount = shell.querySelector<HTMLElement>('[data-filter-count]')
    let activeType = 'all'

    const getKind = (result: HTMLElement): SearchKind => {
      const link = result.querySelector<HTMLAnchorElement>('.pagefind-ui__result-link')
      if (!link) return 'page'
      const pathname = new URL(link.href, window.location.origin).pathname
      const hasBase = baseUrl && (pathname === baseUrl || pathname.startsWith(`${baseUrl}/`))
      const path = hasBase ? pathname.slice(baseUrl.length) || '/' : pathname
      if (/^\/(?:projects|en\/work|en\/projects)(?:\/|$)/.test(path)) return 'project'
      if (/^\/(?:blog|en\/writing)(?:\/|$)/.test(path)) return 'article'
      if (/^\/notes(?:\/|$)/.test(path)) return 'note'
      if (/^\/lab(?:\/|$)/.test(path)) return 'lab'
      if (/^\/talks(?:\/|$)/.test(path)) return 'talk'
      if (/^\/(?:archives|tags)(?:\/|$)/.test(path)) return 'archive'
      return 'page'
    }

    const refreshResults = () => {
      const results = [...shell.querySelectorAll<HTMLElement>('.pagefind-ui__result')]
      let visibleCount = 0
      results.forEach((result) => {
        const kind = getKind(result)
        result.dataset.searchKind = kind
        let badge = result.querySelector<HTMLElement>('[data-search-kind-badge]')
        if (!badge) {
          badge = document.createElement('span')
          badge.dataset.searchKindBadge = ''
          badge.className = 'search-kind-badge'
          result.prepend(badge)
        }
        if (badge.textContent !== labels[kind]) badge.textContent = labels[kind]
        const visible = activeType === 'all' || activeType === kind
        result.hidden = !visible
        if (visible) visibleCount += 1
      })
      const query =
        shell.querySelector<HTMLInputElement>('.pagefind-ui__search-input')?.value.trim() ?? ''
      const isFiltered = activeType !== 'all'
      const showCount = Boolean(query && results.length > 0)
      if (filterCount) {
        filterCount.hidden = !showCount
        const selectedLabel =
          filters.find((filter) => filter.dataset.searchType === activeType)?.textContent?.trim() ??
          ''
        const message = isEnglish
          ? isFiltered
            ? `${results.length} total results. ${visibleCount} match this filter.`
            : `${results.length} results. Showing all ${visibleCount}.`
          : isFiltered
            ? `共 ${results.length} 条结果，当前“${selectedLabel}”筛选显示 ${visibleCount} 条。`
            : `共 ${results.length} 条结果，当前显示全部 ${visibleCount} 条。`
        if (filterCount.textContent !== message) filterCount.textContent = message
      }
    }

    filters.forEach((button) =>
      button.addEventListener('click', () => {
        activeType = button.dataset.searchType ?? 'all'
        filters.forEach((filter) => filter.setAttribute('aria-pressed', String(filter === button)))
        refreshResults()
      })
    )

    shell.addEventListener('input', () => {
      if (filterCount) filterCount.hidden = true
    })
    new MutationObserver(refreshResults).observe(shell, {
      childList: true,
      subtree: true,
      characterData: true
    })
    refreshResults()
  }
</script>

<style>
  .search-page {
    max-width: 58rem;
    margin-inline: auto;
  }
  .search-heading {
    margin-bottom: 1.5rem;
  }
  .eyebrow {
    margin: 0 0 0.4rem;
    color: hsl(var(--field-amber-strong));
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 6vw, 3.4rem);
    line-height: 1.12;
  }
  .search-heading > p:last-child,
  .search-unavailable {
    margin: 0.75rem 0 0;
    color: hsl(var(--muted-foreground));
    line-height: 1.7;
  }
  .search-shell {
    margin-top: 1.5rem;
  }
  .search-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  .search-filters button {
    min-height: 2.5rem;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    padding: 0.4rem 0.8rem;
    background: transparent;
    color: hsl(var(--foreground));
    font-size: 0.76rem;
  }
  .search-filters button[aria-pressed='true'] {
    border-color: hsl(var(--foreground));
    background: hsl(var(--foreground));
    color: hsl(var(--background));
  }
  .filter-count {
    margin: 1rem 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.86rem;
  }
  .search-help {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    margin-top: 1.5rem;
    border-top: 1px solid hsl(var(--border));
    padding-top: 0.75rem;
  }
  .search-help a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: hsl(var(--foreground));
    font-size: 0.84rem;
    text-underline-offset: 0.2em;
  }
  .search-shell :global(.pagefind-ui__result) {
    border-radius: 0.6rem;
    transition: transform 160ms ease;
  }
  .search-shell :global(.pagefind-ui__result[hidden]) {
    display: none;
  }
  .search-shell :global(.search-kind-badge) {
    display: inline-block;
    margin: 0 0 0.35rem;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    padding: 0.15rem 0.5rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.64rem;
    line-height: 1.4;
  }
  .search-shell :global(.pagefind-ui__result:focus-within) {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 3px;
  }
  @media (hover: hover) {
    .search-shell :global(.pagefind-ui__result:hover) {
      transform: translateX(2px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .search-shell :global(.pagefind-ui__result) {
      transition: none;
    }
    .search-shell :global(.pagefind-ui__result:hover) {
      transform: none;
    }
  }
</style>
