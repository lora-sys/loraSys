---
import '@pagefind/default-ui/css/ui.css'

interface Props {
  locale: 'zh-CN' | 'en-US'
}
const { locale } = Astro.props
---

<localized-site-search data-locale={locale}>
  <aside class='form my-4'>
    {
      import.meta.env.DEV ? (
        <p class='rounded-xl border-2 px-4 py-2'>
          {locale === 'en-US'
            ? 'Search is available in the production preview.'
            : '搜索在生产构建预览中可用。'}
        </p>
      ) : (
        <Fragment>
          <>
            <div id='site-search' />
            <p data-search-load-error role='status' hidden />
          </>
        </Fragment>
      )
    }
  </aside>
</localized-site-search>

<script>
  import {
    readSearchState,
    SEARCH_KIND_FILTER,
    searchKindFilters,
    searchKindForPath,
    searchType,
    writeSearchState,
    type SearchKind,
    type SearchState
  } from '@/utils/search'

  interface SearchUI {
    triggerFilters(filters: Record<string, string[]>): void
    triggerSearch(query: string): void
    destroy(): void
  }

  class SiteSearch extends HTMLElement {
    private ui?: SearchUI
    private observer?: MutationObserver
    private events?: AbortController

    connectedCallback() {
      if (this.dataset.initialized || import.meta.env.DEV) return
      this.dataset.initialized = 'true'
      this.events = new AbortController()
      const initialize = () => {
        void this.initialize()
      }
      if (document.readyState === 'loading') {
        window.addEventListener('DOMContentLoaded', initialize, {
          once: true,
          signal: this.events.signal
        })
      } else initialize()
    }

    disconnectedCallback() {
      this.events?.abort()
      this.observer?.disconnect()
      this.ui?.destroy()
      delete this.dataset.initialized
    }

    async initialize() {
      const shell = this.closest<HTMLElement>('[data-search-shell]')
      if (!shell || !this.querySelector('#site-search') || !this.events) return
      const isEnglish = this.dataset.locale === 'en-US'
      const baseUrl = import.meta.env.BASE_URL
      const bundlePath = `${baseUrl.replace(/\/$/, '')}/pagefind/`
      const formatURL = (url: string) => url.replace(/(.)\/(#.*)?$/, '$1$2')
      const buttons = [...shell.querySelectorAll<HTMLButtonElement>('[data-search-type]')]
      const reset = shell.querySelector<HTMLButtonElement>('[data-search-reset]')
      const count = shell.querySelector<HTMLElement>('[data-filter-count]')
      const signal = this.events.signal
      let state = readSearchState(new URL(window.location.href).searchParams)
      const labels: Record<SearchKind, string> = isEnglish
        ? {
            project: 'Project',
            article: 'Article',
            note: 'Short note',
            lab: 'Experiment',
            page: 'Site page',
            talk: 'Talk',
            archive: 'Archive'
          }
        : {
            project: '项目',
            article: '文章',
            note: '短笔记',
            lab: '实验',
            page: '站点页面',
            talk: '活动',
            archive: '归档'
          }

      const updateControls = () => {
        buttons.forEach((button) =>
          button.setAttribute('aria-pressed', String(button.dataset.searchType === state.type))
        )
        if (reset)
          reset.hidden =
            state.type === 'all' && !Object.values(state.filters).some((values) => values.length)
      }
      const saveState = () => {
        const next = writeSearchState(new URL(window.location.href), state)
        window.history.replaceState(window.history.state, '', next)
        updateControls()
      }
      const readVisibleFilters = () => {
        const filters: SearchState['filters'] = {}
        for (const checkbox of this.querySelectorAll<HTMLInputElement>(
          '.pagefind-ui__filter-checkbox:checked'
        )) {
          if (checkbox.name === SEARCH_KIND_FILTER) continue
          ;(filters[checkbox.name] ??= []).push(checkbox.value)
        }
        return filters
      }
      const applyFilters = () => {
        // Pagefind filters the complete index before its UI takes a page of five results.
        this.ui?.triggerFilters({ ...state.filters, ...searchKindFilters(state.type) })
        if (count) count.hidden = true
        updateControls()
      }
      const updateResults = () => {
        const summary = this.querySelector<HTMLElement>('.pagefind-ui__message')
        summary?.setAttribute('role', 'status')
        summary?.setAttribute('aria-live', 'polite')
        const results = [...this.querySelectorAll<HTMLElement>('.pagefind-ui__result')]
        let loaded = 0
        for (const result of results) {
          const link = result.querySelector<HTMLAnchorElement>('.pagefind-ui__result-link')
          if (!link) continue
          loaded += 1
          const kind = searchKindForPath(
            new URL(link.href, window.location.origin).pathname,
            baseUrl
          )
          result.dataset.searchKind = kind
          let badge = result.querySelector<HTMLElement>('[data-search-kind-badge]')
          if (!badge) {
            badge = document.createElement('span')
            badge.dataset.searchKindBadge = ''
            badge.className = 'search-kind-badge'
            result.prepend(badge)
          }
          if (badge.textContent !== labels[kind]) badge.textContent = labels[kind]
        }
        const hasResults = Boolean(
          state.query.trim() && this.querySelector('.pagefind-ui__results')
        )
        if (count) {
          count.hidden = !hasResults || loaded === 0
          const message = isEnglish
            ? `${loaded} matching results loaded.`
            : `已加载 ${loaded} 条匹配结果。`
          if (count.textContent !== message) count.textContent = message
        }
      }

      updateControls()
      try {
        // Check the generated index here so a missing bundle has a recoverable message.
        const pagefind = await import(/* @vite-ignore */ `${bundlePath}pagefind.js`)
        await pagefind.options({ baseUrl })
        await pagefind.filters()
        if (signal.aborted) return
        // @ts-expect-error Missing declarations in @pagefind/default-ui.
        const { PagefindUI } = await import('@pagefind/default-ui')
        if (signal.aborted) return
        this.ui = new PagefindUI({
          element: '#site-search',
          translations: isEnglish
            ? {
                placeholder: 'Search articles and projects',
                zero_results:
                  'No results for [SEARCH_TERM]. Try another term or clear the filters.',
                clear_search: 'Clear',
                searching: 'Searching…',
                one_result: '[COUNT] matching result for [SEARCH_TERM]',
                many_results: '[COUNT] matching results for [SEARCH_TERM]'
              }
            : {
                placeholder: '搜索文章与项目',
                zero_results: '没有找到 [SEARCH_TERM]，请更换关键词或清除筛选。',
                clear_search: '清除',
                searching: '正在搜索…',
                one_result: '找到 [COUNT] 条与 [SEARCH_TERM] 匹配的结果',
                many_results: '找到 [COUNT] 条与 [SEARCH_TERM] 匹配的结果'
              },
          baseUrl,
          bundlePath,
          showImages: false,
          showSubResults: true,
          processResult: (result: { url: string; sub_results: Array<{ url: string }> }) => {
            result.url = formatURL(result.url)
            result.sub_results = result.sub_results.map((item) => ({
              ...item,
              url: formatURL(item.url)
            }))
            return result
          }
        })
        buttons.forEach((button) => {
          button.disabled = false
        })
        if (reset) reset.disabled = false
        applyFilters()
        if (state.query) this.ui?.triggerSearch(state.query)

        buttons.forEach((button) =>
          button.addEventListener(
            'click',
            () => {
              state = {
                ...state,
                type: searchType(button.dataset.searchType)
              }
              applyFilters()
              saveState()
            },
            { signal }
          )
        )
        reset?.addEventListener(
          'click',
          () => {
            state = { ...state, type: 'all', filters: {} }
            applyFilters()
            saveState()
            this.querySelector<HTMLInputElement>('.pagefind-ui__search-input')?.focus()
          },
          { signal }
        )
        this.addEventListener(
          'input',
          (event) => {
            if (
              !(event.target instanceof HTMLInputElement) ||
              !event.target.matches('.pagefind-ui__search-input')
            )
              return
            state.query = event.target.value
            if (count) count.hidden = true
            saveState()
          },
          { signal }
        )
        this.addEventListener(
          'change',
          (event) => {
            if (
              !(event.target instanceof HTMLInputElement) ||
              !event.target.matches('.pagefind-ui__filter-checkbox')
            )
              return
            state.filters = readVisibleFilters()
            if (count) count.hidden = true
            saveState()
          },
          { signal }
        )
        const syncClearedQuery = () => {
          queueMicrotask(() => {
            state.query =
              this.querySelector<HTMLInputElement>('.pagefind-ui__search-input')?.value ?? ''
            if (count) count.hidden = true
            saveState()
          })
        }
        this.addEventListener(
          'click',
          (event) => {
            if (
              event.target instanceof Element &&
              event.target.closest('.pagefind-ui__search-clear')
            )
              syncClearedQuery()
          },
          { signal }
        )
        this.addEventListener(
          'keydown',
          (event) => {
            if (event.key === 'Escape' && event.target instanceof HTMLInputElement)
              syncClearedQuery()
          },
          { signal }
        )
        window.addEventListener(
          'popstate',
          () => {
            state = readSearchState(new URL(window.location.href).searchParams)
            applyFilters()
            // Pagefind 1.4 ignores triggerSearch(''), so dispatch input for an empty history state.
            const input = this.querySelector<HTMLInputElement>('.pagefind-ui__search-input')
            if (input) {
              input.value = state.query
              input.dispatchEvent(new Event('input', { bubbles: true }))
            }
          },
          { signal }
        )
        this.observer = new MutationObserver(updateResults)
        this.observer.observe(this, { childList: true, subtree: true, characterData: true })
      } catch {
        const error = this.querySelector<HTMLElement>('[data-search-load-error]')
        if (error) {
          error.hidden = false
          error.textContent = isEnglish
            ? 'Search could not load. Refresh or browse the links below.'
            : '搜索暂时无法加载，请刷新页面或浏览下方链接。'
        }
      }
    }
  }
  if (!customElements.get('localized-site-search'))
    customElements.define('localized-site-search', SiteSearch)
</script>

<style>
  #site-search {
    --pagefind-ui-scale: 0.8;
    --pagefind-ui-primary: hsl(var(--primary));
    --pagefind-ui-text: hsl(var(--foreground));
    --pagefind-ui-background: hsl(var(--muted));
    --pagefind-ui-border: hsl(var(--border));
    --pagefind-ui-tag: hsl(var(--muted-foreground));
    --pagefind-ui-border-width: 2px;
    --pagefind-ui-border-radius: calc(var(--radius) + 2px);
    --pagefind-ui-font: inherit;
  }
  /* The main type buttons control this index filter. Keep native topic filters available. */
  #site-search :global(.pagefind-ui__filter-block:has(input[name='search-kind'])) {
    display: none;
  }
</style>
