---
import type { SocialIcon as SocialIconName } from '@/data/social'

import { Icon } from 'astro-pure/user'

interface Props {
  name: SocialIconName
  class?: string
}

const { name, class: className } = Astro.props
---

{
  name === 'linkedin' ? (
    <svg class={className} viewBox='0 0 24 24' aria-hidden='true'>
      <path
        fill='currentColor'
        d='M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z'
      />
    </svg>
  ) : name === 'xiaohongshu' ? (
    <svg class={className} viewBox='0 0 24 24' aria-hidden='true'>
      <rect x='2.5' y='2.5' width='19' height='19' rx='5' fill='currentColor' />
      <path
        fill='hsl(var(--background))'
        d='M7.2 8.25h4.05c2.04 0 3.32 1.07 3.32 2.74 0 1.24-.68 2.1-1.75 2.5l2.16 2.26h-2.48l-1.86-2h-1.3v2H7.2V8.25zm2.14 1.72v2.07h1.76c.81 0 1.31-.38 1.31-1.04 0-.67-.5-1.03-1.31-1.03H9.34z'
      />
      <circle cx='17.9' cy='8.4' r='1.05' fill='hsl(var(--background))' />
    </svg>
  ) : name === 'peerlist' ? (
    <svg class={className} viewBox='0 0 24 24' aria-hidden='true'>
      <path
        fill='currentColor'
        d='M12 0C2.667 0 0 2.667 0 12s2.673 12 12 12 12-2.667 12-12S21.327 0 12 0zm8.892 20.894c-1.57 1.569-4.247 2.249-8.892 2.249s-7.322-.68-8.892-2.25C1.735 19.522 1.041 17.3.89 13.654A39.74 39.74 0 0 1 .857 12c0-1.162.043-2.201.13-3.13.177-1.859.537-3.278 1.106-4.366.284-.544.62-1.006 1.013-1.398s.854-.729 1.398-1.013C5.592 1.524 7.01 1.164 8.87.988 9.799.9 10.838.858 12 .858c4.645 0 7.322.68 8.892 2.248 1.569 1.569 2.25 4.246 2.25 8.894s-.681 7.325-2.25 8.894zM12.462 4.214H6.786v15.572h4.522V17.08c4.104-.183 7.621-2.895 7.621-6.604 0-3.452-2.902-6.262-6.467-6.262zm0 8.976H10.45V7.762h2.012c1.531 0 2.801 1.2 2.801 2.714s-1.27 2.714-2.801 2.714z'
      />
    </svg>
  ) : (
    <Icon name={name} class={className} />
  )
}
