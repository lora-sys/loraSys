---
import { Image } from 'astro:assets'
import { certificates } from '@/data/certificates'
---

<section class='credentials-archive not-prose' aria-labelledby='credentials-title' data-credentials-archive>
  <header class='credentials-heading'>
    <div>
      <p class='eyebrow'>Credentials · 证书档案</p>
      <h2 id='credentials-title'>可查看的学习与活动凭证。</h2>
    </div>
    <p>每份资料保留原件，以便按需查阅。</p>
  </header>

  <div class='credentials-grid'>
    {
      certificates.map((certificate, index) => (
        <article class='credential-card' data-field-depth style={`--credential-delay:${index * 55}ms`}>
          <div class='credential-meta'>
            <span>{certificate.issuer}</span>
            <time datetime={certificate.issuedDate}>{certificate.issuedLabel}</time>
          </div>
          <button
            class='credential-preview'
            type='button'
            data-certificate-trigger={certificate.id}
            aria-haspopup='dialog'
            aria-controls={`certificate-${certificate.id}`}
            aria-label={`已归档，查看原件，${certificate.title}`}
          >
            <Image
              src={certificate.image}
              alt=''
              aria-hidden='true'
              class='credential-thumbnail'
              widths={[640, 960, 1280]}
              sizes='(min-width: 900px) 34rem, 100vw'
              loading='lazy'
              decoding='async'
            />
            <span class='credential-stamp' aria-hidden='true'>已归档</span>
            <span class='credential-view' aria-hidden='true'>查看原件 <b>↗</b></span>
          </button>
          <div class='credential-copy'>
            <p class='credential-program'>{certificate.program}</p>
            <h3>{certificate.title}</h3>
            <p>{certificate.description}</p>
          </div>

          <dialog id={`certificate-${certificate.id}`} class='certificate-dialog' aria-labelledby={`certificate-title-${certificate.id}`}>
            <div class='certificate-dialog__frame'>
              <header>
                <div>
                  <p class='eyebrow'>Credential record</p>
                  <h3 id={`certificate-title-${certificate.id}`}>{certificate.title}</h3>
                </div>
                <button type='button' class='certificate-close' data-certificate-close aria-label={`关闭 ${certificate.title}`}>×</button>
              </header>
              <div class='certificate-dialog__image'>
                <Image
                  src={certificate.image}
                  alt={certificate.alt}
                  widths={[960, 1440, 2048]}
                  sizes='(min-width: 900px) 76vw, 94vw'
                  loading='lazy'
                  decoding='async'
                />
              </div>
              <footer>
                <span>{certificate.program}</span>
                <time datetime={certificate.issuedDate}>{certificate.issuedLabel}</time>
              </footer>
            </div>
          </dialog>
        </article>
      ))
    }
  </div>
</section>

<script>
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)')
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)')

  document.querySelectorAll<HTMLButtonElement>('[data-certificate-trigger]').forEach((trigger) => {
    const id = trigger.dataset.certificateTrigger
    const dialog = id ? document.getElementById(`certificate-${id}`) as HTMLDialogElement | null : null
    trigger.addEventListener('click', () => dialog?.showModal())
    dialog?.querySelector<HTMLButtonElement>('[data-certificate-close]')?.addEventListener('click', () => dialog.close())
    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close()
    })
  })

  document.querySelectorAll<HTMLElement>('[data-field-depth]').forEach((card) => {
    const resetDepth = () => {
      card.style.setProperty('--field-depth-x', '0px')
      card.style.setProperty('--field-depth-y', '0px')
    }
    card.addEventListener('pointermove', (event) => {
      if (reducedMotion.matches || !finePointer.matches) return
      const rect = card.getBoundingClientRect()
      const x = Math.max(-5, Math.min(5, ((event.clientX - rect.left) / rect.width - 0.5) * 10))
      const y = Math.max(-4, Math.min(4, ((event.clientY - rect.top) / rect.height - 0.5) * 8))
      card.style.setProperty('--field-depth-x', `${x.toFixed(2)}px`)
      card.style.setProperty('--field-depth-y', `${y.toFixed(2)}px`)
    })
    card.addEventListener('pointerleave', resetDepth)
  })
</script>

<style>
  .credentials-archive { margin-block: 1.4rem 3rem; }
  .credentials-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.15rem; }
  .credentials-heading > div { display: grid; gap: 0.42rem; }
  .credentials-heading .eyebrow, .certificate-dialog .eyebrow { margin: 0; color: hsl(var(--muted-foreground)); font-size: 0.65rem; font-weight: 650; letter-spacing: 0.13em; text-transform: uppercase; }
  .credentials-heading h2 { margin: 0; font-size: clamp(1.45rem, 3vw, 2.15rem); font-weight: 560; letter-spacing: -0.05em; line-height: 1.05; }
  .credentials-heading > p { max-width: 25ch; margin: 0; color: hsl(var(--muted-foreground)); font-size: 0.75rem; line-height: 1.55; text-align: end; }
  .credentials-grid { display: grid; gap: 1rem; }
  .credential-card { position: relative; overflow: hidden; border: 1px solid hsl(var(--border)); border-radius: 1rem; background: hsl(var(--card)); box-shadow: 0 22px 55px -48px hsl(var(--foreground) / 0.55); transform: translate3d(var(--field-depth-x, 0px), var(--field-depth-y, 0px), 0); transition: transform 220ms cubic-bezier(0.23, 1, 0.32, 1), border-color 220ms ease, box-shadow 220ms ease; }
  .credential-card::before { position: absolute; z-index: 1; inset: 0 auto auto 0; width: 0; height: 2px; background: hsl(173 60% 42%); content: ''; transition: width 280ms cubic-bezier(0.23, 1, 0.32, 1); }
  .credential-meta { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.75rem 0.85rem 0; color: hsl(var(--muted-foreground)); font-size: 0.66rem; font-weight: 620; letter-spacing: 0.04em; }
  .credential-meta time { font-variant-numeric: tabular-nums; }
  .credential-preview { position: relative; display: block; width: calc(100% - 1.5rem); margin: 0.72rem; overflow: hidden; border: 1px solid hsl(var(--border)); border-radius: 0.75rem; padding: 0; background: hsl(var(--muted)); text-align: start; cursor: zoom-in; }
  .credential-thumbnail { display: block; width: 100%; height: auto; aspect-ratio: 2048 / 1474; object-fit: cover; transition: transform 280ms cubic-bezier(0.23, 1, 0.32, 1), filter 220ms ease; }
  .credential-preview::after { position: absolute; inset: 0; content: ''; background: linear-gradient(180deg, transparent 48%, hsl(var(--foreground) / 0.58)); opacity: 0; transition: opacity 180ms ease; pointer-events: none; }
  .credential-stamp { position: absolute; z-index: 1; top: 0.65rem; right: 0.65rem; border: 1px solid hsl(var(--border) / 0.85); border-radius: 999px; padding: 0.25rem 0.46rem; background: hsl(var(--background) / 0.9); color: hsl(173 60% 31%); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .credential-view { position: absolute; z-index: 2; right: 0.8rem; bottom: 0.72rem; color: white; font-size: 0.72rem; font-weight: 650; opacity: 0; transform: translateY(0.3rem); transition: opacity 180ms ease, transform 180ms ease; }
  .credential-view b { display: inline-block; margin-left: 0.2rem; font-weight: 500; transition: transform 180ms ease; }
  .credential-copy { display: grid; gap: 0.38rem; padding: 0 1rem 1rem; }
  .credential-program { margin: 0; color: hsl(173 60% 35%); font-size: 0.68rem; font-weight: 660; letter-spacing: 0.04em; }
  .credential-copy h3 { margin: 0; font-size: 1rem; font-weight: 620; letter-spacing: -0.025em; }
  .credential-copy > p:last-child { max-width: 68ch; margin: 0; color: hsl(var(--muted-foreground)); font-size: 0.78rem; line-height: 1.6; }
  .credential-preview:focus-visible, .certificate-close:focus-visible { outline: 2px solid hsl(var(--ring)); outline-offset: 3px; }
  @media (hover: hover) and (pointer: fine) {
    .credential-card:hover { border-color: hsl(var(--foreground) / 0.3); box-shadow: 0 30px 70px -48px hsl(var(--foreground) / 0.72); }
    .credential-card:hover::before, .credential-card:focus-within::before { width: 100%; }
    .credential-card:hover .credential-thumbnail, .credential-card:focus-within .credential-thumbnail { transform: scale(1.018); filter: saturate(1.03); }
    .credential-card:hover .credential-preview::after, .credential-card:focus-within .credential-preview::after { opacity: 1; }
    .credential-card:hover .credential-view, .credential-card:focus-within .credential-view { opacity: 1; transform: translateY(0); }
    .credential-card:hover .credential-view b, .credential-card:focus-within .credential-view b { transform: translate(0.15rem, -0.1rem); }
  }
  .certificate-dialog { width: min(94vw, 72rem); max-height: min(92vh, 58rem); overflow: auto; border: 1px solid hsl(var(--border)); border-radius: 1rem; padding: 0; background: hsl(var(--background)); color: hsl(var(--foreground)); box-shadow: 0 34px 100px hsl(var(--foreground) / 0.3); }
  .certificate-dialog::backdrop { background: hsl(var(--foreground) / 0.62); backdrop-filter: blur(4px); }
  .certificate-dialog__frame { display: grid; gap: 0.85rem; padding: clamp(0.85rem, 2vw, 1.25rem); }
  .certificate-dialog header, .certificate-dialog footer { display: flex; align-items: start; justify-content: space-between; gap: 1rem; }
  .certificate-dialog h3 { margin: 0.35rem 0 0; font-size: clamp(1rem, 2vw, 1.4rem); letter-spacing: -0.035em; }
  .certificate-close { width: 2rem; height: 2rem; flex: none; border: 1px solid hsl(var(--border)); border-radius: 50%; background: transparent; color: inherit; font-size: 1.25rem; line-height: 1; cursor: pointer; transition: background 160ms ease, transform 160ms ease; }
  .certificate-close:hover { background: hsl(var(--muted)); transform: scale(0.96); }
  .certificate-dialog__image { overflow: hidden; border: 1px solid hsl(var(--border)); border-radius: 0.65rem; background: hsl(var(--muted)); }
  .certificate-dialog__image :global(img) { display: block; width: 100%; height: auto; }
  .certificate-dialog footer { color: hsl(var(--muted-foreground)); font-size: 0.7rem; line-height: 1.5; }
  .certificate-dialog footer span { max-width: 46ch; }
  @media (max-width: 600px) { .credentials-heading { align-items: start; flex-direction: column; } .credentials-heading > p { text-align: start; } .credential-meta { align-items: start; flex-direction: column; gap: 0.18rem; } .certificate-dialog footer { align-items: start; flex-direction: column; gap: 0.2rem; } }
  @media (prefers-reduced-motion: reduce) { .credential-card, .credential-card::before, .credential-thumbnail, .credential-preview::after, .credential-view, .credential-view b, .certificate-close { transition: none; } .credential-card, .credential-card:hover { transform: none; } .credential-card:hover .credential-thumbnail, .credential-card:focus-within .credential-thumbnail { transform: none; } }
</style>
