---
import { Font } from 'astro:assets'
import config from 'virtual:config'

import type { SiteMeta } from 'astro-pure/types'
import { socialLinks } from '@/data/social'
import { localeMeta, type SiteLocale } from '@/i18n/site'

type Props = SiteMeta & {
  noindex?: boolean
  locale?: SiteLocale
  alternatePath?: string
  articlePublishedAt?: string
  articleModifiedAt?: string
}

const {
  articleDate,
  articlePublishedAt,
  articleModifiedAt,
  description,
  noindex = false,
  ogImage,
  title,
  locale = 'zh-CN',
  alternatePath
} = Astro.props
const localeInfo = localeMeta(locale)
const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/')

const siteTitle = `${title} ${config.titleDelimiter} ${config.title}`
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const socialImageURL = new URL(ogImage ? ogImage : config.socialCard, Astro.url).href
const alternateURL = alternatePath ? new URL(alternatePath, Astro.site) : undefined
const socialProfiles = socialLinks
  .filter((link) => link.href.startsWith('http'))
  .map((link) => link.href)
const twitterCreator = socialLinks.find((link) => link.name === 'X')?.handle
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: config.title,
  url: canonicalURL.origin + baseUrl,
  description: config.description,
  publisher: { '@type': 'Person', name: config.author }
}
const webPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonicalURL.href,
  isPartOf: { '@type': 'WebSite', name: config.title, url: canonicalURL.origin + baseUrl },
  inLanguage: locale
}
const profileJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: config.author,
  url: canonicalURL.origin + baseUrl,
  jobTitle: config.description,
  description: config.description,
  sameAs: socialProfiles
}
---

<meta charset='utf-8' />
<meta
  content='width=device-width, initial-scale=1.0, shrink-to-fit=no, viewport-fit=cover'
  name='viewport'
/>
<meta content='IE=edge' http-equiv='X-UA-Compatible' />
<title>{siteTitle}</title>

{/* Icons / Favicon */}
<link rel='icon' type={config.favicon.type} href={config.favicon.href} />
<link rel='shortcut icon' type={config.favicon.type} href={config.favicon.href} />
<link rel='icon' type='image/png' sizes='32x32' href={`${baseUrl}favicon/favicon-32x32.png`} />
<link rel='icon' type='image/png' sizes='16x16' href={`${baseUrl}favicon/favicon-16x16.png`} />
<link rel='apple-touch-icon' sizes='180x180' href={`${baseUrl}favicon/apple-touch-icon.png`} />
<link rel='manifest' href={`${baseUrl}favicon/site.webmanifest`} />

{/* Font preloads */}
<Font cssVariable='--font-satoshi' preload={[{ subset: 'latin', style: 'normal' }]} />
<style>
  body {
    font-family: var(--font-satoshi);
  }
</style>

{/* Canonical URL */}
<link rel='canonical' href={canonicalURL} />
<link rel='alternate' hreflang={locale} href={canonicalURL} />
{alternateURL && <link rel='alternate' hreflang={locale === 'zh-CN' ? 'en-US' : 'zh-CN'} href={alternateURL} />}
<link rel='alternate' hreflang='x-default' href={new URL(import.meta.env.BASE_URL, Astro.site)} />

{/* Primary Meta Tags */}
<meta content={siteTitle} name='title' />
<meta content={description} name='description' />
<meta content={config.author} name='author' />
  <meta name='robots' content={noindex ? 'noindex, nofollow' : 'index, follow'} />
  <meta name='referrer' content='strict-origin-when-cross-origin' />

  {/* Theme Color */}
  <meta name='theme-color' media='(prefers-color-scheme: light)' content='#edf4f7' />
  <meta name='theme-color' media='(prefers-color-scheme: dark)' content='#11151b' />
  <meta name='color-scheme' content='light dark' />

{/* Open Graph / Facebook */}
<meta content={articleDate ? 'article' : 'website'} property='og:type' />
<meta content={title} property='og:title' />
<meta content={description} property='og:description' />
<meta content={canonicalURL} property='og:url' />
<meta content={config.title} property='og:site_name' />
<meta content={localeInfo.ogLocale} property='og:locale' />
<meta content='image/webp' property='og:image:type' />
<meta content={socialImageURL} property='og:image' />
  <meta content={`${config.title} — ${description}`} property='og:image:alt' />
  <meta content='1200' property='og:image:width' />

<meta content='630' property='og:image:height' />
{
  articleDate && (
    <>
      <meta content={config.author} property='article:author' />
      <meta content={articlePublishedAt ?? articleDate} property='article:published_time' />
      {articleModifiedAt && <meta content={articleModifiedAt} property='article:modified_time' />}
    </>
  )
}

{/* Twitter */}
<meta content='summary_large_image' property='twitter:card' />
<meta content={canonicalURL} property='twitter:url' />
<meta content={title} property='twitter:title' />
<meta content={description} property='twitter:description' />
<meta content={socialImageURL} property='twitter:image' />
  {twitterCreator && (
    <>
      <meta content={twitterCreator} property='twitter:creator' />
      <meta content={twitterCreator} property='twitter:site' />
    </>
  )}

  {/* Site, page, and person entities for search engines */}
  <script is:inline type='application/ld+json' set:html={JSON.stringify(websiteJsonLd)} />
  <script is:inline type='application/ld+json' set:html={JSON.stringify(webPageJsonLd)} />
  <script is:inline type='application/ld+json' set:html={JSON.stringify(profileJsonLd)} />

  {/* Sitemap */}

<link href={`${baseUrl}sitemap-index.xml`} rel='sitemap' />

{/* RSS auto-discovery */}
<link
  rel='alternate'
  type='application/rss+xml'
  title={config.title}
  href={new URL(`${baseUrl}rss.xml`, Astro.site)}
/>

<meta content={Astro.generator} name='generator' />
