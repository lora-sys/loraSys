---
import {
  contentKindLabels,
  contentSourceLabels,
  contentStatusLabels,
  seededInboxItems,
  socialMapping
} from '@/data/content-inbox'
---

<section class='inbox-shell' aria-labelledby='content-inbox-title'>
  <div class='inbox-heading'>
    <div>
      <p class='eyebrow'>Content operations / 内容收件箱</p>
      <h2 id='content-inbox-title'>把输入先变成候选，再决定它应该成为 Blog、Note 还是项目更新。</h2>
    </div>
    <span class='inbox-mode'>Local-first · no auto publish</span>
  </div>

  <div class='inbox-grid'>
    <form id='content-inbox-form' class='inbox-form'>
      <div class='field-row'>
        <label>
          <span>Source link</span>
          <input name='sourceUrl' type='url' placeholder='https://github.com/... or Notion URL' autocomplete='url' />
        </label>
        <label>
          <span>Source type</span>
          <select name='source'>
            {Object.entries(contentSourceLabels).map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </label>
      </div>
      <div class='field-row'>
        <label>
          <span>Publish shape</span>
          <select name='kind'>
            {Object.entries(contentKindLabels).map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </label>
        <label>
          <span>Project / track</span>
          <input name='project' type='text' placeholder='AgentArena · Horizon Startup Hackathon' />
        </label>
      </div>
      <label>
        <span>Paste a note or attach a local file</span>
        <textarea name='body' rows='6' placeholder='Paste Markdown, a social post draft, or a short project update…'></textarea>
      </label>
      <label class='file-field'>
        <span>Optional local file</span>
        <input name='file' type='file' accept='.md,.mdx,.txt,.markdown' />
      </label>
      <div class='inbox-actions'>
        <button type='submit'>Create candidate</button>
        <button type='button' class='secondary' id='inbox-clear'>Clear local drafts</button>
      </div>
      <p id='inbox-status' class='inbox-status' aria-live='polite'>Candidates stay in this browser until you download or clear them.</p>
      <p class='inbox-review-rule'><strong>Review gate:</strong> every candidate remains unpublished until a human assigns ownership, confirms the source boundary, and chooses a migration target.</p>
    </form>

    <aside class='inbox-guide' aria-label='Content routing guide'>
      <p class='eyebrow'>Routing rules</p>
      <h3>一条内容只保留一个主入口。</h3>
      <p>公开 URL 可以生成候选文件；Notion 页面先登记来源，等连接器可读后再提取；社媒内容不直接复制成文章，而是映射到合适的长文、随记或项目更新。</p>
      <dl>
        {socialMapping.map((item) => (
          <div>
            <dt>{item.source} → {contentKindLabels[item.target]}</dt>
            <dd>{item.reason}</dd>
          </div>
        ))}
      </dl>
    </aside>
  </div>

  <div class='inbox-list-heading'>
    <div>
      <p class='eyebrow'>Current candidates</p>
      <h3>候选不会自动进入 Blog 或线上页面。</h3>
    </div>
    <span id='inbox-count'>{seededInboxItems.length} seeded</span>
  </div>
  <div id='inbox-items' class='inbox-items'>
    {seededInboxItems.map((item) => (
      <article class='inbox-card' data-seeded-card>
        <div class='card-topline'>
          <span>{contentStatusLabels[item.status]}</span>
          <time datetime={item.createdAt}>{item.createdAt}</time>
        </div>
        <h3>{item.title}</h3>
        <p>{item.summary}</p>
        <footer>
          <span>{contentSourceLabels[item.source]} · {contentKindLabels[item.kind]} · {item.ownership}</span>
          {item.sourceUrl && <a href={item.sourceUrl} target='_blank' rel='noopener noreferrer'>Source ↗</a>}
        </footer>
      </article>
    ))}
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#content-inbox-form')
  const status = document.querySelector<HTMLElement>('#inbox-status')
  const items = document.querySelector<HTMLElement>('#inbox-items')
  const count = document.querySelector<HTMLElement>('#inbox-count')
  const clearButton = document.querySelector<HTMLButtonElement>('#inbox-clear')
  const storageKey = 'lora-content-inbox-drafts'

  const escapeHtml = (value: string) =>
    value.replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[character] ?? character)

  const readDrafts = () => {
    try {
      return JSON.parse(localStorage.getItem(storageKey) ?? '[]') as Array<Record<string, string>>
    } catch {
      return []
    }
  }

  const renderDrafts = () => {
    const drafts = readDrafts()
    drafts.forEach((draft) => {
      const card = document.createElement('article')
      card.className = 'inbox-card inbox-card--local'
      card.innerHTML = `<div class='card-topline'><span>Needs review · ${escapeHtml(draft.ownership ?? 'External')}</span><time>${escapeHtml(draft.createdAt)}</time></div><h3>${escapeHtml(draft.title)}</h3><p>${escapeHtml(draft.summary)}</p><p class='review-meta'>${escapeHtml(draft.reviewNote ?? 'Manual review required.')} → ${escapeHtml(draft.migrationTarget ?? 'content-inbox/review')}</p><footer><span>${escapeHtml(draft.sourceLabel)} · ${escapeHtml(draft.kind)}</span>${draft.sourceUrl ? `<a href='${escapeHtml(draft.sourceUrl)}' target='_blank' rel='noopener noreferrer'>Source ↗</a>` : ''}</footer>`
      items?.prepend(card)
    })
    if (count) count.textContent = `${drafts.length + document.querySelectorAll('[data-seeded-card]').length} total`
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    const data = new FormData(form)
    const sourceUrl = String(data.get('sourceUrl') ?? '').trim()
    const body = String(data.get('body') ?? '').trim()
    const file = data.get('file') as File | null
    const source = String(data.get('source') ?? 'public-url')
    const kind = String(data.get('kind') ?? 'note')
    const project = String(data.get('project') ?? '').trim()
    const ownership = source === 'notion' ? 'External' : 'lora-sys'
    const migrationTarget = kind === 'blog' ? 'src/content/blog' : kind === 'project-update' ? 'src/content/projects' : 'src/content/notes'
    const reviewNote = source === 'notion' ? '公开 Notion 只读导入候选；人工确认版权、归属和发布形态后再迁移。' : '待人工确认内容边界后迁移。'
    const fileBody = file && file.size ? await file.text() : ''
    const finalBody = body || fileBody
    const title = (project || (sourceUrl ? sourceUrl.split('/').filter(Boolean).pop() : '') || 'Untitled content candidate').trim()
    const summary = (finalBody || `Candidate from ${sourceUrl || 'local input'}`).replace(/\s+/g, ' ').slice(0, 220)
    const createdAt = new Date().toISOString().slice(0, 10)
    const draft = { title, sourceUrl, sourceLabel: source, kind, project, summary, createdAt, ownership, status: 'needs-review', reviewNote, migrationTarget }
    const drafts = readDrafts()
    drafts.unshift(draft)
    localStorage.setItem(storageKey, JSON.stringify(drafts.slice(0, 12)))

    const markdown = `---\ntitle: "${title.replace(/"/g, '\\"')}"\nsourceUrl: "${sourceUrl}"\nsourceType: "${source}"\ncontentType: "${kind}"\nstatus: "needs-review"\nownership: "${ownership}"\nproject: "${project}"\nmigrationTarget: "${migrationTarget}"\nreviewNote: "${reviewNote}"\ncreatedAt: "${createdAt}"\n---\n\n${finalBody || summary}\n`
    const download = document.createElement('a')
    download.href = URL.createObjectURL(new Blob([markdown], { type: 'text/markdown;charset=utf-8' }))
    download.download = `${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'content-candidate'}.md`
    download.click()
    URL.revokeObjectURL(download.href)
    form.reset()
    renderDrafts()
    if (status) status.textContent = 'Candidate created and downloaded. It is not published.'
  })

  clearButton?.addEventListener('click', () => {
    localStorage.removeItem(storageKey)
    document.querySelectorAll('.inbox-card--local').forEach((card) => card.remove())
    if (count) count.textContent = `${document.querySelectorAll('[data-seeded-card]').length} seeded`
    if (status) status.textContent = 'Local drafts cleared. Seeded candidates remain.'
  })

  renderDrafts()
</script>

<style>
  .inbox-shell { display: grid; gap: 2rem; margin-top: 1rem; }
  .inbox-heading, .inbox-list-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; border-bottom: 1px solid hsl(var(--border)); padding-bottom: 1rem; }
  .inbox-heading h2, .inbox-list-heading h3 { max-width: 42rem; margin: 0; font-size: clamp(1.45rem, 3vw, 2.2rem); line-height: 1.12; }
  .inbox-mode, #inbox-count { flex: none; color: hsl(var(--muted-foreground)); font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; }
  .eyebrow { margin: 0 0 .55rem; color: hsl(var(--muted-foreground)); font-size: .66rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .inbox-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(15rem, .75fr); gap: 1px; background: hsl(var(--border)); }
  .inbox-form, .inbox-guide { background: hsl(var(--background)); padding: clamp(1rem, 3vw, 2rem); }
  .inbox-form { display: grid; gap: 1rem; }
  .field-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
  label { display: grid; gap: .38rem; color: hsl(var(--muted-foreground)); font-size: .74rem; }
  input, textarea, select { width: 100%; border: 1px solid hsl(var(--border)); border-radius: .35rem; background: transparent; padding: .72rem .78rem; color: hsl(var(--foreground)); font: inherit; font-size: .86rem; }
  textarea { resize: vertical; line-height: 1.55; }
  input:focus-visible, textarea:focus-visible, select:focus-visible, button:focus-visible { outline: 2px solid hsl(var(--ring)); outline-offset: 3px; }
  .file-field input { padding: .55rem; }
  .inbox-actions { display: flex; flex-wrap: wrap; gap: .6rem; }
  .inbox-actions button { min-height: 2.5rem; border: 1px solid hsl(var(--foreground)); border-radius: 999px; background: hsl(var(--foreground)); padding: .55rem 1rem; color: hsl(var(--background)); cursor: pointer; font: inherit; font-size: .75rem; font-weight: 650; }
  .inbox-actions button.secondary { background: transparent; color: hsl(var(--foreground)); }
  .inbox-status, .inbox-review-rule, .review-meta { margin: 0; color: hsl(var(--muted-foreground)); font-size: .75rem; line-height: 1.55; }
  .inbox-review-rule { border-left: 2px solid hsl(var(--foreground)); padding-left: .75rem; }
  .review-meta { font-size: .72rem; }
  .inbox-guide h3 { margin: 0 0 .8rem; font-size: 1.2rem; }
  .inbox-guide > p:not(.eyebrow) { color: hsl(var(--muted-foreground)); font-size: .86rem; line-height: 1.65; }
  dl { display: grid; gap: .75rem; margin: 1.5rem 0 0; }
  dt { font-size: .78rem; font-weight: 700; }
  dd { margin: .2rem 0 0; color: hsl(var(--muted-foreground)); font-size: .76rem; line-height: 1.5; }
  .inbox-items { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: hsl(var(--border)); }
  .inbox-card { display: grid; gap: .65rem; min-width: 0; background: hsl(var(--background)); padding: 1.2rem; }
  .inbox-card--local { border-top: 2px solid hsl(var(--foreground)); }
  .card-topline, .inbox-card footer { display: flex; align-items: center; justify-content: space-between; gap: .75rem; color: hsl(var(--muted-foreground)); font-size: .7rem; }
  .card-topline span { color: hsl(var(--foreground)); font-weight: 700; }
  .inbox-card h3 { margin: 0; font-size: 1.05rem; }
  .inbox-card p { margin: 0; color: hsl(var(--muted-foreground)); font-size: .83rem; line-height: 1.6; }
  .inbox-card footer { align-items: end; }
  .inbox-card footer a { color: inherit; font-weight: 650; }
  @media (max-width: 720px) { .inbox-heading, .inbox-list-heading { align-items: flex-start; flex-direction: column; gap: .7rem; } .inbox-grid, .inbox-items { grid-template-columns: 1fr; } .field-row { grid-template-columns: 1fr; } }
</style>
