---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  image: ImageMetadata
  label: string
  caption: string
}

const { image, label, caption } = Astro.props
---

<aside class='article-field-note not-prose' aria-label={label}>
  <Image
    src={image}
    alt=''
    aria-hidden='true'
    class='field-asset'
    widths={[280, 420, 620]}
    sizes='(min-width: 1024px) 18rem, min(76vw, 26rem)'
    loading='lazy'
    decoding='async'
  />
  <div>
    <p>{label}</p>
    <span>{caption}</span>
  </div>
</aside>

<style>
  .article-field-note {
    display: grid;
    grid-template-columns: minmax(8rem, 13rem) minmax(0, 1fr);
    align-items: end;
    gap: 1rem;
    margin-block: 2.25rem;
    border-block: 1px solid hsl(var(--border));
    padding-block: 1rem;
  }

  .article-field-note :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.7rem;
  }

  .article-field-note div {
    display: grid;
    gap: 0.3rem;
    padding-bottom: 0.25rem;
  }

  .article-field-note p {
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.64rem;
    font-weight: 650;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .article-field-note span {
    max-width: 32rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.76rem;
    line-height: 1.55;
  }

  @media (max-width: 640px) {
    .article-field-note {
      grid-template-columns: minmax(0, 10rem) minmax(0, 1fr);
      gap: 0.75rem;
    }
  }
</style>
