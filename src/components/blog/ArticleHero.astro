---
import { Image } from 'astro:assets'
import type { InferEntrySchema } from 'astro:content'
import config from '@/site-config'
import { text } from '@/i18n/ui'
import FormattedDate from './LocalDate.astro'

interface Props {
  data: InferEntrySchema<'blog'>
  remarkPluginFrontmatter: Record<string, unknown>
}

const {
  data: { title, description, draft, heroImage, publishDate, updatedDate, tags, language },
  remarkPluginFrontmatter
} = Astro.props
const locale = language === 'en-US' ? 'en-US' : 'zh-CN'
const t = (zh: string, en: string) => text(locale, zh, en)
const dateTimeOptions: Intl.DateTimeFormatOptions = { day: 'numeric', month: 'short', year: 'numeric' }
const minutesRead = String(remarkPluginFrontmatter.minutesRead ?? '')
const readingMinutes = minutesRead.match(/\d+/)?.[0] ?? '1'
const category = tags?.[0] ?? t('文章', 'Article')
---

{heroImage && (
  <div class='article-hero-image'>
    <Image
      alt={heroImage.alt || title}
      class='cover-image'
      fetchpriority='high'
      loading='eager'
      decoding='async'
      {...heroImage}
    />
  </div>
)}

{draft ? <span class='article-draft'>{t('草稿', 'Draft')}</span> : null}

<header class='article-info'>
  <p class='article-kicker'>{category}</p>
  <h1>{title}</h1>
  <p class='article-deck'>{description}</p>

  <dl class='article-meta-grid'>
    <div>
      <dt>{t('作者', 'Author')}</dt>
      <dd>{config.author}</dd>
    </div>
    <div>
      <dt>{t('发布', 'Published')}</dt>
      <dd><FormattedDate {locale} class='article-meta-date' date={publishDate} dateTimeOptions={dateTimeOptions} /></dd>
    </div>
    <div>
      <dt>{t('阅读时长', 'Reading time')}</dt>
      <dd>{t(`约 ${readingMinutes} 分钟`, `${readingMinutes} min`)}</dd>
    </div>
    {updatedDate && (
      <div>
        <dt>{t('更新', 'Updated')}</dt>
        <dd><FormattedDate {locale} class='article-meta-date' date={updatedDate} dateTimeOptions={dateTimeOptions} /></dd>
      </div>
    )}
  </dl>

  {!!tags?.length && (
    <nav class='article-tags' aria-label={t('文章标签', 'Article tags')}>
      {tags.map((tag: string) => (
        <a data-pagefind-filter={t('标签', 'Tags')} href={`/tags/${tag}`}>#{tag}</a>
      ))}
    </nav>
  )}

  <div class='article-support'>
    <slot name='description' />
  </div>
</header>

<div class='article-header-rule' aria-hidden='true'></div>

<style>
  .article-info {
    width: min(100%, 48rem);
  }

  .article-kicker {
    margin: 0 0 0.95rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.11em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .article-info h1 {
    max-width: 19ch;
    margin: 0;
    color: hsl(var(--foreground));
    font-size: clamp(2.55rem, 6.7vw, 4.8rem);
    font-weight: 520;
    letter-spacing: -0.045em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .article-deck {
    max-width: 42rem;
    margin: 1.2rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: clamp(1.02rem, 0.97rem + 0.25vw, 1.16rem);
    line-height: 1.62;
    text-wrap: pretty;
  }

  .article-meta-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    width: 100%;
    margin: 1.75rem 0 0;
    border-block: 1px solid hsl(var(--border));
  }

  .article-meta-grid > div {
    min-width: 0;
    padding: 0.8rem 0.9rem 0.85rem 0;
  }

  .article-meta-grid > div + div {
    border-left: 1px solid hsl(var(--border));
    padding-left: 0.9rem;
  }

  .article-meta-grid dt {
    margin: 0 0 0.28rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.6rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .article-meta-grid dd {
    margin: 0;
    overflow-wrap: anywhere;
    color: hsl(var(--foreground));
    font-size: 0.77rem;
    font-weight: 530;
    line-height: 1.45;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.9rem;
    margin-top: 0.85rem;
    font-size: 0.67rem;
    line-height: 1.45;
  }

  .article-tags a {
    color: hsl(var(--muted-foreground));
    text-decoration: none;
  }

  .article-tags a:hover,
  .article-tags a:focus-visible {
    color: hsl(var(--foreground));
    text-decoration: underline;
    text-underline-offset: 0.22rem;
  }

  .article-support {
    margin-top: 0.45rem;
  }

  .article-header-rule {
    width: min(100%, 48rem);
    margin-top: 1.5rem;
    border-top: 1px solid hsl(var(--border));
  }

  .article-draft {
    display: inline-block;
    margin-bottom: 0.75rem;
    color: hsl(var(--field-clay));
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-hero-image {
    width: min(100%, 48rem);
    margin-bottom: 1.65rem;
  }

  .article-hero-image :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid hsl(var(--border));
    border-radius: 0.45rem;
    outline: 0;
    object-fit: contain;
    box-shadow: none;
  }

  @media (max-width: 720px) {
    .article-meta-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .article-meta-grid > div:nth-child(3) {
      border-left: 0;
      border-top: 1px solid hsl(var(--border));
      padding-left: 0;
    }

    .article-meta-grid > div:nth-child(4) {
      border-top: 1px solid hsl(var(--border));
    }

    .article-meta-grid > div:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      border-left: 0;
      padding-left: 0;
    }
  }

  @media (max-width: 520px) {
    .article-info h1 {
      font-size: clamp(2.35rem, 12vw, 3.35rem);
      line-height: 1.02;
    }

    .article-deck {
      font-size: 1rem;
      line-height: 1.58;
    }

    .article-meta-grid > div {
      padding-block: 0.72rem;
    }
  }
</style>
