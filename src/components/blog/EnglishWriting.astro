---
import { featuredPostIds } from '@/data/featured-posts'
import { withBasePath } from '@/i18n/site'

import { getBlogCollection } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import ArticleClassification from '@/components/blog/ArticleClassification.astro'
import WritingTaxonomy from '@/components/blog/WritingTaxonomy.astro'
import { articleLanguage, originalArticleId } from '@/utils/article-translations'
import { writingLabel, type WritingKind } from '@/utils/writing'

interface Props {
  activeKind?: WritingKind
  activeValue?: string
}
const { activeKind, activeValue } = Astro.props
const allPosts = await getBlogCollection()
const posts = allPosts
  .filter(
    (post) =>
      !activeKind ||
      (activeKind === 'type'
        ? post.data.contentType === activeValue
        : activeKind === 'topic'
          ? post.data.topics.some((topic) => topic === activeValue)
          : post.data.series === activeValue)
  )
  .sort((left, right) => right.data.publishDate.valueOf() - left.data.publishDate.valueOf())
const languageOf = articleLanguage
const englishCount = posts.filter((post) => languageOf(post) === 'en-US').length
const chineseCount = posts.filter((post) => languageOf(post) === 'zh-CN').length
const featuredPost = !activeKind
  ? (featuredPostIds
      .map((id) =>
        posts.find((post) => originalArticleId(post) === id && languageOf(post) === 'en-US')
      )
      .find((post) => post !== undefined) ??
    posts.find((post) => languageOf(post) === 'en-US') ??
    posts[0])
  : undefined
const featuredEditions = featuredPost
  ? posts
      .filter((post) => originalArticleId(post) === originalArticleId(featuredPost))
      .sort(
        (left, right) =>
          Number(languageOf(right) === 'en-US') - Number(languageOf(left) === 'en-US')
      )
  : []
const selectedPosts = featuredPostIds
  .map((id) =>
    allPosts.find((post) => originalArticleId(post) === id && languageOf(post) === 'en-US')
  )
  .filter((post) => post !== undefined)
const curatedPosts =
  !activeKind && featuredPost
    ? selectedPosts.filter((post) => originalArticleId(post) !== originalArticleId(featuredPost))
    : []
const browsePath =
  activeKind && activeValue ? `/en/writing/${activeKind}/${activeValue}` : '/en/writing'
const publicationRows = posts.filter((post) => !featuredEditions.includes(post))
const longformRows = publicationRows.filter((post) => post.data.contentType !== 'news')
const newsRows = publicationRows.filter((post) => post.data.contentType === 'news')
const mainRows = longformRows.length > 0 ? longformRows : publicationRows
const secondaryNewsRows = longformRows.length > 0 ? newsRows : []
const mainEnglishCount = mainRows.filter((post) => languageOf(post) === 'en-US').length
const newsEnglishCount = secondaryNewsRows.filter((post) => languageOf(post) === 'en-US').length
---

<PageLayout
  lang='en-US'
  data-pagefind-ignore={activeKind ? 'all' : undefined}
  meta={{
    title: activeKind && activeValue ? writingLabel(activeKind, activeValue, 'en-US') : 'Writing',
    description:
      'Published notes on agent systems, tools, and building in public, in Chinese and English.'
  }}
  highlightColor='#d99a33'
>
  <main class:list={['writing-page', { 'writing-page--filtered': Boolean(activeKind) }]}>
    <header>
      <p>Writing</p>
      <h1>
        {
          activeKind && activeValue
            ? writingLabel(activeKind, activeValue, 'en-US')
            : 'Notes on systems I am building, checking, and learning from.'
        }
      </h1>
      {
        activeKind ? (
          <span data-writing-header-count>
            {englishCount} {englishCount === 1 ? 'article' : 'articles'}
          </span>
        ) : (
          <span>
            Browse {englishCount} English articles and {chineseCount} Chinese articles. English
            translations link back to their original versions.
          </span>
        )
      }
    </header>
    <WritingTaxonomy locale='en-US' {activeKind} {activeValue} />
    <div class='filter'>
      <label for='language-filter'>Filter articles by language</label>
      <select id='language-filter' name='language' data-writing-language disabled>
        <option value='all'>All articles ({posts.length})</option>
        <option value='en-US' selected>English ({englishCount})</option>
        <option value='zh-CN'>Chinese ({chineseCount})</option>
      </select>
      <span id='article-count' aria-live='polite'>{englishCount} articles across all sections</span>
    </div>
    <noscript>
      <p>
        <a
          href={withBasePath(
            `${activeKind && activeValue ? `/blog/${activeKind}/${activeValue}` : '/blog'}/language/en-US`
          )}>Browse English articles without JavaScript</a
        >
      </p>
    </noscript>
    {
      featuredEditions.map((featuredPost) => (
        <section
          class='featured'
          aria-labelledby={`featured-title-${featuredPost.id}`}
          hidden={languageOf(featuredPost) !== 'en-US'}
          data-original-id={originalArticleId(featuredPost)}
          data-article
          data-content-type={featuredPost.data.contentType}
          data-series={featuredPost.data.series}
          data-language={languageOf(featuredPost)}
        >
          <div class='featured-label'>
            <>
              <span>Featured note</span>
              <span class='language-badge'>
                {languageOf(featuredPost) === 'en-US' ? 'English' : 'Chinese'}
              </span>
              <time datetime={featuredPost.data.publishDate.toISOString()}>
                {featuredPost.data.publishDate.toLocaleDateString('en-US', {
                  month: 'long',
                  day: 'numeric',
                  year: 'numeric'
                })}
              </time>
            </>
          </div>
          <ArticleClassification data={featuredPost.data} locale='en-US' compact />
          <h2 id={`featured-title-${featuredPost.id}`}>
            <a lang={languageOf(featuredPost)} href={withBasePath(`/blog/${featuredPost.id}`)}>
              {featuredPost.data.title}
            </a>
          </h2>
          <p lang={languageOf(featuredPost)}>{featuredPost.data.description}</p>
          <a class='read' href={withBasePath(`/blog/${featuredPost.id}`)}>
            Read this note <span aria-hidden='true'>↗</span>
          </a>
        </section>
      ))
    }
    {
      curatedPosts.length >= 3 && (
        <section class='curated' aria-labelledby='curated-title' data-curated-navigation>
          <header class='section-heading'>
            <div>
              <p class='section-kicker'>A starting point</p>
              <h2 id='curated-title'>Selected writing</h2>
            </div>
            <span>{curatedPosts.length} notes from the collection</span>
          </header>
          <ol class='curated-grid'>
            {curatedPosts.map((post, index) => (
              <li>
                <a
                  class='curated-card'
                  lang={languageOf(post)}
                  href={withBasePath(`/blog/${post.id}`)}
                  data-language={languageOf(post)}
                >
                  <span class='curated-number'>{String(index + 1).padStart(2, '0')}</span>
                  <span class='curated-title'>{post.data.title}</span>
                  <span class='curated-description'>{post.data.description}</span>
                  <span class='curated-read'>
                    Read this note <span aria-hidden='true'>↗</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }
    {
      posts.length > 0 && (
        <div class='publication-layout'>
          {mainRows.length > 0 && (
            <section
              class='publication-list publication-list--main'
              aria-labelledby='publication-title'
            >
              <header class='section-heading'>
                <div>
                  <p class='section-kicker'>
                    {longformRows.length > 0 ? 'Ideas to revisit' : 'Filtered collection'}
                  </p>
                  <h2 id='publication-title'>
                    {activeKind && activeValue
                      ? writingLabel(activeKind, activeValue, 'en-US')
                      : 'Long reads and practical guides'}
                  </h2>
                </div>
                <div class='section-counts'>
                  <span data-section-count='main'>
                    {mainEnglishCount} {mainEnglishCount === 1 ? 'article' : 'articles'}
                  </span>
                </div>
              </header>
              <ol class='article-grid' data-section-list='main'>
                {mainRows.map((post) => (
                  <li
                    class='article-card'
                    hidden={languageOf(post) !== 'en-US'}
                    data-original-id={originalArticleId(post)}
                    data-article
                    data-content-type={post.data.contentType}
                    data-series={post.data.series}
                    data-language={languageOf(post)}
                  >
                    <time datetime={post.data.publishDate.toISOString()}>
                      {post.data.publishDate.toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                        year: 'numeric'
                      })}
                    </time>
                    <div class='article-card-copy'>
                      <h3>
                        <a lang={languageOf(post)} href={withBasePath(`/blog/${post.id}`)}>
                          {post.data.title}
                        </a>
                      </h3>
                      <p lang={languageOf(post)}>{post.data.description}</p>
                      <ArticleClassification data={post.data} locale='en-US' />
                      <span class='language-badge'>
                        {languageOf(post) === 'en-US' ? 'English' : 'Chinese'}
                      </span>
                    </div>
                  </li>
                ))}
              </ol>
              <p class='section-empty' data-section-empty='main' hidden>
                {longformRows.length > 0
                  ? 'No long-form articles match this language.'
                  : 'No articles match this language.'}
              </p>
            </section>
          )}
          {secondaryNewsRows.length > 0 && (
            <section class='publication-list publication-list--news' aria-labelledby='news-title'>
              <header class='section-heading'>
                <div>
                  <p class='section-kicker'>Reading list</p>
                  <h2 id='news-title'>News notes</h2>
                </div>
                <span data-section-count='news'>
                  {newsEnglishCount} {newsEnglishCount === 1 ? 'note' : 'notes'}
                </span>
              </header>
              <ol class='news-list' data-section-list='news'>
                {secondaryNewsRows.map((post) => (
                  <li
                    hidden={languageOf(post) !== 'en-US'}
                    data-original-id={originalArticleId(post)}
                    data-article
                    data-content-type={post.data.contentType}
                    data-series={post.data.series}
                    data-language={languageOf(post)}
                  >
                    <time datetime={post.data.publishDate.toISOString()}>
                      {post.data.publishDate.toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                        year: 'numeric'
                      })}
                    </time>
                    <div>
                      <h3>
                        <a lang={languageOf(post)} href={withBasePath(`/blog/${post.id}`)}>
                          {post.data.title}
                        </a>
                      </h3>
                      <ArticleClassification data={post.data} locale='en-US' compact />
                    </div>
                    <span class='language-badge'>
                      {languageOf(post) === 'en-US' ? 'English' : 'Chinese'}
                    </span>
                  </li>
                ))}
              </ol>
              <p class='section-empty' data-section-empty='news' hidden>
                No news notes match this language.
              </p>
            </section>
          )}
        </div>
      )
    }
    {
      posts.length === 0 && (
        <p class='empty'>
          {activeKind ? 'No articles match this collection yet.' : 'No articles are published yet.'}
        </p>
      )
    }
    <p class='empty' id='filter-empty' hidden>
      No articles match this language.
      <a href={withBasePath(`${browsePath}?language=all`)}>Show all languages</a>
      <a href={withBasePath('/en/writing')}>Clear all filters</a>
    </p>
  </main>
</PageLayout>

<script>
  const languageFilter = document.querySelector<HTMLSelectElement>('#language-filter')
  const articles = [...document.querySelectorAll<HTMLElement>('[data-article]')]
  const articleCount = document.querySelector<HTMLElement>('#article-count')
  const headerCount = document.querySelector<HTMLElement>('[data-writing-header-count]')
  const filterEmpty = document.querySelector<HTMLElement>('#filter-empty')
  const curatedNavigation = document.querySelector<HTMLElement>('[data-curated-navigation]')
  const curatedCards = [
    ...(curatedNavigation?.querySelectorAll<HTMLElement>('[data-language]') ?? [])
  ]
  const sectionLists = [...document.querySelectorAll<HTMLOListElement>('[data-section-list]')]
  const sectionEmpties = [...document.querySelectorAll<HTMLElement>('[data-section-empty]')]
  const newsCount = document.querySelector<HTMLElement>('[data-section-count="news"]')
  const mainCount = document.querySelector<HTMLElement>('[data-section-count="main"]')

  const applyLanguage = () => {
    const requested = new URL(location.href).searchParams.get('language') ?? 'en-US'
    const language = ['all', 'en-US', 'zh-CN'].includes(requested) ? requested : 'en-US'
    if (languageFilter) languageFilter.value = language
    for (const link of document.querySelectorAll<HTMLAnchorElement>('.writing-taxonomy a')) {
      const destination = new URL(link.href)
      destination.searchParams.set('language', language)
      link.href = destination.href
    }
    let visibleCount = 0
    for (const article of articles) {
      const visible = language === 'all' || article.dataset.language === language
      article.hidden = !visible
      if (visible) visibleCount += 1
    }
    if (articleCount)
      articleCount.textContent = `${visibleCount} ${visibleCount === 1 ? 'article' : 'articles'} across all sections`
    if (headerCount)
      headerCount.textContent = `${visibleCount} ${visibleCount === 1 ? 'article' : 'articles'}`
    if (filterEmpty) filterEmpty.hidden = visibleCount !== 0
    for (const card of curatedCards) {
      card.hidden = language !== 'all' && card.dataset.language !== language
    }
    if (curatedNavigation) curatedNavigation.hidden = curatedCards.every((card) => card.hidden)
    for (const list of sectionLists) {
      const rows = [...list.querySelectorAll<HTMLElement>('[data-article]')]
      const count = rows.filter((article) => !article.hidden).length
      list.hidden = count === 0
      const empty = sectionEmpties.find(
        (item) => item.dataset.sectionEmpty === list.dataset.sectionList
      )
      if (empty) empty.hidden = count !== 0
      if (list.dataset.sectionList === 'main' && mainCount)
        mainCount.textContent = `${count} ${count === 1 ? 'article' : 'articles'}`
      if (list.dataset.sectionList === 'news' && newsCount)
        newsCount.textContent = `${count} ${count === 1 ? 'note' : 'notes'}`
    }
  }
  languageFilter?.addEventListener('change', () => {
    const url = new URL(location.href)
    url.searchParams.set('language', languageFilter.value)
    history.pushState(null, '', url)
    applyLanguage()
  })
  window.addEventListener('popstate', applyLanguage)
  applyLanguage()
  // Do not accept a change before the URL state and change listener are ready.
  if (languageFilter) languageFilter.disabled = false
</script>

<style>
  :global(#main-content:has(> .writing-page)) {
    max-width: 72rem;
  }

  .writing-page {
    display: grid;
    gap: 1.6rem;
  }
  .writing-page--filtered {
    gap: 0.85rem;
  }
  .writing-page.writing-page--filtered > header {
    gap: 0.4rem;
    padding-block: 0.25rem 0.85rem;
  }
  .writing-page--filtered h1 {
    max-width: none;
    font-size: clamp(1.6rem, 4vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.035em;
  }
  .empty a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-inline: 0.4rem;
    color: hsl(var(--foreground));
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .writing-page [hidden] {
    display: none !important;
  }
  .writing-page > header {
    display: grid;
    gap: 0.75rem;
    border-bottom: 1px solid hsl(var(--border));
    padding-block: clamp(1rem, 4vw, 3rem);
  }
  .writing-page > header > p {
    margin: 0;
    color: hsl(var(--field-amber));
    font-size: 0.67rem;
    font-weight: 680;
    letter-spacing: 0.13em;
  }
  h1 {
    max-width: 17ch;
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    font-weight: 580;
    letter-spacing: -0.068em;
    line-height: 0.93;
  }
  .writing-page > header > span {
    max-width: 60ch;
    color: hsl(var(--muted-foreground));
    font-size: 0.88rem;
    line-height: 1.7;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    border-bottom: 1px solid hsl(var(--border));
    padding-bottom: 1rem;
  }
  nav a {
    min-height: 2.5rem;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    padding: 0.65rem 0.8rem;
    color: hsl(var(--foreground));
    font-size: 0.7rem;
    text-decoration: none;
  }
  nav a[aria-current] {
    border-color: hsl(var(--foreground));
    background: hsl(var(--foreground));
    color: hsl(var(--background));
  }
  .filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.875rem;
  }
  .filter select {
    min-height: 2.5rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.5rem;
    padding: 0.45rem 0.7rem;
    background: hsl(var(--background));
    color: hsl(var(--foreground));
    font: inherit;
  }
  nav a:focus-visible,
  .writing-page a:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 3px;
  }
  .featured {
    display: grid;
    max-width: 54rem;
    gap: 0.85rem;
    border-block: 1px solid hsl(var(--border));
    padding: clamp(1.2rem, 4vw, 2.2rem) 0;
  }
  .featured-label {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.68rem;
  }
  .featured-label span {
    color: hsl(var(--field-amber-strong));
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .featured-label .language-badge,
  .language-badge {
    width: fit-content;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    padding: 0.2rem 0.45rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.62rem;
    font-weight: 550;
    letter-spacing: normal;
    text-transform: none;
  }
  .featured h2 {
    max-width: 22ch;
    margin: 0;
    font-size: clamp(1.65rem, 4vw, 2.6rem);
    font-weight: 570;
    letter-spacing: -0.045em;
    line-height: 1.13;
  }
  .featured h2 a,
  .read {
    color: hsl(var(--foreground));
    text-decoration: none;
  }
  .featured > p {
    max-width: 62ch;
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.9rem;
    line-height: 1.7;
  }
  .read {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 640;
  }
  .curated,
  .publication-list {
    min-width: 0;
  }
  .section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid hsl(var(--border));
    padding-block: 1rem;
  }
  .section-heading > div {
    display: grid;
    gap: 0.25rem;
  }
  .section-kicker {
    margin: 0;
    color: hsl(var(--field-amber-strong));
    font-size: 0.62rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    font-weight: 580;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
  .section-heading > span {
    flex: 0 0 auto;
    color: hsl(var(--muted-foreground));
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
  }
  .section-counts {
    display: grid;
    flex: 0 0 auto;
    justify-items: end;
    gap: 0.2rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
  }
  .curated-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
    margin: 0;
    padding: 1rem 0 0;
    list-style: none;
  }
  .curated-card {
    display: grid;
    min-height: 12rem;
    align-content: start;
    gap: 0.65rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.85rem;
    padding: 1rem;
    color: hsl(var(--foreground));
    text-decoration: none;
    transition:
      transform 160ms ease,
      opacity 160ms ease;
  }
  .curated-card:hover {
    transform: translateY(-2px);
  }
  .curated-card:active {
    transform: scale(0.99);
    opacity: 0.84;
  }
  .curated-number {
    color: hsl(var(--field-amber-strong));
    font-size: 0.67rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }
  .curated-title {
    font-size: clamp(1rem, 1.5vw, 1.22rem);
    font-weight: 590;
    letter-spacing: -0.025em;
    line-height: 1.3;
  }
  .curated-description {
    color: hsl(var(--muted-foreground));
    font-size: 0.84rem;
    line-height: 1.6;
  }
  .curated-read {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: auto;
    color: hsl(var(--foreground));
    font-size: 0.76rem;
    font-weight: 640;
  }
  .publication-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.56fr);
    align-items: start;
    gap: clamp(1.25rem, 4vw, 3.25rem);
  }
  .publication-layout:not(:has(.publication-list--news)) {
    grid-template-columns: 1fr;
  }
  .article-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .article-card {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    min-width: 0;
    border-bottom: 1px solid hsl(var(--border));
    padding: 1.15rem 0.15rem 1.25rem;
  }
  .article-card time,
  .news-list time {
    color: hsl(var(--muted-foreground));
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
  }
  .article-card-copy {
    min-width: 0;
  }
  .article-card h3,
  .news-list h3 {
    margin: 0;
    font-size: clamp(1rem, 1.35vw, 1.25rem);
    font-weight: 570;
    line-height: 1.35;
  }
  .article-card h3 a,
  .news-list h3 a {
    color: hsl(var(--foreground));
    text-decoration: none;
  }
  .article-card p {
    margin: 0.5rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.88rem;
    line-height: 1.65;
  }
  .article-card .language-badge {
    display: inline-block;
    margin-top: 0.65rem;
  }
  .news-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .news-list li {
    display: grid;
