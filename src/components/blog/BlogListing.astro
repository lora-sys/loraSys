---
import type { Page } from 'astro'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import projectSnapshot from '@/data/github-projects.json'
import { fieldNotes } from '@/data/notes'

import { Paginator } from 'astro-pure/components/pages'
import { Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import CollectionPageJsonLd from '@/components/seo/CollectionPageJsonLd.astro'
import readingMarker from '@/assets/lora-visual/v2/lora-v2-reading-marker.webp'

import BlogPostCard from './BlogPostCard.astro'
import FeaturedWriting from './FeaturedWriting.astro'

interface Props {
  page: Page<CollectionEntry<'blog'>>
  uniqueTags: string[]
  collectionsCount: number
  featuredPosts: CollectionEntry<'blog'>[]
  activeLanguage?: 'zh-CN' | 'en-US'
}

const { page, uniqueTags, collectionsCount, featuredPosts, activeLanguage } = Astro.props
const curation: Record<string, { theme: string; whyRead: string }> = {
  'agent-budget-memory-evaluation': {
    theme: 'Agent Systems',
    whyRead: '比较连续修改与独立尝试，按相同预算设计评测，并检查最终结果能否通过验收。'
  },
  'tau-agent-architecture': {
    theme: 'Agent Systems',
    whyRead: '分清模型适配、Agent 核心与应用层，检查工具和界面之间的依赖。'
  },
  'tau-agent-loop-events': {
    theme: 'Agent Systems',
    whyRead: '用 Python 示例观察工具调用、错误和结束事件，区分界面更新与会话记录。'
  },
  'ai-engineering-harness': {
    theme: 'Agent Systems',
    whyRead: '看一套 Agent 工程如何从“能跑”走到可验证、可审查、可持续迭代。'
  },
  'free-vision-skill': {
    theme: 'Multimodal Tools',
    whyRead: '理解文本型 Agent 如何用更小的上下文成本获得足够可靠的视觉证据。'
  },
  'eve-agent': {
    theme: 'Agent Systems',
    whyRead: '用 filesystem-first 的视角，拆解一个可落地 Agent 框架的架构与生产边界。'
  },
  wishlive: {
    theme: 'Building in Public',
    whyRead: '从一次多智能体运行时构建，看产品原型、事件流和链上结算如何真正接起来。'
  }
}
const featuredForView = (page.currentPage === 1 ? featuredPosts : [])
  .filter((post) => !activeLanguage || post.data.language === activeLanguage)
  .slice(0, 1)
  .map((post) => ({
    post,
    ...(curation[post.id] ?? { theme: 'Build Notes', whyRead: '一篇来自公开构建过程的技术记录。' })
  }))
const languageTitle =
  activeLanguage === 'zh-CN' ? '中文文章' : activeLanguage === 'en-US' ? '英文文章' : '全部文章'
const meta = {
  description: activeLanguage
    ? `${languageTitle}，记录智能体、工程与产品构建。`
    : '关于智能体、工程、开源与产品构建的文章。',
  title: activeLanguage ? languageTitle : '写作'
}
const paginationProps = {
  ...(page.url.prev && { prevUrl: { text: '上一页', url: page.url.prev } }),
  ...(page.url.next && { nextUrl: { text: '下一页', url: page.url.next } })
}
const languageFilters = [
  { title: '全部', href: '/blog', active: !activeLanguage },
  {
    title: '中文',
    href: '/blog/language/zh-CN',
    active: activeLanguage === 'zh-CN',
    lang: 'zh-CN'
  },
  {
    title: '英文',
    href: '/blog/language/en-US',
    active: activeLanguage === 'en-US',
    lang: 'en-US'
  }
]
---

<PageLayout {meta} lang='zh-CN'>
  <Fragment slot='head'>
    <CollectionPageJsonLd name={meta.title} description={meta.description} inLanguage='zh-CN' />
  </Fragment>
  <main class='blog-shell mt-6 lg:mt-10'>
    <header id='content-header' class='animate editorial-header'>
      <Image
        src={readingMarker}
        alt=''
        aria-hidden='true'
        class='reading-marker'
        widths={[720, 1152, 1536]}
        sizes='(min-width: 1024px) 34rem, 72vw'
        loading='lazy'
        fetchpriority='low'
      />
      <div>
        <p class='eyebrow'>写作</p>
        <h1>把正在构建的东西，写成可复查的笔记。</h1>
        <p class='intro'>记录智能体系统、多模态工具和公开构建中的长期思考与证据。</p>
      </div>
      <span class='edition' aria-label={`当前显示 ${collectionsCount} 篇文章`}>
        {String(collectionsCount).padStart(2, '0')}<small> 篇文章</small>
      </span>
    </header>

    <nav class='language-filter animate' aria-label='按文章语言筛选'>
      {
        languageFilters.map(({ title, href, active, lang }) => (
          <a
            class='tactile-action'
            href={href}
            lang={lang}
            aria-current={active ? 'page' : undefined}
          >
            {title}
          </a>
        ))
      }
    </nav>

    <details class='writing-routes animate'>
      <summary><span>更多阅读路径</span><span aria-hidden='true'>+</span></summary>
      <nav aria-label='更多阅读方式'>
        <a class='tactile-action' href='/en/writing' hreflang='en-US'>英文原文 ↗</a>
        <a class='tactile-action' href='/notes'>短笔记 ↗</a>
        <a class='tactile-action' href='/archives'>完整归档 ↗</a>
      </nav>
    </details>

    {
      featuredForView.length > 0 && (
        <section class='featured-writing animate' aria-labelledby='featured-writing-title'>
          <header class='featured-heading'>
            <div>
              <>
                <p class='eyebrow'>编辑精选</p>
                <h2 id='featured-writing-title'>先读这一篇</h2>
              </>
            </div>
            <p>从一篇有完整背景和证据的构建记录开始。</p>
          </header>
          <div class='featured-grid'>
            {featuredForView.map(({ post, theme, whyRead }) => (
              <FeaturedWriting {post} {theme} {whyRead} />
            ))}
          </div>
        </section>
      )
    }

    {
      page.data.length === 0 ? (
        <p class='empty-state'>该语言暂时没有文章。</p>
      ) : (
        <section class='all-notes animate' aria-labelledby='all-notes-title'>
          <header class='all-notes-heading'>
            <h2 id='all-notes-title'>按发布时间浏览</h2>
            <small>
              第 {page.currentPage} 页 · {page.data.length} / {collectionsCount}
            </small>
          </header>
          <div class='all-notes-body'>
            <div class='content-grid'>
              <section aria-label={`${languageTitle} 文章列表`} id='content'>
                <div class='list-heading'>
                  <span>从最近发布开始</span>
                  <a href='/archives' data-astro-prefetch>
                    完整归档 →
                  </a>
                </div>
                <ul class='post-list'>
                  {page.data
                    .filter(
                      (post) =>
                        !featuredForView.some(
                          ({ post: featuredPost }) => featuredPost.id === post.id
                        )
                    )
                    .map((post) => (
                      <BlogPostCard {post} />
                    ))}
                </ul>
                <Paginator {...paginationProps} />
              </section>

              {!!uniqueTags.length && (
                <aside class='tag-index' aria-labelledby='tag-index-title'>
                  <h2 id='tag-index-title'>
                    <Icon name='tag-2' /> 归档主题
                  </h2>
                  <ul>
                    {uniqueTags.slice(0, 50).map((tag) => (
                      <li>
                        <a href={`/tags/${tag}`}>{tag}</a>
                      </li>
                    ))}
                  </ul>
                  <a class='all-tags' href='/tags' data-astro-prefetch>
                    全部主题 →
                  </a>
                </aside>
              )}
            </div>
          </div>
        </section>
      )
    }

    <footer class='writing-stats'>
      <span>{collectionsCount} 篇长文</span>
      <span>{fieldNotes.length} 篇短笔记</span>
      <span>{Object.keys(projectSnapshot.projects).length} 个公开仓库</span>
    </footer>
  </main>
</PageLayout>

<style>
  .editorial-header {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 1rem 2rem;
    border-bottom: 1px solid hsl(var(--border));
  }

  .reading-marker {
    position: absolute;
    z-index: -1;
    right: -1.5rem;
    bottom: -1.2rem;
    width: min(42%, 31rem);
    height: auto;
    opacity: 0.2;
    transform: rotate(-1.5deg);
    pointer-events: none;
  }

  .eyebrow {
    margin: 0 0 0.55rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.4rem, 7vw, 5.2rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.92;
  }

  .intro {
    max-width: 42rem;
    margin: 1.15rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .edition {
    display: flex;
    align-items: baseline;
    color: hsl(var(--foreground));
    font-size: clamp(2rem, 5vw, 3.8rem);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.06em;
  }

  .edition small {
    margin-left: 0.35rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .featured-writing {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(3.5rem, 8vw, 6rem);
  }

  .featured-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .featured-heading .eyebrow {
    margin-bottom: 0.35rem;
  }

  .featured-heading h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3.5vw, 2.45rem);
    font-weight: 570;
    letter-spacing: -0.05em;
  }

  .featured-heading > p {
    max-width: 28rem;
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.72rem;
    line-height: 1.55;
    text-align: right;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    max-width: 55rem;
    gap: 1rem;
  }

  .writing-routes,
  .all-notes {
    border-top: 1px solid hsl(var(--border));
  }
  .writing-routes {
    margin-top: 0.75rem;
  }
  .writing-routes summary,
  .all-notes-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid hsl(var(--border));
    padding-block: 1rem;
  }
  .all-notes-heading h2 {
    margin: 0;
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    font-weight: 560;
    letter-spacing: -0.035em;
  }
  .writing-routes summary::-webkit-details-marker {
    display: none;
  }
  .writing-routes summary {
    padding-block: 0.65rem;
  }
  .writing-routes summary > span:last-child {
    color: hsl(var(--foreground));
    font-size: 1rem;
    transition: transform 160ms ease;
  }
  .writing-routes[open] summary > span:last-child {
    transform: rotate(45deg);
  }
  .writing-routes nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding: 0 0 0.75rem;
  }
  .writing-routes a {
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    padding: 0.4rem 0.62rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.67rem;
    text-decoration: none;
    transition:
      background 160ms ease,
      color 160ms ease;
  }
  .writing-routes a:hover,
  .writing-routes a:focus-visible {
    background: hsl(var(--muted));
    color: hsl(var(--foreground));
  }
  .all-notes {
    margin-top: clamp(3.5rem, 8vw, 6rem);
  }
  .all-notes-body {
    padding-block: 0.65rem 0.2rem;
  }
  .language-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 1.25rem 2.8rem;
  }

  .language-filter a {
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    padding: 0.42rem 0.85rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.74rem;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      background 160ms ease;
  }

  .language-filter a:hover,
  .language-filter a:focus-visible,
  .language-filter a[aria-current='page'] {
    border-color: hsl(var(--foreground));
    background: hsl(var(--foreground));
    color: hsl(var(--background));
  }

  .language-filter a:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 3px;
  }

  .content-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(9rem, 13rem);
    gap: clamp(2rem, 6vw, 5rem);
  }

  .list-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.8rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.72rem;
  }

  .list-heading a,
  .all-tags {
    color: hsl(var(--foreground));
    text-decoration: none;
  }

  .list-heading a:hover,
  .all-tags:hover {
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .post-list {
    margin: 0;
    padding: 0;
  }

  .tag-index {
    position: sticky;
    top: 7rem;
    align-self: start;
  }

  .tag-index h2 {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 1rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .tag-index h2 :global(svg) {
    width: 1rem;
  }

  .tag-index ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-index li a {
    display: inline-flex;
    min-height: 1.75rem;
    align-items: center;
    padding-inline: 0.28rem;
    border-bottom: 1px solid transparent;
    color: hsl(var(--muted-foreground));
    font-size: 0.7rem;
    text-decoration: none;
  }

  .tag-index li a:hover,
  .tag-index li a:focus-visible {
    border-color: currentColor;
    color: hsl(var(--foreground));
  }

  .all-tags {
    display: inline-block;
    margin-top: 1.2rem;
    font-size: 0.72rem;
  }

  .empty-state {
    border-top: 1px solid hsl(var(--border));
    padding-block: 2rem;
    color: hsl(var(--muted-foreground));
  }

  @media (max-width: 720px) {
    .reading-marker {
      display: none;
    }
    .featured-heading {
      align-items: start;
      flex-direction: column;
    }
    .featured-heading > p {
      text-align: left;
    }
    .featured-grid {
      grid-template-columns: 1fr;
    }

    .editorial-header {
      align-items: start;
      flex-direction: column;
      gap: 0.65rem;
    }

    .edition {
      font-size: 1.5rem;
      flex-shrink: 0;
      white-space: nowrap;
    }

    .edition small {
      margin-left: 0.25rem;
      letter-spacing: 0.04em;
    }

    .content-grid {
      grid-template-columns: 1fr;
    }

    .tag-index {
      position: static;
      order: -1;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid hsl(var(--border));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .language-filter a,
    .writing-routes a,
    .writing-routes summary > span:last-child {
      transition: none;
    }
    .reading-marker {
      transform: none;
    }
  }

  .writing-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.2rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid hsl(var(--border));
    color: hsl(var(--muted-foreground));
    font-size: 0.7rem;
    font-weight: 630;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
