---
import type {Page} from 'astro'
import type {CollectionEntry} from 'astro:content'
import WritingPage from '@/components/studio/WritingPage.astro'
interface Props {page:Page<CollectionEntry<'blog'>>;uniqueTags:string[];collectionsCount:number;featuredPosts:CollectionEntry<'blog'>[];activeLanguage?:'zh-CN'|'en-US'}
const {page,collectionsCount,activeLanguage}=Astro.props
---
<WritingPage locale='zh-CN' posts={page.data} total={collectionsCount} prev={page.url.prev} next={page.url.next} {activeLanguage}/>
