---
import type { Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { Image } from 'astro:assets'
import { Paginator } from 'astro-pure/components/pages'
import { Button, Icon } from 'astro-pure/user'
import readingMarker from '@/assets/field-notes/reading-marker.webp'
import PageLayout from '@/layouts/BaseLayout.astro'
import CollectionPageJsonLd from '@/components/seo/CollectionPageJsonLd.astro'

import BlogPostCard from './BlogPostCard.astro'
import FeaturedWriting from './FeaturedWriting.astro'

interface Props {
  page: Page<CollectionEntry<'blog'>>
  uniqueTags: string[]
  collectionsCount: number
  featuredPosts: CollectionEntry<'blog'>[]
  activeLanguage?: 'zh-CN' | 'en-US'
}

const { page, uniqueTags, collectionsCount, featuredPosts, activeLanguage } = Astro.props
const curation: Record<string, { theme: string; whyRead: string }> = {
  'ai-engineering-harness': {
    theme: 'Agent Systems',
    whyRead: '看一套 Agent 工程如何从“能跑”走到可验证、可审查、可持续迭代。'
  },
  'free-vision-skill': {
    theme: 'Multimodal Tools',
    whyRead: '理解文本型 Agent 如何用更小的上下文成本获得足够可靠的视觉证据。'
  },
  'eve-agent': {
    theme: 'Agent Systems',
    whyRead: '用 filesystem-first 的视角，拆解一个可落地 Agent 框架的架构与生产边界。'
  },
  wishlive: {
    theme: 'Building in Public',
    whyRead: '从一次多智能体运行时构建，看产品原型、事件流和链上结算如何真正接起来。'
  }
}
const featuredForView = featuredPosts
  .filter((post) => !activeLanguage || post.data.language === activeLanguage)
  .map((post) => ({ post, ...(curation[post.id] ?? { theme: 'Build Notes', whyRead: '一篇来自公开构建过程的技术记录。' }) }))
const languageTitle =
  activeLanguage === 'zh-CN'
    ? '中文文章'
    : activeLanguage === 'en-US'
      ? 'English writing'
      : 'All writing'
const meta = {
  description: activeLanguage
    ? `${languageTitle} from Lora on agents, engineering and products.`
    : 'Writing from Lora on AI agents, engineering, open source and products.',
  title: activeLanguage ? `Blog · ${languageTitle}` : 'Blog'
}
const paginationProps = {
  ...(page.url.prev && { prevUrl: { text: '← Previous Posts', url: page.url.prev } }),
  ...(page.url.next && { nextUrl: { text: 'Next Posts →', url: page.url.next } })
}
const languageFilters = [
  { title: 'All', href: '/blog', active: !activeLanguage },
  {
    title: '中文',
    href: '/blog/language/zh-CN',
    active: activeLanguage === 'zh-CN',
    lang: 'zh-CN'
  },
  {
    title: 'English',
    href: '/blog/language/en-US',
    active: activeLanguage === 'en-US',
    lang: 'en-US'
  }
]
---

<PageLayout {meta} lang={activeLanguage}>
  <Fragment slot='head'>
    <CollectionPageJsonLd
      name={meta.title}
      description={meta.description}
      inLanguage={activeLanguage ?? 'zh-CN'}
    />
  </Fragment>
  <Button title='Back' href='/' variant='back' />
  <main class='blog-shell mt-6 lg:mt-10'>
    <header id='content-header' class='animate editorial-header'>
      <Image src={readingMarker} alt='' aria-hidden='true' class='reading-marker' widths={[720, 1152, 1536]} sizes='(min-width: 1024px) 34rem, 72vw' loading='lazy' />
      <div>
        <p class='eyebrow'>Writing / 写作</p>
        <h1>把正在构建的东西，写成可复查的笔记。</h1>
        <p class='intro'>这里不是资讯流，而是关于 Agent Systems、多模态工具与公开构建的长期思考记录。</p>
      </div>
      <span class='edition' aria-label={`${collectionsCount} posts in this view`}>
        {String(collectionsCount).padStart(2, '0')}<small> posts</small>
      </span>
    </header>

    <nav class='language-filter animate' aria-label='Filter posts by language'>
      {
        languageFilters.map(({ title, href, active, lang }) => (
          <a class='tactile-action' href={href} lang={lang} aria-current={active ? 'page' : undefined}>
            {title}
          </a>
        ))
      }
    </nav>

    <details class='writing-routes animate'>
      <summary><span>更多阅读路径</span><span aria-hidden='true'>+</span></summary>
      <nav aria-label='More writing destinations'>
        <a class='tactile-action' href='/en/writing' hreflang='en-US'>English originals ↗</a>
        <a class='tactile-action' href='/notes'>短笔记 Notes ↗</a>
        <a class='tactile-action' href='/archives'>完整归档 Archive ↗</a>
      </nav>
    </details>

    {
      featuredForView.length > 0 && (
        <section class='featured-writing animate' aria-labelledby='featured-writing-title'>
          <header class='featured-heading'>
            <div><p class='eyebrow'>Selected notes · 精选笔记</p><h2 id='featured-writing-title'>先从这几篇读起</h2></div>
            <p>三条主线：Agent Systems · Multimodal Tools · Building in Public</p>
          </header>
          <div class='featured-grid'>
            {featuredForView.map(({ post, theme, whyRead }) => <FeaturedWriting {post} {theme} {whyRead} />)}
          </div>
        </section>
      )
    }

    {
      page.data.length === 0 ? (
        <p class='empty-state'>No posts in this language yet.</p>
      ) : (
        <details class='all-notes animate'>
          <summary>
            <span>继续浏览全部文章</span>
            <small>第 {page.currentPage} 页 · {page.data.length} / {collectionsCount}</small>
          </summary>
          <div class='all-notes-body'>
            <div class='content-grid'>
              <section aria-label={`${languageTitle} post list`} id='content'>
                <div class='list-heading'>
                  <span>按时间浏览完整文章流</span>
                  <a href='/archives' data-astro-prefetch>完整归档 →</a>
                </div>
                <ul class='post-list'>
                  {page.data.map((post) => (
                    <BlogPostCard {post} />
                  ))}
                </ul>
                <Paginator {...paginationProps} />
              </section>

              {!!uniqueTags.length && (
                <aside class='tag-index' aria-labelledby='tag-index-title'>
                  <h2 id='tag-index-title'>
                    <Icon name='tag-2' /> Archive themes
                  </h2>
                  <ul>
                    {uniqueTags.slice(0, 50).map((tag) => (
                      <li>
                        <a href={`/tags/${tag}`}>{tag}</a>
                      </li>
                    ))}
                  </ul>
                  <a class='all-tags' href='/tags' data-astro-prefetch>
                    All topics →
                  </a>
                </aside>
              )}
            </div>
          </div>
        </details>
      )
    }
  </main>
</PageLayout>

<style>
  .editorial-header {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 1rem 2rem;
    border-bottom: 1px solid hsl(var(--border));
  }

  .reading-marker {
    position: absolute;
    z-index: -1;
    right: -1.5rem;
    bottom: -1.2rem;
    width: min(42%, 31rem);
    height: auto;
    opacity: 0.2;
    transform: rotate(-1.5deg);
    pointer-events: none;
  }

  .eyebrow {
    margin: 0 0 0.55rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.4rem, 7vw, 5.2rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.92;
  }

  .intro {
    max-width: 42rem;
    margin: 1.15rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .edition {
    display: flex;
    align-items: baseline;
    color: hsl(var(--foreground));
    font-size: clamp(2rem, 5vw, 3.8rem);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.06em;
  }

  .edition small {
    margin-left: 0.35rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .featured-writing {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(3.5rem, 8vw, 6rem);
  }

  .featured-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .featured-heading .eyebrow { margin-bottom: 0.35rem; }

  .featured-heading h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3.5vw, 2.45rem);
    font-weight: 570;
    letter-spacing: -0.05em;
  }

  .featured-heading > p {
    max-width: 28rem;
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.72rem;
    line-height: 1.55;
    text-align: right;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .writing-routes,
  .all-notes {
    border-block: 1px solid hsl(var(--border));
  }
  .writing-routes {
    margin-top: 0.75rem;
  }
  .writing-routes summary,
  .all-notes summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    list-style: none;
    color: hsl(var(--muted-foreground));
    font-size: 0.72rem;
    font-weight: 620;
  }
  .writing-routes summary::-webkit-details-marker,
  .all-notes summary::-webkit-details-marker { display: none; }
  .writing-routes summary { padding-block: 0.65rem; }
  .writing-routes summary > span:last-child {
    color: hsl(var(--foreground));
    font-size: 1rem;
    transition: transform 160ms ease;
  }
  .writing-routes[open] summary > span:last-child { transform: rotate(45deg); }
  .writing-routes nav { display: flex; flex-wrap: wrap; gap: 0.45rem; padding: 0 0 0.75rem; }
  .writing-routes a { border: 1px solid hsl(var(--border)); border-radius: 999px; padding: 0.4rem 0.62rem; color: hsl(var(--muted-foreground)); font-size: 0.67rem; text-decoration: none; transition: background 160ms ease,color 160ms ease; }
  .writing-routes a:hover,.writing-routes a:focus-visible{background:hsl(var(--muted));color:hsl(var(--foreground))}
  .all-notes { margin-top: clamp(3.5rem, 8vw, 6rem); }
  .all-notes summary { padding-block: 1rem; color: hsl(var(--foreground)); }
  .all-notes summary > span { font-size: clamp(1.1rem, 2vw, 1.35rem); letter-spacing: -0.025em; }
  .all-notes summary small { color: hsl(var(--muted-foreground)); font-size: 0.68rem; font-weight: 500; }
  .all-notes-body { padding-block: 0.65rem 0.2rem; }
  .language-filter{
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 1.25rem 2.8rem;
  }

  .language-filter a {
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    padding: 0.42rem 0.85rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.74rem;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      background 160ms ease;
  }

  .language-filter a:hover,
  .language-filter a:focus-visible,
  .language-filter a[aria-current='page'] {
    border-color: hsl(var(--foreground));
    background: hsl(var(--foreground));
    color: hsl(var(--background));
  }

  .language-filter a:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 3px;
  }

  .content-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(9rem, 13rem);
    gap: clamp(2rem, 6vw, 5rem);
  }

  .list-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.8rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.72rem;
  }

  .list-heading a,
  .all-tags {
    color: hsl(var(--foreground));
    text-decoration: none;
  }

  .list-heading a:hover,
  .all-tags:hover {
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .post-list {
    margin: 0;
    padding: 0;
  }

  .tag-index {
    position: sticky;
    top: 7rem;
    align-self: start;
  }

  .tag-index h2 {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 1rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .tag-index h2 :global(svg) {
    width: 1rem;
  }

  .tag-index ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-index li a {
    display: inline-flex;
    min-height: 1.75rem;
    align-items: center;
    padding-inline: 0.28rem;
    border-bottom: 1px solid transparent;
    color: hsl(var(--muted-foreground));
    font-size: 0.7rem;
    text-decoration: none;
  }

  .tag-index li a:hover,
  .tag-index li a:focus-visible {
    border-color: currentColor;
    color: hsl(var(--foreground));
  }

  .all-tags {
    display: inline-block;
    margin-top: 1.2rem;
    font-size: 0.72rem;
  }

  .empty-state {
    border-top: 1px solid hsl(var(--border));
    padding-block: 2rem;
    color: hsl(var(--muted-foreground));
  }

  @media (max-width: 720px) {
    .reading-marker { right: -0.5rem; width: 58%; opacity: 0.14; }
    .featured-heading { align-items: start; flex-direction: column; }
    .featured-heading > p { text-align: left; }
    .featured-grid { grid-template-columns: 1fr; }

    .editorial-header {
      align-items: start;
    }

    .edition {
      font-size: 1.5rem;
    }

    .edition small {
      display: none;
    }

    .content-grid {
      grid-template-columns: 1fr;
    }

    .tag-index {
      position: static;
      order: -1;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid hsl(var(--border));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .language-filter a,
    .writing-routes a,
    .writing-routes summary > span:last-child { transition: none; }
    .reading-marker { transform: none; }
  }
</style>
