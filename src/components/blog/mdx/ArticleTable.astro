---
const { class: className, ...props } = Astro.props
const isEnglish = Astro.url.pathname.split('/').includes('en')
const scrollHint = isEnglish ? 'Scroll horizontally to see all columns' : '横向滚动查看其余列'
const scrollLabel = isEnglish ? 'Scrollable data table' : '可横向滚动的数据表格'
---

<div
  class='mdx-table-shell not-prose'
  data-mdx-table
  data-scroll-label={scrollLabel}
  data-scroll-label-en='Scrollable data table'
  data-scroll-label-zh='可横向滚动的数据表格'
  data-scroll-hint-en='Scroll horizontally to see all columns'
  data-scroll-hint-zh='横向滚动查看其余列'
>
  <span class='mdx-table-scroll-hint' aria-hidden='true'>{scrollHint}</span>
  <table {...props} class:list={['mdx-table', className]}>
    <slot />
  </table>
</div>

<script>
  const setupMdxTables = () => {
    document.querySelectorAll<HTMLElement>('[data-mdx-table]').forEach((shell) => {
      if (shell.dataset.tableReady === 'true') return
      shell.dataset.tableReady = 'true'
      const isEnglish = document.documentElement.lang.toLowerCase().startsWith('en')
      const hint = shell.querySelector<HTMLElement>('.mdx-table-scroll-hint')
      if (hint) {
        hint.textContent = isEnglish
          ? shell.dataset.scrollHintEn ?? 'Scroll horizontally to see all columns'
          : shell.dataset.scrollHintZh ?? '横向滚动查看其余列'
      }
      shell.dataset.scrollLabel = isEnglish
        ? shell.dataset.scrollLabelEn ?? 'Scrollable data table'
        : shell.dataset.scrollLabelZh ?? '可横向滚动的数据表格'
      const updateOverflow = () => {
        const overflow = shell.scrollWidth > shell.clientWidth + 1
        if (overflow) {
          shell.tabIndex = 0
          shell.setAttribute('role', 'region')
          shell.setAttribute('aria-label', shell.dataset.scrollLabel ?? 'Scrollable data table')
        } else {
          shell.removeAttribute('tabindex')
          shell.removeAttribute('role')
          shell.removeAttribute('aria-label')
        }
        shell.toggleAttribute('data-overflow', overflow)
      }
      updateOverflow()
      if ('ResizeObserver' in window) new ResizeObserver(updateOverflow).observe(shell)
      window.addEventListener('resize', updateOverflow, { passive: true })
    })
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMdxTables, { once: true })
  } else {
    setupMdxTables()
  }
</script>

<style>
  .mdx-table-shell {
    position: relative;
    width: 100%;
    margin-block: 1.8rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    border: 1px solid hsl(var(--border));
    border-radius: 0.9rem;
    background: hsl(var(--card) / 0.5);
    box-shadow: inset 0 1px hsl(var(--foreground) / 0.03);
  }
  .mdx-table-shell[data-overflow] { scrollbar-gutter: stable; }
  .mdx-table-shell:focus-visible { outline: 2px solid hsl(var(--ring)); outline-offset: 3px; }
  .mdx-table-scroll-hint {
    display: none;
    padding: 0.4rem 0.7rem;
    border-bottom: 1px solid hsl(var(--border) / 0.8);
    color: hsl(var(--muted-foreground));
    font-size: 0.75rem;
    line-height: 1.45;
  }
  .mdx-table-shell[data-overflow] .mdx-table-scroll-hint { display: block; }
  .mdx-table {
    width: 100%;
    min-width: 36rem;
    border-collapse: collapse;
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.55;
  }
  .mdx-table :global(th),
  .mdx-table :global(td) {
    border: 0;
    border-bottom: 1px solid hsl(var(--border) / 0.8);
    padding: 0.72rem 0.78rem;
    text-align: left;
    vertical-align: top;
  }
  .mdx-table :global(th) {
    background: hsl(var(--muted) / 0.72);
    color: hsl(var(--foreground));
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.015em;
  }
  .mdx-table :global(caption) {
    padding: 0.65rem 0.78rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.75rem;
    line-height: 1.55;
    text-align: left;
    caption-side: bottom;
  }
  .mdx-table :global(tbody tr:last-child td) { border-bottom: 0; }
  .mdx-table :global(tbody tr:nth-child(even)) { background: hsl(var(--background) / 0.32); }
  .mdx-table :global(code) { white-space: nowrap; }
  @media (max-width: 640px) {
    .mdx-table { min-width: 32rem; font-size: 0.78rem; }
    .mdx-table :global(th),
    .mdx-table :global(td) { padding: 0.65rem 0.68rem; }
  }
</style>
