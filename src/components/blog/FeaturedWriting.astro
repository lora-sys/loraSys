---
import { displayLabel } from '@/i18n/ui'
import type { CollectionEntry } from 'astro:content'
import FormattedDate from './LocalDate.astro'
import { projects } from '@/data/projects'
import { getProjectsForStory } from '@/data/project-stories'

interface Props {
  post: CollectionEntry<'blog'>
  theme: string
  whyRead: string
}

const { post, theme, whyRead } = Astro.props
const postDate = post.data.updatedDate ?? post.data.publishDate
const relatedProjects = getProjectsForStory(`/blog/${post.id}`).flatMap((repository) => {
  const project = projects.find((item) => item.repository === repository)
  return project ? [project] : []
})
---

<article class='featured-writing'>
  <div class='featured-meta'>
    <span>{displayLabel(theme, 'zh-CN')}</span>
    <FormattedDate date={postDate} />
  </div>
  <h3 lang={post.data.language}><a href={`/blog/${post.id}`} data-astro-prefetch>{post.data.title}</a></h3>
  <p class='description' lang={post.data.language}>{post.data.description}</p>
  <p class='why-read'><b>阅读要点</b>{whyRead}</p>
  {
    relatedProjects.length > 0 && (
      <div class='related-context' aria-label='关联项目'>
        <span>关联项目</span>
        <div>
          {relatedProjects.map((project) => (
            <a href={`/projects#${project.repository}`} data-astro-prefetch>
              {project.title} <span aria-hidden='true'>↗</span>
            </a>
          ))}
        </div>
      </div>
    )
  }
  <a class='read-link' href={`/blog/${post.id}`} data-astro-prefetch>阅读文章 <span aria-hidden='true'>↗</span></a>
</article>

<style>
  .featured-writing {
    display: flex;
    min-width: 0;
    min-height: 18rem;
    flex-direction: column;
    gap: 0;
    margin: 0;
    border: 1px solid hsl(var(--border));
    border-radius: 0.9rem;
    padding: clamp(1.1rem, 2.6vw, 1.6rem);
    background: hsl(var(--card));
    transition: border-color 160ms ease;
  }

  .featured-writing:hover,
  .featured-writing:focus-within {
    border-color: hsl(var(--field-amber) / 0.65);
  }

  .featured-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .featured-meta > span {
    color: hsl(var(--foreground));
    font-weight: 600;
  }

  h3 {
    margin: 1rem 0 0;
    font-size: clamp(1.18rem, 2vw, 1.5rem);
    font-weight: 620;
    letter-spacing: -0.025em;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  h3 a,
  .read-link {
    color: hsl(var(--foreground));
    text-decoration: none;
  }

  h3 a:hover,
  .read-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  h3 a:focus-visible,
  .read-link:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 4px;
    border-radius: 2px;
  }

  .description,
  .why-read {
    color: hsl(var(--muted-foreground));
    font-size: 0.86rem;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }

  .description {
    margin: 0.7rem 0 1.3rem;
  }

  .why-read {
    margin: auto 0 0;
    border-top: 1px solid hsl(var(--border));
    padding-top: 0.85rem;
  }

  .why-read b {
    display: block;
    margin-bottom: 0.25rem;
    color: hsl(var(--foreground));
    font-size: 0.72rem;
    font-weight: 600;
  }

  .related-context {
    display: grid;
    gap: .4rem;
    margin-top: .85rem;
    border-top: 1px dashed hsl(var(--border));
    padding-top: .75rem;
  }

  .related-context > span {
    color: hsl(var(--muted-foreground));
    font-size: .66rem;
    font-weight: 650;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .related-context > div {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
  }

  .related-context a {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    border: 1px solid hsl(var(--field-teal) / .28);
    border-radius: 999px;
    padding: .3rem .55rem;
    background: hsl(var(--field-teal) / .07);
    color: hsl(var(--foreground));
    font-size: .68rem;
    font-weight: 620;
    text-decoration: none;
  }

  .related-context a:hover,
  .related-context a:focus-visible {
    border-color: hsl(var(--field-teal) / .62);
  }

  .read-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    align-self: flex-start;
    min-height: 2.75rem;
    margin-top: 0.55rem;
    font-size: 0.8rem;
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-writing { transition: none; }
  }
</style>
