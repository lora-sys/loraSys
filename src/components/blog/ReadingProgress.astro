---
import type { SiteLocale } from '@/i18n/site'
interface Props { locale: SiteLocale }
const { locale } = Astro.props
---

<div
  class='reading-progress'
  data-reading-progress
  role='progressbar'
  aria-label={locale === 'en-US' ? 'Reading progress' : '阅读进度'}
  aria-valuemin='0'
  aria-valuemax='100'
  aria-valuenow='0'
  hidden
>
  <span data-reading-progress-fill></span>
</div>

<script>
  const progress = document.querySelector<HTMLElement>('[data-reading-progress]')
  const fill = progress?.querySelector<HTMLElement>('[data-reading-progress-fill]')
  const content = document.getElementById('content')
  if (progress && fill && content) {
    let frame = 0
    let previous = -1
    const update = () => {
      frame = 0
      const rect = content.getBoundingClientRect()
      const headerBottom = document.querySelector('[data-site-header]')?.getBoundingClientRect().bottom ?? 0
      const readingTop = Math.max(0, headerBottom) + 16
      const range = Math.max(0, rect.height - (window.innerHeight - readingTop))
      const ratio = range > 0
        ? Math.max(0, Math.min(1, (readingTop - rect.top) / range))
        : rect.bottom <= window.innerHeight ? 1 : 0
      fill.style.transform = `scaleX(${ratio})`
      const percent = Math.round(ratio * 100)
      if (percent !== previous) {
        progress.setAttribute('aria-valuenow', String(percent))
        previous = percent
      }
      progress.hidden = false
    }
    const requestUpdate = () => { if (!frame) frame = requestAnimationFrame(update) }
    window.addEventListener('scroll', requestUpdate, { passive: true })
    window.addEventListener('resize', requestUpdate)
    window.addEventListener('pageshow', requestUpdate)
    // Code expansion, lazy media, and Mermaid can change article height after load.
    if ('ResizeObserver' in window) new ResizeObserver(requestUpdate).observe(content)
    content.addEventListener('load', requestUpdate, true)
    document.fonts?.ready.then(requestUpdate)
    update()
  }
</script>

<style>
  .reading-progress { position:fixed; inset:0 0 auto; z-index:80; height:3px; background:hsl(var(--border) / .35); pointer-events:none; }
  .reading-progress[hidden] { display:none; }
  .reading-progress span { display:block; width:100%; height:100%; background:hsl(var(--field-amber-strong)); transform:scaleX(0); transform-origin:left; }
  @media print { .reading-progress { display:none; } }
</style>
