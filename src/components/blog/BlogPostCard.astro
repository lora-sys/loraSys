---
import { render, type CollectionEntry } from 'astro:content'
import { withBasePath } from '@/i18n/site'

import { Icon } from 'astro-pure/user'

import ArticleClassification from './ArticleClassification.astro'
import LanguageBadge from './LanguageBadge.astro'
import FormattedDate from './LocalDate.astro'

interface Props {
  post: CollectionEntry<'blog'>
  variant?: 'grid' | 'list'
}

const { post, variant = 'list' } = Astro.props
const { data, id } = post
const { remarkPluginFrontmatter } = await render(post)
const postDate = data.publishDate
---

<li
  class:list={['post-card', { 'post-card--grid': variant === 'grid' }]}
  data-article
  data-content-type={data.contentType}
  data-series={data.series}
>
  <article>
    <div class='post-meta'>
      <FormattedDate date={postDate} />
      <span aria-hidden='true'>·</span>
      <span class='read-time'>
        <Icon name='time' class='size-4' />
        约 {String(remarkPluginFrontmatter.minutesRead).match(/\d+/)?.[0] ?? '1'} 分钟
      </span>
      <LanguageBadge language={data.language} compact />
    </div>

    <a
      class='post-link'
      lang={data.language}
      href={withBasePath(`/blog/${id}`)}
      data-astro-prefetch
    >
      <span>
        {data.draft && <span class='draft'>草稿 </span>}
        {data.title}
      </span>
      <svg aria-hidden='true' viewBox='0 0 24 24'>
        <path d='M5 12h14M13 6l6 6-6 6'></path>
      </svg>
    </a>

    <p lang={data.language}>{data.description}</p>

    <ArticleClassification {data} compact={variant === 'grid'} />
  </article>
</li>

<style>
  .post-card--grid article {
    height: 100%;
    border: 1px solid hsl(var(--border));
    border-radius: 0.65rem;
    padding: 1.15rem;
    background: hsl(var(--card) / 0.5);
  }
  .post-card--grid article::before {
    display: none;
  }
  .post-card--grid .post-link {
    font-size: 1.2rem;
    font-weight: 620;
    line-height: 1.45;
  }
  .post-card--grid .post-meta {
    font-size: 0.8125rem;
  }
  .post-card--grid article:active {
    transform: translateY(0) scale(0.99);
  }
  .post-card {
    list-style: none;
  }

  article {
    position: relative;
    overflow: hidden;
    border-top: 1px solid hsl(var(--border));
    padding: 1.35rem 0.2rem 1.6rem;
    transition: transform 220ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  article::before {
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left;
    height: 1px;
    background: hsl(var(--foreground));
    content: '';
    transition: transform 180ms ease;
  }

  article:focus-within::before,
  article:hover::before {
    transform: scaleX(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .post-card--grid article:hover {
      transform: translateY(-3px);
    }
    article:hover {
      background: linear-gradient(90deg, hsl(var(--muted) / 0.48), transparent 72%);
      transform: translateX(0.2rem);
    }
  }

  article:focus-within {
    background: linear-gradient(90deg, hsl(var(--muted) / 0.45), transparent 72%);
  }

  .post-meta,
  .read-time {
    display: flex;
    align-items: center;
  }

  .post-meta {
    min-height: 1.65rem;
    flex-wrap: wrap;
    gap: 0.45rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.72rem;
  }

  .read-time {
    gap: 0.25rem;
  }

  .post-link {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.7rem;
    color: hsl(var(--foreground));
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    font-weight: 500;
    line-height: 1.35;
    text-decoration: none;
  }

  .post-link svg {
    width: 1.15rem;
    flex: none;
    margin-top: 0.2rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
    transform: translateX(-0.35rem);
    opacity: 0;
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .post-link:focus-visible {
    border-radius: 0.2rem;
    outline: 2px solid hsl(var(--ring));
    outline-offset: 4px;
  }

  article:focus-within .post-link svg,
  article:hover .post-link svg {
    transform: translateX(0);
    opacity: 1;
  }

  .draft {
    color: hsl(var(--destructive));
  }

  article > p {
    max-width: 66ch;
    margin: 0.55rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.7rem;
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tag-list a {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    padding-inline: 0.2rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.7rem;
    text-decoration: none;
  }

  .tag-list a:hover,
  .tag-list a:focus-visible {
    color: hsl(var(--foreground));
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card--grid article:is(:hover, :active) {
      transform: none;
    }
    article:hover {
      transform: none;
    }
    article,
    article::before,
    .post-link svg {
      transition: none;
    }
  }
  @media (hover: none) {
    .post-link svg {
      opacity: 0.7;
      transform: none;
    }
  }
</style>
