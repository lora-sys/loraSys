---
import type { SiteLocale } from '@/i18n/site'
import { withBasePath } from '@/i18n/site'

import { writingGroups, writingLabel, writingPath, type WritingKind } from '@/utils/writing'

interface Props {
  locale?: SiteLocale
  activeKind?: WritingKind
  activeValue?: string
  activeLanguage?: string
}
const { locale = 'zh-CN', activeKind, activeValue, activeLanguage } = Astro.props
const en = locale === 'en-US'
const suffix = !en && activeLanguage ? `/language/${activeLanguage}` : ''
const home = en ? '/en/writing' : `/blog${suffix}`
const activeLabel =
  activeKind && activeValue
    ? writingLabel(activeKind, activeValue, locale)
    : en
      ? 'All articles'
      : '全部文章'
const groupLabels = {
  type: en ? 'Article types' : '内容类型',
  topic: en ? 'Topics' : '主题',
  series: en ? 'Series' : '系列'
}
---

<div class='writing-taxonomy' data-writing-taxonomy>
  <details class='taxonomy-filter'>
    <summary>
      <span class='filter-label'>{en ? 'Filter articles' : '筛选文章'}</span>
      <span class='active-selection' data-writing-selection>{activeLabel}</span>
      <span class='disclosure-mark' aria-hidden='true'>⌄</span>
    </summary>
    <div class='taxonomy-groups'>
      {
        (['type', 'topic', 'series'] as const).map((kind) => (
          <nav
            class:list={['taxonomy-group', { 'type-filter': kind === 'type' }]}
            aria-label={groupLabels[kind]}
          >
            <span class='group-label'>{groupLabels[kind]}</span>
            {kind === 'type' && (
              <a href={withBasePath(home)} aria-current={!activeKind ? 'page' : undefined}>
                {en ? 'All articles' : '全部文章'}
              </a>
            )}
            {Object.keys(writingGroups[kind]).map((id) => (
              <a
                href={withBasePath(writingPath(kind, id, locale) + suffix)}
                aria-current={activeKind === kind && activeValue === id ? 'page' : undefined}
              >
                {writingLabel(kind, id, locale)}
              </a>
            ))}
          </nav>
        ))
      }
    </div>
  </details>
  {
    activeKind && (
      <a class='reset-filter' href={withBasePath(home)} data-writing-reset>
        {en ? 'Clear category' : '清除分类'}
      </a>
    )
  }
</div>

<style>
  .writing-taxonomy {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.5rem 1rem;
    margin-block: 1rem;
  }
  details {
    flex: 1 1 16rem;
    min-width: 0;
    border-block: 1px solid hsl(var(--border));
  }
  summary {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 2.75rem;
    padding-block: 0.5rem;
    list-style: none;
    font-size: 0.78rem;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .filter-label {
    flex: none;
    color: hsl(var(--muted-foreground));
  }
  .active-selection {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .disclosure-mark {
    margin-left: auto;
    font-size: 1.1rem;
  }
  details[open] .disclosure-mark {
    transform: rotate(180deg);
  }
  .taxonomy-groups {
    display: grid;
    gap: 0.85rem;
    padding-block: 0.35rem 1rem;
  }
  details:not([open]) > .taxonomy-groups { display:none; }
  .taxonomy-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .group-label {
    width: 100%;
    color: hsl(var(--muted-foreground));
    font-size: 0.7rem;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    padding: 0.4rem 0.75rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.76rem;
    text-decoration: none;
  }
  a:hover,
  a[aria-current] {
    border-color: hsl(var(--foreground));
    background: hsl(var(--foreground));
    color: hsl(var(--background));
  }
  a:focus-visible,
  summary:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 3px;
  }
  .reset-filter {
    flex: none;
    border-color: transparent;
    border-radius: 0.35rem;
    padding-inline: 0.25rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
