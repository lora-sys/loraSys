---
import { Image } from 'astro:assets'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { SiteLocale } from '@/i18n/site'
import WorkCard from './WorkCard.astro'
import { caseStudies, casePath, experiments, local, pick } from '@/data/studio/curation'
import { anime,localizeShowcase } from '@/data/showcase'
import hero from '@/assets/lora-visual/v2/lora-v2-hero-lora.webp'
import mochi from '@/assets/lora-visual/v2/lora-v2-hero-mochi.webp'
interface Props { locale: SiteLocale }
const {locale}=Astro.props
const en=locale==='en-US'
const t=(zh:string,english:string)=>local(locale,zh,english)
const all=sortMDByDate(await getBlogCollection())
const posts=all.filter(p=>en?p.data.language==='en-US':p.data.language!=='en-US').slice(0,3)
const interests=anime.slice(0,3).map(item=>localizeShowcase(item,en))
const date=(value:Date)=>new Intl.DateTimeFormat(locale,{month:'short',day:'numeric',timeZone:'UTC'}).format(value)
---
<BaseLayout lang={locale} meta={{title:t('Lora · 项目与构建笔记','Lora · Projects and build notes'),description:t('AI Agent、开发者工具与可检查的实验。查看 Lora 的项目案例、写作和学习记录。','AI agents, developer tools and inspectable experiments. Explore Lora’s projects, writing and learning notes.')}}>
 <main class='studio-page studio-home'>
  <section class='studio-hero' aria-labelledby='home-title'>
   <div class='hero-copy'><p class='eyebrow'>{t('Lora · 学生开发者 · 西安','Lora · Student developer · Xi’an')}</p><h1 id='home-title'>{t('做 AI Agent，','Building AI agents,')}<br/>{t('也做开发者工具。','and developer tools.')}</h1><p class='hero-subtitle'>{t('这里有我的项目、实验记录，以及构建中的取舍和失败。','Projects, experiments, and the decisions and failures behind the work.')}</p><div class='action-row'><a class='button primary' href='#work'>{t('看代表作品','Explore the work')} <span aria-hidden='true'>↘</span></a><a class='button' href={t('/blog','/en/writing')}>{t('读构建笔记','Read build notes')}</a></div><div class='hero-meta'><a data-resume-reading href={t('/resume','/en/resume')}>{t('阅读简历','Read résumé')}</a><a href='https://github.com/lora-sys' target='_blank' rel='me noopener noreferrer'>GitHub</a><a href={t('/contact','/en/contact')}>{t('联系我','Get in touch')}</a></div></div>
   <div class='studio-desk' aria-label={t('Lora 与 Mochi 的工作台插画','An illustration of Lora and Mochi at the workbench')}><Image src={hero} class='desk-lora' alt='' widths={[400,640,960]} sizes='(max-width:640px) 300px, 520px' loading='eager' fetchpriority='high' quality={80}/><Image src={mochi} class='desk-mochi' alt='' widths={[160,240]} sizes='(max-width:640px) 90px, 150px' loading='eager' quality={75}/><span class='desk-label'>{t('项目、记录与一点好奇心','Projects, notes and curiosity')}<br/><a href={t('/lab','/en/lab')}>{t('打开实验室','Open the lab')} ↗</a></span></div>
  </section>
  <section id='work' class='home-work' aria-labelledby='home-work-title'><header class='section-head'><div><p class='eyebrow'>{t('01 / 精选作品','01 / Selected work')}</p><h2 id='home-work-title'>{t('先从一个具体问题看起。','Start with a concrete problem.')}</h2></div><a class='text-link' href={t('/projects','/en/work')}>{t('全部项目','All projects')} ↗</a></header><div class='work-grid'>{caseStudies.slice(0,3).map((study,i)=><WorkCard {study} {locale} lead={i===0}/>)}</div></section>
  <section id='writing' class='studio-section split-section' aria-labelledby='home-writing-title'><div><header class='section-head'><div><p class='eyebrow'>{t('02 / 构建笔记','02 / Build notes')}</p><h2 id='home-writing-title'>{t('把过程写下来。','Keep a record of the work.')}</h2></div></header><ul class='quiet-list'>{posts.map(post=><li><div class='list-meta'><time datetime={post.data.publishDate.toISOString()}>{date(post.data.publishDate)}</time><span>{t('长文','Article')}</span></div><h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3><p>{post.data.description}</p></li>)}</ul><a class='text-link' href={t('/blog','/en/writing')}>{t('浏览写作','Browse writing')} ↗</a></div><aside id='now' class='notebook-aside'><p class='eyebrow'>{t('项目索引','Project index')}</p><h2>{t('最近关注的方向','Current areas of interest')}</h2><p>{t('Agent 工作区、证据选择与工程验收。每个方向都能进入对应项目，查看实现与限制。','Agent workspaces, source selection and engineering acceptance. Each area links to its implementation and limitations.')}</p><ul class='quiet-list'>{caseStudies.slice(0,3).map(study=><li><a href={casePath(study,locale)}>{study.title} ↗</a></li>)}</ul><a class='text-link' href={t('/now','/en/now')}>{t('查看构建记录','Read the now page')} ↗</a></aside></section>
  <section class='studio-section lab-teaser' aria-labelledby='home-lab-title'><div><p class='eyebrow'>{t('03 / 亲手试一次','03 / Try it yourself')}</p><h2 id='home-lab-title'>{pick(experiments[1].title,locale)}</h2><p>{t('同样四条输出，只改验收规则。为什么通过率会从 75% 变成 25%？','Keep four outputs fixed and change the acceptance rule. Why does the pass rate change from 75% to 25%?')}</p><a class='text-link' href={t('/lab/evaluation-rules','/en/lab/evaluation-rules')}>{t('打开评测实验','Open the evaluation experiment')} ↗</a></div><div class='experiment-mini' aria-label={t('固定教学样例的两种验收结果','Two acceptance results for fixed teaching fixtures')}><div><span>{t('只看输出完成','Completion only')}</span><strong>3 / 4</strong></div><div><span>{t('完成、工具与证据','Completion, tools & evidence')}</span><strong>1 / 4</strong></div><small class='muted'>{t('教学样例，不是模型性能结果。','Teaching fixtures, not model performance results.')}</small></div></section>
  <section id='personal-signals' class='studio-section'><header class='section-head'><div><p class='eyebrow'>{t('04 / 工作之外','04 / Away from the keyboard')}</p><h2>{t('也留一点空间给喜欢的东西。','A few things worth keeping.')}</h2></div><a class='text-link' href={t('/collections','/en/collections')}>{t('打开收藏架','Open the shelf')} ↗</a></header><div class='collection-strip'>{interests.map(item=><a href={item.href} target='_blank' rel='noopener noreferrer'><img src={item.image} alt='' width='53' height='74' loading='lazy'/><span><b>{item.name}</b><small>{t('动画收藏','Animation shelf')}</small></span></a>)}</div></section>
  <section id='contact' class='contact-strip'><div><h2>{t('聊一个具体问题。','Let’s talk about a specific problem.')}</h2><p>{t('项目反馈、开源协作，或一次技术交流。','Project feedback, open-source collaboration, or a technical conversation.')}</p></div><a class='button primary' href={t('/contact','/en/contact')}>{t('联系 Lora','Contact Lora')} ↗</a></section>
 </main>
</BaseLayout>
