---
import type {CollectionEntry} from 'astro:content'
import type {SiteLocale} from '@/i18n/site'
import BaseLayout from '@/layouts/BaseLayout.astro'
import {local} from '@/data/studio/curation'
interface Props {locale:SiteLocale;posts:CollectionEntry<'blog'>[];total:number;prev?:string;next?:string;activeLanguage?:'zh-CN'|'en-US'}
const {locale,posts,total,prev,next,activeLanguage}=Astro.props
const en=locale==='en-US'
const t=(zh:string,english:string)=>local(locale,zh,english)
---
<BaseLayout lang={locale} meta={{title:t('写作','Writing'),description:t('关于项目实现、Agent 工程和实验过程的文章与短笔记。','Articles and short notes on implementation, agent engineering and experiments.')}}>
 <main class='studio-page' data-studio-writing><header class='page-intro'><p class='eyebrow'>{t('写作 / 长文、短笔记与阅读','Writing / Articles, notes & reading')}</p><h1>{t('把选择、过程和结果写下来。','Write down the decisions, the process, and the results.')}</h1><p class='lede'>{t('文章列表直接展开。每篇保留原始语言与唯一地址，英文入口不会复制一份中文正文。','Browse the articles directly. Each keeps its original language and one permanent address. English routes do not duplicate Chinese articles.')}</p></header>
 <nav class='content-tabs' aria-label={t('内容类型','Content types')}><a aria-current='page' href={t('/blog','/en/writing')}>{t('长文','Articles')}</a><a href='/notes'>{t('短笔记','Notes in Chinese')}</a><a href={t('/reading','/en/reading')}>{t('阅读收藏','Reading')}</a><a href={t('/now','/en/now')}>{t('构建记录','Now')}</a></nav>
 <div class='section-head'><p class='muted'>{t(`共 ${total} 篇文章`,`${total} articles`)}</p><nav class='article-tags' aria-label={t('文章语言','Article language')}>{en?<a href='/blog'>All articles and Chinese originals</a>:<><a href='/blog' aria-current={!activeLanguage?'page':undefined}>全部</a><a href='/blog/language/zh-CN' aria-current={activeLanguage==='zh-CN'?'page':undefined}>中文原文</a><a href='/en/writing'>英文原文</a></>}</nav></div>
 <section id='content' aria-label={t('文章列表','Article list')}>{posts.map(post=><article class='writing-row' lang={post.data.language}><time datetime={post.data.publishDate.toISOString()}>{new Intl.DateTimeFormat(locale,{year:'numeric',month:'short',day:'numeric',timeZone:'UTC'}).format(post.data.publishDate)}</time><div><h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2><p>{post.data.description}</p><div class='article-tags'><span>{post.data.language==='en-US'?t('英文原文','English original'):t('中文原文','Chinese original')}</span>{post.data.tags.slice(0,4).map(tag=><a href={`/tags/${tag}`}>{tag}</a>)}</div></div><a class='row-open' href={`/blog/${post.id}`} aria-label={`${t('阅读','Read')} ${post.data.title}`}>↗</a></article>)}</section>
 {posts.length===0&&<p class='boundary-note'>{t('这个语言下还没有文章，可继续浏览全部原文。','There are no articles in this language yet. Browse the original-language archive instead.')}</p>}
 <nav class='action-row' aria-label={t('文章分页','Article pagination')}>{prev&&<a class='button' href={prev}>{t('上一页','Previous page')}</a>}{next&&<a class='button' href={next}>{t('下一页','Next page')}</a>}<a class='text-link' href='/archives'>{t('按年份归档','Archive by year')} ↗</a><a class='text-link' href='/rss.xml'>{t('订阅 RSS','Subscribe via RSS')} ↗</a></nav>
 </main>
</BaseLayout>
