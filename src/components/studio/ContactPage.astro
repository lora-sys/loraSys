---
import BaseLayout from '@/layouts/BaseLayout.astro'
import CopyAction from '@/components/layout/CopyAction.astro'
import type {SiteLocale} from '@/i18n/site'
import {local} from '@/data/studio/curation'
import {profile} from '@/data/profile'
interface Props {locale:SiteLocale}
const {locale}=Astro.props
const t=(zh:string,en:string)=>local(locale,zh,en)
const social=profile.social.filter(item=>['GitHub','LinkedIn','X'].includes(item[0]))
---
<BaseLayout lang={locale} meta={{title:t('联系','Contact'),description:t('通过邮件交流项目反馈、开源协作与职业机会。','Email for project feedback, open-source collaboration and professional opportunities.')}}>
 <main class='studio-page'><header class='page-intro'><p class='eyebrow'>{t('联系 / 先说具体问题','Contact / Start with a specific problem')}</p><h1>{t('你正在做什么？','What are you working on?')}</h1><p class='lede'>{t('项目反馈、开源协作或职业交流都可以。附上背景、已有链接和希望讨论的问题。','Project feedback, open-source collaboration or professional conversations are welcome. Include the context, relevant links and the question you want to discuss.')}</p></header><section><p class='eyebrow'>{t('邮件是主要入口','Email is the main channel')}</p><a class='contact-email' href={`mailto:${profile.email}`}>{profile.email}</a><div class='action-row'><a class='button primary' href={`mailto:${profile.email}`}>{t('写一封邮件','Write an email')} ↗</a><CopyAction value={profile.email} label={t('复制邮箱','Copy email')} {locale}/></div></section><section class='studio-section split-section'><div><h2>{t('项目问题','Project issues')}</h2><p class='lede'>{t('已有仓库的问题，请保留复现步骤、运行条件和相关日志，直接在对应仓库讨论。','For an existing repository, keep reproduction steps, the environment and relevant logs in the project’s issue tracker.')}</p><a class='text-link' href={t('/projects','/en/work')}>{t('找到对应项目','Find the project')} ↗</a></div><div><h2>{t('职业交流','Professional conversations')}</h2><p class='lede'>{t('网页简历便于手机阅读，PDF 原件仍在简历页按需提供。','The web résumé is readable on mobile. The original PDF remains available on the résumé page.')}</p><a class='text-link' data-resume-reading href={t('/resume','/en/resume')}>{t('阅读简历','Read résumé')} ↗</a></div></section><section class='studio-section'><h2>{t('其他入口','Other channels')}</h2><nav class='action-row' aria-label={t('社交平台','Social channels')}>{social.map(([name,href])=><a class='button' href={href} target='_blank' rel='me noopener noreferrer'>{name} ↗</a>)}<a class='button' href='/rss.xml' data-interaction='subscribe_feed'>{t('订阅 RSS','Subscribe via RSS')} ↗</a><a class='button' href={t('/links','/en/links')}>{t('友链','Links')} ↗</a></nav></section></main>
</BaseLayout>
