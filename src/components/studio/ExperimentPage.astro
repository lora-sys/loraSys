---
import BaseLayout from '@/layouts/BaseLayout.astro'
import type {SiteLocale} from '@/i18n/site'
import {experiments,caseStudies,casePath,pick,local} from '@/data/studio/curation'
import SourceExplorer from './SourceExplorer.astro'
import EvalExplorer from './EvalExplorer.astro'
interface Props {locale:SiteLocale;slug:string}
const {locale,slug}=Astro.props
const experiment=experiments.find(item=>item.slug===slug)
if(!experiment)throw new Error(`Unknown experiment: ${slug}`)
const t=(zh:string,en:string)=>local(locale,zh,en)
const study=caseStudies.find(item=>item.slug===experiment.related)!
const chineseTitle=experiment.kind==='sources'?['选择来源，','检查证据缺口']:['规则变了，','通过率也会变']
---
<BaseLayout lang={locale} meta={{title:pick(experiment.title,locale),description:pick(experiment.summary,locale)}}>
 <main class='studio-page' data-experiment-page={slug}><header class='page-intro'><p class='eyebrow'>{t('实验室 / 固定教学材料','Lab / Fixed teaching fixtures')}</p><h1>{locale==='zh-CN'?chineseTitle.map(part=><span class='title-phrase'>{part}</span>):pick(experiment.title,locale)}</h1><p class='lede'>{pick(experiment.summary,locale)}</p><div class='action-row'><a class='button' href={t('/lab','/en/lab')}>{t('返回实验室','Back to the lab')}</a><a class='button' href={casePath(study,locale)}>{t('关联项目','Related project')} · {study.title}</a></div></header>
 {experiment.kind==='sources'?<SourceExplorer {locale}/>:<EvalExplorer {locale}/>}
 <section class='studio-section case-section'><h2>{t('你可以检查什么','What to inspect')}</h2><div class='decision-list'>{(experiment.kind==='sources'?[
[t('取消来源 B','Uncheck source B'),t('第二个节点和同时需要 A、B 的第三个节点会失去完整依据。输出没有被重新生成。','The second node and the third node requiring A and B lose full support. No output is regenerated.')],
[t('取消全部来源','Uncheck every source'),t('所有节点保留可见，但都标记证据缺口。页面不会把没有依据的内容藏起来。','All nodes remain visible, with missing evidence marked. Unsupported content is not silently hidden.')],
[t('恢复默认选择','Restore the default selection'),t('重置后选择 A、B，四个节点中有三个获得完整依据。','Reset selects A and B, giving three of the four nodes complete support.')]
]:[
[t('先看同一批输出','Keep the outputs fixed'),t('四条记录全部展开后，可以检查完成情况、工具选择和证据是否保留。','Expand all four records to inspect completion, tool selection and retained evidence.')],
[t('切换严格验收','Switch to strict checks'),t('只看完成时通过三条，同时检查工具和证据时只通过一条。这是规则变化，不是模型能力下降。','Completion-only passes three records. Requiring correct tools and evidence passes one. This is a change of rule, not a decline in model capability.')],
[t('不要把样例当结论','Do not generalize fixture scores'),t('这组样例没有代表性采样，也没有调用模型。实际评测还需要任务分布、版本和原始运行记录。','These fixtures are not a representative sample and no model is called. A real evaluation also needs a task distribution, versions and original run records.')]
]).map(([title,body])=><article><h3>{title}</h3><p>{body}</p></article>)}</div></section>
 </main>
</BaseLayout>
<style>.title-phrase{display:inline-block;white-space:nowrap}</style>
