---
// 产品微演示：默认可见，进入视口单次播放，支持访客点击/Tab 互动探索。
// 只动 transform 与 opacity；reduced-motion 下展示静态终态，不循环播放。
type DemoKind = 'timeline' | 'pipeline' | 'terminal'
type Props = { kind: DemoKind; locale?: 'zh-CN' | 'en-US' }
const { kind, locale = 'zh-CN' } = Astro.props

const meta: Record<DemoKind, Record<'zh-CN' | 'en-US', { name: string; note: string }>> = {
  timeline: {
    'zh-CN': { name: 'AgentArena · 对战时间线', note: '提交 → 对战 → 评审 → 复盘（点击节点可查看详情）' },
    'en-US': { name: 'AgentArena · Match timeline', note: 'Commit → Arena → Review → Retro (click step to inspect)' }
  },
  pipeline: {
    'zh-CN': { name: 'Harness · 闭环流水线', note: 'Issue → Plan → Build → Review → Merge（点击筹码查看产物）' },
    'en-US': { name: 'Harness · Closed loop', note: 'Issue → Plan → Build → Review → Merge (click chip to inspect)' }
  },
  terminal: {
    'zh-CN': { name: 'Glassbox · 记录流', note: '一次真实运行的捕获回放（点击日志行可复制）' },
    'en-US': { name: 'Glassbox · Capture stream', note: 'Replay of one captured run (click line to copy)' }
  }
}

const timelineData = {
  'zh-CN': [
    { label: '提交', note: '01 提交 · 封装 Agent 镜像、沙盒指令与提示词规范' },
    { label: '对战', note: '02 对战 · 多智能体在隔离环境中针对真实任务交锋' },
    { label: '评审', note: '03 评审 · 裁判模型多维度盲评打分，生成胜率矩阵' },
    { label: '复盘', note: '04 复盘 · 溯源完整思维链、动作轨迹与失误归因证据' }
  ],
  'en-US': [
    { label: 'Commit', note: '01 Commit · Package runtime, sandbox instructions & prompts' },
    { label: 'Arena', note: '02 Arena · Multi-agents compete in isolated environment' },
    { label: 'Review', note: '03 Review · Blind judging matrix & score verdict' },
    { label: 'Retro', note: '04 Retro · Trace full CoT, action logs & failure evidence' }
  ]
}

const pipelineData = {
  'zh-CN': [
    { label: 'Issue', note: 'Issue · 问题确立：捕获真实需求、前置边界与验收条件' },
    { label: 'Plan', note: 'Plan · 任务拆解：输出可验证的代码修改规划与检查单' },
    { label: 'Build', note: 'Build · 隔离构建：在独立 Worktree 中编写代码并跑通测试' },
    { label: 'Review', note: 'Review · 证据审计：通过多维度代码闸门与安全性检查' },
    { label: 'Merge', note: 'Merge · 交付归档：自动合入主干并生成现场变更快照' }
  ],
  'en-US': [
    { label: 'Issue', note: 'Issue · Capture requirements, boundaries & criteria' },
    { label: 'Plan', note: 'Plan · Output verifiable code plan & checklist' },
    { label: 'Build', note: 'Build · Code & test in isolated worktree' },
    { label: 'Review', note: 'Review · Quality gates & security audits' },
    { label: 'Merge', note: 'Merge · Automated merge & field note archive' }
  ]
}

const terminalData = {
  'zh-CN': [
    { line: '$ glassbox attach --run 42', tip: '已复制指令 · 接入活跃运行会话 42' },
    { line: '» step 03 captured · context rebuilt', tip: '已复制 · 捕获第 03 步完整上下文与思维链' },
    { line: '» evidence saved · verdict: pass', tip: '已复制 · 证据文件已就绪，判定结果：通过' }
  ],
  'en-US': [
    { line: '$ glassbox attach --run 42', tip: 'Copied command · Attached to active run 42' },
    { line: '» step 03 captured · context rebuilt', tip: 'Copied · Captured step 03 trace & context' },
    { line: '» evidence saved · verdict: pass', tip: 'Copied · Evidence saved with passing verdict' }
  ]
}

const currentTimeline = timelineData[locale]
const currentPipeline = pipelineData[locale]
const currentTerminal = terminalData[locale]
const copy = meta[kind][locale]
---

<div class='project-demo' data-demo={kind} data-default-note={copy.note}>
  <div class='demo-stage' aria-label={copy.name}>
    {
      kind === 'timeline' && (
        <div class='demo-track'>
          <span class='demo-sweep' />
          {currentTimeline.map((item, index) => (
            <button
              type='button'
              class='demo-node tactile-action'
              data-step={index}
              data-note={item.note}
              style={`--i:${index}`}
              aria-label={`${item.label} · ${item.note}`}
            >
              <i aria-hidden='true' />
              <span>{item.label}</span>
            </button>
          ))}
        </div>
      )
    }
    {
      kind === 'pipeline' && (
        <div class='demo-chips'>
          {currentPipeline.map((item, index) => (
            <button
              type='button'
              class='demo-chip tactile-action'
              data-chip={index}
              data-note={item.note}
              style={`--i:${index}`}
              aria-label={`${item.label} · ${item.note}`}
            >
              <span>{item.label}</span>
            </button>
          ))}
        </div>
      )
    }
    {
      kind === 'terminal' && (
        <div class='demo-term'>
          {currentTerminal.map((item, index) => (
            <button
              type='button'
              class='demo-line'
              data-line={index}
              data-text={item.line}
              data-tip={item.tip}
              style={`--i:${index}`}
              title={locale === 'zh-CN' ? '点击复制此行日志' : 'Click to copy log line'}
            >
              <span class='demo-line-inner'>{item.line}</span>
              <span class='demo-copy-badge' aria-hidden='true'>Copy</span>
            </button>
          ))}
        </div>
      )
    }
  </div>
  <div class='demo-bar'>
    <span class='demo-name'>
      <strong>{copy.name}</strong>
      <small data-demo-note aria-live='polite'>{copy.note}</small>
    </span>
    <button type='button' class='demo-replay tactile-action' data-demo-replay aria-label={locale === 'zh-CN' ? '从头重播演示' : 'Replay demo from beginning'}>
      {locale === 'zh-CN' ? '重播' : 'Replay'} <span aria-hidden='true'>↻</span>
    </button>
  </div>
</div>

<style>
  .project-demo {
    display: grid;
    gap: 0.55rem;
    margin-block: 0.7rem;
    border: 1px dashed hsl(var(--border) / 0.95);
    border-radius: 0.8rem;
    padding: 0.75rem 0.85rem 0.6rem;
    background: hsl(var(--background) / 0.66);
    transition: border-color var(--motion-base, 190ms) ease;
  }

  .project-demo:focus-within {
    border-color: hsl(var(--field-amber) / 0.6);
  }

  /* 未播放前（视口外或等待 IntersectionObserver）保持静态初始态，避免页面加载即全部播完。 */
  .project-demo[data-playing='false'] .demo-sweep,
  .project-demo[data-playing='false'] .demo-node,
  .project-demo[data-playing='false'] .demo-chip,
  .project-demo[data-playing='false'] .demo-chip::after,
  .project-demo[data-playing='false'] .demo-line-inner {
    animation: none;
  }

  .demo-stage {
    min-height: 3.4rem;
  }

  /* timeline：进度扫线 + 节点依次点亮（单次 2.1s），支持点击探索。 */
  .demo-track {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    border-top: 1px solid hsl(var(--border) / 0.9);
    padding-top: 0.5rem;
  }
  .demo-sweep {
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background: hsl(var(--field-amber));
    transform: scaleX(0);
    transform-origin: left;
    animation: demo-sweep 2100ms var(--motion-spring) forwards;
  }
  .demo-node {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    border: none;
    background: transparent;
    padding: 0.2rem 0.35rem;
    border-radius: 999px;
    color: hsl(var(--muted-foreground) / 0.65);
    font-size: 0.62rem;
    font-weight: 650;
    opacity: 0;
    transform: translateY(3px);
    cursor: pointer;
    animation: demo-node-on 240ms ease forwards;
    animation-delay: calc(var(--i) * 480ms);
    transition: color 160ms ease, background 160ms ease, transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .demo-node i {
    width: 0.42rem;
    height: 0.42rem;
    border: 1px solid hsl(var(--field-amber-strong));
    border-radius: 999px;
    background: hsl(var(--background));
    transition: background 160ms ease, transform 160ms ease;
  }
  .demo-node:hover,
  .demo-node:focus-visible,
  .demo-node[data-active='true'] {
    color: hsl(var(--foreground));
    background: hsl(var(--field-amber) / 0.12);
  }
  .demo-node:hover i,
  .demo-node:focus-visible i,
  .demo-node[data-active='true'] i {
    background: hsl(var(--field-amber));
    box-shadow: 0 0 0 3px hsl(var(--field-amber) / 0.2);
    transform: scale(1.15);
  }

  /* pipeline：筹码依次盖章点亮，支持点击切片。 */
  .demo-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }
  .demo-chip {
    position: relative;
    border: 1px solid hsl(var(--border));
    border-radius: 0.45rem;
    padding: 0.24rem 0.5rem;
    background: hsl(var(--background) / 0.8);
    color: hsl(var(--muted-foreground) / 0.7);
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.6rem;
    font-weight: 620;
    cursor: pointer;
    opacity: 0.45;
    animation: demo-chip-on 260ms var(--motion-spring) forwards;
    animation-delay: calc(var(--i) * 440ms);
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease, transform 140ms ease;
  }
  .demo-chip::after {
    position: absolute;
    right: 0.35rem;
    bottom: 0.16rem;
    left: 0.35rem;
    height: 2px;
    background: hsl(var(--field-amber) / 0.75);
    content: '';
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left;
    animation: demo-sweep 300ms ease forwards;
    animation-delay: calc(var(--i) * 440ms + 120ms);
  }
  .demo-chip:hover,
  .demo-chip:focus-visible,
  .demo-chip[data-active='true'] {
    border-color: hsl(var(--field-amber));
    background: hsl(var(--field-amber) / 0.1);
    color: hsl(var(--foreground));
    opacity: 1;
    transform: translateY(-1px);
  }

  /* terminal：可点击复制行，带微型 Copy 浮标。 */
  .demo-term {
    display: grid;
    gap: 0.28rem;
    border: 1px solid hsl(var(--field-ink) / 0.32);
    border-radius: 0.55rem;
    padding: 0.55rem 0.65rem;
    background: hsl(var(--field-ink) / 0.045);
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.62rem;
  }
  .demo-line {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
    margin: 0;
    padding: 0.15rem 0.3rem;
    border: none;
    border-radius: 0.3rem;
    background: transparent;
    color: inherit;
    font-family: inherit;
    font-size: inherit;
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    white-space: nowrap;
    transition: background 140ms ease;
  }
  .demo-line:hover,
  .demo-line:focus-visible {
    background: hsl(var(--field-ink) / 0.08);
  }
  .demo-line-inner {
    display: inline-block;
    color: hsl(var(--field-ink) / 0.86);
    transform: translateX(-101%);
    animation: demo-type-in 460ms steps(20) forwards;
    animation-delay: calc(var(--i) * 520ms);
  }
  .demo-copy-badge {
    opacity: 0;
    color: hsl(var(--field-amber-strong));
    font-size: 0.55rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: opacity 160ms ease;
  }
  .demo-line:hover .demo-copy-badge,
  .demo-line:focus-visible .demo-copy-badge {
    opacity: 1;
  }

  .demo-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .demo-name {
    display: grid;
    gap: 0.05rem;
  }
  .demo-name strong {
    color: hsl(var(--foreground));
    font-size: 0.66rem;
    font-weight: 680;
    letter-spacing: 0.02em;
  }
  .demo-name small {
    color: hsl(var(--muted-foreground));
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.58rem;
    transition: color 180ms ease;
  }
  .demo-name small[data-highlight='true'] {
    color: hsl(var(--field-amber-strong));
    font-weight: 600;
  }
  .demo-replay {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    padding: 0.3rem 0.6rem;
    background: hsl(var(--background) / 0.85);
    color: hsl(var(--foreground));
    font-size: 0.62rem;
    font-weight: 640;
    cursor: pointer;
    text-decoration: none;
  }

  @keyframes demo-sweep {
    to {
      transform: scaleX(1);
    }
  }
  @keyframes demo-node-on {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes demo-chip-on {
    to {
      opacity: 1;
      color: hsl(var(--foreground));
    }
  }
  @keyframes demo-type-in {
    to {
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-sweep,
    .demo-node,
    .demo-chip,
    .demo-chip::after,
    .demo-line-inner {
      animation: none;
    }
    .demo-sweep {
      transform: scaleX(1);
    }
    .demo-node,
    .demo-chip {
      opacity: 1;
      transform: none;
      color: hsl(var(--foreground));
    }
    .demo-chip::after {
      opacity: 1;
      transform: scaleX(1);
    }
    .demo-line-inner {
      transform: none;
    }
  }
</style>

<script>
  const initDemos = () => {
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)')
    for (const demo of document.querySelectorAll<HTMLElement>('[data-demo]')) {
      if (demo.dataset.demoReady === 'true') continue
      demo.dataset.demoReady = 'true'
      demo.dataset.playing = 'false'

      const noteEl = demo.querySelector<HTMLElement>('[data-demo-note]')
      const defaultNote = demo.dataset.defaultNote ?? ''
      let noteResetTimer: number | undefined

      const setNote = (text: string, isTemporary = true) => {
        if (!noteEl) return
        noteEl.textContent = text
        noteEl.dataset.highlight = isTemporary ? 'true' : 'false'
        if (noteResetTimer) window.clearTimeout(noteResetTimer)
        if (isTemporary) {
          noteResetTimer = window.setTimeout(() => {
            noteEl.textContent = defaultNote
            noteEl.dataset.highlight = 'false'
            demo.querySelectorAll('[data-active="true"]').forEach((el) => el.removeAttribute('data-active'))
          }, 3600)
        }
      }

      // 1. Timeline 节点点击与悬停探索
      const nodes = demo.querySelectorAll<HTMLButtonElement>('[data-step]')
      nodes.forEach((node) => {
        const handleInspect = () => {
          nodes.forEach((n) => n.removeAttribute('data-active'))
          node.dataset.active = 'true'
          const note = node.dataset.note
          if (note) setNote(note, true)
          try {
            if (document.documentElement.dataset.haptics === 'on') navigator.vibrate?.(8)
          } catch {}
        }
        node.addEventListener('click', handleInspect)
        node.addEventListener('mouseenter', handleInspect)
      })

      // 2. Pipeline 筹码点击探索
      const chips = demo.querySelectorAll<HTMLButtonElement>('[data-chip]')
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          chips.forEach((c) => c.removeAttribute('data-active'))
          chip.dataset.active = 'true'
          const note = chip.dataset.note
          if (note) setNote(note, true)
          try {
            if (document.documentElement.dataset.haptics === 'on') navigator.vibrate?.(8)
          } catch {}
        })
      })

      // 3. Terminal 终端点击复制
      const lines = demo.querySelectorAll<HTMLButtonElement>('[data-line]')
      lines.forEach((line) => {
        line.addEventListener('click', async () => {
          const text = line.dataset.text
          const tip = line.dataset.tip
          if (text) {
            try {
              await navigator.clipboard.writeText(text)
              if (tip) setNote(tip, true)
              const badge = line.querySelector<HTMLElement>('.demo-copy-badge')
              if (badge) {
                const old = badge.textContent
                badge.textContent = '✓ Copied'
                window.setTimeout(() => { badge.textContent = old }, 1500)
              }
              if (document.documentElement.dataset.haptics === 'on') navigator.vibrate?.(12)
            } catch {}
          }
        })
      })

      const play = () => {
        demo.dataset.playing = 'false'
        demo.querySelectorAll('[data-active="true"]').forEach((el) => el.removeAttribute('data-active'))
        if (noteEl) {
          noteEl.textContent = defaultNote
          noteEl.dataset.highlight = 'false'
        }
        void demo.offsetWidth
        demo.dataset.playing = 'true'
      }

      const replay = demo.querySelector<HTMLButtonElement>('[data-demo-replay]')
      replay?.addEventListener('click', play)

      // 进入视口才首播一次；reduced-motion 访客静态终态即可，不注册观察器。
      if (reducedMotion.matches || !('IntersectionObserver' in window)) continue
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              observer.disconnect()
              play()
            }
          }
        },
        { threshold: 0.45 }
      )
      observer.observe(demo)
    }
  }
  initDemos()
  document.addEventListener('astro:page-load', initDemos)
</script>
