---
// 体感 demo 面板：只在 html[data-haptics='on'] 且未开启 reduced-motion 时可见。
// 单次有限播放，重播由访客手动触发；只动 transform 与 opacity。
type DemoKind = 'timeline' | 'pipeline' | 'terminal'
type Props = { kind: DemoKind; locale?: 'zh-CN' | 'en-US' }
const { kind, locale = 'zh-CN' } = Astro.props

const meta: Record<DemoKind, Record<'zh-CN' | 'en-US', { name: string; note: string }>> = {
  timeline: {
    'zh-CN': { name: 'AgentArena · 对战时间线', note: '提交 → 对战 → 评审 → 复盘' },
    'en-US': { name: 'AgentArena · Match timeline', note: 'Commit → Arena → Review → Retro' }
  },
  pipeline: {
    'zh-CN': { name: 'Harness · 闭环流水线', note: 'Issue → Plan → Build → Review → Merge' },
    'en-US': { name: 'Harness · Closed loop', note: 'Issue → Plan → Build → Review → Merge' }
  },
  terminal: {
    'zh-CN': { name: 'Glassbox · 记录流', note: '一次真实运行的捕获回放' },
    'en-US': { name: 'Glassbox · Capture stream', note: 'Replay of one captured run' }
  }
}

const timelineStepsByLocale = {
  'zh-CN': ['提交', '对战', '评审', '复盘'],
  'en-US': ['Commit', 'Arena', 'Review', 'Retro']
}
const pipelineSteps = ['Issue', 'Plan', 'Build', 'Review', 'Merge']
const terminalLines = [
  '$ glassbox attach --run 42',
  '» step 03 captured · context rebuilt',
  '» evidence saved · verdict: pass'
]
const timelineSteps = timelineStepsByLocale[locale]
const copy = meta[kind][locale]
---

<div class='project-demo' data-demo={kind}>
  <div class='demo-stage' aria-hidden='true'>
    {
      kind === 'timeline' && (
        <div class='demo-track'>
          <span class='demo-sweep' />
          {timelineSteps.map((step, index) => (
            <span class='demo-node' style={`--i:${index}`}>
              <i />
              {step}
            </span>
          ))}
        </div>
      )
    }
    {
      kind === 'pipeline' && (
        <div class='demo-chips'>
          {pipelineSteps.map((step, index) => (
            <span class='demo-chip' style={`--i:${index}`}>
              {step}
            </span>
          ))}
        </div>
      )
    }
    {
      kind === 'terminal' && (
        <div class='demo-term'>
          {terminalLines.map((line, index) => (
            <span class='demo-line' style={`--i:${index}`}>
              <span class='demo-line-inner'>{line}</span>
            </span>
          ))}
        </div>
      )
    }
  </div>
  <div class='demo-bar'>
    <span class='demo-name'>
      <strong>{copy.name}</strong>
      <small>{copy.note}</small>
    </span>
    <button type='button' class='demo-replay tactile-action' data-demo-replay>
      {locale === 'zh-CN' ? '重播' : 'Replay'} <span aria-hidden='true'>↻</span>
    </button>
  </div>
</div>

<style>
  .project-demo {
    display: none;
    margin-block: 0.7rem;
    border: 1px dashed hsl(var(--border) / 0.95);
    border-radius: 0.8rem;
    padding: 0.75rem 0.85rem 0.6rem;
    background: hsl(var(--background) / 0.66);
  }
  /* 体感开启才点亮；reduced-motion 访客永远看不到，也不会被动画打扰。 */
  :global(html[data-haptics='on']) .project-demo {
    display: grid;
    gap: 0.55rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .project-demo {
      display: none !important;
    }
  }

  .demo-stage {
    min-height: 3.4rem;
  }

  /* timeline：进度扫线 + 节点依次点亮（单次 2.1s）。 */
  .demo-track {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    border-top: 1px solid hsl(var(--border) / 0.9);
    padding-top: 0.5rem;
  }
  .demo-sweep {
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background: hsl(var(--field-amber));
    transform: scaleX(0);
    transform-origin: left;
    animation: demo-sweep 2100ms var(--motion-spring) forwards;
  }
  .demo-node {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    color: hsl(var(--muted-foreground) / 0.55);
    font-size: 0.62rem;
    font-weight: 650;
    opacity: 0;
    transform: translateY(3px);
    animation: demo-node-on 240ms ease forwards;
    animation-delay: calc(var(--i) * 480ms);
  }
  .demo-node i {
    width: 0.42rem;
    height: 0.42rem;
    border: 1px solid hsl(var(--field-amber-strong));
    border-radius: 999px;
    background: hsl(var(--background));
  }

  /* pipeline：筹码依次盖章点亮（单次 2.4s）。 */
  .demo-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }
  .demo-chip {
    position: relative;
    border: 1px solid hsl(var(--border));
    border-radius: 0.45rem;
    padding: 0.24rem 0.5rem;
    color: hsl(var(--muted-foreground) / 0.6);
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.6rem;
    font-weight: 620;
    opacity: 0.45;
    animation: demo-chip-on 260ms var(--motion-spring) forwards;
    animation-delay: calc(var(--i) * 440ms);
  }
  .demo-chip::after {
    position: absolute;
    right: 0.35rem;
    bottom: 0.16rem;
    left: 0.35rem;
    height: 2px;
    background: hsl(var(--field-amber) / 0.75);
    content: '';
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left;
    animation: demo-sweep 300ms ease forwards;
    animation-delay: calc(var(--i) * 440ms + 120ms);
  }

  /* terminal：行从左到右揭示，steps() 制造打字感（单次约 1.8s）。 */
  .demo-term {
    display: grid;
    gap: 0.28rem;
    border: 1px solid hsl(var(--field-ink) / 0.32);
    border-radius: 0.55rem;
    padding: 0.55rem 0.65rem;
    background: hsl(var(--field-ink) / 0.045);
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.62rem;
  }
  .demo-line {
    overflow: hidden;
    white-space: nowrap;
  }
  .demo-line-inner {
    display: inline-block;
    color: hsl(var(--field-ink) / 0.86);
    transform: translateX(-101%);
    animation: demo-type-in 460ms steps(20) forwards;
    animation-delay: calc(var(--i) * 520ms);
  }

  .demo-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .demo-name {
    display: grid;
    gap: 0.05rem;
  }
  .demo-name strong {
    color: hsl(var(--foreground));
    font-size: 0.66rem;
    font-weight: 680;
    letter-spacing: 0.02em;
  }
  .demo-name small {
    color: hsl(var(--muted-foreground));
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.58rem;
  }
  .demo-replay {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    padding: 0.3rem 0.6rem;
    background: hsl(var(--background) / 0.85);
    color: hsl(var(--foreground));
    font-size: 0.62rem;
    font-weight: 640;
    text-decoration: none;
  }

  @keyframes demo-sweep {
    to {
      transform: scaleX(1);
    }
  }
  @keyframes demo-node-on {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes demo-chip-on {
    to {
      opacity: 1;
      color: hsl(var(--foreground));
    }
  }
  @keyframes demo-type-in {
    to {
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-sweep,
    .demo-node,
    .demo-chip,
    .demo-chip::after,
    .demo-line-inner {
      animation: none;
    }
    .demo-sweep {
      transform: scaleX(1);
    }
    .demo-node,
    .demo-chip {
      opacity: 1;
      transform: none;
      color: hsl(var(--foreground));
    }
    .demo-chip::after {
      opacity: 1;
      transform: scaleX(1);
    }
    .demo-line-inner {
      transform: none;
    }
  }
</style>

<script>
  const initDemos = () => {
    for (const demo of document.querySelectorAll<HTMLElement>('[data-demo]')) {
      const replay = demo.querySelector<HTMLButtonElement>('[data-demo-replay]')
      replay?.addEventListener('click', () => {
        const animations = demo.getAnimations({ subtree: true })
        // Safari 上对 fill:forwards 的动画直接 cancel()+play() 偶发不重启；
        // 先 cancel，再强制一次 reflow，最后重播，保证三条引擎路径一致。
        for (const animation of animations) animation.cancel()
        if (animations.length > 0) void demo.offsetWidth
        for (const animation of animations) animation.play()
      })
    }
  }
  initDemos()
  document.addEventListener('astro:page-load', initDemos)
</script>
