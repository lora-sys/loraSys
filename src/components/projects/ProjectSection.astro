---
import { Image } from 'astro:assets'
import { Icon } from 'astro-pure/user'
import type { Project } from '@/data/profile'
interface Props { projects: Project[]; compact?: boolean }
const { projects, compact=false }=Astro.props
const images=import.meta.glob<{default:ImageMetadata}>('/src/assets/projects/*.{avif,webp,png,jpg}')
---
<div class:list={['projects', { compact }]}>
 {projects.map((project,i)=>{
  const path=`/src/assets/projects/${project.image}`; const source=images[path]
  return <article class:list={['project-card',{'project-card--stagger':i%2}]} data-project-card>
   <div class='visual'>{source&&<Image src={source()} alt={`${project.title} project preview`} widths={[480,760]} sizes={compact?'(min-width:640px) 38vw, 90vw':'(min-width:640px) 42vw, 94vw'} loading='lazy' />}</div>
   <div class='body'>
    <div class='meta'><span>{project.dates}</span>{project.active&&<span class='active'><i></i>Active</span>}</div>
    <h3>{project.title}</h3><p>{project.description}</p>
    <ul aria-label='Technologies'>{project.technologies.map(t=><li>{t}</li>)}</ul>
    <div class='actions'>{project.links.map(link=><a href={link.href} target='_blank' rel='noopener noreferrer'><Icon name={link.type==='source'?'github-circle':'earth'} class='size-4'/>{link.type==='source'?'Source':'Website'} <span>↗</span></a>)}</div>
   </div>
  </article>
 })}
</div>
<script>
 if(matchMedia('(hover:hover)').matches) document.querySelectorAll<HTMLElement>('[data-project-card]').forEach(card=>card.addEventListener('pointermove',e=>{const r=card.getBoundingClientRect();card.style.setProperty('--x',`${e.clientX-r.left}px`);card.style.setProperty('--y',`${e.clientY-r.top}px`)}))
</script>
<style>
.projects{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.4rem}.project-card{position:relative;overflow:hidden;border:1px solid hsl(var(--border));border-radius:1rem;background:hsl(var(--card));transition:transform .28s,box-shadow .28s}.project-card:after{content:'';position:absolute;inset:0;pointer-events:none;background:radial-gradient(360px circle at var(--x,-500px) var(--y,-500px),hsl(var(--primary)/.13),transparent 65%)}.project-card--stagger{transform:translateY(1.5rem)}.project-card:hover{box-shadow:0 20px 50px -35px hsl(var(--foreground)/.42)}.project-card--stagger:hover{transform:translateY(1.25rem)}.visual{aspect-ratio:16/9;overflow:hidden;background:hsl(var(--muted))}.visual img{width:100%;height:100%;object-fit:cover;transition:transform .5s}.project-card:hover .visual img{transform:scale(1.025)}.body{position:relative;z-index:1;padding:1rem 1.1rem 1.15rem}.meta{display:flex;justify-content:space-between;gap:1rem;color:hsl(var(--muted-foreground));font-size:.72rem;letter-spacing:.04em}.active{display:flex;align-items:center;gap:.35rem}.active i{width:.42rem;height:.42rem;border-radius:50%;background:#22c55e;box-shadow:0 0 0 3px rgb(34 197 94/.12)}h3{margin:.55rem 0 .35rem;font-size:1.12rem;font-weight:650}p{min-height:3.9em;margin:0;color:hsl(var(--muted-foreground));font-size:.86rem;line-height:1.55}ul{display:flex;flex-wrap:wrap;gap:.35rem;margin:.85rem 0;padding:0;list-style:none}li{border:1px solid hsl(var(--border));border-radius:999px;padding:.18rem .5rem;color:hsl(var(--muted-foreground));font-size:.68rem}.actions{display:flex;gap:.55rem}.actions a{display:flex;align-items:center;gap:.35rem;border:1px solid hsl(var(--border));border-radius:.6rem;padding:.42rem .68rem;color:hsl(var(--foreground));font-size:.78rem;text-decoration:none;transition:background .2s,transform .2s}.actions a:hover{background:hsl(var(--muted));transform:translateY(-1px)}.compact{gap:1rem}.compact .body{padding:.8rem .9rem}.compact p{min-height:2.7em;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}@media(max-width:640px){.projects{grid-template-columns:1fr}.project-card--stagger,.project-card--stagger:hover{transform:none}p{min-height:0}}@media(prefers-reduced-motion:reduce){.project-card,.visual img,.actions a{transition:none}.project-card:hover,.project-card--stagger:hover{transform:none}}
</style>
