---
import { Image } from 'astro:assets'
import type { Project } from '@/data/projects'

interface Props {
  project: Project
  priority?: boolean
  lens?: boolean
  sizes?: string
}

const {
  project,
  priority = false,
  lens = false,
  sizes = '(min-width: 1024px) 48vw, (min-width: 640px) 46vw, 94vw'
} = Astro.props
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/projects/*.{avif,webp,png,jpg,jpeg}'
)
const source = images[`/src/assets/projects/${project.image}`]
const fallbackMark = project.title
  .split(/\s+/)
  .map((part) => part[0])
  .join('')
  .slice(0, 3)
  .toUpperCase()
---

<div
  class:list={['project-media', { 'project-media--lens': lens }]}
  data-project-media
  data-has-source={String(Boolean(source))}
  style={`--poster-fit:${project.posterFit};--poster-position:${project.objectPosition}`}
>
  <div class='media-fallback' aria-hidden='true'>
    <span>{fallbackMark || '</>'}</span>
    <strong>{project.title}</strong>
    <small>{project.language || 'Open source'}</small>
  </div>
  {
    source && (
      <Image
        src={source()}
        alt={`${project.title} project poster`}
        widths={[480, 720, 960, 1280]}
        {sizes}
        loading={priority ? 'eager' : 'lazy'}
        decoding='async'
        fetchpriority={priority ? 'high' : 'auto'}
        data-project-poster
      />
    )
  }
  {lens && <span class='project-lens' aria-hidden='true' data-project-lens />}
</div>

<script>
  const markBrokenPoster = (image: HTMLImageElement) => {
    if (!image.complete || image.naturalWidth > 0) return
    image.closest<HTMLElement>('[data-project-media]')?.setAttribute('data-image-failed', 'true')
  }

  document.querySelectorAll<HTMLImageElement>('[data-project-poster]').forEach((image) => {
    markBrokenPoster(image)
    image.addEventListener('error', () =>
      image.closest<HTMLElement>('[data-project-media]')?.setAttribute('data-image-failed', 'true')
    )
  })
</script>

<style>
  .project-media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: hsl(var(--muted));
    isolation: isolate;
  }

  .project-media :global(picture),
  .project-media :global(img) {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
  }

  :global(.project-card--lead) .project-media {
    align-self: stretch;
    height: auto;
    min-height: 30rem;
    aspect-ratio: unset;
  }

  .project-media :global(img) {
    object-fit: var(--poster-fit, cover);
    object-position: var(--poster-position, center);
    transform: translate3d(var(--parallax-x, 0px), var(--parallax-y, 0px), 0) scale(1.012);
    transition: transform 260ms cubic-bezier(0.23, 1, 0.32, 1);
    will-change: transform;
  }

  .media-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: end;
    gap: 0.2rem;
    padding: clamp(1rem, 4vw, 1.6rem);
    background:
      linear-gradient(135deg, hsl(var(--muted)), transparent 55%),
      repeating-linear-gradient(
        90deg,
        transparent 0,
        transparent 3.2rem,
        hsl(var(--border) / 0.42) 3.2rem,
        hsl(var(--border) / 0.42) calc(3.2rem + 1px)
      );
    color: hsl(var(--foreground));
  }

  .media-fallback span {
    position: absolute;
    top: 1rem;
    right: 1rem;
    color: hsl(var(--muted-foreground) / 0.45);
    font-size: clamp(2rem, 7vw, 4rem);
    font-weight: 650;
    letter-spacing: -0.08em;
  }

  .media-fallback strong {
    max-width: 20ch;
    font-size: clamp(1rem, 3vw, 1.35rem);
    font-weight: 620;
    line-height: 1.1;
    text-wrap: balance;
  }

  .media-fallback small {
    color: hsl(var(--muted-foreground));
    font-size: 0.68rem;
  }

  .project-media[data-has-source='false'] :global(picture),
  .project-media[data-image-failed='true'] :global(picture) {
    display: none;
  }

  .project-lens {
    position: absolute;
    z-index: 3;
    width: 7.5rem;
    height: 7.5rem;
    border: 1px solid hsl(var(--background) / 0.75);
    border-radius: 50%;
    background-color: hsl(var(--card));
    background-image: var(--lens-image);
    background-position: var(--lens-position, center);
    background-repeat: no-repeat;
    background-size: 220%;
    box-shadow: 0 18px 45px -20px hsl(var(--foreground) / 0.65);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%) scale(0.88);
    transition:
      opacity 150ms ease,
      transform 150ms ease;
  }

  .project-media[data-lens-active='true'] .project-lens {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  @media (hover: hover) and (pointer: fine) {
    :global(.project-card:hover) .project-media :global(img) {
      transform: translate3d(var(--parallax-x, 0px), var(--parallax-y, 0px), 0) scale(1.03);
    }
  }

  @media (max-width: 780px) {
    :global(.project-card--lead) .project-media {
      min-height: 0;
      height: auto;
      aspect-ratio: 16 / 9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-media :global(img),
    .project-lens {
      transition: none;
    }

    :global(.project-card:hover) .project-media :global(img),
    .project-media :global(img) {
      transform: none;
      will-change: auto;
    }

    .project-lens {
      display: none;
    }
  }
</style>
