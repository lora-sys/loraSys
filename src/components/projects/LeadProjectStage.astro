---
import { demoByRepo } from '@/data/project-demos'
import type { Project } from '@/data/projects'

import ProjectCard from '@/components/projects/ProjectCard.astro'
import ProjectDemo from '@/components/projects/ProjectDemo.astro'

interface Props {
  project: Project
  locale?: 'zh-CN' | 'en-US'
  rationale?: string
  hideRationale?: boolean
  anchor?: boolean
  priority?: boolean
}

const { project, locale = 'zh-CN', rationale, hideRationale = false, anchor = false, priority = false } = Astro.props
const demo = demoByRepo[project.repository]
const copy = locale === 'en-US'
  ? rationale ?? 'See the current work, source and related notes.'
  : rationale ?? '查看当前能力、源码和相关构建记录。'
---

<div class='lead-project-stage'>
  <ProjectCard project={project} variant='lead' lens={false} compact compactLocale={locale} {anchor} {priority}>
    {demo && <ProjectDemo kind={demo} locale={locale} slot='demo' />}
  </ProjectCard>
  {!hideRationale && <p class='work-rationale'>{copy}</p>}
</div>

<style>
  .lead-project-stage {
    min-width: 0;
    max-width: 100%;
  }
  .work-rationale {
    margin: 0.7rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.78rem;
    line-height: 1.6;
  }
</style>
