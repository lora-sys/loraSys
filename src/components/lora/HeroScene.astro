---
import { Image } from 'astro:assets'

import heroIllustration from '@/assets/lora-visual/v3/lora-mochi-home.webp'

interface Props {
  locale?: 'zh-CN' | 'en-US'
}

const { locale = 'zh-CN' } = Astro.props
const label = locale === 'en-US' ? 'Lora and Mochi.' : 'Lora 和 Mochi。'
---

<div class='hero-scene'>
  <div class='hero-figure'>
    <Image
      src={heroIllustration}
      alt={label}
      widths={[384, 640, 900, 1200]}
      sizes='(max-width: 760px) 78vw, 38rem'
      loading='eager'
      fetchpriority='high'
      decoding='async'
    />
  </div>
</div>

<style>
  .hero-scene {
    position: relative;
    display: grid;
    width: min(100%, 38rem);
    aspect-ratio: 1.15 / 1;
    place-items: center;
    justify-self: end;
  }
  .hero-figure {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .hero-figure :global(img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  @media (max-width: 760px) {
    .hero-scene {
      width: min(78vw, 20rem);
      aspect-ratio: 1.2 / 0.82;
      justify-self: center;
    }
  }
</style>
