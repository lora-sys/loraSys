---
import LoraVisual from './LoraVisual.astro'
---

<div class='hero-scene' aria-hidden='true'>
  <div class='hero-props'><LoraVisual asset='heroProps' priority /></div>
  <div class='hero-lora'><LoraVisual asset='heroLora' priority /></div>
  <div class='hero-mochi'>
    <LoraVisual asset='heroMochi' priority />
  </div>
</div>

<style>
  .hero-scene { position: relative; width: min(43vw, 34rem); aspect-ratio: 3 / 2; pointer-events: none; isolation: isolate; }
  .hero-lora,.hero-mochi,.hero-props { position: absolute; inset: 0; }
  .hero-props { z-index: 0; opacity: .82; }
  .hero-lora { z-index: 1; }
  .hero-mochi { z-index: 2; width: 54%; left: 46%; top: 30%; }
  .hero-scene :global(img) { width: 100%; height: 100%; object-fit: contain; }
  @media (max-width: 760px) { .hero-scene { width: min(100%, 34rem); } }
</style>
