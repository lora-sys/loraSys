---
import LoraVisual from './LoraVisual.astro'
---

<div class='hero-scene' data-hero-scene data-hero-ready='true' aria-hidden='true'>
  <span class='hero-glow'></span>
  <span class='hero-orbit'></span>
  <div class='hero-props'><LoraVisual asset='heroProps' priority decoding='async' /></div>
  <div class='hero-lora'>
    <LoraVisual asset='heroLora' loading='lazy' fetchpriority='low' decoding='async' />
  </div>
  <div class='hero-mochi'>
    <LoraVisual asset='heroMochi' loading='lazy' fetchpriority='low' decoding='async' />
  </div>
</div>

<noscript>
  <style>
    .hero-scene[data-hero-ready='false'] .hero-props,
    .hero-scene[data-hero-ready='false'] .hero-lora,
    .hero-scene[data-hero-ready='false'] .hero-mochi { opacity: 1; }
  </style>
</noscript>

<script>
  const heroScene = document.querySelector<HTMLElement>('[data-hero-scene]')

  if (heroScene) {
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)')
    const finePointer = matchMedia('(hover: hover) and (pointer: fine)')
    const heroRoot = document.querySelector<HTMLElement>('[data-field-notes-hero]')

    // 桌面指针视差微动：计算微小偏移量（-1 到 1），带动工作台各图层产生立体目光视差
    if (heroRoot && !reducedMotion.matches) {
      let frame = 0
      const onPointerMove = (event: PointerEvent) => {
        if (!finePointer.matches) return
        if (frame) return
        frame = requestAnimationFrame(() => {
          frame = 0
          const rect = heroRoot.getBoundingClientRect()
          const x = ((event.clientX - rect.left) / rect.width - 0.5) * 2
          const y = ((event.clientY - rect.top) / rect.height - 0.5) * 2
          heroScene.style.setProperty('--hx', Math.max(-1, Math.min(1, x)).toFixed(3))
          heroScene.style.setProperty('--hy', Math.max(-1, Math.min(1, y)).toFixed(3))
        })
      }
      const resetParallax = () => {
        heroScene.style.setProperty('--hx', '0')
        heroScene.style.setProperty('--hy', '0')
      }
      heroRoot.addEventListener('pointermove', onPointerMove, { passive: true })
      heroRoot.addEventListener('pointerleave', resetParallax)
    }
  }
</script>

<style>
  /* 宽度完全由外层容器决定，避免 vw 双重约束互相打架。 */
  .hero-scene {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    pointer-events: none;
    isolation: isolate;
    contain: layout paint;
    perspective: 900px;
    --hero-depth-props: -18px;
    --hero-depth-lora: 12px;
    --hero-depth-mochi: 34px;
  }
  .hero-glow {
    position: absolute;
    z-index: 0;
    inset: 10% 6% 7% 12%;
    border-radius: 50%;
    background:
      radial-gradient(circle at calc(58% + var(--hx, 0) * 4%) calc(38% + var(--hy, 0) * 4%), hsl(var(--field-amber) / .22), transparent 48%),
      radial-gradient(circle at 34% 70%, hsl(var(--field-teal) / .12), transparent 42%);
    filter: blur(18px);
    transform: translate3d(calc(var(--hx, 0) * -3px), calc(var(--hy, 0) * -2px), var(--hero-depth-props));
    transition: transform var(--motion-story, 280ms) var(--motion-spring, cubic-bezier(0.23, 1, 0.32, 1));
  }
  .hero-orbit {
    position: absolute;
    z-index: 0;
    inset: 13% 8% 10% 15%;
    border: 1px solid hsl(var(--field-ink) / .10);
    border-radius: 50%;
    transform: rotateX(64deg) rotateZ(-10deg) translateZ(-34px);
    opacity: .72;
  }
  .hero-orbit::before,
  .hero-orbit::after {
    position: absolute;
    width: .42rem;
    height: .42rem;
    border-radius: 50%;
    content: '';
  }
  .hero-orbit::before {
    top: 17%;
    left: 14%;
    background: hsl(var(--field-amber));
    box-shadow: 0 0 0 .45rem hsl(var(--field-amber) / .10);
  }
  .hero-orbit::after {
    right: 16%;
    bottom: 10%;
    background: hsl(var(--field-teal));
    box-shadow: 0 0 0 .45rem hsl(var(--field-teal) / .09);
  }
  .hero-lora,.hero-mochi,.hero-props {
    position: absolute;
    inset: 0;
    will-change: transform;
    transition:
      opacity 180ms ease,
      transform var(--motion-story, 280ms) var(--motion-spring, cubic-bezier(0.23, 1, 0.32, 1));
  }
  .hero-props { z-index: 1; opacity: .82; transform: translate3d(calc(var(--hx, 0) * 2px), calc(var(--hy, 0) * 1.5px), var(--hero-depth-props)); }
  .hero-lora { z-index: 2; transform: translate3d(calc(var(--hx, 0) * 4.5px), calc(var(--hy, 0) * 3.5px), var(--hero-depth-lora)); }
  .hero-mochi { z-index: 3; width: 48%; left: 52%; top: 32%; transform: translate3d(calc(var(--hx, 0) * 7.5px), calc(var(--hy, 0) * 5.5px), var(--hero-depth-mochi)); }
  .hero-lora::after, .hero-mochi::after {
    position: absolute;
    inset: 11% 12% 7%;
    border-radius: 50%;
    background: radial-gradient(ellipse at 50% 80%, rgb(17 19 15 / .18), transparent 66%);
    content: '';
    filter: blur(10px);
    opacity: .55;
    transform: translateZ(-8px) scale(.92);
  }
  .hero-scene[data-hero-ready='false'] > div { opacity: 0; }
  .hero-scene[data-hero-ready='true'] .hero-props { opacity: .82; }
  .hero-scene[data-hero-ready='true'] .hero-lora,
  .hero-scene[data-hero-ready='true'] .hero-mochi { opacity: 1; }
  .hero-scene :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .hero-mochi :global(.lora-visual--heroMochi) {
    transform-origin: 50% 76%;
    animation: mochi-breathe 4.8s ease-in-out infinite;
  }
  @keyframes mochi-breathe {
    0%, 100% { transform: scaleY(1); }
    50% { transform: scaleY(1.008) translateY(-1px); }
  }

  @media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) {
    .hero-lora,.hero-mochi,.hero-props { will-change: auto; transform: none !important; }
    .hero-glow {
      filter: none;
      transform: none !important;
    }
    .hero-orbit { transform: rotateX(64deg) rotateZ(-10deg); }
    .hero-lora::after, .hero-mochi::after { display: none; }
    .hero-scene :global(img) { filter: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-lora,.hero-mochi,.hero-props,
    .hero-glow { transition: none; transform: none !important; }
    .hero-mochi :global(.lora-visual--heroMochi) { animation: none; }
    .hero-scene[data-hero-ready='false'] > div { opacity: 1; }
  }
</style>
