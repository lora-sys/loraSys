---
import LoraVisual from './LoraVisual.astro'
---

<div class='hero-scene' data-hero-scene data-hero-ready='false' aria-hidden='true'>
  <div class='hero-props'><LoraVisual asset='heroProps' priority /></div>
  <div class='hero-lora'><LoraVisual asset='heroLora' priority /></div>
  <div class='hero-mochi'>
    <LoraVisual asset='heroMochi' priority />
  </div>
</div>

<noscript>
  <style>
    .hero-scene[data-hero-ready='false'] .hero-props,
    .hero-scene[data-hero-ready='false'] .hero-lora,
    .hero-scene[data-hero-ready='false'] .hero-mochi { opacity: 1; }
  </style>
</noscript>

<script>
  const heroScene = document.querySelector<HTMLElement>('[data-hero-scene]')

  if (heroScene) {
    const heroImages = Array.from(heroScene.querySelectorAll('img'))
    const waitForImage = async (image: HTMLImageElement) => {
      if (!image.complete) {
        await new Promise<void>((resolve) => {
          image.addEventListener('load', () => resolve(), { once: true })
          image.addEventListener('error', () => resolve(), { once: true })
        })
      }

      if (typeof image.decode === 'function') {
        await image.decode().catch(() => undefined)
      }
    }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      heroScene.dataset.heroReady = 'true'
    } else {
      Promise.all(heroImages.map(waitForImage)).then(() => {
        heroScene.dataset.heroReady = 'true'
      })
    }
  }
</script>

<style>
  /* 宽度完全由外层容器决定，避免 vw 双重约束互相打架。 */
  .hero-scene { position: relative; width: 100%; aspect-ratio: 3 / 2; pointer-events: none; isolation: isolate; }
  .hero-lora,.hero-mochi,.hero-props { position: absolute; inset: 0; }
  .hero-props { z-index: 0; opacity: .82; }
  .hero-lora { z-index: 1; }
  .hero-mochi { z-index: 2; width: 48%; left: 52%; top: 32%; }
  .hero-scene > div { transition: opacity 180ms ease; }
  .hero-scene[data-hero-ready='false'] > div { opacity: 0; }
  .hero-scene[data-hero-ready='true'] .hero-props { opacity: .82; }
  .hero-scene[data-hero-ready='true'] .hero-lora,
  .hero-scene[data-hero-ready='true'] .hero-mochi { opacity: 1; }
  .hero-scene :global(img) { width: 100%; height: 100%; object-fit: contain; }

  @media (prefers-reduced-motion: reduce) {
    .hero-scene > div { transition: none; }
    .hero-scene[data-hero-ready='false'] > div { opacity: 1; }
  }
</style>
