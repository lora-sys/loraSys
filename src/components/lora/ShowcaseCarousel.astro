---
import type { ShowcaseItem } from '../../data/showcase'
interface Props { id: string; title: string; eyebrow: string; items: ShowcaseItem[]; locale?: 'zh-CN' | 'en-US' }
const { id, title, eyebrow, items, locale = 'zh-CN' } = Astro.props
const isEnglish = locale === 'en-US'
const labels = isEnglish
  ? { previous: `Previous ${title}`, next: `Next ${title}`, more: 'Learn more', close: 'Close music player', listening: 'Listening with Lora' }
  : { previous: `上一张：${title}`, next: `下一张：${title}`, more: '查看详情', close: '关闭音乐播放器', listening: 'Lora 正在聆听' }
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---
<section class='showcase' aria-labelledby={`${id}-title`} data-carousel>
  <header><div><p>{eyebrow}</p><h2 id={`${id}-title`}>{title}</h2></div><div class='controls'><button type='button' data-prev aria-label={labels.previous}>←</button><button type='button' data-next aria-label={labels.next}>→</button></div></header>
  <div class='track' tabindex='0' data-track aria-label={title}>
    {items.map((item, i) => <article class:list={['magic-card', { stagger: i % 2 }]} data-magic>
      <a href={item.spotify ? '#spotify-player' : item.href} target={item.spotify ? undefined : '_blank'} rel='noopener noreferrer' class='lens' data-lens data-spotify={item.spotify ? item.href : undefined} data-spotify-title={item.spotify ? [item.name, item.artist].filter(Boolean).join(' — ') : undefined} aria-label={`${item.name}: ${item.description}`}>
        <img src={`${base}${item.image}`} alt={`${item.name} — ${item.description}`} width='600' height='840' loading='lazy' decoding='async' />
        <span class='lens-pane' aria-hidden='true'></span><span class='lens-glass' aria-hidden='true'></span>
        <div class='copy'><span>{String(i + 1).padStart(2, '0')}</span><h3>{item.name}</h3><p>{item.description}</p><b>{item.cta || labels.more} ↗</b></div>
      </a>
    </article>)}
  </div>
  <div class='progress' aria-hidden='true'><i data-progress></i></div>
  {items.some(i=>i.spotify)&&<dialog data-spotify-dialog data-default-title={labels.listening}><button type='button' data-close aria-label={labels.close}>×</button><h3 data-spotify-heading>{labels.listening}</h3><iframe title='Lora’s favorite Spotify track' loading='lazy' allow='autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture'></iframe></dialog>}
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!; const bar = root.querySelector<HTMLElement>('[data-progress]')!
    const prev=root.querySelector<HTMLButtonElement>('[data-prev]')!;const next=root.querySelector<HTMLButtonElement>('[data-next]')!;const move = (n:number) => track.scrollBy({ left: n * Math.min(track.clientWidth * .82, 420), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' })
    root.querySelector('[data-prev]')?.addEventListener('click', () => move(-1)); root.querySelector('[data-next]')?.addEventListener('click', () => move(1))
    track.addEventListener('keydown', e => { if (e.key === 'ArrowLeft') { e.preventDefault(); move(-1) } if (e.key === 'ArrowRight') { e.preventDefault(); move(1) } })
    const update = () => { const max = track.scrollWidth - track.clientWidth; bar.style.transform = `scaleX(${max ? track.scrollLeft / max : 1})`;prev.disabled=track.scrollLeft<2;next.disabled=track.scrollLeft>=max-2 }; track.addEventListener('scroll', update, { passive: true });new ResizeObserver(update).observe(track); update()
  })
  if (matchMedia('(hover:hover)').matches) document.querySelectorAll<HTMLElement>('[data-magic]').forEach(card => {let frame=0;card.addEventListener('pointermove', e => {cancelAnimationFrame(frame);frame=requestAnimationFrame(()=>{const r=card.getBoundingClientRect(); card.style.setProperty('--mx', `${e.clientX-r.left}px`); card.style.setProperty('--my', `${e.clientY-r.top}px`)})})})
  if (matchMedia('(hover:hover) and (prefers-reduced-motion: no-preference)').matches) document.querySelectorAll<HTMLElement>('[data-lens]').forEach(lens => {let frame=0;lens.addEventListener('pointermove', e => {cancelAnimationFrame(frame);frame=requestAnimationFrame(()=>{const r=lens.getBoundingClientRect(); lens.style.setProperty('--lx', `${(e.clientX-r.left)/r.width*100}%`); lens.style.setProperty('--ly', `${(e.clientY-r.top)/r.height*100}%`);const glass=lens.querySelector<HTMLElement>('.lens-glass');const image=lens.querySelector<HTMLImageElement>('img');if(glass&&image&&!glass.dataset.lensLoaded&&image.currentSrc){glass.style.setProperty('--lens-image',`url("${image.currentSrc}")`);glass.dataset.lensLoaded='true'}})})})
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(root=>{const dialog=root.querySelector<HTMLDialogElement>('[data-spotify-dialog]');root.querySelectorAll<HTMLElement>('[data-spotify]').forEach(trigger=>trigger.addEventListener('click',e=>{e.preventDefault();if(dialog){dialog.querySelector('iframe')!.src=trigger.dataset.spotify!;dialog.querySelector('[data-spotify-heading]')!.textContent=trigger.dataset.spotifyTitle || dialog.dataset.defaultTitle || 'Listening with Lora';dialog.showModal()}}));dialog?.querySelector('[data-close]')?.addEventListener('click',()=>dialog.close());dialog?.addEventListener('click',e=>{if(e.target===dialog)dialog.close()})})
</script>
<style>
  .showcase{display:grid;gap:1rem}.showcase header{display:flex;align-items:end;justify-content:space-between}.showcase header p{margin:0;color:hsl(var(--muted-foreground));font-size:.75rem;text-transform:uppercase;letter-spacing:.14em}.showcase h2{font-size:1.25rem;font-weight:600}.controls{display:flex;gap:.4rem}.controls button{width:2.25rem;height:2.25rem;border:1px solid hsl(var(--border));border-radius:999px;background:hsl(var(--background));transition:background .2s,transform .16s cubic-bezier(.23,1,.32,1)}.controls button:hover,.controls button:focus-visible{background:hsl(var(--muted));outline:2px solid hsl(var(--ring));outline-offset:2px;transform:translateY(-1px)}.controls button:active{transform:scale(.93)}.controls button:disabled{opacity:.35;cursor:not-allowed;transform:none}.track{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(15rem,42%);gap:1rem;overflow-x:auto;scroll-snap-type:x mandatory;padding:.5rem .2rem 1rem;scrollbar-width:none}.track::-webkit-scrollbar{display:none}.magic-card{position:relative;scroll-snap-align:start;border:1px solid hsl(var(--border));border-radius:1rem;overflow:hidden;background:hsl(var(--card));min-height:22rem}.magic-card::after{content:'';position:absolute;inset:0;pointer-events:none;background:radial-gradient(240px circle at var(--mx,-100px) var(--my,-100px),hsl(var(--primary)/.13),transparent 70%)}.lens{display:block;position:absolute;inset:0;color:white}.lens img{width:100%;height:100%;object-fit:cover}.lens-pane{position:absolute;inset:0;background:linear-gradient(transparent 35%,rgb(0 0 0/.84))}.lens-glass{position:absolute;z-index:2;left:var(--lx,50%);top:var(--ly,50%);width:7rem;height:7rem;border:2px solid rgb(255 255 255/.8);border-radius:50%;transform:translate(-50%,-50%) scale(.85);opacity:0;pointer-events:none;background-image:var(--lens-image);background-size:calc(100% * 3.2) calc(100% * 3.2);background-position:var(--lx,50%) var(--ly,50%);background-repeat:no-repeat;box-shadow:0 8px 28px rgb(0 0 0/.35),inset 0 0 0 1px rgb(0 0 0/.2);transition:opacity .18s,transform .18s}.lens:hover .lens-glass,.lens:focus-visible .lens-glass{opacity:1;transform:translate(-50%,-50%) scale(1)}.lens:focus-visible{outline:2px solid hsl(173 60% 54%);outline-offset:-3px}.copy{position:absolute;inset:auto 1.1rem 1.1rem;display:grid;gap:.3rem}.copy span{font-size:.7rem;letter-spacing:.15em;opacity:.75}.copy h3{font-size:1.12rem;font-weight:600}.copy p{font-size:.84rem;line-height:1.45;color:rgb(255 255 255/.76)}.copy b{font-size:.72rem;font-weight:500}.progress{height:2px;background:hsl(var(--border));overflow:hidden}.progress i{display:block;height:100%;background:hsl(var(--foreground));transform:scaleX(0);transform-origin:left}.stagger{transform:translateY(1rem)}dialog{width:min(92vw,480px);border:1px solid hsl(var(--border));border-radius:1rem;padding:1rem;background:hsl(var(--background));color:hsl(var(--foreground))}dialog::backdrop{background:rgb(0 0 0/.55);backdrop-filter:blur(5px)}dialog button{float:right;font-size:1.4rem}dialog h3{margin:.4rem 0 1rem}dialog iframe{width:100%;height:152px;border:0;border-radius:.75rem}@media(max-width:640px){.track{grid-auto-columns:82%}.stagger{transform:none}.lens-glass{display:none}}@media(prefers-reduced-motion:reduce){.lens-glass,.controls button{transition:none}.controls button:hover,.controls button:focus-visible,.controls button:active{transform:none}.lens-glass{display:none}}
</style>
