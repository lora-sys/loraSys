---
import type { ShowcaseItem } from '../../data/showcase'
import { Image } from 'astro:assets'
import loraHeart from '@/assets/lora-visual/v3/lora-icon-heart-v1.webp'
import loraThinking from '@/assets/lora-visual/v3/lora-icon-thinking-v1.webp'

interface Props {
  id: string
  title: string
  eyebrow: string
  items: ShowcaseItem[]
  locale?: 'zh-CN' | 'en-US'
}

const { id, title, eyebrow, items, locale = 'zh-CN' } = Astro.props
const isEnglish = locale === 'en-US'
const labels = isEnglish
  ? {
      previous: `Previous ${title}`,
      next: `Next ${title}`,
      more: 'Open archive card',
      browse: 'Use the controls or swipe horizontally to browse. Open a card for details.'
    }
  : {
      previous: `上一项：${title}`,
      next: `下一项：${title}`,
      more: '打开档案卡片',
      browse: '使用左右按钮或横向滑动浏览。打开卡片查看详情。'
    }
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const mascotMood = id === 'anime' ? loraThinking : id === 'favorites' ? loraHeart : undefined
---

<section class='showcase' aria-labelledby={`${id}-title`} data-carousel data-showcase-id={id}>
  <header class='showcase-heading'>
    <div class='showcase-title'>
      <div>
        <p>{eyebrow}</p>
        <h2 id={`${id}-title`}>{title}</h2>
      </div>
      {mascotMood && <Image src={mascotMood} alt='' aria-hidden='true' class='showcase-mood' width={108} height={108} loading='lazy' />}
    </div>
    <div class='controls' aria-label={isEnglish ? `${title} controls` : `${title} 控制`}>
      <button class='tactile-action' type='button' data-prev aria-label={labels.previous} disabled
        >←</button
      >
      <button
        class='tactile-action'
        type='button'
        data-next
        aria-label={labels.next}
        disabled={items.length < 2}>→</button
      >
    </div>
  </header>
  <p id={`${id}-carousel-instructions`} class='sr-only'>{labels.browse}</p>
  <div
    class='track'
    tabindex='0'
    data-track
    aria-label={title}
    aria-describedby={`${id}-carousel-instructions`}
  >
    {
      items.map((item, i) => (
        <article
          class='archive-card'
          data-archive-card
          data-source-label={item.sourceLabel}
          data-poster-source={item.posterSource}
          data-video-id={item.video?.provider === 'youtube' ? item.video.id : undefined}
          data-video-source={item.video?.sourceLabel}
          data-spotify={item.spotify ? item.href : undefined}
          data-media-title={
            item.spotify ? [item.name, item.artist].filter(Boolean).join(' — ') : undefined
          }
        >
          <a
            href={item.href}
            target='_blank'
            rel='noopener noreferrer'
            class='archive-card-link'
            data-viewer-trigger
            aria-haspopup='dialog'
          >
            <img
              src={item.image.startsWith('http') ? item.image : `${base}${item.image}`}
              alt={`${item.name} — ${item.description}`}
              width='600'
              height='840'
              loading={item.imageEager ? 'eager' : 'lazy'}
              decoding='async'
              fetchpriority={item.imageEager ? 'high' : undefined}
              referrerpolicy={item.image.startsWith('http') ? 'no-referrer' : undefined}
              style={`--showcase-object-position:${item.objectPosition ?? '50% 50%'}`}
              data-media-kind={item.mediaKind ?? (id === 'anime' ? 'poster' : 'cover')}
              data-fallback={item.imageFallback}
              onerror={
                item.imageFallback
                  ? `if(this.dataset.fallbackUsed!=='1'){this.dataset.fallbackUsed='1';this.src=this.dataset.fallback}`
                  : undefined
              }
            />
            <span class='archive-card-shade' aria-hidden='true' />
            <div class='archive-card-copy'>
              <span>{String(i + 1).padStart(2, '0')}</span>
              <h3>{item.name}</h3>
              <p>{item.description}</p>
              <b>{item.cta || labels.more} ↗</b>
            </div>
          </a>
        </article>
      ))
    }
  </div>
  <div class='carousel-meta'>
    <p data-index aria-live='polite'>1 / {items.length}</p>
    <div class='progress' aria-hidden='true'><i data-progress></i></div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')
    const bar = root.querySelector<HTMLElement>('[data-progress]')
    const index = root.querySelector<HTMLElement>('[data-index]')
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')
    const next = root.querySelector<HTMLButtonElement>('[data-next]')
    const cards = [...root.querySelectorAll<HTMLElement>('[data-archive-card]')]
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)')
    if (!track || !bar || !index || !prev || !next || cards.length === 0) return

    let announceTimer: number | undefined
    let startX = 0
    let startLeft = 0
    let dragged = false

    const activeIndex = () => {
      const left = track.getBoundingClientRect().left
      return cards.reduce((nearest, card, candidate) => {
        const distance = Math.abs(card.getBoundingClientRect().left - left)
        const nearestDistance = Math.abs(cards[nearest].getBoundingClientRect().left - left)
        return distance < nearestDistance ? candidate : nearest
      }, 0)
    }
    const update = (announce = false) => {
      const current = activeIndex()
      index.textContent = `${current + 1} / ${cards.length}`
      bar.style.transform = `scaleX(${cards.length > 1 ? current / (cards.length - 1) : 1})`
      prev.disabled = current === 0
      next.disabled = current === cards.length - 1
      if (announce) {
        index.setAttribute('aria-live', 'polite')
        if (announceTimer) window.clearTimeout(announceTimer)
        announceTimer = window.setTimeout(() => index.setAttribute('aria-live', 'off'), 700)
      }
    }
    const goTo = (candidate: number) => {
      const target = Math.max(0, Math.min(cards.length - 1, candidate))
      track.scrollTo({
        left: cards[target].offsetLeft - track.offsetLeft,
        behavior: reducedMotion.matches ? 'auto' : 'smooth'
      })
      update(true)
    }

    prev.addEventListener('click', () => goTo(activeIndex() - 1))
    next.addEventListener('click', () => goTo(activeIndex() + 1))
    track.addEventListener('scroll', () => update(), { passive: true })
    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault()
        goTo(activeIndex() + (event.key === 'ArrowLeft' ? -1 : 1))
      }
    })
    track.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse' || reducedMotion.matches) return
      startX = event.clientX
      startLeft = track.scrollLeft
      dragged = false
      track.dataset.dragCandidate = 'true'
    })
    track.addEventListener('pointermove', (event) => {
      if (!track.dataset.dragCandidate && !track.dataset.dragging) return
      const delta = event.clientX - startX
      if (!dragged && Math.abs(delta) > 10) {
        dragged = true
        delete track.dataset.dragCandidate
        track.dataset.dragging = 'true'
        track.setPointerCapture(event.pointerId)
      }
      if (dragged) track.scrollLeft = startLeft - delta
    })
    const stopDragging = (event: PointerEvent) => {
      if (!track.dataset.dragCandidate && !track.dataset.dragging) return
      const didDrag = dragged
      if (track.dataset.dragging && track.hasPointerCapture?.(event.pointerId))
        track.releasePointerCapture?.(event.pointerId)
      delete track.dataset.dragCandidate
      delete track.dataset.dragging
      if (didDrag) root.dataset.suppressClick = 'true'
      window.setTimeout(() => {
        dragged = false
        delete root.dataset.suppressClick
      }, 0)
    }
    track.addEventListener('pointerup', stopDragging)
    track.addEventListener('pointercancel', stopDragging)
    track.addEventListener(
      'click',
      (event) => {
        if (root.dataset.suppressClick !== 'true') return
        event.preventDefault()
        event.stopPropagation()
      },
      true
    )

    new ResizeObserver(() => update()).observe(track)
    reducedMotion.addEventListener('change', () => update())
    update()
  })
</script>

<style>
  .showcase {
    display: grid;
    gap: 0.9rem;
  }
  .showcase-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }
  .showcase-title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .showcase-mood {
    width: 3.4rem;
    height: 3.4rem;
    flex: 0 0 auto;
    object-fit: contain;
    transition: transform 180ms ease;
  }
  .showcase:hover .showcase-mood,
  .showcase:focus-within .showcase-mood {
    transform: translateY(-0.2rem) rotate(4deg) scale(1.04);
  }
  @media (prefers-reduced-motion: reduce) {
    .showcase-mood {
      transition: none;
    }
    .showcase:hover .showcase-mood,
    .showcase:focus-within .showcase-mood {
      transform: none;
    }
  }
  .showcase-heading p {
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.69rem;
    text-transform: uppercase;
    letter-spacing: 0.11em;
  }
  .showcase h2 {
    margin: 0.35rem 0 0;
    font-size: clamp(1.2rem, 2.2vw, 1.55rem);
    font-weight: 630;
  }
  .controls {
    display: flex;
    gap: 0.4rem;
  }
  .controls button {
    display: inline-grid;
    width: 2.35rem;
    height: 2.35rem;
    place-items: center;
    border: 1px solid hsl(var(--border));
    border-radius: 50%;
    background: hsl(var(--background));
    color: hsl(var(--foreground));
    transition:
      background-color 140ms ease,
      border-color 140ms ease;
  }
  .controls button:hover,
  .controls button:focus-visible {
    border-color: hsl(var(--field-amber));
    background: hsl(var(--muted));
  }
  .controls button:focus-visible,
  .archive-card-link:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 3px;
  }
  .controls button:disabled {
    opacity: 0.38;
    cursor: not-allowed;
  }
  .track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(15rem, 42%);
    gap: 1rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: x mandatory;
    padding: 0.35rem 0.2rem 1rem;
    scrollbar-width: none;
    touch-action: pan-x;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .track[data-dragging] {
    scroll-snap-type: none;
    user-select: none;
  }
  .archive-card {
    position: relative;
    min-height: 21rem;
    overflow: hidden;
    border: 1px solid hsl(var(--border));
    border-radius: 0.85rem;
    background: hsl(var(--card));
    scroll-snap-align: start;
  }
  .archive-card-link {
    position: absolute;
    inset: 0;
    display: block;
    color: white;
    text-decoration: none;
  }
  .archive-card-link > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--showcase-object-position, 50% 50%);
  }
  .archive-card-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 30%, rgb(0 0 0 / 0.84));
  }
  .archive-card-copy {
    position: absolute;
    inset: auto 1rem 1rem;
    display: grid;
    gap: 0.35rem;
  }
  .archive-card-copy > span {
    font-size: 0.67rem;
    letter-spacing: 0.13em;
    opacity: 0.78;
  }
  .archive-card-copy h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 650;
  }
  .archive-card-copy p {
    margin: 0;
    color: rgb(255 255 255 / 0.78);
    font-size: 0.78rem;
    line-height: 1.5;
  }
  .archive-card-copy b {
    margin-top: 0.15rem;
    font-size: 0.7rem;
    font-weight: 600;
  }
  .carousel-meta {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.7rem;
  }
  .carousel-meta p {
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.64rem;
    font-variant-numeric: tabular-nums;
  }
  .progress {
    height: 2px;
    overflow: hidden;
    background: hsl(var(--border));
  }
  .progress i {
    display: block;
    width: 100%;
    height: 100%;
    transform: scaleX(0);
    transform-origin: left;
    background: hsl(var(--foreground));
  }
  @media (max-width: 640px) {
    .track {
      grid-auto-columns: 82%;
    }
    .archive-card {
      min-height: 20rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .controls button {
      transition: none;
    }
    .track {
      scroll-behavior: auto;
    }
  }
</style>
