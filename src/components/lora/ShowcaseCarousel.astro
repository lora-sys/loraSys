---
import { Image } from 'astro:assets'

import loraHeart from '@/assets/lora-visual/v3/lora-icon-heart-v1.webp'
import loraThinking from '@/assets/lora-visual/v3/lora-icon-thinking-v1.webp'

import type { ShowcaseItem } from '../../data/showcase'

interface Props {
  id: string
  title: string
  eyebrow: string
  items: ShowcaseItem[]
  locale?: 'zh-CN' | 'en-US'
}

const { id, title, eyebrow, items, locale = 'zh-CN' } = Astro.props
const isEnglish = locale === 'en-US'
const isAnime = id === 'anime'
const labels = isEnglish
  ? {
      previous: `Previous ${title}`,
      next: `Next ${title}`,
      more: 'Open archive card',
      browse:
        'Swipe or use the arrows to browse. When this strip has focus, use the arrow keys, Home or End.',
      featured: 'First in the collection',
      screening: 'Open card & trailer',
      strip: 'The complete collection',
      swipe: 'Scroll to explore',
      trailer: 'Trailer',
      video: 'Video',
      music: 'Listen',
      anime: 'Anime',
      collection: 'Collection'
    }
  : {
      previous: `上一组：${title}`,
      next: `下一组：${title}`,
      more: '打开档案',
      browse: '横向滑动或使用左右按钮浏览。聚焦此列表时，可使用方向键、Home 和 End。',
      featured: '从这部开始',
      screening: '查看档案与预告',
      strip: '完整片单',
      swipe: '横向浏览',
      trailer: '预告',
      video: '视频',
      music: '收听',
      anime: '动画',
      collection: '收藏'
    }
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const imageUrl = (item: ShowcaseItem) =>
  item.image.startsWith('http') ? item.image : `${base}${item.image}`
const mascotMood = isAnime ? loraThinking : loraHeart
const first = isAnime ? items[0] : undefined
const directMediaUrl = (item: ShowcaseItem) =>
  item.video?.watchUrl ||
  (item.spotify ? item.href.replace('/embed/track/', '/track/').split('?')[0] : '')
const directMediaLabel = (item: ShowcaseItem) =>
  item.spotify
    ? isEnglish
      ? 'Listen on Spotify'
      : '在 Spotify 收听'
    : isEnglish
      ? `Watch on ${item.video?.provider === 'bilibili' ? 'Bilibili' : 'YouTube'}`
      : `在 ${item.video?.provider === 'bilibili' ? 'B站' : 'YouTube'} 观看原片`
const mediaLabel = (item: ShowcaseItem) =>
  item.video
    ? `${item.video.provider === 'bilibili' ? 'Bilibili' : 'YouTube'} · ${item.video.provider === 'youtube' ? labels.trailer : labels.video}`
    : item.spotify
      ? `Spotify · ${labels.music}`
      : ''
---

<section
  class:list={['showcase', { 'showcase--anime': isAnime }]}
  aria-labelledby={`${id}-title`}
  data-carousel
  data-showcase-id={id}
>
  <header class='showcase-heading'>
    <div class='showcase-title'>
      <div>
        <p>{eyebrow}</p>
        <h2 id={`${id}-title`}>
          {title}<span class='collection-count'>{String(items.length).padStart(2, '0')}</span>
        </h2>
      </div>
      <Image
        src={mascotMood}
        alt=''
        aria-hidden='true'
        class='showcase-mood'
        width={108}
        height={108}
        loading='lazy'
      />
    </div>
    <div class='controls' aria-label={isEnglish ? `${title} controls` : `${title} 控制`}>
      <button
        type='button'
        data-prev
        aria-label={labels.previous}
        aria-controls={`${id}-track`}
        disabled>←</button
      >
      <button
        type='button'
        data-next
        aria-label={labels.next}
        aria-controls={`${id}-track`}
        disabled={items.length < 2}>→</button
      >
    </div>
  </header>
  {
    first && (
      <a
        class='exhibition-card'
        href={first.href}
        target='_blank'
        rel='noopener noreferrer'
        data-viewer-trigger
        data-item-index='0'
        aria-haspopup='dialog'
      >
        <div class='exhibition-copy'>
          <span class='exhibition-label'>
            <span aria-hidden='true'>01</span> {labels.featured}
          </span>
          <h3>{first.name}</h3>
          <p>{first.description}</p>
          <div class='exhibition-tags'>
            <span>{first.medium || labels.anime}</span>
            {first.video && <span>{mediaLabel(first)}</span>}
          </div>
          <span class='exhibition-action'>
            <span class='play-mark' aria-hidden='true'>
              ▷
            </span>
            {labels.more}
            <span aria-hidden='true'>↗</span>
          </span>
        </div>
        <div class='exhibition-art' data-magnifier>
          <img
            src={imageUrl(first)}
            alt=''
            width='600'
            height='840'
            loading='lazy'
            decoding='async'
            style={`object-position:${first.objectPosition ?? '50% 50%'}`}
          />
          <span class='artwork-lens' data-artwork-lens aria-hidden='true' hidden><span /></span>
          <span class='exhibition-caption' aria-hidden='true'>
            {eyebrow}
          </span>
        </div>
      </a>
    )
  }
  <div class='strip-heading'>
    <p>{isAnime ? labels.strip : eyebrow}</p><span
      >{labels.swipe} <span aria-hidden='true'>→</span></span
    >
  </div>
  <p id={`${id}-carousel-instructions`} class='sr-only'>{labels.browse}</p>
  <div
    class='track'
    id={`${id}-track`}
    tabindex='0'
    data-track
    aria-label={title}
    aria-describedby={`${id}-carousel-instructions`}
  >
    {
      items.map((item, i) => (
        <article
          class='archive-card'
          data-archive-card
          data-source-label={item.sourceLabel}
          data-poster-source={item.posterSource}
          data-medium={item.medium || (isAnime ? labels.anime : labels.collection)}
          data-video-provider={item.video?.provider}
          data-video-id={item.video?.id}
          data-video-source={item.video?.sourceLabel}
          data-video-title={item.video?.title}
          data-video-source-url={item.video?.sourceUrl}
          data-video-watch-url={item.video?.watchUrl}
          data-video-uploader={item.video?.uploader}
          data-video-checked-at={item.video?.checkedAt}
          data-video-embed={item.video ? String(item.video.embed !== false) : undefined}
          data-spotify={item.spotify ? item.href : undefined}
          data-media-title={
            item.spotify ? [item.name, item.artist].filter(Boolean).join(' · ') : undefined
          }
        >
          <a
            href={item.href}
            target='_blank'
            rel='noopener noreferrer'
            class='archive-card-link'
            data-viewer-trigger
            data-item-index={i}
            aria-haspopup='dialog'
          >
            <div class='archive-art' data-magnifier>
              <img
                src={imageUrl(item)}
                alt=''
                width='600'
                height='840'
                loading={item.imageEager ? 'eager' : 'lazy'}
                decoding='async'
                fetchpriority={item.imageEager ? 'high' : undefined}
                referrerpolicy={item.image.startsWith('http') ? 'no-referrer' : undefined}
                style={`--showcase-object-position:${item.objectPosition ?? '50% 50%'}`}
                data-media-kind={item.mediaKind ?? (isAnime ? 'poster' : 'cover')}
                data-fallback={item.imageFallback}
                onerror={
                  item.imageFallback
                    ? `if(this.dataset.fallbackUsed!=='1'){this.dataset.fallbackUsed='1';this.src=this.dataset.fallback}`
                    : undefined
                }
              />
              <span class='artwork-lens' data-artwork-lens aria-hidden='true' hidden><span /></span>
              <span class='archive-number' aria-hidden='true'>
                {String(i + 1).padStart(2, '0')}
              </span>
              {!isAnime && <span class='format-label'>{item.medium || labels.collection}</span>}
              {(item.video || item.spotify) && (
                <span class='media-label'>
                  <span aria-hidden='true'>{item.video?.provider === 'bilibili' ? '↗' : '▷'}</span>
                  {mediaLabel(item)}
                </span>
              )}
            </div>
            <div class='archive-card-copy'>
              <h3>{item.name}</h3>
              <p>{item.description}</p>
              <span class='archive-card-action'>
                {labels.more}
                <span aria-hidden='true'>↗</span>
              </span>
            </div>
          </a>
          {directMediaUrl(item) && (
            <a
              class='direct-media-link'
              data-media-direct
              href={directMediaUrl(item)}
              target='_blank'
              rel='noopener noreferrer'
              aria-label={`${item.name} · ${directMediaLabel(item)}`}
            >
              {directMediaLabel(item)} <span aria-hidden='true'>↗</span>
            </a>
          )}
        </article>
      ))
    }
  </div>
  <div class='carousel-meta'>
    <p data-index aria-live='off'>01 / {String(items.length).padStart(2, '0')}</p>
    <div class='progress' aria-hidden='true'><i data-progress></i></div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')
    const bar = root.querySelector<HTMLElement>('[data-progress]')
    const index = root.querySelector<HTMLElement>('[data-index]')
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')
    const next = root.querySelector<HTMLButtonElement>('[data-next]')
    const cards = [...root.querySelectorAll<HTMLElement>('[data-archive-card]')]
    if (!track || !bar || !index || !prev || !next || !cards.length) return
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)')
    const finePointer = matchMedia('(hover: hover) and (pointer: fine)')
    const hideLenses: (() => void)[] = []
    const dismissLenses: (() => void)[] = []
    root.querySelectorAll<HTMLElement>('[data-magnifier]').forEach((art) => {
      const image = art.querySelector<HTMLImageElement>('img')
      const lens = art.querySelector<HTMLElement>('[data-artwork-lens]')
      const copy = lens?.querySelector<HTMLElement>('span')
      const trigger = art.closest<HTMLAnchorElement>('[data-viewer-trigger]')
      if (!image || !lens || !copy || !trigger) return
      // Match the original Svelte Lens: anime 1.5× / 150px, favorites 1.4× / 120px.
      lens.style.setProperty('--lens-zoom', root.dataset.showcaseId === 'anime' ? '1.5' : '1.4')
      lens.style.setProperty('--lens-radius', root.dataset.showcaseId === 'anime' ? '75px' : '60px')
      let bounds: DOMRect | undefined
      let frame: number | undefined
      let dismissed = false
      const hide = () => {
        lens.hidden = true
        bounds = undefined
        if (frame !== undefined) cancelAnimationFrame(frame)
        frame = undefined
      }
      hideLenses.push(hide)
      dismissLenses.push(() => {
        if (!lens.hidden || document.activeElement === trigger) dismissed = true
        hide()
      })
      const prepare = () => {
        if (dismissed || !image.complete || !image.naturalWidth) return false
        if (!bounds) {
          bounds = art.getBoundingClientRect()
          const imageStyle = getComputedStyle(image)
          copy.style.backgroundImage = `url(${JSON.stringify(image.currentSrc || image.src)})`
          copy.style.backgroundSize = imageStyle.objectFit
          copy.style.backgroundPosition = imageStyle.objectPosition
        }
        return true
      }
      const position = (x: number, y: number) => {
        if (!bounds) return
        lens.style.setProperty('--lens-x', `${Math.max(0, Math.min(bounds.width, x))}px`)
        lens.style.setProperty('--lens-y', `${Math.max(0, Math.min(bounds.height, y))}px`)
        lens.hidden = false
      }
      const follow = (event: PointerEvent) => {
        if (!finePointer.matches || event.pointerType === 'touch' || event.buttons) {
          hide()
          return
        }
        if (!prepare() || !bounds) return
        if (reducedMotion.matches) {
          position(bounds.width / 2, bounds.height / 2)
          return
        }
        const x = event.clientX - bounds.left
        const y = event.clientY - bounds.top
        if (frame !== undefined) cancelAnimationFrame(frame)
        frame = requestAnimationFrame(() => {
          frame = undefined
          position(x, y)
        })
      }
      art.addEventListener('pointerenter', follow)
      art.addEventListener('pointermove', follow)
      art.addEventListener('pointerleave', () => {
        hide()
        dismissed = false
      })
      art.addEventListener('pointerdown', hide)
      art.addEventListener('pointercancel', hide)
      trigger.addEventListener('focus', () => {
        dismissed = false
        if (trigger.matches(':focus-visible') && prepare() && bounds)
          position(bounds.width / 2, bounds.height / 2)
      })
      trigger.addEventListener('blur', hide)
      trigger.addEventListener('click', hide)
      image.addEventListener('error', hide)
      image.addEventListener('load', () => {
        hide()
        if (
          document.activeElement === trigger &&
          trigger.matches(':focus-visible') &&
          prepare() &&
          bounds
        )
          position(bounds.width / 2, bounds.height / 2)
      })
    })
    const hideAllLenses = () => hideLenses.forEach((hide) => hide())
    window.addEventListener('scroll', hideAllLenses, { passive: true, capture: true })
    window.addEventListener('resize', hideAllLenses)
    window.addEventListener('blur', hideAllLenses)
    window.addEventListener('pagehide', hideAllLenses)
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') dismissLenses.forEach((dismiss) => dismiss())
    })
    finePointer.addEventListener('change', hideAllLenses)
    reducedMotion.addEventListener('change', hideAllLenses)
    let announceTimer: number | undefined
    const update = () => {
      const maxScroll = Math.max(0, track.scrollWidth - track.clientWidth)
      const position = Math.max(0, Math.min(maxScroll, track.scrollLeft))
      const atEnd = position >= maxScroll - 2
      const trackLeft = track.getBoundingClientRect().left
      const nearest = cards.reduce(
        (best, card, candidate) =>
          Math.abs(card.getBoundingClientRect().left - trackLeft) <
          Math.abs(cards[best].getBoundingClientRect().left - trackLeft)
            ? candidate
            : best,
        0
      )
      const current = atEnd && maxScroll > 2 ? cards.length - 1 : nearest
      index.textContent = `${String(current + 1).padStart(2, '0')} / ${String(cards.length).padStart(2, '0')}`
      bar.style.transform = `scaleX(${maxScroll > 2 ? Math.max(1 / cards.length, position / maxScroll) : 1})`
      prev.disabled = position <= 2
      next.disabled = atEnd
    }
    const move = (left: number) => {
      index.setAttribute('aria-live', 'polite')
      if (announceTimer) window.clearTimeout(announceTimer)
      track.scrollTo({ left, behavior: reducedMotion.matches ? 'auto' : 'smooth' })
      announceTimer = window.setTimeout(() => index.setAttribute('aria-live', 'off'), 1000)
    }
    prev.addEventListener('click', () => move(track.scrollLeft - track.clientWidth * 0.8))
    next.addEventListener('click', () => move(track.scrollLeft + track.clientWidth * 0.8))
    track.addEventListener('scroll', update, { passive: true })
    track.addEventListener('keydown', (event) => {
      if (event.target !== track) return
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return
      event.preventDefault()
      move(
        event.key === 'Home'
          ? 0
          : event.key === 'End'
            ? track.scrollWidth
            : track.scrollLeft + (event.key === 'ArrowLeft' ? -1 : 1) * track.clientWidth * 0.8
      )
    })
    new ResizeObserver(update).observe(track)
    update()
  })
</script>

<style>
  .direct-media-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
    margin: 0 1rem 1rem;
    border-top: 1px solid hsl(var(--border));
    padding-top: 0.8rem;
    color: hsl(var(--foreground));
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .direct-media-link:focus-visible {
    outline: 2px solid hsl(var(--foreground));
    outline-offset: 3px;
  }

  .showcase {
    min-width: 0;
    display: grid;
    gap: 1rem;
  }
  .showcase-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .showcase-title {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .showcase-heading p {
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.69rem;
    letter-spacing: 0.08em;
  }
  .showcase h2 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0.35rem 0 0;
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 650;
    letter-spacing: -0.04em;
  }
  .collection-count {
    border: 1px solid hsl(var(--border));
    border-radius: 50%;
    padding: 0.3rem 0.35rem;
    color: hsl(var(--muted-foreground));
    font:
      0.65rem ui-monospace,
      monospace;
    letter-spacing: 0;
  }
  .showcase-mood {
    width: 3.6rem;
    height: 3.6rem;
    object-fit: contain;
  }
  .controls {
    display: flex;
    gap: 0.45rem;
  }
  .controls button {
    display: inline-grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid hsl(var(--border));
    border-radius: 50%;
    background: hsl(var(--field-paper));
    color: hsl(var(--foreground));
    cursor: pointer;
  }
  .controls button:hover:not(:disabled) {
    border-color: var(--collection-accent);
    background: hsl(var(--field-teal) / 0.08);
  }
  .controls button:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .showcase :is(button, a, [tabindex]):focus-visible {
    outline: 2px solid hsl(var(--field-teal));
    outline-offset: 4px;
  }
  .exhibition-card {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    min-height: 21rem;
    overflow: hidden;
    border: 1px solid hsl(var(--field-ink) / 0.22);
    border-radius: 0.65rem;
    background: hsl(var(--field-warm) / 0.45);
    color: hsl(var(--foreground));
    text-decoration: none;
    box-shadow: 3px 4px 0 hsl(var(--field-ink) / 0.08);
  }
  .exhibition-copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: start;
    justify-content: center;
    padding: clamp(1.4rem, 4vw, 3.5rem);
  }
  .exhibition-label {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--collection-accent);
    font-size: 0.69rem;
    letter-spacing: 0.08em;
  }
  .exhibition-label > span {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid hsl(var(--field-teal) / 0.4);
    border-radius: 50%;
    font-family: ui-monospace, monospace;
    letter-spacing: 0;
  }
  .exhibition-copy h3 {
    max-width: 12ch;
    margin: 1rem 0 0.65rem;
    font-size: clamp(2rem, 4.8vw, 3.6rem);
    line-height: 1.12;
    font-weight: 650;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .exhibition-copy > p {
    max-width: 29ch;
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.88rem;
    line-height: 1.8;
  }
  .exhibition-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 1rem;
  }
  .exhibition-tags > span {
    padding: 0.25rem 0.5rem;
    border: 1px solid hsl(var(--field-ink) / 0.16);
    border-radius: 0.2rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.65rem;
  }
  .exhibition-action {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.55rem;
    min-height: 2.5rem;
    color: var(--collection-accent);
    font-size: 0.8rem;
    font-weight: 650;
  }
  .play-mark {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 1px solid hsl(var(--field-teal) / 0.4);
    border-radius: 50%;
    font-size: 1.2rem;
    transition: transform 160ms ease;
  }
  .exhibition-card:hover .play-mark {
    transform: scale(1.06);
  }
  .exhibition-art {
    position: relative;
    min-height: 22rem;
    background: #263b36;
    overflow: hidden;
  }
  .exhibition-art::after {
    position: absolute;
    content: '';
    inset: 0;
    background: linear-gradient(0deg, rgb(13 29 25 / 0.8), transparent 32%);
  }
  .exhibition-art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .exhibition-caption {
    position: absolute;
    z-index: 1;
    bottom: 1.2rem;
    left: 1.4rem;
    right: 1.4rem;
    padding-top: 0.7rem;
    border-top: 1px solid rgb(255 255 255 / 0.35);
    color: #fff8eb;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }
  .strip-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.35rem;
    color: hsl(var(--muted-foreground));
  }
  .strip-heading p {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 600;
  }
  .strip-heading > span {
    font-size: 0.65rem;
  }
  .track {
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(14.5rem, 26%);
    gap: 1rem;
    padding: 0.4rem 0.4rem 0.8rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    scrollbar-color: hsl(var(--border)) transparent;
  }
  .showcase--anime .track {
    grid-auto-columns: minmax(10.5rem, 18.8%);
    gap: 0.8rem;
  }
  .archive-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid hsl(var(--border));
    border-radius: 0.4rem;
    background: hsl(var(--field-paper));
    scroll-snap-align: start;
  }
  .archive-card:focus-within {
    outline: 2px solid hsl(var(--field-teal));
    outline-offset: 3px;
  }
  .archive-card-link {
    display: flex;
    flex: 1;
    flex-direction: column;
    color: hsl(var(--foreground));
    text-decoration: none;
  }
  .archive-art {
    position: relative;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: hsl(var(--muted));
  }
  .showcase--anime .archive-art {
    aspect-ratio: 3 / 4;
  }
  .archive-art::after {
    position: absolute;
    content: '';
    inset: 55% 0 0;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.45));
    pointer-events: none;
