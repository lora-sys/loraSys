---
import type { ShowcaseItem } from '../../data/showcase'
interface Props { id: string; title: string; eyebrow: string; items: ShowcaseItem[] }
const { id, title, eyebrow, items } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---
<section class='showcase' aria-labelledby={`${id}-title`} data-carousel>
  <header><div><p>{eyebrow}</p><h2 id={`${id}-title`}>{title}</h2></div><div class='controls'><button type='button' data-prev aria-label={`Previous ${title}`}>←</button><button type='button' data-next aria-label={`Next ${title}`}>→</button></div></header>
  <div class='track' tabindex='0' data-track aria-label={title}>
    {items.map((item, i) => <article class:list={['magic-card', { stagger: i % 2 }]} data-magic>
      <a href={item.href} target='_blank' rel='noreferrer' class='lens' data-lens>
        <img src={`${base}${item.image}`} alt='' width='600' height='840' loading='lazy' />
        <span class='lens-pane' aria-hidden='true'></span>
        <div class='copy'><span>{String(i + 1).padStart(2, '0')}</span><h3>{item.name}</h3><p>{item.description}</p></div>
      </a>
    </article>)}
  </div>
  <div class='progress' aria-hidden='true'><i data-progress></i></div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!; const bar = root.querySelector<HTMLElement>('[data-progress]')!
    const move = (n:number) => track.scrollBy({ left: n * Math.min(track.clientWidth * .82, 420), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' })
    root.querySelector('[data-prev]')?.addEventListener('click', () => move(-1)); root.querySelector('[data-next]')?.addEventListener('click', () => move(1))
    track.addEventListener('keydown', e => { if (e.key === 'ArrowLeft') { e.preventDefault(); move(-1) } if (e.key === 'ArrowRight') { e.preventDefault(); move(1) } })
    const update = () => { const max = track.scrollWidth - track.clientWidth; bar.style.transform = `scaleX(${max ? track.scrollLeft / max : 1})` }; track.addEventListener('scroll', update, { passive: true }); update()
  })
  if (matchMedia('(hover:hover)').matches) document.querySelectorAll<HTMLElement>('[data-magic]').forEach(card => card.addEventListener('pointermove', e => { const r=card.getBoundingClientRect(); card.style.setProperty('--mx', `${e.clientX-r.left}px`); card.style.setProperty('--my', `${e.clientY-r.top}px`) }))
  if (matchMedia('(hover:hover) and (prefers-reduced-motion: no-preference)').matches) document.querySelectorAll<HTMLElement>('[data-lens]').forEach(lens => lens.addEventListener('pointermove', e => { const r=lens.getBoundingClientRect(); lens.style.setProperty('--lx', `${(e.clientX-r.left)/r.width*100}%`); lens.style.setProperty('--ly', `${(e.clientY-r.top)/r.height*100}%`) }))
</script>
<style>
  .showcase{display:grid;gap:1rem}.showcase header{display:flex;align-items:end;justify-content:space-between}.showcase header p{margin:0;color:hsl(var(--muted-foreground));font-size:.75rem;text-transform:uppercase;letter-spacing:.14em}.showcase h2{font-size:1.25rem;font-weight:600}.controls{display:flex;gap:.4rem}.controls button{width:2.25rem;height:2.25rem;border:1px solid hsl(var(--border));border-radius:999px;background:hsl(var(--background));transition:background .2s}.controls button:hover,.controls button:focus-visible{background:hsl(var(--muted));outline:2px solid hsl(var(--ring));outline-offset:2px}.track{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(15rem,42%);gap:1rem;overflow-x:auto;scroll-snap-type:x mandatory;padding:.5rem .2rem 1rem;scrollbar-width:none}.track::-webkit-scrollbar{display:none}.magic-card{position:relative;scroll-snap-align:start;border:1px solid hsl(var(--border));border-radius:1rem;overflow:hidden;background:hsl(var(--card));min-height:22rem}.magic-card::after{content:'';position:absolute;inset:0;pointer-events:none;background:radial-gradient(240px circle at var(--mx,-100px) var(--my,-100px),hsl(var(--primary)/.13),transparent 70%)}.lens{display:block;position:absolute;inset:0;color:white}.lens img{width:100%;height:100%;object-fit:cover;transition:transform .5s}.lens-pane{position:absolute;inset:0;background:linear-gradient(transparent 35%,rgb(0 0 0/.84))}.lens:hover img{transform:scale(1.045);transform-origin:var(--lx,50%) var(--ly,50%)}.copy{position:absolute;inset:auto 1.1rem 1.1rem;display:grid;gap:.3rem}.copy span{font-size:.7rem;letter-spacing:.15em;opacity:.75}.copy h3{font-size:1.12rem;font-weight:600}.copy p{font-size:.84rem;line-height:1.45;color:rgb(255 255 255/.76)}.progress{height:2px;background:hsl(var(--border));overflow:hidden}.progress i{display:block;height:100%;background:hsl(var(--foreground));transform:scaleX(0);transform-origin:left}.stagger{transform:translateY(1rem)}@media(max-width:640px){.track{grid-auto-columns:82%}.stagger{transform:none}}@media(prefers-reduced-motion:reduce){.lens img,.controls button{transition:none}.lens:hover img{transform:none}}
</style>
