---
import { uiLocale, text } from '@/i18n/ui'
import data from '../../data/contributions.json'
interface Day { date: string; contributionCount: number }
interface Week { contributionDays: Day[] }
interface Props { compact?: boolean; locale?: 'zh-CN' | 'en-US' }
const { compact = false, locale = uiLocale(Astro.url.pathname) } = Astro.props
const t = (zh: string, en: string) => text(locale, zh, en)
const allWeeks = data.weeks as Week[]
const weeks = compact ? allWeeks.slice(-12) : allWeeks
const days = weeks.flatMap(week => week.contributionDays)
const max = Math.max(1, ...days.map(day => day.contributionCount))
const level = (count: number) => count === 0 ? 0 : Math.max(1, Math.ceil(count / max * 4))
const total = days.reduce((sum, day) => sum + day.contributionCount, 0)
const monthLabels = weeks.map((week, index) => {
  const date = new Date(`${week.contributionDays[0]?.date}T00:00:00Z`)
  const previous = index ? new Date(`${weeks[index - 1].contributionDays[0]?.date}T00:00:00Z`).getUTCMonth() : -1
  return date.getUTCMonth() !== previous ? date.toLocaleString(locale, { month: 'short', timeZone: 'UTC' }) : ''
})
---
<section class:list={['contributions', { compact }]} aria-labelledby={`contribution-title-${compact ? 'compact' : 'full'}`} data-contributions>
  <header><div><p>{t('公开贡献', 'Open-source activity')}</p><h2 id={`contribution-title-${compact ? 'compact' : 'full'}`}>{t('GitHub 贡献记录', 'GitHub contributions')}</h2></div><strong>{total.toLocaleString(locale)}</strong></header>
  {days.length ? <>
    <div class='chart-wrap' tabindex='0' role='region' aria-label={t('贡献日历，可使用方向键横向滚动', 'Contribution calendar. Use arrow keys to scroll horizontally.')}>
      <div class='months' aria-hidden='true'>{monthLabels.map(month => <span>{month}</span>)}</div>
      <div class='plot'><div class='weekdays' aria-hidden='true'><span>{t('一', 'Mon')}</span><span>{t('三', 'Wed')}</span><span>{t('五', 'Fri')}</span></div><div class='calendar' role='img' aria-label={t(`${total} 次 GitHub 贡献，${compact ? '最近十二周' : '最近一年'}`, `${total} GitHub contributions ${compact ? 'in the last 12 weeks' : 'in the last year'}`)}>{days.map(day => <span class={`level-${level(day.contributionCount)}`} aria-hidden='true' data-tip={`${new Date(`${day.date}T00:00:00Z`).toLocaleDateString(locale, { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })} · ${day.contributionCount}`} data-evidence={day.contributionCount === max ? 'true' : undefined}></span>)}</div></div>
    </div>
    <div class='legend'><span>{t('少', 'Less')}</span>{[0, 1, 2, 3, 4].map(n => <i class={`level-${n}`}></i>)}<span>{t('多', 'More')}</span></div>
    <div class='tooltip' role='status' aria-live='polite' data-tooltip></div>
    <footer><span>{compact ? t('最近十二周', 'Last 12 weeks') : `${t('更新', 'Updated')} ${new Date(data.lastUpdated).toLocaleDateString(locale, { timeZone: 'UTC' })}`}</span>{compact ? <a href={locale === 'en-US' ? '/en/about' : '/about'}>{t('查看全年', 'Full year')} →</a> : <a href='https://github.com/lora-sys' target='_blank' rel='noopener noreferrer'>{t('查看主页', 'View profile')} →</a>}</footer>
  </> : <p class='empty'>{t('首次同步后显示贡献记录。', 'Contribution history appears after the first sync.')}</p>}
  <details class='daily-records'><summary>{t('按日期查看贡献数', 'View daily contribution counts')}</summary><ul tabindex='0' aria-label={t('每日贡献数，可使用方向键滚动', 'Daily contribution counts. Use arrow keys to scroll.')} >{[...days].reverse().map(day => <li><time datetime={day.date}>{day.date}</time><span>{day.contributionCount}</span></li>)}</ul></details>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-contributions]').forEach(root => {
    const tip = root.querySelector<HTMLElement>('[data-tooltip]')
    if (!tip) return
    root.querySelectorAll<HTMLElement>('[data-tip]').forEach(cell => {
      cell.addEventListener('mouseenter', () => { tip.textContent = cell.dataset.tip || ''; tip.classList.add('show') })
      cell.addEventListener('mouseleave', () => tip.classList.remove('show'))
    })
  })
</script>
<style>
  .daily-records{font-size:.8rem}.daily-records summary{cursor:pointer;min-height:2.75rem;padding-block:.6rem}.daily-records ul{list-style:none;max-height:15rem;overflow:auto;padding:0}.daily-records li{display:flex;gap:1.5rem;padding:.3rem 0}
  .contributions{--c0:hsl(var(--muted));--c1:#b7eadc;--c2:#62cfb3;--c3:#22a98d;--c4:#087460;position:relative;overflow:hidden;border:1px solid hsl(var(--border));border-radius:1rem;padding:1.2rem;background:hsl(var(--card));display:grid;gap:.7rem}
  :global(.dark) .contributions{--c0:#202b2a;--c1:#174f46;--c2:#147a68;--c3:#19a98d;--c4:#4ed8ba}.contributions header,.contributions footer{position:relative;display:flex;justify-content:space-between;align-items:end;gap:1rem}.contributions header p{font-size:.72rem;letter-spacing:.08em;color:hsl(var(--muted-foreground));margin:0}.contributions h2{font-size:1.12rem;font-weight:600}.contributions strong{font-variant-numeric:tabular-nums;font-size:1.4rem}.chart-wrap{overflow-x:auto;padding-bottom:.2rem}.chart-wrap:focus-visible,.daily-records ul:focus-visible{outline:2px solid hsl(var(--ring));outline-offset:3px}.months{display:grid;grid-auto-flow:column;grid-auto-columns:.65rem;gap:.18rem;margin-left:2rem;min-width:max-content;height:1rem}.months span{font-size:.6rem;color:hsl(var(--muted-foreground));white-space:nowrap}.plot{display:flex;gap:.4rem}.weekdays{display:grid;grid-template-rows:repeat(7,.65rem);gap:.18rem;width:1.6rem}.weekdays span{grid-row:2;font-size:.56rem;color:hsl(var(--muted-foreground))}.weekdays span:nth-child(2){grid-row:4}.weekdays span:nth-child(3){grid-row:6}.calendar{display:grid;grid-template-rows:repeat(7,.65rem);grid-auto-flow:column;grid-auto-columns:.65rem;gap:.18rem;min-width:max-content}.calendar>span,.legend i{display:block;width:.65rem;height:.65rem;border:0;border-radius:2px;background:var(--c0)}.level-1{background:var(--c1)!important}.level-2{background:var(--c2)!important}.level-3{background:var(--c3)!important}.level-4{background:var(--c4)!important}.legend{display:flex;justify-content:flex-end;align-items:center;gap:.25rem;color:hsl(var(--muted-foreground));font-size:.62rem}.legend i{width:.65rem;height:.65rem}.tooltip{min-height:1rem;text-align:right;color:hsl(var(--muted-foreground));font-size:.7rem;opacity:0}.tooltip.show{opacity:1}.contributions footer,.empty{font-size:.78rem;color:hsl(var(--muted-foreground))}.contributions a{color:hsl(var(--foreground));text-decoration:underline;text-underline-offset:3px;min-height:44px;display:inline-flex;align-items:center}
</style>
