---
import data from '../../data/contributions.json'
interface Day { date:string; contributionCount:number }
interface Week { contributionDays:Day[] }
interface Props { compact?:boolean }
const { compact=false }=Astro.props
const allWeeks=data.weeks as Week[]; const weeks=compact?allWeeks.slice(-12):allWeeks
const days=weeks.flatMap(w=>w.contributionDays); const max=Math.max(1,...days.map(d=>d.contributionCount))
const level=(n:number)=>n===0?0:Math.max(1,Math.ceil(n/max*4))
const total=days.reduce((sum,d)=>sum+d.contributionCount,0)
const monthLabels=weeks.map((w,i)=>{const d=new Date(`${w.contributionDays[0]?.date}T00:00:00Z`);const prior=i?new Date(`${weeks[i-1].contributionDays[0]?.date}T00:00:00Z`).getUTCMonth():-1;return d.getUTCMonth()!==prior?d.toLocaleString('en-US',{month:'short',timeZone:'UTC'}):''})
---
<section class:list={['contributions',{compact}]} aria-labelledby={`contribution-title-${compact?'compact':'full'}`} data-contributions data-magic>
 <header><div><p>Open source rhythm</p><h2 id={`contribution-title-${compact?'compact':'full'}`}>GitHub Contributions</h2></div><strong>{total.toLocaleString()}</strong></header>
 {days.length?<><div class='chart-wrap'><div class='months' aria-hidden='true'>{monthLabels.map(m=><span>{m}</span>)}</div><div class='plot'><div class='weekdays' aria-hidden='true'><span>Mon</span><span>Wed</span><span>Fri</span></div><div class='calendar' role='grid' aria-label={`${total} GitHub contributions ${compact?'in the last 12 weeks':'in the last year'}`}>{days.map(day=><button class={`level-${level(day.contributionCount)}`} type='button' role='gridcell' aria-label={`${day.date}: ${day.contributionCount} contribution${day.contributionCount===1?'':'s'}`} data-tip={`${new Date(`${day.date}T00:00:00Z`).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'})} · ${day.contributionCount}`}></button>)}</div></div></div><div class='legend'><span>Less</span>{[0,1,2,3,4].map(n=><i class={`level-${n}`}></i>)}<span>More</span></div><div class='tooltip' role='status' aria-live='polite' data-tooltip></div><footer><span>{compact?'Last 12 weeks':`Updated ${new Date(data.lastUpdated).toLocaleDateString('en-US',{timeZone:'UTC'})}`}</span>{compact?<a href={`${import.meta.env.BASE_URL}about`}>Full year →</a>:<a href='https://github.com/lora-sys' target='_blank' rel='noopener noreferrer'>View profile →</a>}</footer></>:<p class='empty'>Contribution history will appear after the first scheduled build.</p>}
</section>
<script>
 document.querySelectorAll<HTMLElement>('[data-contributions]').forEach(root=>{const tip=root.querySelector<HTMLElement>('[data-tooltip]')!;root.querySelectorAll<HTMLElement>('[data-tip]').forEach(cell=>{const show=()=>{tip.textContent=cell.dataset.tip||'';tip.classList.add('show')};cell.addEventListener('mouseenter',show);cell.addEventListener('focus',show);cell.addEventListener('mouseleave',()=>tip.classList.remove('show'));cell.addEventListener('blur',()=>tip.classList.remove('show'))});if(matchMedia('(hover:hover)').matches){let frame=0;root.addEventListener('pointermove',e=>{cancelAnimationFrame(frame);frame=requestAnimationFrame(()=>{const r=root.getBoundingClientRect();root.style.setProperty('--mx',`${e.clientX-r.left}px`);root.style.setProperty('--my',`${e.clientY-r.top}px`)})})}})
</script>
<style>
.contributions{--c0:hsl(var(--muted));--c1:#b7eadc;--c2:#62cfb3;--c3:#22a98d;--c4:#087460;position:relative;overflow:hidden;border:1px solid hsl(var(--border));border-radius:1rem;padding:1.2rem;background:hsl(var(--card));display:grid;gap:.7rem}.contributions:after{content:'';position:absolute;inset:0;pointer-events:none;background:radial-gradient(380px circle at var(--mx,-500px) var(--my,-500px),rgb(20 184 166/.1),transparent 65%)}:global(.dark) .contributions{--c0:#202b2a;--c1:#174f46;--c2:#147a68;--c3:#19a98d;--c4:#4ed8ba}.contributions header,.contributions footer{position:relative;z-index:1;display:flex;justify-content:space-between;align-items:end;gap:1rem}.contributions header p{font-size:.72rem;text-transform:uppercase;letter-spacing:.14em;color:hsl(var(--muted-foreground));margin:0}.contributions h2{font-size:1.12rem;font-weight:600}.contributions strong{font-variant-numeric:tabular-nums;font-size:1.4rem}.chart-wrap{overflow-x:auto;padding-bottom:.2rem}.months{display:grid;grid-auto-flow:column;grid-auto-columns:.65rem;gap:.18rem;margin-left:2rem;min-width:max-content;height:1rem}.months span{font-size:.6rem;color:hsl(var(--muted-foreground));white-space:nowrap}.plot{display:flex;gap:.4rem}.weekdays{display:grid;grid-template-rows:repeat(7,.65rem);gap:.18rem;width:1.6rem}.weekdays span{grid-row:2;font-size:.56rem;color:hsl(var(--muted-foreground))}.weekdays span:nth-child(2){grid-row:4}.weekdays span:nth-child(3){grid-row:6}.calendar{display:grid;grid-template-rows:repeat(7,.65rem);grid-auto-flow:column;grid-auto-columns:.65rem;gap:.18rem;min-width:max-content}.calendar button,.legend i{border:0;border-radius:2px;background:var(--c0);padding:0}.calendar button{width:.65rem;height:.65rem;transition:transform .15s,outline-color .15s}.calendar button:hover,.calendar button:focus-visible{z-index:2;transform:scale(1.5);outline:1px solid hsl(var(--foreground));outline-offset:1px}.level-1{background:var(--c1)!important}.level-2{background:var(--c2)!important}.level-3{background:var(--c3)!important}.level-4{background:var(--c4)!important}.legend{display:flex;justify-content:flex-end;align-items:center;gap:.25rem;color:hsl(var(--muted-foreground));font-size:.62rem}.legend i{width:.65rem;height:.65rem}.tooltip{min-height:1rem;text-align:right;color:hsl(var(--muted-foreground));font-size:.7rem;opacity:0}.tooltip.show{opacity:1}.contributions footer,.empty{font-size:.78rem;color:hsl(var(--muted-foreground))}.contributions a{color:hsl(var(--foreground));text-decoration:underline;text-underline-offset:3px}@media(prefers-reduced-motion:reduce){.calendar button{transition:none}.calendar button:hover,.calendar button:focus-visible{transform:none}}
</style>
