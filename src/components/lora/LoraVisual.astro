---
import { Image } from 'astro:assets'
import { loraVisuals, type LoraVisualKey, type VisualEntry } from '@/data/lora-visual'
import { uiLocale } from '@/i18n/ui'

interface Props {
  asset: LoraVisualKey
  class?: string
  priority?: boolean
  alt?: string
  quality?: number
  widths?: number[]
}

const englishAlt: Record<LoraVisualKey, string> = {
  heroLora: '', heroMochi: '', heroProps: '',
  avatar: 'Illustrated portrait of Lora.',
  aboutJourney: 'Lora and Mochi follow a path through projects, learning and contributions.',
  aboutHackathon: 'Lora organizes a hackathon evidence board while Mochi holds a timer.',
  nowWorkbench: 'Lora updates the workbench while Mochi rests beside a timer.',
  contactCorrespondence: 'Lora and Mochi prepare letters at their correspondence desk.',
  readingMarker: 'Lora and Mochi place a bookmark in their build notes.',
  favoritesTicket: 'Lora sorts collected tickets while Mochi sits beside the archive box.',
  labLedger: 'Lora and Mochi review interactive prototypes in an experiment notebook.',
  notesStrip: 'Lora and Mochi organize a series of short notes.',
  blogAgentSystems: 'A task moves from a question card through a run box to an evidence record.',
  blogMultimodal: 'Text and images join a timeline of inspectable results.',
  agentRunbook: 'Lora follows a runbook while Mochi carries an evidence folder.',
  mediaWorkbench: 'Lora organizes image and audio evidence in one folder.',
  sandbox: 'Lora places an input in an isolated experiment box and checks its output.',
  shippingLog: 'Lora and Mochi package a completed record for delivery.',
  projectsMap: 'Lora and Mochi unfold a map of agent, visual, simulation, memory and verification projects.',
  linksConstellation: 'Lora and Mochi connect friend-link cards with thread.',
  resumeDossier: 'Lora opens a dossier of experience, projects and supporting records.',
  guestbookPostcard: 'Lora and Mochi put a blank postcard in the guestbook box.',
  indexScene: 'Lora and Mochi search and organize a card index.',
  talksPodium: 'Lora sorts talk cards beside a podium while Mochi watches the microphone.',
  termsLedger: 'Lora and Mochi read the site terms notebook.',
  wayfinding404: 'Lora points toward the way home while Mochi inspects a broken path.',
  stampVerified: '', stampExperiment: '', stampContribution: ''
}
const { asset, class: className, priority = false, alt, quality, widths } = Astro.props
const visual: VisualEntry = loraVisuals[asset]
const resolvedAlt = alt ?? (uiLocale(Astro.url.pathname) === 'en-US' ? englishAlt[asset] : visual.alt)
const decorative = visual.decorative ?? resolvedAlt === ''
---

<Image
  src={visual.src}
  alt={decorative ? '' : resolvedAlt}
  aria-hidden={decorative ? 'true' : undefined}
  class:list={['lora-visual', `lora-visual--${asset}`, className]}
  widths={widths ?? visual.widths}
  sizes={visual.sizes}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  quality={quality ?? visual.quality}
  decoding='async'
/>

<style>
  .lora-visual { display: block; max-width: 100%; height: auto; filter: drop-shadow(0 18px 24px hsl(var(--foreground) / .08)); }
  :global(html.dark) .lora-visual { filter: drop-shadow(0 20px 28px rgb(0 0 0 / .42)) brightness(.92) saturate(.92); }
</style>
