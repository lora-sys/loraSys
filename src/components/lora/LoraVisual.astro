---
import { Image } from 'astro:assets'
import { loraVisuals, type LoraVisualKey, type VisualEntry } from '@/data/lora-visual'

interface Props {
  asset: LoraVisualKey
  class?: string
  priority?: boolean
  alt?: string
  quality?: number
  widths?: number[]
}

const { asset, class: className, priority = false, alt, quality, widths } = Astro.props
const visual: VisualEntry = loraVisuals[asset]
const resolvedAlt = alt ?? visual.alt
const decorative = visual.decorative ?? resolvedAlt === ''
const isPriority = priority
---

<Image
  src={visual.src}
  alt={decorative ? '' : resolvedAlt}
  aria-hidden={decorative ? 'true' : undefined}
  class:list={['lora-visual', `lora-visual--${asset}`, className]}
  widths={widths ?? visual.widths}
  sizes={visual.sizes}
  loading={isPriority ? 'eager' : 'lazy'}
  fetchpriority={isPriority ? 'high' : 'auto'}
  quality={quality ?? visual.quality}
  decoding='async'
/>

<style>
  .lora-visual { display: block; max-width: 100%; height: auto; filter: drop-shadow(0 18px 24px hsl(var(--foreground) / .08)); }
  :global(html.dark) .lora-visual { filter: drop-shadow(0 20px 28px rgb(0 0 0 / .42)) brightness(.92) saturate(.92); }
</style>
