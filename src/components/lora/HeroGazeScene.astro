---
import LoraVisual from './LoraVisual.astro'
---

<div class='hero-gaze-scene' data-hero-gaze aria-hidden='true'>
  <div class='hero-props'><LoraVisual asset='heroProps' priority /></div>
  <div class='hero-lora'>
    <LoraVisual asset='heroLora' priority />
    <i class='pupil pupil--lora-left'></i><i class='pupil pupil--lora-right'></i>
  </div>
  <div class='hero-mochi'>
    <LoraVisual asset='heroMochi' priority />
    <i class='pupil pupil--mochi-left'></i><i class='pupil pupil--mochi-right'></i>
  </div>
</div>

<script>
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)')
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)')

  document.querySelectorAll<HTMLElement>('[data-hero-gaze]').forEach((scene) => {
    const hero = scene.closest<HTMLElement>('[data-field-notes-hero]')
    if (!hero) return
    let frame = 0
    let lastFrame = 0
    let targetX = 0
    let targetY = 0
    let currentX = 0
    let currentY = 0
    const setGaze = () => {
      scene.style.setProperty('--gaze-x', currentX.toFixed(3))
      scene.style.setProperty('--gaze-y', currentY.toFixed(3))
    }
    const tick = (time: number) => {
      frame = 0
      const delta = lastFrame ? Math.min(32, time - lastFrame) / 16.67 : 1
      lastFrame = time
      const easing = 1 - Math.pow(1 - .16, delta)
      currentX += (targetX - currentX) * easing
      currentY += (targetY - currentY) * easing
      setGaze()
      if (Math.abs(targetX - currentX) > .002 || Math.abs(targetY - currentY) > .002) {
        frame = requestAnimationFrame(tick)
      } else {
        currentX = targetX
        currentY = targetY
        lastFrame = 0
        setGaze()
      }
    }
    const queue = () => {
      if (!frame) frame = requestAnimationFrame(tick)
    }
    const reset = () => {
      targetX = 0
      targetY = 0
      if (!finePointer.matches || reducedMotion.matches) {
        if (frame) cancelAnimationFrame(frame)
        frame = 0
        lastFrame = 0
        currentX = 0
        currentY = 0
        setGaze()
        return
      }
      queue()
    }
    const follow = (event: PointerEvent) => {
      if (!finePointer.matches || reducedMotion.matches) return
      const rect = scene.getBoundingClientRect()
      if (!rect.width || !rect.height) return
      targetX = Math.max(-1, Math.min(1, ((event.clientX - rect.left) / rect.width - .5) * 2))
      targetY = Math.max(-1, Math.min(1, ((event.clientY - rect.top) / rect.height - .5) * 2))
      queue()
    }
    hero.addEventListener('pointermove', follow, { passive: true })
    hero.addEventListener('pointerleave', reset)
    finePointer.addEventListener('change', reset)
    reducedMotion.addEventListener('change', reset)
  })
</script>

<style>
  .hero-gaze-scene { --gaze-x: 0; --gaze-y: 0; position: relative; width: min(43vw, 34rem); aspect-ratio: 3 / 2; pointer-events: none; isolation: isolate; }
  .hero-lora,.hero-mochi,.hero-props { position: absolute; inset: 0; will-change: transform; }
  .hero-props { z-index: 0; transform: translate(calc(var(--gaze-x) * -3px), calc(var(--gaze-y) * -3px)); opacity: .82; }
  .hero-lora { z-index: 1; transform: translate(calc(var(--gaze-x) * 4px), calc(var(--gaze-y) * 4px)); }
  .hero-mochi { z-index: 2; width: 54%; left: 46%; top: 30%; transform: translate(calc(var(--gaze-x) * 6px), calc(var(--gaze-y) * 6px)); }
  .hero-gaze-scene :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .pupil { position: absolute; z-index: 3; display: block; width: .34rem; height: .38rem; border-radius: 50%; background: #17130f; box-shadow: inset .1rem .1rem 0 rgb(255 255 255 / .88); transform: translate(calc(var(--gaze-x) * .42rem), calc(var(--gaze-y) * .3rem)); will-change: transform; }
  .pupil--lora-left { left: 34.3%; top: 22%; }
  .pupil--lora-right { left: 37.6%; top: 21.8%; }
  .hero-mochi .pupil { width: .25rem; height: .28rem; transform: translate(calc(var(--gaze-x) * .25rem), calc(var(--gaze-y) * .18rem)); }
  .pupil--mochi-left { left: 68.5%; top: 43.2%; }
  .pupil--mochi-right { left: 73.2%; top: 43.3%; }
  @media (max-width: 760px) { .hero-gaze-scene { width: min(100%, 34rem); } }
  @media (prefers-reduced-motion: reduce) { .hero-lora,.hero-mochi,.hero-props,.pupil { transition: none; transform: none; } }
</style>
