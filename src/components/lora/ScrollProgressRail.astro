---
// 左缘滚动进度仪：竖线填充 + 00→100 计数。只报告真实滚动位置，不做任何演出。
---

<div class='scroll-rail' aria-hidden='true'>
  <span class='scroll-rail-track'><span class='scroll-rail-fill'></span></span>
  <span class='scroll-rail-count'>00</span>
</div>

<style>
  .scroll-rail {
    position: fixed;
    z-index: 40;
    left: clamp(0.7rem, 1.6vw, 1.5rem);
    top: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    transform: translateY(-50%);
    pointer-events: none;
  }
  .scroll-rail-track {
    position: relative;
    display: block;
    width: 2px;
    height: 8.5rem;
    overflow: hidden;
    border-radius: 999px;
    background: hsl(var(--field-ink) / 0.14);
  }
  .scroll-rail-fill {
    position: absolute;
    inset: 0;
    background: hsl(var(--field-amber));
    transform: scaleY(var(--page-progress, 0));
    transform-origin: top;
  }
  .scroll-rail-count {
    min-width: 2.4ch;
    color: hsl(var(--muted-foreground));
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.58rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    text-align: center;
  }
  @media (max-width: 1180px) {
    .scroll-rail {
      display: none;
    }
  }
</style>

<script>
  const rail = document.querySelector('.scroll-rail')
  if (rail) {
    const fill = rail.querySelector<HTMLElement>('.scroll-rail-fill')
    const count = rail.querySelector<HTMLElement>('.scroll-rail-count')
    let ticking = false
    const update = () => {
      ticking = false
      const max = document.documentElement.scrollHeight - window.innerHeight
      const progress = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0
      fill?.style.setProperty('--page-progress', progress.toFixed(4))
      if (count) count.textContent = String(Math.round(progress * 100)).padStart(2, '0')
    }
    const requestUpdate = () => {
      if (!ticking) {
        ticking = true
        requestAnimationFrame(update)
      }
    }
    addEventListener('scroll', requestUpdate, { passive: true })
    addEventListener('resize', requestUpdate, { passive: true })
    update()
  }
</script>
