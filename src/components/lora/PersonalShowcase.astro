---
import { Image } from 'astro:assets'
import favoritesTicket from '@/assets/lora-visual/v2/lora-v2-favorites-ticket.webp'
import ShowcaseCarousel from './ShowcaseCarousel.astro'
import { anime, favorites, localizeShowcase, type ShowcaseItem } from '../../data/showcase'

interface Props {
  locale?: 'zh-CN' | 'en-US'
}

const { locale = 'zh-CN' } = Astro.props
const isEnglish = locale === 'en-US'
const localizeItems = (items: ShowcaseItem[]) => items.map((item) => localizeShowcase(item, isEnglish))
const copy = isEnglish
  ? {
      eyebrow: 'Outside the build log',
      title: 'A little room for stories, sounds, and ideas.',
      intro: 'Anime, films, music, games, and a few things worth keeping around.',
      animeTitle: 'Anime Archive',
      animeEyebrow: 'Stories that stay with me',
      favoritesTitle: 'Favorites',
      favoritesEyebrow: 'Films, music, games & ideas'
    }
  : {
      eyebrow: '工作之外',
      title: '也留一点位置给故事、声音与想法。',
      intro: '动漫、电影、音乐、游戏和一些值得收藏的东西，都在这里。',
      animeTitle: '动漫档案',
      animeEyebrow: '一直留在心里的故事',
      favoritesTitle: '私藏',
      favoritesEyebrow: '电影、音乐、游戏与想法'
    }

const viewerCopy = isEnglish
  ? {
      label: 'Anime Archive',
      previous: 'Previous channel',
      next: 'Next channel',
      close: 'Close Anime Archive',
      details: 'Open details',
      hint: '← → change channel · Esc return'
    }
  : {
      label: '动漫档案',
      previous: '上一台',
      next: '下一台',
      close: '关闭动漫档案',
      details: '查看作品资料',
      hint: '← → 切换频道 · Esc 返回'
    }
---

<section class='personal-showcase' aria-labelledby='personal-signals-title'>
  <Image src={favoritesTicket} alt='' aria-hidden='true' class='favorites-ticket' widths={[480, 760, 1000]} sizes='(min-width: 1024px) 15rem, 26vw' loading='lazy' />
  <header class='personal-heading'>
    <p>{copy.eyebrow}</p>
    <h2 id='personal-signals-title'>{copy.title}</h2>
    <span>{copy.intro}</span>
  </header>
  <ShowcaseCarousel
    id='anime'
    title={copy.animeTitle}
    eyebrow={copy.animeEyebrow}
    items={localizeItems(anime)}
    locale={locale}
  />
  <dialog
    class='anime-broadcast'
    data-anime-broadcast
    aria-label={viewerCopy.label}
  >
    <div class='broadcast-surface' data-broadcast-surface>
      <img data-broadcast-image alt='' />
      <span class='broadcast-scanlines' aria-hidden='true'></span>
      <div class='broadcast-hud' data-broadcast-hud>
        <button class='broadcast-close' type='button' data-broadcast-close aria-label={viewerCopy.close}>×</button>
        <div class='broadcast-copy'>
          <small data-broadcast-count aria-live='polite'>ANIME ARCHIVE / 01</small>
          <h3 data-broadcast-title></h3>
          <p data-broadcast-description></p>
          <span class='broadcast-media-status' data-broadcast-media-status role='status'></span>
          <button class='broadcast-video' type='button' data-broadcast-video hidden>Play official trailer</button>
        </div>
        <div class='broadcast-foot'>
          <span>{viewerCopy.hint}</span>
          <div class='broadcast-actions'>
            <button type='button' data-broadcast-prev aria-label={viewerCopy.previous}>←</button>
            <button type='button' data-broadcast-next aria-label={viewerCopy.next}>→</button>
            <a data-broadcast-link target='_blank' rel='noopener noreferrer'>{viewerCopy.details} ↗</a>
          </div>
        </div>
      </div>
    </div>
  </dialog>
  <ShowcaseCarousel
    id='favorites'
    title={copy.favoritesTitle}
    eyebrow={copy.favoritesEyebrow}
    items={localizeItems(favorites)}
    locale={locale}
  />
</section>

<style>
  .personal-showcase {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    scroll-margin-top: 5.5rem;
  }

  .favorites-ticket {
    position: absolute;
    z-index: -1;
    top: -1.4rem;
    right: clamp(-1rem, -5vw, -3rem);
    width: clamp(7rem, 16vw, 12rem);
    height: auto;
    opacity: 0.2;
    transform: rotate(4deg);
    filter: saturate(0.9);
    pointer-events: none;
  }

  .personal-heading {
    display: grid;
    max-width: 48rem;
    gap: 0.65rem;
    border-top: 1px solid hsl(var(--border));
    padding-top: 1.1rem;
  }

  .personal-heading p {
    margin: 0;
    color: hsl(var(--field-amber));
    font-size: 0.67rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .personal-heading h2 {
    max-width: 20ch;
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 3.1rem);
    font-weight: 570;
    letter-spacing: -0.055em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .personal-heading span {
    max-width: 58ch;
    color: hsl(var(--muted-foreground));
    font-size: 0.82rem;
    line-height: 1.7;
  }

  .anime-broadcast {
    position: fixed;
    inset: 0;
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    overflow: hidden;
    border: 0;
    padding: 0;
    background: transparent;
    color: white;
  }
  .anime-broadcast::backdrop {
    background: rgb(8 9 8 / .9);
    backdrop-filter: blur(14px);
  }
  .broadcast-surface {
    position: fixed;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / .16);
    border-radius: 1rem;
    background: #111310;
    box-shadow: 0 38px 100px -45px rgb(0 0 0 / .9);
    transition:
      left 560ms var(--motion-spring),
      top 560ms var(--motion-spring),
      width 560ms var(--motion-spring),
      height 560ms var(--motion-spring),
      border-radius 560ms var(--motion-spring);
    will-change: left, top, width, height, border-radius;
  }
  .broadcast-surface[data-expanded='true'] {
    border-radius: .75rem;
  }
  .broadcast-surface > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--broadcast-position, 50% 50%);
    filter: saturate(.92) contrast(1.03) brightness(.82);
    transform: scale(var(--broadcast-scale, 1.025));
    transition: filter 220ms ease, opacity 180ms ease;
  }
  .broadcast-surface[data-expanded='true'] > img {
    animation: broadcast-drift var(--broadcast-duration, 9s) ease-in-out infinite alternate;
  }
  .broadcast-surface[data-switching='true'] > img { opacity: .18; }
  .broadcast-surface[data-switching='true'] .broadcast-copy { opacity: .45; }
  .broadcast-surface[data-switching='true'] .broadcast-scanlines { opacity: .9; }
  @keyframes broadcast-drift {
    to { transform: scale(var(--broadcast-scale, 1.055)) translate3d(var(--broadcast-x, .7%), var(--broadcast-y, -.4%), 0); }
  }
  .broadcast-scanlines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      repeating-linear-gradient(to bottom, rgb(255 255 255 / .018) 0 1px, rgb(0 0 0 / .035) 1px 3px),
      radial-gradient(circle at 50% 46%, transparent 50%, rgb(0 0 0 / .34) 100%);
  }
  .broadcast-hud {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 1;
    transition: opacity 260ms ease;
  }
  .broadcast-hud.is-hidden {
    opacity: 0;
  }
  .broadcast-hud button,
  .broadcast-hud a {
    pointer-events: auto;
  }
  .broadcast-close {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    display: grid;
    width: 2.4rem;
    height: 2.4rem;
    place-items: center;
    border: 1px solid rgb(255 255 255 / .22);
    border-radius: 50%;
    background: rgb(0 0 0 / .3);
    color: white;
    font-size: 1.2rem;
  }
  .broadcast-copy {
    position: absolute;
    top: clamp(1.25rem, 5vw, 3rem);
    left: clamp(1.25rem, 5vw, 3rem);
    max-width: min(70vw, 44rem);
    text-shadow: 0 2px 18px rgb(0 0 0 / .42);
  }
  .broadcast-copy small {
    color: var(--broadcast-accent, #e7b56a);
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: .66rem;
    font-weight: 700;
    letter-spacing: .13em;
  }
  .broadcast-copy h3 {
    max-width: 14ch;
    margin: .55rem 0 0;
    font-size: clamp(2.5rem, 7vw, 6.5rem);
    font-weight: 620;
    letter-spacing: -.065em;
    line-height: .92;
  }
  .broadcast-copy p {
    max-width: 46ch;
    margin: .7rem 0 0;
    color: rgb(255 255 255 / .78);
    font-size: clamp(.78rem, 1.4vw, .96rem);
    line-height: 1.6;
  }
  .broadcast-media-status {
    display: block;
    min-height: 1.1em;
    margin-top: .75rem;
    color: rgb(255 255 255 / .72);
    font-size: .72rem;
  }
  .broadcast-video { display:block; margin-top:.65rem; border:1px solid rgb(255 255 255 / .28); border-radius:999px; padding:.45rem .7rem; background:rgb(0 0 0 / .28); color:white; font-size:.72rem; }
  .broadcast-video-frame { position:absolute; z-index:3; right:1rem; bottom:4rem; width:min(34rem,calc(100% - 2rem)); aspect-ratio:16/9; border:1px solid rgb(255 255 255 / .25); border-radius:.7rem; background:#000; }
  .broadcast-foot {
    position: absolute;
    right: clamp(1.25rem, 4vw, 2.5rem);
    bottom: clamp(1.1rem, 3vw, 2rem);
    left: clamp(1.25rem, 4vw, 2.5rem);
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    color: rgb(255 255 255 / .62);
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: .62rem;
  }
  .broadcast-actions {
    display: flex;
    align-items: center;
    gap: .4rem;
  }
  .broadcast-actions button,
  .broadcast-actions a {
    display: inline-flex;
    min-height: 2.2rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(255 255 255 / .2);
    border-radius: 999px;
    padding: .45rem .7rem;
    background: rgb(0 0 0 / .28);
    color: white;
    text-decoration: none;
  }

  @media (max-width: 720px) {
    .favorites-ticket {
      top: -0.8rem;
      right: -0.5rem;
      width: 7rem;
      opacity: 0.14;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .favorites-ticket {
      transform: none;
    }
    .broadcast-surface,
    .broadcast-hud {
      transition: none;
    }
    .broadcast-surface[data-expanded='true'] > img {
      animation: none;
      transform: none;
    }
  }
</style>


<script>
  const viewer = document.querySelector<HTMLDialogElement>('[data-anime-broadcast]')
  const animeRoot = document.querySelector<HTMLElement>('[data-showcase-id="anime"]')
  const surface = viewer?.querySelector<HTMLElement>('[data-broadcast-surface]')
  const image = viewer?.querySelector<HTMLImageElement>('[data-broadcast-image]')
  const title = viewer?.querySelector<HTMLElement>('[data-broadcast-title]')
  const description = viewer?.querySelector<HTMLElement>('[data-broadcast-description]')
  const count = viewer?.querySelector<HTMLElement>('[data-broadcast-count]')
  const details = viewer?.querySelector<HTMLAnchorElement>('[data-broadcast-link]')
  const hud = viewer?.querySelector<HTMLElement>('[data-broadcast-hud]')
  const close = viewer?.querySelector<HTMLButtonElement>('[data-broadcast-close]')
  const previous = viewer?.querySelector<HTMLButtonElement>('[data-broadcast-prev]')
  const next = viewer?.querySelector<HTMLButtonElement>('[data-broadcast-next]')
  const mediaStatus = viewer?.querySelector<HTMLElement>('[data-broadcast-media-status]')
  const videoButton = viewer?.querySelector<HTMLButtonElement>('[data-broadcast-video]')
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)')
  const triggers = animeRoot
    ? [...animeRoot.querySelectorAll<HTMLAnchorElement>('.lens')]
    : []
  let activeIndex = 0
  let returnTrigger: HTMLAnchorElement | null = null
  let closeTimer: number | undefined
  let hudTimer: number | undefined
  let switchTimer: number | undefined

  const setRect = (rect: DOMRect | { left: number; top: number; width: number; height: number }) => {
    if (!surface) return
    surface.style.left = `${rect.left}px`
    surface.style.top = `${rect.top}px`
    surface.style.width = `${rect.width}px`
    surface.style.height = `${rect.height}px`
  }

  const targetRect = () => {
    const gap = innerWidth < 720 ? 8 : Math.max(18, innerWidth * .03)
    const top = innerWidth < 720 ? 62 : Math.max(42, innerHeight * .055)
    return {
      left: gap,
      top,
      width: innerWidth - gap * 2,
      height: innerHeight - top - gap
    }
  }

  const showHud = () => {
    if (!hud) return
    hud.classList.remove('is-hidden')
    if (hudTimer) clearTimeout(hudTimer)
    if (hud.contains(document.activeElement)) return
    hudTimer = window.setTimeout(() => hud.classList.add('is-hidden'), 2800)
  }

  const syncViewer = (index: number) => {
    if (!viewer || !surface || !image || !title || !description || !count || !details || triggers.length === 0) return
    activeIndex = (index + triggers.length) % triggers.length
    const trigger = triggers[activeIndex]
    const poster = trigger.querySelector<HTMLImageElement>('img')
    const heading = trigger.querySelector<HTMLElement>('.copy h3')
    const summary = trigger.querySelector<HTMLElement>('.copy p')
    const card = trigger.closest<HTMLElement>('[data-magic]')
    const motion = card?.dataset.motion ? JSON.parse(card.dataset.motion) as { duration: number; x: number; y: number; scale: number } : null
    const palette = card?.dataset.palette?.split('|')
    const videoId = card?.dataset.videoId
    image.src = poster?.currentSrc || poster?.src || ''
    image.alt = poster?.alt || heading?.textContent || ''
    image.onload = () => {
      if (mediaStatus) mediaStatus.textContent = ''
    }
    image.onerror = () => {
      if (mediaStatus) mediaStatus.textContent = 'Poster unavailable; opening the verified detail source.'
    }
    surface.style.setProperty('--broadcast-position', poster?.style.getPropertyValue('--showcase-object-position') || '50% 50%')
    surface.style.setProperty('--broadcast-duration', `${motion?.duration ?? 9}s`)
    surface.style.setProperty('--broadcast-x', `${motion?.x ?? 0.7}%`)
    surface.style.setProperty('--broadcast-y', `${motion?.y ?? -0.4}%`)
    surface.style.setProperty('--broadcast-scale', `${motion?.scale ?? 1.055}`)
    surface.style.setProperty('--broadcast-accent', palette?.[0] || '#e7b56a')
    surface.style.setProperty('--broadcast-secondary', palette?.[1] || '#4c8177')
    title.textContent = heading?.textContent || ''
    description.textContent = summary?.textContent || ''
    count.textContent = `ANIME ARCHIVE / ${String(activeIndex + 1).padStart(2, '0')}`
    details.href = trigger.href
    if (mediaStatus) mediaStatus.textContent = ''
    if (videoButton) {
      videoButton.hidden = !videoId || reducedMotion.matches
      videoButton.dataset.videoId = videoId || ''
    }
    if (switchTimer) window.clearTimeout(switchTimer)
    surface.dataset.switching = 'true'
    switchTimer = window.setTimeout(() => {
      delete surface.dataset.switching
    }, reducedMotion.matches ? 0 : 220)
    showHud()
  }

  const openViewer = (trigger: HTMLAnchorElement, index: number) => {
    if (!viewer || !surface) return
    if (closeTimer) clearTimeout(closeTimer)
    returnTrigger = trigger
    const source = trigger.closest<HTMLElement>('.magic-card') ?? trigger
    const rect = source.getBoundingClientRect()
    setRect(rect)
    surface.dataset.expanded = 'false'
    syncViewer(index)
    viewer.showModal()
    document.documentElement.style.overflow = 'hidden'
    requestAnimationFrame(() => requestAnimationFrame(() => {
      surface.dataset.expanded = 'true'
      setRect(targetRect())
    }))
  }

  const closeViewer = () => {
    if (!viewer?.open || !surface) return
    const source = returnTrigger?.closest<HTMLElement>('.magic-card') ?? returnTrigger
    surface.dataset.expanded = 'false'
    if (hudTimer) window.clearTimeout(hudTimer)
    if (switchTimer) window.clearTimeout(switchTimer)
    delete surface.dataset.switching
    if (image) image.onload = null
    if (image) image.onerror = null
    surface?.querySelector('.broadcast-video-frame')?.remove()
    if (videoButton) videoButton.hidden = true
    if (source) setRect(source.getBoundingClientRect())
    const finish = () => {
      viewer.close()
      document.documentElement.style.overflow = ''
      returnTrigger?.focus()
    }
    if (reducedMotion.matches) finish()
    else closeTimer = window.setTimeout(finish, 540)
  }

  animeRoot?.addEventListener(
    'click',
    (event) => {
      const target = event.target instanceof Element ? event.target : null
      const trigger = target?.closest<HTMLAnchorElement>('.lens')
      if (!trigger || trigger.dataset.spotify || animeRoot.dataset.suppressClick === 'true') return
      const index = triggers.indexOf(trigger)
      if (index < 0) return
      event.preventDefault()
      openViewer(trigger, index)
    },
    true
  )

  const openOfficialVideo = () => {
    const id = videoButton?.dataset.videoId
    if (!id || !viewer) return
    const video = document.createElement('iframe')
    video.title = 'Official anime trailer'
    video.src = `https://www.youtube.com/embed/${id}?autoplay=1&mute=1&rel=0`
    video.loading = 'lazy'
    video.allow = 'autoplay; encrypted-media; picture-in-picture'
    video.className = 'broadcast-video-frame'
    videoButton.hidden = true
    surface?.append(video)
    if (mediaStatus) mediaStatus.textContent = 'Official trailer · muted'
  }
  videoButton?.addEventListener('click', openOfficialVideo)
  close?.addEventListener('click', closeViewer)
  previous?.addEventListener('click', () => syncViewer(activeIndex - 1))
  next?.addEventListener('click', () => syncViewer(activeIndex + 1))
  viewer?.addEventListener('cancel', (event) => {
    event.preventDefault()
    closeViewer()
  })
  viewer?.addEventListener('pointermove', showHud)
  viewer?.addEventListener('focusin', showHud)
  viewer?.addEventListener('pointerdown', showHud)
  window.addEventListener('resize', () => {
    if (viewer?.open && surface?.dataset.expanded === 'true') setRect(targetRect())
  })
  document.addEventListener('keydown', (event) => {
    if (!viewer?.open) return
    if (event.key === 'ArrowLeft') {
      event.preventDefault()
      syncViewer(activeIndex - 1)
    }
    if (event.key === 'ArrowRight') {
      event.preventDefault()
      syncViewer(activeIndex + 1)
    }
  })
</script>
