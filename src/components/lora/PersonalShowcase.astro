---
import { Image } from 'astro:assets'

import favoritesTicket from '@/assets/lora-visual/v2/lora-v2-favorites-ticket.webp'

import { anime, favorites, localizeShowcase, type ShowcaseItem } from '../../data/showcase'
import ShowcaseCarousel from './ShowcaseCarousel.astro'

interface Props {
  locale?: 'zh-CN' | 'en-US'
}
const { locale = 'zh-CN' } = Astro.props
const isEnglish = locale === 'en-US'
const localizeItems = (items: ShowcaseItem[]) =>
  items.map((item) => ({ ...localizeShowcase(item, isEnglish), imageEager: false }))
const copy = isEnglish
  ? {
      eyebrow: 'Outside the build log',
      title: 'Stories, sounds, and things worth keeping.',
      intro: 'Browse the collection. Open a card for its story, sources, and selected videos.',
      animeTitle: 'Anime archive',
      animeEyebrow: 'Stories that stay with me',
      favoritesTitle: 'Favorites',
      favoritesEyebrow: 'Manga, film, music, ideas & games',
      close: 'Close archive card',
      previous: 'Previous item',
      next: 'Next item',
      detail: 'About this work',
      poster: 'Artwork source',
      media: 'Video & audio',
      source: 'Source',
      detailsSource: 'Details: ',
      checked: 'Link checked',
      stop: 'Stop & unload player',
      playTrailer: 'Load YouTube player',
      playMusic: 'Load Spotify player',
      original: 'Open original site',
      provenance: 'Source page',
      privacy:
        'The player connects to its provider only after you choose to load it. Then use its play button.',
      help: 'No picture or sound? The provider may restrict playback, require sign-in, or be unavailable on your network. Open the original site instead.',
      external: 'This video opens on Bilibili. The embedded player is not available here.',
      loading: 'Requesting the player… You can still use the original-site link.',
      requested:
        'Use the play button inside the player. This site cannot read its playback status.',
      delayed: 'If the player is still blank or will not start, open the original site.',
      failed: 'The player could not be loaded here. Open the original site to try watching there.',
      stopped: 'Player stopped and unloaded. You can load it again.',
      invalid: 'An embedded player is not available for this source. Open the original site.',
      spotifyTitle: 'Spotify audio',
      videoTitle: 'Selected video'
    }
  : {
      eyebrow: '工作之外',
      title: '故事、声音，还有值得留下的东西。',
      intro: '翻翻片单与私藏，打开卡片查看介绍、来源和精选视频。',
      animeTitle: '动漫档案',
      animeEyebrow: '一直留在心里的故事',
      favoritesTitle: '私藏',
      favoritesEyebrow: '漫画、电影、音乐、想法与游戏',
      close: '关闭档案卡片',
      previous: '上一项',
      next: '下一项',
      detail: '了解这部作品',
      poster: '图片来源',
      media: '视频与音乐',
      source: '来源',
      detailsSource: '资料来源：',
      checked: '链接核验',
      stop: '停止并关闭播放器',
      playTrailer: '加载 YouTube 播放器',
      playMusic: '加载 Spotify 播放器',
      original: '前往原站',
      provenance: '查看来源页面',
      privacy: '点击加载后才连接第三方平台，再用播放器内的按钮开始播放。',
      help: '没有画面或声音？平台可能限制播放、要求登录，或暂时无法连接。可前往原站观看或收听。',
      external: '此视频在 Bilibili 原站打开，本站不加载它的嵌入播放器。',
      loading: '正在请求播放器，可随时使用原站链接。',
      requested: '请使用播放器内的播放按钮。本站无法读取它的实际播放状态。',
      delayed: '如果播放器仍未显示或无法开始播放，请前往原站。',
      failed: '播放器未能在此加载，可前往原站重试。',
      stopped: '播放器已停止并关闭，可重新加载。',
      invalid: '此来源暂不支持在本站加载播放器，请前往原站。',
      spotifyTitle: 'Spotify 音乐',
      videoTitle: '精选视频'
    }
---

<section class='personal-showcase' aria-labelledby='personal-signals-title' data-personal-showcase>
  <Image
    src={favoritesTicket}
    alt=''
    aria-hidden='true'
    class='favorites-ticket'
    widths={[480, 760]}
    sizes='(min-width: 1024px) 12rem, 26vw'
    loading='lazy'
  />
  <header class='personal-heading'>
    <p>{copy.eyebrow}</p>
    <h2 id='personal-signals-title'>{copy.title}</h2>
    <span>{copy.intro}</span>
  </header>
  <ShowcaseCarousel
    id='anime'
    title={copy.animeTitle}
    eyebrow={copy.animeEyebrow}
    items={localizeItems(anime)}
    locale={locale}
  />
  <ShowcaseCarousel
    id='favorites'
    title={copy.favoritesTitle}
    eyebrow={copy.favoritesEyebrow}
    items={localizeItems(favorites)}
    locale={locale}
  />

  <dialog
    class='archive-viewer'
    data-archive-viewer
    data-copy={JSON.stringify(copy)}
    aria-labelledby='archive-viewer-title'
    aria-describedby='archive-viewer-description'
  >
    <div class='viewer-topbar'>
      <span data-viewer-count></span>
      <button class='viewer-close' type='button' data-viewer-close aria-label={copy.close} autofocus
        ><span aria-hidden='true'>×</span></button
      >
    </div>
    <div class='viewer-surface'>
      <aside class='viewer-artwork'>
        <img class='viewer-image' data-viewer-image alt='' width='600' height='840' />
        <span class='viewer-medium' data-viewer-medium></span>
        <a data-viewer-poster target='_blank' rel='noopener noreferrer'>{copy.poster} ↗</a>
      </aside>
      <div class='viewer-copy'>
        <h3 id='archive-viewer-title' data-viewer-title></h3>
        <p id='archive-viewer-description' data-viewer-description></p>
        <p class='viewer-source' data-viewer-source></p>
        <a class='viewer-detail' data-viewer-detail target='_blank' rel='noopener noreferrer'
          >{copy.detail} ↗</a
        >
        <section
          class='viewer-media'
          data-viewer-media
          aria-labelledby='archive-media-title'
          hidden
        >
          <p class='media-eyebrow'>{copy.media}</p>
          <h4 id='archive-media-title' data-media-title></h4>
          <dl class='media-provenance'>
            <div data-media-source-row><dt>{copy.source}</dt><dd data-media-source></dd></div>
            <div data-media-checked-row hidden>
              <dt>{copy.checked}</dt><dd data-media-checked></dd>
            </div>
          </dl>
          <p class='viewer-help' data-media-privacy>{copy.privacy}</p>
          <div class='media-actions'>
            <button class='viewer-play' type='button' data-viewer-play></button>
            <a
              class='viewer-original'
              data-viewer-original
              target='_blank'
              rel='noopener noreferrer'>{copy.original} ↗</a
            >
            <button class='viewer-stop' type='button' data-viewer-stop hidden>{copy.stop}</button>
          </div>
          <iframe
            class='viewer-player'
            data-viewer-player
            title={copy.videoTitle}
            loading='lazy'
            referrerpolicy='strict-origin-when-cross-origin'
            allow='encrypted-media; fullscreen; picture-in-picture'
            hidden></iframe>
          <p class='viewer-status' data-viewer-status role='status' aria-live='polite'></p>
          <p class='viewer-help media-help' data-media-help>{copy.help}</p>
          <a
            class='media-source-link'
            data-media-source-link
            target='_blank'
            rel='noopener noreferrer'
            hidden>{copy.provenance} ↗</a
          >
        </section>
      </div>
    </div>
    <footer class='viewer-footer'>
      <span data-viewer-index aria-live='polite'></span>
      <div class='viewer-controls'>
        <button type='button' data-viewer-prev aria-label={copy.previous}
          >← <span>{copy.previous}</span></button
        >
        <button type='button' data-viewer-next aria-label={copy.next}
          ><span>{copy.next}</span> →</button
        >
      </div>
    </footer>
  </dialog>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-personal-showcase]').forEach((root) => {
    const viewer = root.querySelector<HTMLDialogElement>('[data-archive-viewer]')
    if (!viewer) return
    const poster = viewer.querySelector<HTMLImageElement>('[data-viewer-image]')
    const count = viewer.querySelector<HTMLElement>('[data-viewer-count]')
    const title = viewer.querySelector<HTMLElement>('[data-viewer-title]')
    const description = viewer.querySelector<HTMLElement>('[data-viewer-description]')
    const source = viewer.querySelector<HTMLElement>('[data-viewer-source]')
    const medium = viewer.querySelector<HTMLElement>('[data-viewer-medium]')
    const indexLabel = viewer.querySelector<HTMLElement>('[data-viewer-index]')
    const detail = viewer.querySelector<HTMLAnchorElement>('[data-viewer-detail]')
    const posterSource = viewer.querySelector<HTMLAnchorElement>('[data-viewer-poster]')
    const previous = viewer.querySelector<HTMLButtonElement>('[data-viewer-prev]')
    const next = viewer.querySelector<HTMLButtonElement>('[data-viewer-next]')
    const close = viewer.querySelector<HTMLButtonElement>('[data-viewer-close]')
    const media = viewer.querySelector<HTMLElement>('[data-viewer-media]')
    const mediaTitle = viewer.querySelector<HTMLElement>('[data-media-title]')
    const mediaSource = viewer.querySelector<HTMLElement>('[data-media-source]')
    const mediaCheckedRow = viewer.querySelector<HTMLElement>('[data-media-checked-row]')
    const mediaChecked = viewer.querySelector<HTMLElement>('[data-media-checked]')
    const mediaSourceLink = viewer.querySelector<HTMLAnchorElement>('[data-media-source-link]')
    const privacy = viewer.querySelector<HTMLElement>('[data-media-privacy]')
    const help = viewer.querySelector<HTMLElement>('[data-media-help]')
    const original = viewer.querySelector<HTMLAnchorElement>('[data-viewer-original]')
    const play = viewer.querySelector<HTMLButtonElement>('[data-viewer-play]')
    const stop = viewer.querySelector<HTMLButtonElement>('[data-viewer-stop]')
    const player = viewer.querySelector<HTMLIFrameElement>('[data-viewer-player]')
    const status = viewer.querySelector<HTMLElement>('[data-viewer-status]')
    if (
      !poster ||
      !count ||
      !title ||
      !description ||
      !source ||
      !medium ||
      !indexLabel ||
      !detail ||
      !posterSource ||
      !previous ||
      !next ||
      !close ||
      !media ||
      !mediaTitle ||
      !mediaSource ||
      !mediaCheckedRow ||
      !mediaChecked ||
      !mediaSourceLink ||
      !privacy ||
      !help ||
      !original ||
      !play ||
      !stop ||
      !player ||
      !status
    )
      return
    const labels: Record<string, string> = JSON.parse(viewer.dataset.copy || '{}')
    let activeShelf: HTMLElement | null = null
    let activeItems: HTMLAnchorElement[] = []
    let activeIndex = 0
    let returnTrigger: HTMLAnchorElement | null = null
    let previousOverflow = ''
    let sessionActive = false
    let loadTimer: number | undefined
    let embedUrl = ''
    let playerTitle = ''
    let loadingPlayer = false

    const httpsUrl = (value: string | undefined) => {
      if (!value) return ''
      try {
        const url = new URL(value)
        return url.protocol === 'https:' ? url.href : ''
      } catch {
        return ''
      }
    }
    const unload = () => {
      loadingPlayer = false
      if (loadTimer) window.clearTimeout(loadTimer)
      loadTimer = undefined
      player.removeAttribute('src')
      player.hidden = true
      stop.hidden = true
      play.hidden = !embedUrl
    }
    const syncViewer = (requestedIndex: number) => {
      unload()
      activeIndex = Math.max(0, Math.min(activeItems.length - 1, requestedIndex))
      const trigger = activeItems[activeIndex]
      const card = trigger?.closest<HTMLElement>('[data-archive-card]')
      const image = card?.querySelector<HTMLImageElement>('img')
      if (!trigger || !card || !image) return
      const itemTitle = card.querySelector('.archive-card-copy h3')?.textContent?.trim() ?? ''
      poster.src = image.currentSrc || image.src
      poster.alt = itemTitle
      poster.style.objectPosition =
        image.style.getPropertyValue('--showcase-object-position') || '50% 50%'
      title.textContent = itemTitle
      description.textContent =
        card.querySelector('.archive-card-copy p')?.textContent?.trim() ?? ''
      const detailsUrl = httpsUrl(trigger.href)
      const detailsHostname = detailsUrl ? new URL(detailsUrl).hostname : ''
      source.hidden = !detailsHostname
      source.textContent = detailsHostname ? `${labels.detailsSource}${detailsHostname}` : ''
      medium.textContent = card.dataset.medium ?? ''
      count.textContent = `${activeShelf?.querySelector('h2')?.childNodes[0]?.textContent?.trim() ?? ''} / ${String(activeIndex + 1).padStart(2, '0')}`
      indexLabel.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${String(activeItems.length).padStart(2, '0')}`
      detail.href = trigger.href
      const artworkUrl = httpsUrl(card.dataset.posterSource)
      posterSource.hidden = !artworkUrl
      if (artworkUrl) posterSource.href = artworkUrl
      else posterSource.removeAttribute('href')

      const provider = card.dataset.videoProvider
      const videoId = card.dataset.videoId ?? ''
      const spotifyUrl = httpsUrl(card.dataset.spotify)
      const youtube = provider === 'youtube' && /^[\w-]{11}$/.test(videoId)
      const bilibili = provider === 'bilibili' && /^BV[0-9A-Za-z]{10}$/.test(videoId)
      let watchUrl = ''
      embedUrl = ''
      if (youtube) {
        watchUrl = `https://www.youtube.com/watch?v=${videoId}`
        if (card.dataset.videoEmbed !== 'false')
          embedUrl = `https://www.youtube.com/embed/${videoId}?autoplay=0&rel=0`
      } else if (bilibili) {
        watchUrl = `https://www.bilibili.com/video/${videoId}/`
      } else if (spotifyUrl) {
        const url = new URL(spotifyUrl)
        if (
          url.hostname === 'open.spotify.com' &&
          /^\/embed\/(track|album|playlist)\/[A-Za-z0-9]+$/.test(url.pathname)
        ) {
          url.searchParams.delete('autoplay')
          embedUrl = url.href
          watchUrl = `https://open.spotify.com${url.pathname.replace('/embed', '')}`
        }
      }
      const providedWatchUrl = httpsUrl(card.dataset.videoWatchUrl)
      if (providedWatchUrl && (youtube || bilibili)) {
        const url = new URL(providedWatchUrl)
        if (
          (youtube && ['youtube.com', 'www.youtube.com', 'youtu.be'].includes(url.hostname)) ||
          (bilibili && ['bilibili.com', 'www.bilibili.com'].includes(url.hostname))
        )
          watchUrl = url.href
      }
      media.hidden = !videoId && !spotifyUrl
      original.hidden = !watchUrl
      if (watchUrl) original.href = watchUrl
      else original.removeAttribute('href')
      original.textContent = `${labels.original}${bilibili ? ' · Bilibili' : youtube ? ' · YouTube' : spotifyUrl ? ' · Spotify' : ''} ↗`
      mediaTitle.textContent = card.dataset.videoTitle || card.dataset.mediaTitle || itemTitle
      mediaSource.textContent = [
        card.dataset.videoSource || (spotifyUrl ? 'Spotify' : ''),
        card.dataset.videoUploader
      ]
        .filter(Boolean)
        .join(' · ')
      mediaCheckedRow.hidden = !card.dataset.videoCheckedAt
      mediaChecked.textContent = card.dataset.videoCheckedAt || ''
      const provenanceUrl = httpsUrl(card.dataset.videoSourceUrl)
      mediaSourceLink.hidden = !provenanceUrl || provenanceUrl === watchUrl
      if (provenanceUrl) mediaSourceLink.href = provenanceUrl
      else mediaSourceLink.removeAttribute('href')
      privacy.textContent = bilibili ? labels.external : embedUrl ? labels.privacy : labels.invalid
      help.hidden = !embedUrl
      play.hidden = !embedUrl
      play.textContent = spotifyUrl ? labels.playMusic : labels.playTrailer
      playerTitle = `${spotifyUrl ? labels.spotifyTitle : labels.videoTitle} · ${mediaTitle.textContent}`
      player.dataset.kind = spotifyUrl ? 'audio' : 'video'
      status.textContent = ''
      previous.disabled = activeIndex === 0
      next.disabled = activeIndex === activeItems.length - 1
      viewer.scrollTop = 0
    }

    const cleanupViewer = (restoreFocus = true) => {
      if (!sessionActive) return
      sessionActive = false
      unload()
      document.documentElement.style.overflow = previousOverflow
      const trigger = returnTrigger
      returnTrigger = null
      activeItems = []
      activeShelf = null
      if (restoreFocus) trigger?.focus({ preventScroll: true })
    }
    const closeViewer = (restoreFocus = true) => {
      if (viewer.open) viewer.close()
      // Native close events are queued. Restore scroll and media before returning.
      cleanupViewer(restoreFocus)
    }

    root.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null
      const trigger = target?.closest<HTMLAnchorElement>('[data-viewer-trigger]')
      const shelf = trigger?.closest<HTMLElement>('[data-carousel]')
      if (
        !trigger ||
        !shelf ||
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      )
        return
      event.preventDefault()
      if (viewer.open) return
      // Also recover if another caller closed the dialog before its close event ran.
      cleanupViewer(false)
      activeShelf = shelf
      activeItems = [
        ...shelf.querySelectorAll<HTMLAnchorElement>('[data-archive-card] [data-viewer-trigger]')
      ]
      returnTrigger = trigger
      syncViewer(Number(trigger.dataset.itemIndex) || 0)
      previousOverflow = document.documentElement.style.overflow
      viewer.showModal()
      sessionActive = true
      document.documentElement.style.overflow = 'hidden'
      close.focus()
    })
    play.addEventListener('click', () => {
      if (!embedUrl || loadingPlayer) return
      loadingPlayer = true
      player.title = playerTitle
      player.hidden = false
      player.src = embedUrl
      play.hidden = true
      stop.hidden = false
      status.textContent = labels.loading
      stop.focus({ preventScroll: true })
      loadTimer = window.setTimeout(() => {
        if (loadingPlayer) status.textContent = labels.delayed
      }, 12000)
    })
    player.addEventListener('load', () => {
      if (!loadingPlayer || !player.getAttribute('src')) return
      if (loadTimer) window.clearTimeout(loadTimer)
      // A cross-origin iframe load does not tell us whether the video can play.
      status.textContent = labels.requested
    })
    player.addEventListener('error', () => {
      if (!loadingPlayer) return
      if (loadTimer) window.clearTimeout(loadTimer)
      status.textContent = labels.failed
    })
    stop.addEventListener('click', () => {
      unload()
      status.textContent = labels.stopped
      play.focus({ preventScroll: true })
    })
    previous.addEventListener('click', () => {
      syncViewer(activeIndex - 1)
      if (previous.disabled) next.focus()
    })
    next.addEventListener('click', () => {
      syncViewer(activeIndex + 1)
      if (next.disabled) previous.focus()
    })
    viewer.addEventListener('keydown', (event) => {
      if (event.key === 'Tab') {
        const focusable = [...viewer.querySelectorAll<HTMLElement>(
          'a[href], button, input, select, textarea, iframe, [tabindex]'
        )].filter((element) => element.tabIndex >= 0 &&
          !element.matches(':disabled') && !element.closest('[hidden], [inert]') &&
          element.getClientRects().length > 0 && getComputedStyle(element).visibility !== 'hidden')
        const first = focusable[0]
        const last = focusable[focusable.length - 1]
        const active = document.activeElement
        if (!first || !last) {
          event.preventDefault()
          close.focus()
        } else if (event.shiftKey && (active === first || !focusable.includes(active as HTMLElement))) {
          event.preventDefault()
          last.focus()
        } else if (!event.shiftKey && (active === last || !focusable.includes(active as HTMLElement))) {
          event.preventDefault()
          first.focus()
        }
        return
      }
      if (!['ArrowLeft', 'ArrowRight'].includes(event.key)) return
      const target = event.target instanceof Element ? event.target : null
      if (
        target?.closest('input, textarea, select, [contenteditable], iframe, [data-viewer-media]')
      )
        return
      event.preventDefault()
      syncViewer(activeIndex + (event.key === 'ArrowLeft' ? -1 : 1))
    })
    close.addEventListener('click', () => closeViewer())
    viewer.addEventListener('cancel', (event) => {
      event.preventDefault()
      closeViewer()
    })
    window.addEventListener('pagehide', () => closeViewer(false))
    viewer.addEventListener('close', () => {
      // An old queued close event must not clear a newly opened session.
      if (!viewer.open) cleanupViewer()
    })
  })
</script>

<style>
  .personal-showcase {
    --collection-accent: #28655e;
    --collection-on-accent: #ffffff;
    position: relative;
    isolation: isolate;
    display: grid;
    min-width: 0;
    gap: clamp(2.2rem, 5vw, 3.8rem);
    scroll-margin-top: 5.5rem;
  }
  :global(.dark) .personal-showcase {
    --collection-accent: #8bd4c7;
    --collection-on-accent: #162823;
  }
  .favorites-ticket {
    position: absolute;
    z-index: -1;
    top: -0.8rem;
    right: 0;
    width: clamp(7rem, 16vw, 12rem);
    height: auto;
    opacity: 0.15;
    pointer-events: none;
  }
  .personal-heading {
    display: grid;
    gap: 0.65rem;
    border-top: 1px solid hsl(var(--border));
    padding-top: 1.2rem;
    padding-right: 8rem;
  }
  .personal-heading p {
    margin: 0;
    color: hsl(var(--field-amber-strong));
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .personal-heading h2 {
    max-width: 22ch;
    margin: 0;
    font-size: clamp(1.7rem, 4vw, 2.7rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1.25;
    text-wrap: balance;
  }
  .personal-heading > span {
    max-width: 58ch;
    color: hsl(var(--muted-foreground));
    font-size: 0.82rem;
    line-height: 1.7;
  }
  .archive-viewer {
    position: fixed;
    inset: 0;
    width: min(66rem, calc(100vw - 3rem));
    max-width: none;
    max-height: calc(100dvh - 3rem);
    margin: auto;
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid hsl(var(--field-ink) / 0.3);
    border-radius: 0.8rem;
    padding: 0;
    background: hsl(var(--field-paper));
    color: hsl(var(--foreground));
    box-shadow: 0 1rem 6rem rgb(0 0 0 / 0.3);
  }
  .archive-viewer::backdrop {
    background: rgb(14 23 20 / 0.78);
  }
  .archive-viewer [hidden] {
    display: none !important;
  }
  .viewer-topbar {
    position: sticky;
    top: 0;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 3.75rem;
    border-bottom: 1px solid hsl(var(--border));
    padding: 0.5rem 1.4rem;
    background: hsl(var(--field-paper));
  }
  .viewer-topbar > span {
    color: hsl(var(--muted-foreground));
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }
  .viewer-close {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid hsl(var(--border));
    border-radius: 50%;
    background: transparent;
    color: hsl(var(--foreground));
    font-size: 1.5rem;
    cursor: pointer;
  }
