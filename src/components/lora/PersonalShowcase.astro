---
import { Image } from 'astro:assets'
import favoritesTicket from '@/assets/field-notes/favorites-ticket.webp'
import ShowcaseCarousel from './ShowcaseCarousel.astro'
import { anime, favorites } from '../../data/showcase'

interface Props {
  locale?: 'zh-CN' | 'en-US'
}

const { locale = 'zh-CN' } = Astro.props
const isEnglish = locale === 'en-US'
const copy = isEnglish
  ? {
      eyebrow: 'Personal signals',
      title: 'A small archive of stories, sounds, and ideas.',
      intro: 'A few works and objects worth keeping close alongside the build log.',
      animeTitle: 'Anime Archive',
      animeEyebrow: 'Stories that stay with me',
      favoritesTitle: 'Favorites',
      favoritesEyebrow: 'Films, music, games & ideas'
    }
  : {
      eyebrow: 'Personal Signals · 私人坐标',
      title: '系统之外，也有一直想收藏的故事、声音与想法。',
      intro: '一份可横向浏览的个人兴趣清单，和项目记录并排放在这里。',
      animeTitle: 'Anime Archive · 动漫档案',
      animeEyebrow: '一直留在心里的故事',
      favoritesTitle: 'Favorites · 私藏',
      favoritesEyebrow: '电影、音乐、游戏与想法'
    }
---

<section class='personal-showcase' aria-labelledby='personal-signals-title'>
  <Image src={favoritesTicket} alt='' aria-hidden='true' class='favorites-ticket' widths={[240, 360, 520]} sizes='(min-width: 1024px) 15rem, 26vw' loading='lazy' />
  <header class='personal-heading'>
    <p>{copy.eyebrow}</p>
    <h2 id='personal-signals-title'>{copy.title}</h2>
    <span>{copy.intro}</span>
  </header>
  <ShowcaseCarousel
    id='anime'
    title={copy.animeTitle}
    eyebrow={copy.animeEyebrow}
    items={anime}
    locale={locale}
  />
  <ShowcaseCarousel
    id='favorites'
    title={copy.favoritesTitle}
    eyebrow={copy.favoritesEyebrow}
    items={favorites}
    locale={locale}
  />
</section>

<style>
  .personal-showcase {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    scroll-margin-top: 5rem;
  }

  .favorites-ticket {
    position: absolute;
    z-index: -1;
    top: -1.4rem;
    right: clamp(-1rem, -5vw, -3rem);
    width: clamp(7rem, 16vw, 12rem);
    height: auto;
    opacity: 0.2;
    transform: rotate(4deg);
    filter: saturate(0.9);
    pointer-events: none;
  }

  .personal-heading {
    display: grid;
    max-width: 48rem;
    gap: 0.65rem;
    border-top: 1px solid hsl(var(--border));
    padding-top: 1.1rem;
  }

  .personal-heading p {
    margin: 0;
    color: hsl(173 60% 40%);
    font-size: 0.67rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .personal-heading h2 {
    max-width: 20ch;
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 3.1rem);
    font-weight: 570;
    letter-spacing: -0.055em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .personal-heading span {
    max-width: 58ch;
    color: hsl(var(--muted-foreground));
    font-size: 0.82rem;
    line-height: 1.7;
  }

  @media (max-width: 720px) {
    .favorites-ticket {
      top: -0.8rem;
      right: -0.5rem;
      width: 7rem;
      opacity: 0.14;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .favorites-ticket {
      transform: none;
    }
  }
</style>
