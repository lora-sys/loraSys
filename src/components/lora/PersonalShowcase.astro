---
import { Image } from 'astro:assets'

import favoritesTicket from '@/assets/lora-visual/v2/lora-v2-favorites-ticket.webp'

import { anime, favorites, localizeShowcase, type ShowcaseItem } from '../../data/showcase'
import ShowcaseCarousel from './ShowcaseCarousel.astro'

interface Props {
  locale?: 'zh-CN' | 'en-US'
}

const { locale = 'zh-CN' } = Astro.props
const isEnglish = locale === 'en-US'
const localizeItems = (items: ShowcaseItem[]) =>
  items.map((item) => localizeShowcase(item, isEnglish))
const localizedAnime = localizeItems(anime).map((item) => ({ ...item, imageEager: false }))
const localizedFavorites = localizeItems(favorites).map((item) => ({ ...item, imageEager: false }))
const copy = isEnglish
  ? {
      eyebrow: 'Outside the build log',
      title: 'A little room for stories, sounds, and ideas.',
      intro: 'Anime, films, music, games, and a few things worth keeping around.',
      animeTitle: 'Anime Archive',
      animeEyebrow: 'Stories that stay with me',
      favoritesTitle: 'Favorites',
      favoritesEyebrow: 'Films, music, games & ideas',
      viewerLabel: 'Archive card',
      close: 'Close archive card',
      previous: 'Previous item',
      next: 'Next item',
      detail: 'Open details',
      poster: 'Artwork source',
      playTrailer: 'Play official trailer',
      playMusic: 'Listen on Spotify',
      trailerStatus: 'Official trailer',
      musicStatus: 'Spotify player'
    }
  : {
      eyebrow: '工作之外',
      title: '也留一点位置给故事、声音与想法。',
      intro: '动漫、电影、音乐、游戏和一些值得收藏的东西，都在这里。',
      animeTitle: '动漫档案',
      animeEyebrow: '一直留在心里的故事',
      favoritesTitle: '私藏',
      favoritesEyebrow: '电影、音乐、游戏与想法',
      viewerLabel: '档案卡片',
      close: '关闭档案卡片',
      previous: '上一项',
      next: '下一项',
      detail: '打开详情',
      poster: '图片来源',
      playTrailer: '播放官方预告片',
      playMusic: '在 Spotify 收听',
      trailerStatus: '官方预告片',
      musicStatus: 'Spotify 播放器'
    }
---

<section class='personal-showcase' aria-labelledby='personal-signals-title' data-personal-showcase>
  <Image
    src={favoritesTicket}
    alt=''
    aria-hidden='true'
    class='favorites-ticket'
    widths={[480, 760, 1000]}
    sizes='(min-width: 1024px) 15rem, 26vw'
    loading='lazy'
  />
  <header class='personal-heading'>
    <p>{copy.eyebrow}</p>
    <h2 id='personal-signals-title'>{copy.title}</h2>
    <span>{copy.intro}</span>
  </header>
  <ShowcaseCarousel
    id='anime'
    title={copy.animeTitle}
    eyebrow={copy.animeEyebrow}
    items={localizedAnime}
    locale={locale}
  />
  <ShowcaseCarousel
    id='favorites'
    title={copy.favoritesTitle}
    eyebrow={copy.favoritesEyebrow}
    items={localizedFavorites}
    locale={locale}
  />

  <dialog
    class='archive-viewer'
    data-archive-viewer
    data-play-trailer={copy.playTrailer}
    data-play-music={copy.playMusic}
    data-trailer-status={copy.trailerStatus}
    data-music-status={copy.musicStatus}
    aria-label={copy.viewerLabel}
  >
    <div class='viewer-surface'>
      <img class='viewer-backdrop' data-viewer-backdrop alt='' aria-hidden='true' />
      <img class='viewer-image' data-viewer-image alt='' />
      <span class='viewer-shade' aria-hidden='true'></span>
      <button class='viewer-close' type='button' data-viewer-close aria-label={copy.close}>×</button
      >
      <div class='viewer-copy'>
        <small data-viewer-count></small>
        <h3 data-viewer-title></h3>
        <p data-viewer-description></p>
        <p class='viewer-source' data-viewer-source></p>
        <div class='viewer-media' data-viewer-media hidden>
          <button class='viewer-play' type='button' data-viewer-play></button>
          <iframe
            class='viewer-player'
            data-viewer-player
            title={isEnglish ? 'Selected media player' : '所选媒体播放器'}
            loading='lazy'
            allow='autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture'
            hidden></iframe>
        </div>
        <span class='viewer-status' data-viewer-status role='status'></span>
      </div>
      <div class='viewer-footer'>
        <div class='viewer-links'>
          <a data-viewer-detail target='_blank' rel='noopener noreferrer'>{copy.detail} ↗</a>
          <a data-viewer-poster target='_blank' rel='noopener noreferrer'>{copy.poster} ↗</a>
        </div>
        <div class='viewer-controls' aria-label={isEnglish ? 'Archive controls' : '档案控制'}>
          <span data-viewer-index aria-live='polite'></span>
          <button type='button' data-viewer-prev aria-label={copy.previous}>←</button>
          <button type='button' data-viewer-next aria-label={copy.next}>→</button>
        </div>
      </div>
    </div>
  </dialog>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-personal-showcase]').forEach((root) => {
    const viewer = root.querySelector<HTMLDialogElement>('[data-archive-viewer]')
    const poster = viewer?.querySelector<HTMLImageElement>('[data-viewer-image]')
    const backdrop = viewer?.querySelector<HTMLImageElement>('[data-viewer-backdrop]')
    const count = viewer?.querySelector<HTMLElement>('[data-viewer-count]')
    const title = viewer?.querySelector<HTMLElement>('[data-viewer-title]')
    const description = viewer?.querySelector<HTMLElement>('[data-viewer-description]')
    const source = viewer?.querySelector<HTMLElement>('[data-viewer-source]')
    const indexLabel = viewer?.querySelector<HTMLElement>('[data-viewer-index]')
    const detail = viewer?.querySelector<HTMLAnchorElement>('[data-viewer-detail]')
    const posterSource = viewer?.querySelector<HTMLAnchorElement>('[data-viewer-poster]')
    const previous = viewer?.querySelector<HTMLButtonElement>('[data-viewer-prev]')
    const next = viewer?.querySelector<HTMLButtonElement>('[data-viewer-next]')
    const close = viewer?.querySelector<HTMLButtonElement>('[data-viewer-close]')
    const media = viewer?.querySelector<HTMLElement>('[data-viewer-media]')
    const play = viewer?.querySelector<HTMLButtonElement>('[data-viewer-play]')
    const player = viewer?.querySelector<HTMLIFrameElement>('[data-viewer-player]')
    const status = viewer?.querySelector<HTMLElement>('[data-viewer-status]')
    const labels = {
      detail: detail?.textContent ?? '',
      poster: posterSource?.textContent ?? '',
      playTrailer: viewer?.dataset.playTrailer ?? '',
      playMusic: viewer?.dataset.playMusic ?? '',
      trailer: viewer?.dataset.trailerStatus ?? '',
      music: viewer?.dataset.musicStatus ?? ''
    }
    let activeShelf: HTMLElement | null = null
    let activeItems: HTMLAnchorElement[] = []
    let activeIndex = 0
    let returnTrigger: HTMLAnchorElement | null = null
    let previousOverflow = ''

    const syncViewer = (requestedIndex: number) => {
      if (
        !viewer ||
        !poster ||
        !backdrop ||
        !count ||
        !title ||
        !description ||
        !source ||
        !indexLabel ||
        !detail ||
        !posterSource ||
        !previous ||
        !next ||
        !media ||
        !play ||
        !player ||
        !status
      )
        return
      activeIndex = Math.max(0, Math.min(activeItems.length - 1, requestedIndex))
      const trigger = activeItems[activeIndex]
      const card = trigger?.closest<HTMLElement>('[data-archive-card]')
      const cardImage = card?.querySelector<HTMLImageElement>('img')
      const heading = trigger?.querySelector<HTMLElement>('.archive-card-copy h3')
      const summary = trigger?.querySelector<HTMLElement>('.archive-card-copy p')
      const itemTitle = heading?.textContent?.trim() ?? ''
      const imageUrl = cardImage?.currentSrc || cardImage?.src || ''
      if (!trigger || !card || !cardImage) return

      poster.src = imageUrl
      poster.alt = cardImage.alt
      backdrop.src = imageUrl
      title.textContent = itemTitle
      description.textContent = summary?.textContent?.trim() ?? ''
      source.textContent = card.dataset.sourceLabel ?? ''
      count.textContent = `${activeShelf?.querySelector('h2')?.textContent ?? ''} / ${String(activeIndex + 1).padStart(2, '0')}`
      indexLabel.textContent = `${activeIndex + 1} / ${activeItems.length}`
      detail.href = trigger.href
      detail.textContent = labels.detail

      const posterHref = card.dataset.posterSource
      posterSource.hidden = !posterHref
      if (posterHref) posterSource.href = posterHref
      posterSource.textContent = labels.poster

      const videoId = card.dataset.videoId
      const spotifyUrl = card.dataset.spotify
      media.hidden = !videoId && !spotifyUrl
      player.hidden = true
      player.removeAttribute('src')
      play.hidden = !videoId && !spotifyUrl
      play.textContent = spotifyUrl ? labels.playMusic : labels.playTrailer
      play.dataset.videoId = videoId ?? ''
      play.dataset.spotifyUrl = spotifyUrl ?? ''
      status.textContent = videoId ? card.dataset.videoSource || labels.trailer : ''
      previous.disabled = activeIndex === 0
      next.disabled = activeIndex === activeItems.length - 1
    }

    const closeViewer = () => {
      if (viewer?.open) viewer.close()
    }

    root.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null
      const trigger = target?.closest<HTMLAnchorElement>('[data-viewer-trigger]')
      const shelf = trigger?.closest<HTMLElement>('[data-carousel]')
      if (!trigger || !shelf || root.dataset.suppressClick === 'true') return
      event.preventDefault()
      activeShelf = shelf
      activeItems = [...shelf.querySelectorAll<HTMLAnchorElement>('[data-viewer-trigger]')]
      activeIndex = activeItems.indexOf(trigger)
      returnTrigger = trigger
      syncViewer(activeIndex)
      viewer?.showModal()
      previousOverflow = document.documentElement.style.overflow
      document.documentElement.style.overflow = 'hidden'
      close?.focus()
    })

    play?.addEventListener('click', () => {
      if (!player || !play) return
      if (play.dataset.spotifyUrl) {
        player.title = play.dataset.spotifyUrl.includes('spotify')
          ? 'Spotify track player'
          : 'Selected media player'
        player.src = play.dataset.spotifyUrl
        player.hidden = false
        play.hidden = true
        if (status) status.textContent = labels.music
        return
      }
      const videoId = play.dataset.videoId
      if (!videoId) return
      player.title = 'Official anime trailer'
      player.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&mute=1&rel=0`
      player.hidden = false
      play.hidden = true
      if (status) status.textContent = labels.trailer
    })

    previous?.addEventListener('click', () => syncViewer(activeIndex - 1))
    next?.addEventListener('click', () => syncViewer(activeIndex + 1))
    close?.addEventListener('click', closeViewer)
    viewer?.addEventListener('cancel', () => {
      // Native dialog cancellation closes through the matching close event.
    })
    viewer?.addEventListener('close', () => {
      player?.removeAttribute('src')
      if (player) player.hidden = true
      document.documentElement.style.overflow = previousOverflow
      returnTrigger?.focus()
    })
    viewer?.addEventListener('close', () => {
      returnTrigger = null
      activeItems = []
      activeShelf = null
    })
    document.addEventListener('keydown', (event) => {
      if (!viewer?.open) return
      if (event.key === 'ArrowLeft') {
        event.preventDefault()
        syncViewer(activeIndex - 1)
      } else if (event.key === 'ArrowRight') {
        event.preventDefault()
        syncViewer(activeIndex + 1)
      }
    })
  })
</script>

<style>
  .personal-showcase {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: clamp(2.2rem, 5vw, 3.8rem);
    scroll-margin-top: 5.5rem;
  }
  .favorites-ticket {
    position: absolute;
    z-index: -1;
    top: -1.4rem;
    right: clamp(-1rem, -5vw, -3rem);
    width: clamp(7rem, 16vw, 12rem);
    height: auto;
    opacity: 0.15;
    pointer-events: none;
  }
  .personal-heading {
    display: grid;
    max-width: 48rem;
    gap: 0.55rem;
    border-top: 1px solid hsl(var(--border));
    padding-top: 1.1rem;
  }
  .personal-heading p {
    margin: 0;
    color: hsl(var(--field-amber-strong));
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .personal-heading h2 {
    max-width: 20ch;
    margin: 0;
    font-size: clamp(1.7rem, 4vw, 2.7rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1.05;
    text-wrap: balance;
  }
  .personal-heading span {
    max-width: 58ch;
    color: hsl(var(--muted-foreground));
    font-size: 0.82rem;
    line-height: 1.7;
  }
  .archive-viewer {
    position: fixed;
    inset: 0;
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    overflow: hidden;
    border: 0;
    padding: 0;
    background: #171815;
    color: white;
  }
  .archive-viewer::backdrop {
    background: rgb(8 9 8 / 0.9);
  }
  .viewer-surface {
    position: relative;
    display: grid;
    width: 100%;
    height: 100%;
    grid-template-rows: minmax(0, 1fr) auto;
    overflow: hidden;
    isolation: isolate;
  }
  .viewer-backdrop {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(34px) brightness(0.32) saturate(0.85);
    transform: scale(1.12);
  }
  .viewer-image {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: var(--viewer-object-position, 50% 50%);
  }
  .viewer-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.72), transparent 68%),
      linear-gradient(0deg, rgb(0 0 0 / 0.7), transparent 28%);
    pointer-events: none;
  }
  .viewer-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 2;
    display: grid;
    width: 2.7rem;
    height: 2.7rem;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: 50%;
    background: rgb(0 0 0 / 0.4);
    color: white;
    font-size: 1.45rem;
  }
  .viewer-close:focus-visible,
  .viewer-controls button:focus-visible,
  .viewer-links a:focus-visible,
  .viewer-play:focus-visible {
    outline: 2px solid white;
    outline-offset: 3px;
  }
  .viewer-copy {
    align-self: center;
    width: min(100% - 3rem, 46rem);
    padding: clamp(2rem, 6vw, 4rem);
    text-shadow: 0 2px 18px rgb(0 0 0 / 0.45);
  }
  .viewer-copy small {
    color: var(--viewer-accent, #e7b56a);
    font-family: ui-monospace, monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .viewer-copy h3 {
    max-width: 14ch;
    margin: 0.6rem 0 0;
    font-size: clamp(2.4rem, 7vw, 5.6rem);
    font-weight: 630;
    letter-spacing: -0.06em;
    line-height: 0.96;
  }
  .viewer-copy > p {
    max-width: 46ch;
    margin: 0.8rem 0 0;
    color: rgb(255 255 255 / 0.83);
    font-size: clamp(0.85rem, 1.5vw, 1rem);
    line-height: 1.65;
  }
  .viewer-copy .viewer-source {
    color: rgb(255 255 255 / 0.66);
    font-size: 0.69rem;
  }
  .viewer-status {
    display: block;
    margin-top: 0.6rem;
    color: rgb(255 255 255 / 0.72);
    font-size: 0.72rem;
  }
  .viewer-footer {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem clamp(1rem, 4vw, 2.5rem);
    color: rgb(255 255 255 / 0.72);
  }
  .viewer-links,
  .viewer-controls {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .viewer-links a,
  .viewer-controls button {
    display: inline-flex;
    min-height: 2.3rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: 999px;
    padding: 0.45rem 0.75rem;
    background: rgb(0 0 0 / 0.32);
    color: white;
    font-size: 0.72rem;
    text-decoration: none;
  }
  .viewer-controls span {
    margin-right: 0.3rem;
    font-family: ui-monospace, monospace;
    font-size: 0.66rem;
    font-variant-numeric: tabular-nums;
  }
  .viewer-controls button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .viewer-media:not([hidden]) {
    display: grid;
    width: min(30rem, 100%);
    gap: 0.6rem;
    margin-top: 0.8rem;
  }
  .viewer-play {
    justify-self: start;
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: 999px;
    padding: 0.5rem 0.8rem;
    background: rgb(0 0 0 / 0.4);
    color: white;
    font-size: 0.74rem;
  }
  .viewer-player {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: 0.6rem;
    background: #000;
  }
  .viewer-player[hidden],
  .viewer-media[hidden],
  .viewer-links a[hidden] {
    display: none;
  }
  @media (max-width: 720px) {
    .favorites-ticket {
      top: -0.8rem;
      right: -0.5rem;
      width: 7rem;
      opacity: 0.11;
    }
    .viewer-copy {
      align-self: end;
      width: 100%;
      padding: 1.5rem 1.25rem 1rem;
    }
    .viewer-copy h3 {
      font-size: clamp(2.1rem, 10vw, 3.4rem);
    }
    .viewer-footer {
      align-items: start;
      flex-direction: column;
      padding: 0.8rem 1.25rem 1.25rem;
    }
    .viewer-shade {
      background: linear-gradient(0deg, rgb(0 0 0 / 0.88), transparent 72%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .viewer-backdrop {
      transform: none;
    }
  }
</style>
