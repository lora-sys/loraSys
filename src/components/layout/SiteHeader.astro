---
import { Icon } from 'astro-pure/user'
import { getLocale, localeMeta, localizedPath, primaryNavigation } from '@/i18n/site'

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/'
const locale = getLocale(pathname)
const copy = localeMeta(locale)
const menu = primaryNavigation(locale)
const alternate = localizedPath(pathname, locale === 'zh-CN' ? 'en-US' : 'zh-CN')
const home = locale === 'en-US' ? '/en/' : '/'
const search = locale === 'en-US' ? '/search' : '/search'
---

<header class='site-header' data-site-header>
  <a class='brand' href={home} aria-label={locale === 'en-US' ? 'Lora home' : 'Lora 首页'}>Lora</a>

  <nav class='primary-nav' aria-label={locale === 'en-US' ? 'Primary navigation' : '主导航'} data-primary-nav>
    {menu.map((item) => <a href={item.href}>{item.title}</a>)}
  </nav>

  <div class='header-tools'>
    <a class='contact-cta' href={locale === 'en-US' ? '/en/contact' : '/contact'}>{copy.contactLabel}</a>
    <a class='locale-toggle' href={alternate} hreflang={locale === 'en-US' ? 'zh-CN' : 'en-US'} lang={locale === 'en-US' ? 'zh-CN' : 'en-US'}>{copy.switchLabel}</a>
    <a class='search-link' href={search} title={copy.searchLabel} aria-label={copy.searchLabel}><Icon name='search' class='size-4' /></a>
    <button id='toggleDarkMode' type='button' aria-label={locale === 'en-US' ? 'Toggle dark theme' : '切换深色主题'}>
      <Icon class='system size-4' name='computer' />
      <Icon class='light hidden size-4' name='sun' />
      <Icon class='dark hidden size-4' name='moon' />
    </button>
    <button class='menu-toggle' type='button' data-menu-toggle aria-expanded='false' aria-controls='mobile-navigation'>
      <span class='sr-only'>{locale === 'en-US' ? 'Open menu' : '打开菜单'}</span><Icon name='menu' class='size-5' />
    </button>
  </div>

  <nav id='mobile-navigation' class='mobile-nav' aria-label={locale === 'en-US' ? 'Mobile navigation' : '移动端导航'} data-mobile-nav hidden>
    {menu.map((item) => <a href={item.href}>{item.title}</a>)}
    <a href={locale === 'en-US' ? '/en/contact' : '/contact'}>{copy.contactLabel}</a>
    <a href={alternate} hreflang={locale === 'en-US' ? 'zh-CN' : 'en-US'}>{locale === 'en-US' ? '中文' : 'English'}</a>
  </nav>
</header>

<script is:inline>
  const themeButton = document.getElementById('toggleDarkMode')
  if (themeButton) themeButton.dataset.theme = localStorage.getItem('theme') || 'system'
</script>
<script>
  import { setTheme } from 'astro-pure/utils'

  const header = document.querySelector<HTMLElement>('[data-site-header]')
  const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')
  const mobileNav = document.querySelector<HTMLElement>('[data-mobile-nav]')
  const themeButton = document.querySelector<HTMLButtonElement>('#toggleDarkMode')

  const setMenu = (open: boolean) => {
    if (!menuToggle || !mobileNav) return
    menuToggle.setAttribute('aria-expanded', open.toString())
    mobileNav.hidden = !open
    header?.classList.toggle('menu-open', open)
  }

  menuToggle?.addEventListener('click', () => setMenu(menuToggle.getAttribute('aria-expanded') !== 'true'))
  mobileNav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)))
  const currentPath = window.location.pathname.replace(/\/$/, '') || '/'
  document.querySelectorAll<HTMLAnchorElement>('[data-primary-nav] a, [data-mobile-nav] a').forEach((link) => {
    const linkPath = new URL(link.href, window.location.origin).pathname.replace(/\/$/, '') || '/'
    if (linkPath === currentPath) link.setAttribute('aria-current', 'page')
  })

  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setMenu(false) })
  window.addEventListener('resize', () => { if (matchMedia('(min-width: 900px)').matches) setMenu(false) })

  themeButton?.addEventListener('click', () => {
    themeButton.dataset.theme = setTheme(undefined, true)
  })
</script>

<style>
  .site-header{position:sticky;top:1rem;z-index:50;display:flex;align-items:center;min-height:3.3rem;margin-bottom:clamp(2.75rem,7vw,5rem);border:1px solid hsl(var(--border) / .72);border-radius:1rem;padding:.42rem .55rem .42rem .85rem;background:hsl(var(--background) / .78);box-shadow:0 10px 34px -28px hsl(var(--foreground) / .45);backdrop-filter:blur(18px)}.brand{margin-right:auto;color:hsl(var(--foreground));font-size:1.12rem;font-weight:650;letter-spacing:-.05em;text-decoration:none}.primary-nav{display:flex;align-items:center;gap:.12rem}.primary-nav a,.mobile-nav a{border-radius:.5rem;padding:.46rem .58rem;color:hsl(var(--muted-foreground));font-size:.72rem;font-weight:590;text-decoration:none;transition:background 160ms ease,color 160ms ease,transform 160ms ease}.primary-nav a:hover,.primary-nav a:focus-visible,.mobile-nav a:hover,.mobile-nav a:focus-visible{background:hsl(var(--muted));color:hsl(var(--foreground));transform:translateY(-1px)}.primary-nav a[aria-current='page'],.mobile-nav a[aria-current='page']{background:hsl(173 60% 36% / .12);box-shadow:inset 0 -2px hsl(173 60% 36%);color:hsl(var(--foreground))}.header-tools{display:flex;align-items:center;gap:.28rem;margin-left:.55rem}.contact-cta,.locale-toggle,.search-link,#toggleDarkMode,.menu-toggle{display:inline-grid;min-height:2rem;place-items:center;border:1px solid hsl(var(--border));border-radius:.55rem;background:transparent;color:hsl(var(--foreground));font-size:.67rem;font-weight:650;text-decoration:none}.contact-cta{padding-inline:.58rem;background:hsl(var(--foreground));color:hsl(var(--background));border-color:hsl(var(--foreground));transition:transform 160ms cubic-bezier(.23,1,.32,1),opacity 160ms ease}.contact-cta:hover,.contact-cta:focus-visible{opacity:.84;transform:translateY(-1px)}.contact-cta:active,.primary-nav a:active,.mobile-nav a:active{transform:scale(.97)}.locale-toggle{min-width:2rem;padding-inline:.42rem;color:hsl(173 60% 31%)}.search-link,#toggleDarkMode,.menu-toggle{width:2rem;padding:0}.menu-toggle{display:none}.mobile-nav[hidden]{display:none}.mobile-nav{position:absolute;top:calc(100% + .5rem);right:0;left:0;display:grid;gap:.2rem;border:1px solid hsl(var(--border));border-radius:.9rem;padding:.45rem;background:hsl(var(--background));box-shadow:0 18px 46px -28px hsl(var(--foreground) / .45)}.mobile-nav a{padding:.72rem .75rem;font-size:.82rem}.mobile-nav a:nth-last-child(2){margin-top:.18rem;background:hsl(var(--foreground));color:hsl(var(--background))}#toggleDarkMode[data-theme='dark'] .system,#toggleDarkMode[data-theme='light'] .system{display:none}#toggleDarkMode[data-theme='dark'] .dark,#toggleDarkMode[data-theme='light'] .light{display:block}@media(max-width:1040px){.primary-nav a{padding-inline:.42rem;font-size:.67rem}}@media(max-width:899px){.primary-nav,.contact-cta,.header-tools>.locale-toggle,.header-tools>.search-link{display:none}.menu-toggle{display:grid}.site-header{margin-bottom:2rem}}@media(prefers-reduced-motion:reduce){.primary-nav a,.mobile-nav a,.contact-cta{transition:none}.primary-nav a:hover,.primary-nav a:focus-visible,.mobile-nav a:hover,.mobile-nav a:focus-visible,.contact-cta:hover,.contact-cta:focus-visible,.contact-cta:active,.primary-nav a:active,.mobile-nav a:active{transform:none}}
</style>
