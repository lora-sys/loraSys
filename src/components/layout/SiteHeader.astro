---
import { Icon } from 'astro-pure/user'
import { getLocale, localeMeta, localizedPath, primaryNavigation } from '@/i18n/site'

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/'
const locale = getLocale(pathname)
const copy = localeMeta(locale)
const menu = primaryNavigation(locale)
const alternate = localizedPath(pathname, locale === 'zh-CN' ? 'en-US' : 'zh-CN')
const home = locale === 'en-US' ? '/en/' : '/'
const search = locale === 'en-US' ? '/search' : '/search'
---

<header class='site-header' data-site-header>
  <a class='brand' href={home} aria-label={locale === 'en-US' ? 'Lora home' : 'Lora 首页'}>Lora</a>

  <nav class='primary-nav' aria-label={locale === 'en-US' ? 'Primary navigation' : '主导航'} data-primary-nav>
    {menu.map((item) => <a class='tactile-action' href={item.href} data-nav-note={item.title}>{item.title}</a>)}
  </nav>

  <div class='header-tools'>
    <a class='contact-cta tactile-action' href={locale === 'en-US' ? '/en/contact' : '/contact'}>{copy.contactLabel}</a>
    <a class='locale-toggle' href={alternate} hreflang={locale === 'en-US' ? 'zh-CN' : 'en-US'} lang={locale === 'en-US' ? 'zh-CN' : 'en-US'}>{copy.switchLabel}</a>
    <a class='search-link' href={search} title={copy.searchLabel} aria-label={copy.searchLabel}><Icon name='search' class='size-4' /></a>
    <button id='toggleDarkMode' type='button' aria-label={locale === 'en-US' ? 'Toggle dark theme' : '切换深色主题'} aria-pressed='false'>
      <Icon class='system size-4' name='computer' />
      <Icon class='light hidden size-4' name='sun' />
      <Icon class='dark hidden size-4' name='moon' />
    </button>
    <button class='menu-toggle' type='button' data-menu-toggle aria-expanded='false' aria-controls='mobile-navigation'>
      <span class='sr-only'>{locale === 'en-US' ? 'Open menu' : '打开菜单'}</span><Icon name='menu' class='size-5' />
    </button>
  </div>

  <span class='scroll-progress' data-scroll-progress aria-hidden='true'></span>
  <nav id='mobile-navigation' class='mobile-nav' aria-label={locale === 'en-US' ? 'Mobile navigation' : '移动端导航'} data-mobile-nav hidden>
    {menu.map((item) => <a class='tactile-action' href={item.href}>{item.title}</a>)}
    <a class='tactile-action' href={locale === 'en-US' ? '/en/contact' : '/contact'}>{copy.contactLabel}</a>
    <a href={alternate} hreflang={locale === 'en-US' ? 'zh-CN' : 'en-US'}>{locale === 'en-US' ? '中文' : 'English'}</a>
  </nav>
</header>

<script is:inline>
  const themeButton = document.getElementById('toggleDarkMode')
  if (themeButton) {
    const savedTheme = localStorage.getItem('theme') || 'system'
    themeButton.dataset.theme = savedTheme
    const appliedTheme = savedTheme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : savedTheme
    themeButton.setAttribute('aria-pressed', String(appliedTheme === 'dark'))
  }
</script>
<script>
  import { setTheme } from 'astro-pure/utils'

  const header = document.querySelector<HTMLElement>('[data-site-header]')
  const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')
  const mobileNav = document.querySelector<HTMLElement>('[data-mobile-nav]')
  const themeButton = document.querySelector<HTMLButtonElement>('#toggleDarkMode')
  const scrollProgress = document.querySelector<HTMLElement>('[data-scroll-progress]')
  let menuReturnFocus: HTMLElement | null = null

  const updateScrollState = () => {
    if (!header) return
    header.toggleAttribute('data-scrolled', window.scrollY > 18)
    const maxScroll = document.documentElement.scrollHeight - window.innerHeight
    const progress = maxScroll > 0 ? Math.min(1, Math.max(0, window.scrollY / maxScroll)) : 0
    scrollProgress?.style.setProperty('--page-scroll', progress.toFixed(4))
  }

  const setMenu = (open: boolean, restoreFocus = false) => {
    if (!menuToggle || !mobileNav) return
    if (open && menuToggle.getAttribute('aria-expanded') !== 'true') menuReturnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : menuToggle
    menuToggle.setAttribute('aria-expanded', open.toString())
    mobileNav.hidden = !open
    header?.classList.toggle('menu-open', open)
    if (open) window.requestAnimationFrame(() => mobileNav.querySelector<HTMLElement>('a')?.focus())
    if (!open && restoreFocus) menuReturnFocus?.focus()
  }

  menuToggle?.addEventListener('click', () => setMenu(menuToggle.getAttribute('aria-expanded') !== 'true'))
  mobileNav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)))
  const currentPath = window.location.pathname.replace(/\/$/, '') || '/'
  document.querySelectorAll<HTMLAnchorElement>('[data-primary-nav] a, [data-mobile-nav] a').forEach((link) => {
    const linkPath = new URL(link.href, window.location.origin).pathname.replace(/\/$/, '') || '/'
    if (linkPath === currentPath) link.setAttribute('aria-current', 'page')
  })

  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setMenu(false, true) })
  document.addEventListener('pointerdown', (event) => {
    if (header && event.target instanceof Node && !header.contains(event.target)) setMenu(false)
  })
  window.addEventListener('resize', () => { if (matchMedia('(min-width: 900px)').matches) setMenu(false) })
  window.addEventListener('scroll', updateScrollState, { passive: true })
  updateScrollState()

  themeButton?.addEventListener('click', () => {
    const root = document.documentElement
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const rect = themeButton.getBoundingClientRect()
    root.style.setProperty('--theme-origin-x', `${rect.left + rect.width / 2}px`)
    root.style.setProperty('--theme-origin-y', `${rect.top + rect.height / 2}px`)

    const applyTheme = () => {
      const nextTheme = setTheme(undefined, true)
      themeButton.dataset.theme = nextTheme
      const appliedTheme = nextTheme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : nextTheme
      themeButton.setAttribute('aria-pressed', String(appliedTheme === 'dark'))
    }

    const finish = () => {
      window.setTimeout(() => {
        root.removeAttribute('data-theme-transition')
        root.style.removeProperty('--theme-origin-x')
        root.style.removeProperty('--theme-origin-y')
      }, 300)
    }

    if (reducedMotion || !document.startViewTransition) {
      root.setAttribute('data-theme-transition', 'true')
      applyTheme()
      finish()
      return
    }

    root.setAttribute('data-theme-transition', 'true')
    document.startViewTransition(applyTheme).finished.finally(finish)
  })
</script>

<style>
  .site-header{position:sticky;top:1rem;z-index:50;display:flex;align-items:center;min-height:3.3rem;margin-bottom:clamp(2.75rem,7vw,5rem);border:1px solid hsl(var(--border) / .72);border-radius:1rem;padding:.42rem .55rem .42rem .85rem;background:hsl(var(--background) / .78);box-shadow:0 10px 34px -28px hsl(var(--foreground) / .45);backdrop-filter:blur(18px);transition:border-color var(--motion-base,190ms) ease,background var(--motion-base,190ms) ease,box-shadow var(--motion-base,190ms) ease,transform var(--motion-quick,140ms) var(--motion-spring,cubic-bezier(.23,1,.32,1))}.scroll-progress{position:absolute;right:.6rem;bottom:-.22rem;left:.6rem;height:2px;border-radius:999px;background:hsl(var(--field-teal,173 52% 42%));box-shadow:0 2px 9px hsl(var(--field-teal,173 52% 42%) / .25);opacity:.72;pointer-events:none;transform:scaleX(var(--page-scroll,0));transform-origin:left;transition:transform 120ms linear,opacity 160ms ease}.site-header:not([data-scrolled]) .scroll-progress{opacity:0}.site-header[data-scrolled]{border-color:hsl(var(--field-teal,173 52% 42%) / .24);background:hsl(var(--background) / .92);box-shadow:0 18px 44px -32px hsl(var(--foreground) / .52);transform:translateY(-.08rem)}.brand{margin-right:auto;color:hsl(var(--foreground));font-size:1.12rem;font-weight:650;letter-spacing:-.05em;text-decoration:none}.primary-nav{display:flex;align-items:center;gap:.12rem}.primary-nav a,.mobile-nav a{border-radius:.5rem;padding:.46rem .58rem;color:hsl(var(--muted-foreground));font-size:.72rem;font-weight:590;text-decoration:none;transition:background 160ms ease,color 160ms ease,transform 160ms ease}.primary-nav a:hover,.primary-nav a:focus-visible,.mobile-nav a:hover,.mobile-nav a:focus-visible{background:hsl(var(--muted));color:hsl(var(--foreground));transform:translateY(-1px)}.primary-nav a[aria-current='page'],.mobile-nav a[aria-current='page']{background:hsl(173 60% 36% / .12);box-shadow:inset 0 -2px hsl(173 60% 36%);color:hsl(var(--foreground))}.header-tools{display:flex;align-items:center;gap:.28rem;margin-left:.55rem}.contact-cta,.locale-toggle,.search-link,#toggleDarkMode,.menu-toggle{display:inline-grid;min-height:2rem;place-items:center;border:1px solid hsl(var(--border));border-radius:.55rem;background:transparent;color:hsl(var(--foreground));font-size:.67rem;font-weight:650;text-decoration:none}.contact-cta{padding-inline:.58rem;background:hsl(var(--foreground));color:hsl(var(--background));border-color:hsl(var(--foreground));transition:transform 160ms cubic-bezier(.23,1,.32,1),opacity 160ms ease}.contact-cta:hover,.contact-cta:focus-visible{opacity:.84;transform:translateY(-1px)}.contact-cta:active,.primary-nav a:active,.mobile-nav a:active,.locale-toggle:active,.search-link:active,#toggleDarkMode:active,.menu-toggle:active{transform:scale(.97)}.locale-toggle{min-width:2rem;padding-inline:.42rem;color:hsl(173 60% 31%)}.search-link,#toggleDarkMode,.menu-toggle{width:2rem;padding:0}.menu-toggle{display:none}.mobile-nav[hidden]{display:none}.mobile-nav{position:absolute;top:calc(100% + .5rem);right:0;left:0;display:grid;gap:.2rem;border:1px solid hsl(var(--border));border-radius:.9rem;padding:.45rem;background:hsl(var(--background));box-shadow:0 18px 46px -28px hsl(var(--foreground) / .45)}.mobile-nav a{padding:.72rem .75rem;font-size:.82rem}.mobile-nav a:nth-last-child(2){margin-top:.18rem;background:hsl(var(--foreground));color:hsl(var(--background))}#toggleDarkMode[data-theme='dark'] .system,#toggleDarkMode[data-theme='light'] .system{display:none}#toggleDarkMode[data-theme='dark'] .dark,#toggleDarkMode[data-theme='light'] .light{display:block}@media(max-width:1040px){.primary-nav a{padding-inline:.42rem;font-size:.67rem}}@media(max-width:899px){.primary-nav,.contact-cta,.header-tools>.locale-toggle,.header-tools>.search-link{display:none}.menu-toggle{display:grid}.site-header{margin-bottom:2rem}#toggleDarkMode,.menu-toggle{position:relative}#toggleDarkMode::after,.menu-toggle::after{position:absolute;inset:-.32rem;content:''}.mobile-nav a{display:flex;align-items:center;min-height:2.75rem}}@media(prefers-reduced-motion:reduce){.site-header,.scroll-progress,.primary-nav a,.mobile-nav a,.contact-cta{transition:none}.primary-nav a:hover,.primary-nav a:focus-visible,.mobile-nav a:hover,.mobile-nav a:focus-visible,.contact-cta:hover,.contact-cta:focus-visible,.contact-cta:active,.primary-nav a:active,.mobile-nav a:active,.locale-toggle:active,.search-link:active,#toggleDarkMode:active,.menu-toggle:active{transform:none}}
</style>
