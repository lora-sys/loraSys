---
import {
  footerNavigation,
  getLocale,
  hasAlternate,
  localeMeta,
  localizedPath,
  primaryNavigation,
  withBasePath
} from '@/i18n/site'

import { Icon } from 'astro-pure/user'
import { Image } from 'astro:assets'
import loraCheer from '@/assets/lora-visual/v3/lora-icon-cheer-v1.webp'
import loraCoding from '@/assets/lora-visual/v3/lora-icon-coding-v1.webp'
import loraNeutral from '@/assets/lora-visual/v3/lora-icon-neutral-v1.webp'
import loraReading from '@/assets/lora-visual/v3/lora-icon-reading-v1.webp'
import loraSleepy from '@/assets/lora-visual/v3/lora-icon-sleepy-v1.webp'
import loraThinking from '@/assets/lora-visual/v3/lora-icon-thinking-v1.webp'
import loraWave from '@/assets/lora-visual/v3/lora-icon-wave-v1.webp'

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/'
interface Props {
  locale?: 'zh-CN' | 'en-US'
}
const locale = Astro.props.locale ?? getLocale(pathname)
const copy = localeMeta(locale)
const menu = primaryNavigation(locale)
const mainMenu = menu.filter((item) => !item.href.endsWith('/links'))
const moreMenu = [
  ...menu.filter((item) => item.href.endsWith('/links')),
  ...footerNavigation(locale)
]
const otherLocale = locale === 'zh-CN' ? 'en-US' : 'zh-CN'
// 无对应路由的页面不提供语言切换，避免把访客丢回对方语言首页。
const alternate = hasAlternate(pathname, otherLocale)
  ? withBasePath(localizedPath(pathname, otherLocale))
  : undefined
const home = withBasePath(locale === 'en-US' ? '/en' : '/')
const search = withBasePath(locale === 'en-US' ? '/en/search' : '/search')
const isProjectPage =
  pathname.startsWith('/projects') || pathname.startsWith('/en/work') || pathname.startsWith('/en/projects')
const isWritingPage =
  pathname.startsWith('/blog') ||
  pathname.startsWith('/en/writing') ||
  pathname.startsWith('/archives')
const isNowOrSearchPage =
  pathname.startsWith('/now') ||
  pathname.startsWith('/en/now') ||
  pathname.startsWith('/search') ||
  pathname.startsWith('/en/search')
const isContactOrTalksPage =
  pathname.startsWith('/talks') ||
  pathname.startsWith('/en/talks') ||
  pathname.startsWith('/contact') ||
  pathname.startsWith('/en/contact') ||
  pathname.startsWith('/guestbook') ||
  pathname.startsWith('/en/guestbook')
const isTermsPage = pathname.startsWith('/terms')
const pageMood = isProjectPage
  ? loraCoding
  : isWritingPage
    ? loraReading
    : isNowOrSearchPage
      ? loraThinking
      : isContactOrTalksPage
        ? loraCheer
        : isTermsPage
          ? loraSleepy
          : loraNeutral
---

<header class='site-header' data-site-header>
  <a class='brand' href={home} aria-label={locale === 'en-US' ? 'Lora home' : 'Lora 首页'}>
    <span class='brand-avatar' aria-hidden='true'>
      <Image class='brand-avatar__mood' src={pageMood} alt='' width={80} height={80} />
      <Image class='brand-avatar__wave' src={loraWave} alt='' width={80} height={80} />
    </span>
    <span>Lora</span>
  </a>

  <nav
    class='primary-nav'
    aria-label={locale === 'en-US' ? 'Primary navigation' : '主导航'}
    data-primary-nav
  >
    {
      mainMenu.map((item) => (
        <a class='tactile-action' href={withBasePath(item.href)}>
          {item.title}
        </a>
      ))
    }
    <div class='more-menu'>
      <button
        class='more-toggle'
        type='button'
        data-more-toggle
        aria-expanded='false'
        aria-controls='more-navigation'
      >
        {locale === 'en-US' ? 'More' : '更多'}
        <span class='more-caret' aria-hidden='true'>⌄</span>
      </button>
      <nav
        id='more-navigation'
        class='more-nav'
        aria-label={locale === 'en-US' ? 'More pages' : '更多页面'}
        data-more-nav
        hidden
      >
        {moreMenu.map((item) => <a href={withBasePath(item.href)}>{item.title}</a>)}
        <a href={withBasePath(locale === 'en-US' ? '/en/contact' : '/contact')}>{copy.contactLabel}</a>
      </nav>
    </div>
  </nav>

  <div class='header-tools'>
    <a
      class='search-link'
      href={search}
      title={`${copy.searchLabel} /`}
      aria-label={copy.searchLabel}
      aria-keyshortcuts='/'><Icon name='search' class='size-4' /></a
    >
    {
      alternate && (
        <a class='locale-toggle' href={alternate} hreflang={otherLocale} lang={otherLocale}>
          {copy.switchLabel}
        </a>
      )
    }
    <button
      id='toggleDarkMode'
      type='button'
      aria-label={locale === 'en-US'
        ? 'Theme: system. Activate to change theme.'
        : '主题：跟随系统。点击切换主题。'}
    >
      <Icon class='system size-4' name='computer' />
      <Icon class='light hidden size-4' name='sun' />
      <Icon class='dark hidden size-4' name='moon' />
    </button>
    <button
      class='menu-toggle'
      type='button'
      data-menu-toggle
      aria-expanded='false'
      aria-controls='mobile-navigation'
    >
      <span class='sr-only' data-menu-label>{locale === 'en-US' ? 'Open menu' : '打开菜单'}</span
      ><Icon name='menu' class='size-5' />
    </button>
  </div>

  <nav
    id='mobile-navigation'
    class='mobile-nav'
    aria-label={locale === 'en-US' ? 'Mobile navigation' : '移动端导航'}
    data-mobile-nav
    hidden
  >
    {mainMenu.map((item) => <a href={withBasePath(item.href)}>{item.title}</a>)}
    <span class='mobile-nav-label'>{locale === 'en-US' ? 'More pages' : '更多页面'}</span>
    {moreMenu.map((item) => <a href={withBasePath(item.href)}>{item.title}</a>)}
    <a href={withBasePath(locale === 'en-US' ? '/en/contact' : '/contact')}>{copy.contactLabel}</a>
    {
      alternate && (
        <a href={alternate} hreflang={otherLocale} lang={otherLocale}>
          {locale === 'en-US' ? '中文' : 'English'}
        </a>
      )
    }
  </nav>
</header>

<script is:inline>
  const themeButton = document.getElementById('toggleDarkMode')
  if (themeButton) {
    const savedTheme = localStorage.getItem('theme') || 'system'
    const isEnglish = document.documentElement.lang.toLowerCase().startsWith('en')
    const themeNames = isEnglish
      ? { system: 'system', light: 'light', dark: 'dark' }
      : { system: '跟随系统', light: '浅色', dark: '深色' }
    themeButton.dataset.theme = savedTheme
    themeButton.setAttribute(
      'aria-label',
      isEnglish
        ? `Theme: ${themeNames[savedTheme] || savedTheme}. Activate to change theme.`
        : `主题：${themeNames[savedTheme] || savedTheme}。点击切换主题。`
    )
  }
</script>
<script>
  import { setTheme } from 'astro-pure/utils'

  const header = document.querySelector<HTMLElement>('[data-site-header]')
  const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')
  const mobileNav = document.querySelector<HTMLElement>('[data-mobile-nav]')
  const themeButton = document.querySelector<HTMLButtonElement>('#toggleDarkMode')
  const moreToggle = document.querySelector<HTMLButtonElement>('[data-more-toggle]')
  const moreNav = document.querySelector<HTMLElement>('[data-more-nav]')
  const menuLabel = menuToggle?.querySelector<HTMLElement>('[data-menu-label]')
  const isEnglish = document.documentElement.lang.toLowerCase().startsWith('en')
  let menuReturnFocus: HTMLElement | null = null

  const updateThemeLabel = (theme: string) => {
    if (!themeButton) return
    const name = isEnglish
      ? ({ system: 'system', light: 'light', dark: 'dark' }[theme] ?? theme)
      : ({ system: '跟随系统', light: '浅色', dark: '深色' }[theme] ?? theme)
    themeButton.setAttribute(
      'aria-label',
      isEnglish ? `Theme: ${name}. Activate to change theme.` : `主题：${name}。点击切换主题。`
    )
  }

  const updateScrollState = () => {
    if (!header) return
    header.toggleAttribute('data-scrolled', window.scrollY > 24)
  }

  const setMenu = (open: boolean, restoreFocus = false) => {
    if (!menuToggle || !mobileNav) return
    if (open && menuToggle.getAttribute('aria-expanded') !== 'true') {
      const activeElement = document.activeElement
      menuReturnFocus =
        activeElement instanceof HTMLElement && activeElement !== document.body
          ? activeElement
          : menuToggle
    }
    menuToggle.setAttribute('aria-expanded', open.toString())
    if (menuLabel)
      menuLabel.textContent = open
        ? isEnglish
          ? 'Close menu'
          : '关闭菜单'
        : isEnglish
          ? 'Open menu'
          : '打开菜单'
    mobileNav.hidden = !open
    header?.classList.toggle('menu-open', open)
    if (open) window.requestAnimationFrame(() => mobileNav.querySelector<HTMLElement>('a')?.focus())
    if (!open && restoreFocus) menuReturnFocus?.focus()
  }

  menuToggle?.addEventListener('click', () =>
    setMenu(menuToggle.getAttribute('aria-expanded') !== 'true')
  )
  mobileNav
    ?.querySelectorAll('a')
    .forEach((link) => link.addEventListener('click', () => setMenu(false)))
  const setMore = (open: boolean) => {
    if (!moreToggle || !moreNav) return
    moreToggle.setAttribute('aria-expanded', String(open))
    moreNav.hidden = !open
    if (open) window.requestAnimationFrame(() => moreNav.querySelector<HTMLElement>('a')?.focus())
  }
  moreToggle?.addEventListener('click', () =>
    setMore(moreToggle.getAttribute('aria-expanded') !== 'true')
  )
  moreNav
    ?.querySelectorAll('a')
    .forEach((link) => link.addEventListener('click', () => setMore(false)))
  const currentPath = window.location.pathname.replace(/\/$/, '') || '/'
  document
    .querySelectorAll<HTMLAnchorElement>(
      '[data-primary-nav] a, [data-more-nav] a, [data-mobile-nav] a'
    )
    .forEach((link) => {
      const linkPath = new URL(link.href, window.location.origin).pathname.replace(/\/$/, '') || '/'
      if (linkPath === currentPath) link.setAttribute('aria-current', 'page')
    })

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return
    if (menuToggle?.getAttribute('aria-expanded') === 'true') setMenu(false, true)
    if (moreToggle?.getAttribute('aria-expanded') === 'true') {
      setMore(false)
      moreToggle.focus()
    }
  })
  document.addEventListener('pointerdown', (event) => {
    if (header && event.target instanceof Node && !header.contains(event.target)) {
      setMenu(false)
      setMore(false)
    }
  })
  window.addEventListener('resize', () => {
    if (matchMedia('(min-width: 900px)').matches) setMenu(false)
    else setMore(false)
  })
  window.addEventListener('scroll', updateScrollState, { passive: true })
  updateScrollState()

  document.addEventListener('keydown', (event) => {
    if (
      event.key !== '/' ||
      event.isComposing ||
      event.altKey ||
      event.ctrlKey ||
      event.metaKey ||
      event.shiftKey ||
      event.defaultPrevented
    )
      return
    if (
      event.target instanceof Element &&
      event.target.closest(
        'input, textarea, select, [contenteditable]:not([contenteditable="false"]), [role="textbox"]'
      )
    )
      return
    if (document.querySelector('dialog[open]')) return
    const input = document.querySelector<HTMLInputElement>('.pagefind-ui__search-input')
    event.preventDefault()
    if (input) input.focus()
    else document.querySelector<HTMLAnchorElement>('.search-link')?.click()
  })

  themeButton?.addEventListener('click', () => {
    const root = document.documentElement
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const rect = themeButton.getBoundingClientRect()
    root.style.setProperty('--theme-origin-x', `${rect.left + rect.width / 2}px`)
    root.style.setProperty('--theme-origin-y', `${rect.top + rect.height / 2}px`)

    const applyTheme = () => {
      const nextTheme = setTheme(undefined, true) ?? 'system'
      themeButton.dataset.theme = nextTheme
      updateThemeLabel(nextTheme)
    }

    const finish = () => {
      window.setTimeout(() => {
        root.removeAttribute('data-theme-transition')
        root.style.removeProperty('--theme-origin-x')
        root.style.removeProperty('--theme-origin-y')
      }, 300)
    }

    if (reducedMotion || !document.startViewTransition) {
      root.setAttribute('data-theme-transition', 'true')
      applyTheme()
      finish()
      return
    }

    root.setAttribute('data-theme-transition', 'true')
    document.startViewTransition(applyTheme).finished.finally(finish)
  })
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    min-height: 3.4rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    border: 1px solid transparent;
    border-radius: 0;
    padding: 0.35rem 0;
    background: transparent;
    transition:
      border-color var(--motion-base) ease,
      background var(--motion-base) ease,
      box-shadow var(--motion-base) ease;
  }

  .site-header[data-scrolled] {
    border-color: hsl(var(--border) / 0.68);
    border-radius: 0 0 0.8rem 0.8rem;
    background: hsl(var(--background) / 0.94);
    box-shadow: 0 10px 30px -26px hsl(var(--foreground) / 0.48);
    backdrop-filter: blur(12px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-right: auto;
    color: hsl(var(--foreground));
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 1.2rem;
    font-weight: 650;
    letter-spacing: -0.05em;
    text-decoration: none;
  }

  .brand-avatar {
    position: relative;
    display: block;
    width: 2.25rem;
    height: 2.25rem;
    flex: 0 0 auto;
  }

  .brand-avatar img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .brand-avatar__mood {
    opacity: 1;
  }

  .brand-avatar__wave {
    opacity: 0;
    transform: translateY(2px) scale(0.94);
  }

  .brand:hover .brand-avatar__mood,
  .brand:focus-visible .brand-avatar__mood {
    opacity: 0;
  }

  .brand:hover .brand-avatar__wave,
  .brand:focus-visible .brand-avatar__wave {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .primary-nav {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .primary-nav a,
  .mobile-nav a,
  .more-nav a {
    border-radius: 0.5rem;
    padding: 0.5rem 0.62rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.77rem;
    font-weight: 590;
    text-decoration: none;
    transition:
      background-color var(--motion-base) ease,
      color var(--motion-base) ease,
      transform var(--motion-quick) ease;
  }

  .primary-nav a:hover,
  .primary-nav a:focus-visible,
  .mobile-nav a:hover,
  .mobile-nav a:focus-visible,
  .more-nav a:hover,
  .more-nav a:focus-visible {
    background: hsl(var(--muted));
    color: hsl(var(--foreground));
    transform: translateY(-1px);
  }

  .primary-nav a[aria-current='page'],
  .mobile-nav a[aria-current='page'],
  .more-nav a[aria-current='page'] {
    background: hsl(var(--field-amber) / 0.12);
    box-shadow: inset 0 -2px hsl(var(--field-amber));
    color: hsl(var(--foreground));
  }

  .more-menu {
    position: relative;
  }

  .more-toggle {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    border: 0;
    border-radius: 0.5rem;
    padding: 0.5rem 0.62rem;
    background: transparent;
    color: hsl(var(--muted-foreground));
    font: inherit;
    font-size: 0.77rem;
  }

  .more-toggle:hover,
  .more-toggle:focus-visible,
  .more-toggle[aria-expanded='true'] {
    background: hsl(var(--muted));
    color: hsl(var(--foreground));
  }
  .more-caret {
    font-size: 1rem;
    line-height: 1;
  }
  .more-nav[hidden],
  .mobile-nav[hidden] {
    display: none;
  }

  .more-nav {
    position: absolute;
    top: calc(100% + 0.45rem);
    right: 0;
    z-index: 60;
    display: grid;
    grid-template-columns: repeat(2, minmax(8rem, 1fr));
    gap: 0.12rem;
    min-width: 19rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.75rem;
    padding: 0.4rem;
    background: hsl(var(--background));
    box-shadow: 0 14px 36px -24px hsl(var(--foreground) / 0.4);
  }

  .more-nav a {
    padding: 0.56rem 0.62rem;
    font-size: 0.76rem;
  }
  .header-tools {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: 0.7rem;
  }

  .locale-toggle,
  .search-link,
  #toggleDarkMode,
  .menu-toggle {
    display: inline-grid;
    min-width: 2.25rem;
    min-height: 2.25rem;
    place-items: center;
    border: 1px solid transparent;
    border-radius: 0.55rem;
    background: transparent;
    color: hsl(var(--foreground));
    font-size: 0.72rem;
    font-weight: 650;
    text-decoration: none;
  }

  .locale-toggle {
    color: hsl(var(--field-amber-strong));
  }
  .search-link {
    width: 2.25rem;
  }
  .menu-toggle {
    display: none;
  }
  .mobile-nav-label {
    display: none;
  }
  #toggleDarkMode[data-theme='dark'] .system,
  #toggleDarkMode[data-theme='light'] .system {
    display: none;
  }
  #toggleDarkMode[data-theme='dark'] .dark,
  #toggleDarkMode[data-theme='light'] .light {
    display: block;
  }

  @media (max-width: 899px) {
    .site-header {
      margin-bottom: 1.75rem;
      padding-block: 0.2rem;
    }
    .primary-nav,
    .header-tools > .locale-toggle {
      display: none;
    }
    .header-tools {
      gap: 0.2rem;
      margin-left: 0.5rem;
    }
    .search-link,
    #toggleDarkMode,
    .menu-toggle {
      min-width: 2.75rem;
      min-height: 2.75rem;
    }
    .menu-toggle {
      display: inline-grid;
    }

    .mobile-nav {
      position: absolute;
      top: 100%;
      right: calc(-1 * (1rem + env(safe-area-inset-right)));
      left: calc(-1 * (1rem + env(safe-area-inset-left)));
      z-index: 60;
      display: grid;
      gap: 0.12rem;
      max-height: calc(100dvh - 4.5rem);
      overflow: auto;
      border: 1px solid hsl(var(--border));
      border-radius: 0 0 0.8rem 0.8rem;
      padding: 0.75rem max(1rem, env(safe-area-inset-right)) 1rem
        max(1rem, env(safe-area-inset-left));
      background: hsl(var(--background));
      box-shadow: 0 14px 36px -24px hsl(var(--foreground) / 0.4);
    }

    .mobile-nav a {
      display: flex;
      align-items: center;
      min-height: 2.75rem;
      padding: 0.6rem 0.75rem;
      font-size: 0.88rem;
    }
    .mobile-nav-label {
      display: block;
      margin: 0.45rem 0.75rem 0.1rem;
      color: hsl(var(--muted-foreground));
      font-size: 0.68rem;
      font-weight: 650;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .brand-avatar img,
    .primary-nav a,
    .mobile-nav a,
    .more-toggle,
    .more-nav a {
      transition: none;
    }
    .primary-nav a:hover,
    .primary-nav a:focus-visible,
    .mobile-nav a:hover,
    .mobile-nav a:focus-visible,
    .more-nav a:hover,
    .more-nav a:focus-visible {
      transform: none;
    }
  }
</style>
