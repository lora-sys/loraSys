---
interface Props {
  name: string
  description: string
  inLanguage?: string
}

const { name, description, inLanguage = 'zh-CN' } = Astro.props
const canonicalUrl = new URL(Astro.url.pathname, Astro.site)
const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name,
  description,
  url: canonicalUrl.href,
  inLanguage,
  isPartOf: {
    '@type': 'WebSite',
    url: siteUrl.href
  }
}
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c')
---

<script is:inline type='application/ld+json' set:html={jsonLdText} />
