---
import { cn } from 'astro-pure/utils'
import Pageview from '@/components/waline/Pageview.astro'
import config from '@/site-config'
import { uiLocale, text } from '@/i18n/ui'
import type { SiteLocale } from '@/i18n/site'

interface Props {
  locale?: SiteLocale
  view?: boolean
  comment?: boolean
  class?: string
}

const { view, comment, locale = uiLocale(Astro.url.pathname), class: className, ...props } = Astro.props
const enabled = config.integ.waline.enable
const t = (zh: string, en: string) => text(locale, zh, en)
const path = Astro.url.pathname
---

{enabled && (view || comment) && (
  <div class={cn('text-sm text-muted-foreground', className)} {...props}>
    {view && <span><span class='waline-pageview-count' data-path={path}></span> {t('次阅读', 'views')}</span>}
    {view && comment && ' · '}
    {comment && (
      <a href='#waline'>
        <span class='waline-comment-count' data-path={path}></span> {t('条评论', 'comments')}
      </a>
    )}
  </div>
)}

{enabled && view && !comment && <Pageview />}
