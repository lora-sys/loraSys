---
import { hasAlternate, localizedPath, type SiteLocale, withBasePath } from '@/i18n/site'

import { ThemeProvider } from 'astro-pure/components/basic'
import type { SiteMeta } from 'astro-pure/types'
import BaseHead from '@/components/BaseHead.astro'
import SiteFooter from '@/components/layout/SiteFooter.astro'
import SiteHeader from '@/components/layout/SiteHeader.astro'
import config from '@/site-config'
import { searchKindForPath, SEARCH_KIND_FILTER } from '@/utils/search'

// Import the global.css file here so that it is included on
// all pages through the use of the <BaseLayout /> component.
import '@/assets/styles/global.css'
import '@/assets/styles/app.css'
import '@/assets/styles/paper-depth.css'
import '@/assets/styles/microinteractions.css'

interface Props {
  meta: SiteMeta
  articlePublishedAt?: string
  articleModifiedAt?: string
  highlightColor?: string
  noindex?: boolean
  lang?: string
  alternatePath?: string
}

const {
  meta: { articleDate, description: metaDescription, ogImage, title },
  articlePublishedAt,
  articleModifiedAt,
  highlightColor,
  noindex = false,
  lang = config.locale.lang,
  alternatePath: articleAlternatePath,
  ...props
} = Astro.props
const locale: SiteLocale = lang === 'en-US' ? 'en-US' : 'zh-CN'
const description =
  metaDescription ??
  (locale === 'en-US'
    ? config.description
    : 'Lora 的个人网站，记录 AI Agent、开发者工具、公开构建、技术写作与正在进行的实验。')
const localPath = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/'
const pageKind =
  /^\/blog\/[^/]+\/?$/.test(localPath)
    ? 'article'
    : /^\/(blog(?:\/|$)|en\/writing(?:\/|$)|notes(?:\/|$)|archives(?:\/|$)|tags(?:\/|$)|terms(?:\/|$))/.test(
          localPath
        )
      ? 'reading'
    : /^\/(?:$|en\/?$|projects(?:\/|$)|en\/work(?:\/|$)|lab(?:\/|$))/.test(localPath)
      ? 'showcase'
      : 'regular'
// 只有真实存在对应路由的页面才声明 hreflang alternate。
const otherLocale: SiteLocale = locale === 'zh-CN' ? 'en-US' : 'zh-CN'
const alternatePath = articleAlternatePath ?? (hasAlternate(localPath, otherLocale)
  ? localizedPath(localPath, otherLocale)
  : undefined)
const footerLabel = locale === 'en-US' ? 'Explore' : '站点导航'
const footerPrimary =
  locale === 'en-US'
    ? [
        { title: 'Work', href: '/en/work' },
        { title: 'Writing', href: '/en/writing' },
        { title: 'Now', href: '/en/now' },
        { title: 'About', href: '/en/about' },
        { title: 'Contact', href: '/en/contact' }
      ]
    : [
        { title: '作品', href: '/projects' },
        { title: '写作', href: '/blog' },
        { title: '近况', href: '/now' },
        { title: '关于', href: '/about' },
        { title: '联系', href: '/contact' }
      ]
---

<html {lang}>
  <head>
    <BaseHead
      {articleDate}
      {articlePublishedAt}
      {articleModifiedAt}
      {description}
      {noindex}
      {ogImage}
      {title}
      locale={locale}
      {alternatePath}
    />
    <slot name='head' />
    <ThemeProvider />
  </head>

  <body
    class='flex justify-center bg-background text-foreground'
    data-pagefind-filter={`${SEARCH_KIND_FILTER}:${searchKindForPath(Astro.url.pathname, import.meta.env.BASE_URL)}`}
    {...props}
  >
    {
      highlightColor && (
        <div
          id='highlight-gradient'
          class='pointer-events-none absolute start-0 top-0 z-0 h-screen w-full opacity-25'
          style={`background-image:linear-gradient(${highlightColor},transparent)`}
        />
      )
    }
    <a class='skip-link' href='#main-content'
      >{locale === 'en-US' ? 'Skip to content' : '跳到正文'}</a
    >
    <div id='main-container' class='w-full min-h-[100dvh] flex flex-col justify-between site-frame'>
      <SiteHeader locale={locale} {alternatePath} />
      <div
        id='main-content'
        class={`page-content page-content--${pageKind} flex-1 w-full`}
        tabindex='-1'
      >
        <slot />
      </div>
      <div class='site-footer'>
        <nav
          class='secondary-navigation'
          aria-label={locale === 'en-US' ? 'Secondary navigation' : '补充导航'}
        >
          <span>{footerLabel}</span>
          <ul>
            {
              footerPrimary.map((item) => (
                <li>
                  <a href={withBasePath(item.href)}>{item.title}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <SiteFooter locale={locale} />
      </div>
    </div>
    {/* Set highlight color */}
    <style define:vars={{ highlightColor }}>
      :global(.highlight) {
        --highlight-fg: color-mix(
          in srgb,
          var(--highlightColor) 40%,
          hsl(var(--foreground)/var(--un-text-opacity, 1))
        );
        color: hsl(var(--foreground)) !important;
      }
      :global(.highlight-bg) {
        background-color: var(
          --highlightColor,
          hsl(var(--primary) / var(--un-text-opacity))
        ) !important;
      }

      /* Extend safe area for some special screens
       * https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Values/env
       * https://webkit.org/blog/7929/designing-websites-for-iphone-x/
       */
      #main-container {
        max-width: 75rem;
        margin-inline: auto;
        padding-top: env(safe-area-inset-top);
        padding-left: calc(1rem + env(safe-area-inset-left));
        padding-right: calc(1rem + env(safe-area-inset-right));
      }

      #main-content {
        margin-inline: auto;
      }

      #main-content.page-content--reading {
        max-width: var(--width-reading);
      }

      #main-content.page-content--article {
        max-width: var(--width-article);
      }

      #main-content.page-content--regular {
        max-width: var(--width-regular);
      }

      #main-content.page-content--showcase {
        max-width: var(--width-showcase);
      }

      :global(.wide-visual) {
        width: min(calc(100% + 4rem), var(--width-visual));
        max-width: var(--width-visual);
        margin-inline: auto;
      }
      .site-footer {
        width: 100%;
        max-width: var(--width-showcase);
        margin-inline: auto;
      }
      @media (min-width: 640px) {
        #main-container {
          padding-left: calc(1.75rem + env(safe-area-inset-left));
          padding-right: calc(1.75rem + env(safe-area-inset-right));
        }
      }
      @media (min-width: 1024px) {
        #main-container {
          padding-left: calc(2.5rem + env(safe-area-inset-left));
          padding-right: calc(2.5rem + env(safe-area-inset-right));
        }
      }

      .skip-link {
        position: fixed;
        top: 0.75rem;
        left: 0.75rem;
        z-index: 50;
        border: 1px solid hsl(var(--foreground));
        border-radius: 999px;
        padding: 0.55rem 0.8rem;
        background: hsl(var(--background));
        color: hsl(var(--foreground));
        font-size: 0.75rem;
        font-weight: 650;
        text-decoration: none;
        transform: translateY(-180%);
        transition: transform 160ms ease;
      }

      .skip-link:focus-visible {
        transform: translateY(0);
      }

      .secondary-navigation {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 4rem;
        padding-top: 1rem;
        border-top: 1px solid hsl(var(--border));
      }

      .secondary-navigation > span {
        color: hsl(var(--muted-foreground));
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .secondary-navigation ul {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.55rem 1.1rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .secondary-navigation a {
        color: hsl(var(--muted-foreground));
        font-size: 0.72rem;
        text-decoration: none;
      }

      .secondary-navigation a:hover,
      .secondary-navigation a:focus-visible {
        color: hsl(var(--foreground));
        text-decoration: underline;
        text-underline-offset: 0.25rem;
      }

      :global(.site-footer footer) {
        margin-top: 1.5rem;
      }

      @media (prefers-reduced-motion: reduce) {
        .skip-link {
          transition: none;
        }
      }

      @media (max-width: 560px) {
        .secondary-navigation {
          align-items: flex-start;
          flex-direction: column;
        }

        .secondary-navigation ul {
          justify-content: flex-start;
        }
      }

      @media (max-width: 640px) {
        :global(.wide-visual) {
          width: 100%;
        }
      }

      @media print {
        :global(.site-header),
        .site-footer,
        .skip-link,
        #highlight-gradient {
          display: none !important;
        }

        #main-container,
        #main-content {
          width: 100%;
          max-width: none;
          min-height: 0;
          margin: 0;
          padding: 0;
        }

        body {
          color: #111;
          background: #fff;
        }
      }
    </style>
  </body>
</html>
