---
import SiteFooter from '@/components/layout/SiteFooter.astro'
import { ThemeProvider } from 'astro-pure/components/basic'
import type { SiteMeta } from 'astro-pure/types'
import BaseHead from '@/components/BaseHead.astro'
import config from '@/site-config'
import SiteHeader from '@/components/layout/SiteHeader.astro'
import { footerNavigation, hasAlternate, localizedPath, type SiteLocale } from '@/i18n/site'
import '@/assets/styles/global.css'
import '@/assets/styles/app.css'
import '@/assets/styles/studio.css'
interface Props {
  meta: SiteMeta
  articlePublishedAt?: string
  articleModifiedAt?: string
  highlightColor?: string
  noindex?: boolean
  lang?: string
}
const {
  meta: { articleDate, description = config.description, ogImage, title },
  articlePublishedAt, articleModifiedAt, highlightColor, noindex = false,
  lang = config.locale.lang, ...props
} = Astro.props
const locale: SiteLocale = lang === 'en-US' ? 'en-US' : 'zh-CN'
const localPath = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/'
const otherLocale: SiteLocale = locale === 'zh-CN' ? 'en-US' : 'zh-CN'
const alternatePath = hasAlternate(localPath, otherLocale) ? localizedPath(localPath, otherLocale) : undefined
const footerItems = footerNavigation(locale)
const footerLabel = locale === 'en-US' ? 'Explore' : '继续探索'
---
<html {lang}>
  <head>
    <BaseHead {articleDate} {articlePublishedAt} {articleModifiedAt} {description} {noindex} {ogImage} {title} {locale} {alternatePath}/>
    <slot name='head'/><ThemeProvider/>
  </head>
  <body class='site-v4 flex justify-center bg-background text-foreground' {...props}>
    <a class='skip-link' href='#main-content'>{locale === 'en-US' ? 'Skip to content' : '跳到正文'}</a>
    <div id='main-container' class='w-full max-w-[70rem] min-h-[100dvh] flex flex-col justify-between'>
      <SiteHeader locale={locale}/>
      <div id='main-content' class='flex-1 w-full' tabindex='-1'><slot/></div>
      <div class='site-footer'>
        <nav class='secondary-navigation' aria-label={locale === 'en-US' ? 'Secondary navigation' : '补充导航'}><span>{footerLabel}</span><ul>{footerItems.map(item=><li><a href={item.href}>{item.title}</a></li>)}</ul></nav>
        <SiteFooter locale={locale}/>
      </div>
    </div>
    <style define:vars={{highlightColor}}>
      :global(.highlight){--highlight-fg:color-mix(in srgb,var(--highlightColor) 40%,hsl(var(--foreground)));color:hsl(var(--foreground))!important}
      :global(.highlight-bg){background-color:var(--highlightColor,hsl(var(--primary)))!important}
      :global(body.site-v4){--studio-accent:#85501e}
      :global(html.dark body.site-v4){--studio-accent:#e5b879}
      :global(.site-v4 .locale-toggle){color:hsl(var(--foreground))}
      :global(.studio-page [data-source-node][data-supported='false']){opacity:1}
      #main-container{padding-top:env(safe-area-inset-top);padding-left:calc(1rem + env(safe-area-inset-left));padding-right:calc(1rem + env(safe-area-inset-right))}
      @media(min-width:640px){#main-container{padding-left:calc(1.75rem + env(safe-area-inset-left));padding-right:calc(1.75rem + env(safe-area-inset-right))}}
      @media(min-width:1024px){#main-container{padding-left:calc(2.5rem + env(safe-area-inset-left));padding-right:calc(2.5rem + env(safe-area-inset-right))}}
      .skip-link{position:fixed;top:.75rem;left:.75rem;z-index:100;border:1px solid hsl(var(--foreground));border-radius:.4rem;padding:.65rem .85rem;background:hsl(var(--background));color:hsl(var(--foreground));font-size:.85rem;font-weight:600;text-decoration:none;transform:translateY(-180%);transition:transform 150ms ease}
      .skip-link:focus-visible{transform:translateY(0)}
      .secondary-navigation{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;margin-top:4rem;padding-top:1rem;border-top:1px solid hsl(var(--border))}
      .secondary-navigation>span{color:hsl(var(--muted-foreground));font-size:.7rem;font-weight:600;white-space:nowrap}
      .secondary-navigation ul{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:.3rem 1rem;margin:0;padding:0;list-style:none}
      .secondary-navigation a{display:inline-flex;align-items:center;min-height:44px;color:hsl(var(--muted-foreground));font-size:.78rem;text-decoration:none}
      .secondary-navigation a:hover,.secondary-navigation a:focus-visible{color:hsl(var(--foreground));text-decoration:underline;text-underline-offset:.25rem}
      :global(.site-footer footer){margin-top:1.5rem}
      @media(prefers-reduced-motion:reduce){.skip-link{transition:none}}
      @media(max-width:560px){.secondary-navigation{align-items:flex-start;flex-direction:column;gap:.5rem}.secondary-navigation ul{justify-content:flex-start}}
    </style>
  </body>
</html>
