---
import CodeActions from '@/components/blog/CodeActions.astro'
import { BackToTop } from 'astro-pure/components/pages'
import type { SiteMeta } from 'astro-pure/types'
import { Button, Icon } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'
import PageLayout from '@/layouts/BaseLayout.astro'
import { uiLocale } from '@/i18n/ui'
import { integ } from '@/site-config'
interface Props {
  meta: SiteMeta
  articlePublishedAt?: string
  articleModifiedAt?: string
  highlightColor?: string
  back?: string
  lang?: string
  showSidebar?: boolean
}
const { meta, articlePublishedAt, articleModifiedAt, highlightColor, back = '/', lang = uiLocale(Astro.url.pathname), showSidebar = Astro.slots.has('sidebar'), ...props } = Astro.props
---
<PageLayout {meta} {articlePublishedAt} {articleModifiedAt} {highlightColor} {lang} {...props}>
  <slot name='head' slot='head'/>
  <CodeActions/>
  <Button title={lang === 'en-US' ? 'Back' : '返回'} href={back} variant='back'/>
  <main class:list={['reading-layout', { 'has-sidebar': showSidebar }]}>
    {showSidebar && <>
      <aside id='sidebar' class='reading-sidebar' aria-label={lang === 'en-US' ? 'Article navigation' : '文章目录'} tabindex='-1'>
        <button type='button' class='sidebar-close' data-sidebar-close>{lang === 'en-US' ? 'Close contents' : '关闭目录'}</button>
        <slot name='sidebar'/>
      </aside>
      <div id='sidebar-shade' hidden aria-hidden='true'></div>
    </>}
    <article class='reading-article'>
      <div id='content-header'><slot name='header'/></div>
      <div id='content' class={cn('mt-8', integ.typography.class)}><slot/></div>
    </article>
  </main>
  <div class:list={['reading-bottom', { 'has-sidebar': showSidebar }]}>
    <div><slot name='bottom'/></div><div><slot name='bottom-sidebar'/></div>
  </div>
  <BackToTop label={lang === 'en-US' ? 'Back to top' : '返回顶部'} header='content-header' content='content'>
    {showSidebar && <button slot='other-icons' type='button' aria-label={lang === 'en-US' ? 'Toggle table of contents' : '展开或收起目录'} class='toc-toggle size-12 flex items-center justify-center rounded-full border-2 border-transparent bg-muted text-muted-foreground' id='sidebar-btn' aria-expanded='false' aria-controls='sidebar'><Icon name='list'/></button>}
  </BackToTop>
</PageLayout>
<script>
  const sidebar = document.querySelector<HTMLElement>('#sidebar')
  const shade = document.querySelector<HTMLElement>('#sidebar-shade')
  const trigger = document.querySelector<HTMLButtonElement>('#sidebar-btn')
  const mobile = matchMedia('(max-width:767px)')
  let open = false
  const setOpen = (value: boolean, restoreFocus = false) => {
    if (!sidebar || !shade) return
    open = mobile.matches && value
    sidebar.classList.toggle('show', open)
    sidebar.inert = mobile.matches && !open
    sidebar.setAttribute('aria-hidden', String(sidebar.inert))
    shade.hidden = !open
    trigger?.setAttribute('aria-expanded', String(open))
    if (open) sidebar.querySelector<HTMLElement>('button, a, [tabindex="0"]')?.focus()
    else if (restoreFocus) trigger?.focus()
  }
  trigger?.addEventListener('click', () => setOpen(!open, open))
  sidebar?.querySelector('[data-sidebar-close]')?.addEventListener('click', () => setOpen(false, true))
  shade?.addEventListener('click', () => setOpen(false, true))
  sidebar?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { if (mobile.matches) setOpen(false, true) }))
  mobile.addEventListener('change', () => setOpen(false))
  document.addEventListener('keydown', event => {
    if (!open || !sidebar) return
    if (event.key === 'Escape') { event.preventDefault(); setOpen(false, true); return }
    if (event.key !== 'Tab') return
    const focusable = [...sidebar.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex="0"]')].filter(el => el.getBoundingClientRect().height > 0)
    const first = focusable[0], last = focusable.at(-1)
    if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus() }
    else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus() }
  })
  setOpen(false)
</script>
<style>
  .reading-layout { display: grid; grid-template-columns: minmax(0,1fr); gap: 2.5rem; margin-top: 1.5rem; align-items: start; }
  .reading-layout.has-sidebar { grid-template-columns: minmax(0,1fr) 13rem; }
  .reading-article { min-width: 0; grid-column: 1; grid-row: 1; }
  #content { max-width: 45rem; min-width: 0; overflow-wrap: anywhere; }
  #content :global(pre), #content :global(table) { overflow-x: auto; max-width: 100%; }
  .reading-sidebar { grid-column: 2; grid-row: 1; position: sticky; top: 5.75rem; max-height: calc(100dvh - 7rem); overflow-y: auto; font-size: .8rem; padding-right: .3rem; }
  .sidebar-close { display: none; }
  .reading-bottom { display: grid; grid-template-columns: minmax(0,1fr); gap: 2.5rem; margin-top: 2rem; color: hsl(var(--muted-foreground)); }
  .reading-bottom.has-sidebar { grid-template-columns: minmax(0,1fr) 13rem; }
  .reading-bottom > div { min-width: 0; }
  #sidebar-shade { position: fixed; inset: 0; z-index: 70; background: #0008; }
  #sidebar-shade[hidden] { display: none; }
  @media(min-width:768px) { :global(.toc-toggle) { display: none!important; } }
  @media(max-width:767px) {
    .reading-layout.has-sidebar, .reading-bottom.has-sidebar { grid-template-columns: minmax(0,1fr); }
    .reading-sidebar { display: none; position: fixed; inset: 0 0 0 auto; width: min(88vw,22rem); max-height: 100dvh; padding: 1rem; background: hsl(var(--background)); border-left: 1px solid hsl(var(--border)); z-index: 80; }
    .reading-sidebar.show { display: block; animation: contents-in 160ms ease; }
    .sidebar-close { display: flex; min-height: 44px; align-items: center; margin-bottom: 1rem; border: 1px solid hsl(var(--border)); border-radius: .4rem; padding: .5rem .8rem; background: hsl(var(--background)); color: hsl(var(--foreground)); font: inherit; cursor: pointer; }
  }
  @keyframes contents-in { from { opacity: 0; transform: translateX(10px); } to { opacity: 1; transform: none; } }
  @media(prefers-reduced-motion:reduce) { .reading-sidebar.show { animation: none; } }
  @media print { .reading-sidebar, #sidebar-shade, :global(.site-header), :global(.site-footer), :global(.back-to-top) { display: none!important; } .reading-layout.has-sidebar, .reading-bottom.has-sidebar { display: block; } #content { max-width: none; } }
</style>
