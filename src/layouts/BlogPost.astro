---
import type { MarkdownHeading } from 'astro'
import type { CollectionEntry } from 'astro:content'

// Plugin styles
import 'katex/dist/katex.min.css'

import config from 'virtual:config'
import { projects } from '@/data/projects'
import { getProjectsForStory } from '@/data/project-stories'

import { MediumZoom } from 'astro-pure/advanced'
import { Copyright, TOC } from 'astro-pure/components/pages'
import PageLayout from '@/layouts/ContentLayout.astro'
import LanguageBadge from '@/components/blog/LanguageBadge.astro'
import ArticleHero from '@/components/blog/ArticleHero.astro'
import RelatedReading from '@/components/blog/RelatedReading.astro'
import { Comment, PageInfo } from '@/components/waline'

interface Props {
  post: CollectionEntry<'blog'>
  posts: CollectionEntry<'blog'>[]
  headings: MarkdownHeading[]
  remarkPluginFrontmatter: Record<string, unknown>
  basePath?: string
  lang?: string
}

const {
  post: { id, data },
  posts,
  headings,
  remarkPluginFrontmatter,
  basePath = '/blog',
  lang = data.language
} = Astro.props

const {
  description,
  heroImage,
  publishDate,
  title,
  updatedDate,
  draft: isDraft,
  comment: enableComment
} = data

const socialImage = heroImage
  ? typeof heroImage.src === 'string'
    ? heroImage.src
    : heroImage.src.src
  : config.socialCard
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString()
const primaryColor = data.heroImage?.color ?? 'hsl(var(--primary) / var(--un-text-opacity))'
const postIndex = posts.findIndex((entry) => entry.id === id)
const previousPost = posts[postIndex - 1]
const nextPost = posts[postIndex + 1]
// Root-relative source paths are prefixed exactly once by the post-build GitHub Pages pass.
const blogBase = `${basePath.replace(/\/$/, '')}/`
const linkedRepositories = getProjectsForStory(`${blogBase}${id}`)
const linkedProjects = projects.filter((project) => linkedRepositories.includes(project.repository))
const denseToc = headings.length > 36
---

<PageLayout
  meta={{ articleDate, description, ogImage: socialImage, title }}
  highlightColor={primaryColor}
  back={basePath}
  lang={lang}
  showSidebar={!!headings.length}
>
  {!!headings.length && (
    denseToc ? (
      <details class='article-toc-condensed' slot='sidebar'>
        <summary>
          <span>Document map</span>
          <small>{headings.length} sections</small>
        </summary>
        <TOC {headings} />
      </details>
    ) : <TOC {headings} slot='sidebar' />
  )}

  <ArticleHero {data} {remarkPluginFrontmatter} slot='header'>
    <Fragment slot='description'>
      <div class='mt-3 flex items-center gap-2 not-italic'>
        <LanguageBadge language={data.language} />
        <span class='text-xs text-muted-foreground'>
          {data.language === 'en-US' ? 'Article in English' : '中文长文'}
        </span>
      </div>
      {!isDraft && enableComment && config.integ.waline.enable && <PageInfo comment class='mt-1' />}
    </Fragment>
  </ArticleHero>

  <slot />

  <Fragment slot='bottom'>
    {/* Copyright */}
    <Copyright {data} />
    {
      linkedProjects.length > 0 && (
        <aside class='build-context' aria-labelledby='build-context-title'>
          <p class='build-context-eyebrow'>Build context</p>
          <h2 id='build-context-title'>This article is part of the project trail.</h2>
          <div class='build-context-list'>
            {linkedProjects.map((project) => (
              <a href={`/projects#${project.repository}`} data-interaction='article_project_link'>
                <span>{project.source === 'ACAMLab' ? 'ACAMLab' : 'lora-sys'}</span>
                {project.title}
                <span aria-hidden='true'>↗</span>
              </a>
            ))}
          </div>
        </aside>
      )
    }
    <RelatedReading post={Astro.props.post} {posts} />
    <nav
      aria-label='Adjacent articles'
      class='mt-3 flex gap-3 max-sm:flex-col sm:mt-6 sm:justify-between'
    >
      {
        previousPost ? (
          <a
            class='rounded-xl px-4 py-2 no-underline transition-colors hover:bg-muted'
            href={`${blogBase}${previousPost.id}`}
          >
            ← {previousPost.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        nextPost && (
          <a
            class='rounded-xl px-4 py-2 text-right no-underline transition-colors hover:bg-muted'
            href={`${blogBase}${nextPost.id}`}
          >
            {nextPost.data.title} →
          </a>
        )
      }
    </nav>
    {
      /* Comment */
      !isDraft && enableComment && config.integ.waline.enable && <Comment class='mt-3 sm:mt-6' />
    }
  </Fragment>

  <slot name='bottom-sidebar' slot='bottom-sidebar' />
</PageLayout>

{config.integ.mediumZoom.enable && <MediumZoom />}

<script>
  const renderMermaidDiagrams = async () => {
    const blocks = Array.from(
      document.querySelectorAll<HTMLElement>(
        '[data-language="mermaid"] pre code, code.language-mermaid'
      )
    )
    if (!blocks.length) return

    const { default: mermaid } = await import('mermaid')

    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'strict',
      theme: document.documentElement.classList.contains('dark') ? 'dark' : 'default'
    })

    for (const [index, block] of blocks.entries()) {
      const container = block.closest('[data-language="mermaid"]') ?? block.closest('pre') ?? block
      const sourceNode = block
      // Read Shiki's source lines only. Its language label and collapse-button
      // text live in the same outer container and are not Mermaid syntax.
      const lines = sourceNode?.querySelectorAll<HTMLElement>('.line')
      const source = lines?.length
        ? Array.from(lines, (line) => line.textContent ?? '')
            .join('\n')
            .trim()
        : sourceNode?.textContent?.trim()
      if (!source) continue

      try {
        const { svg, bindFunctions } = await mermaid.render(`mermaid-${index}`, source)
        const figure = document.createElement('figure')
        figure.className = 'mermaid-diagram not-prose'
        figure.setAttribute('aria-label', 'Architecture diagram')
        figure.innerHTML = svg
        container.replaceWith(figure)
        bindFunctions?.(figure)
      } catch (error) {
        console.error('Unable to render Mermaid diagram', error)
      }
    }
  }

  type IdleCapableWindow = Window & {
    requestIdleCallback?: (callback: IdleRequestCallback, options?: IdleRequestOptions) => number
  }

  const scheduleMermaidRender = () => {
    const render = () => void renderMermaidDiagrams()
    const idleWindow = window as IdleCapableWindow
    if (typeof idleWindow.requestIdleCallback === 'function') {
      idleWindow.requestIdleCallback(render, { timeout: 1200 })
    } else {
      setTimeout(render, 500)
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleMermaidRender, { once: true })
  } else {
    scheduleMermaidRender()
  }
</script>

<style is:global>
  .article-toc-condensed {
    border-block: 1px solid hsl(var(--border));
    padding-block: 0.55rem;
  }

  .article-toc-condensed summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    cursor: pointer;
    color: hsl(var(--foreground));
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    list-style: none;
    text-transform: uppercase;
  }

  .article-toc-condensed summary::-webkit-details-marker {
    display: none;
  }

  .article-toc-condensed summary::after {
    content: '+';
    color: hsl(var(--muted-foreground));
    font-size: 1rem;
    font-weight: 400;
  }

  .article-toc-condensed[open] summary::after {
    content: '−';
  }

  .article-toc-condensed summary small {
    margin-left: auto;
    color: hsl(var(--muted-foreground));
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: none;
  }

  .article-toc-condensed :global(nav) {
    max-height: min(62vh, 36rem);
    margin-top: 0.65rem;
    overflow: auto;
    overscroll-behavior: contain;
  }

  .article-toc-condensed summary:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 4px;
  }

  .build-context {
    margin-block: 2rem;
    border-block: 1px solid hsl(var(--border));
    padding-block: 1.2rem;
  }

  .build-context-eyebrow {
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.65rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .build-context h2 {
    margin: 0.45rem 0 0.8rem;
    font-size: clamp(1.25rem, 3vw, 1.7rem);
    font-weight: 560;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .build-context-list {
    display: grid;
    gap: 0.45rem;
  }

  .build-context-list a {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: hsl(var(--foreground));
    font-size: 0.82rem;
    text-decoration: none;
  }

  .build-context-list a:hover,
  .build-context-list a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .build-context-list a span:first-child {
    color: hsl(var(--muted-foreground));
    font-size: 0.62rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mermaid-diagram {
    margin-block: 2rem;
    overflow-x: auto;
    border: 1px solid hsl(var(--border));
    border-radius: 0.75rem;
    background: hsl(var(--card));
    padding: 1rem;
  }

  .mermaid-diagram svg {
    display: block;
    width: 100%;
    min-width: 36rem;
    height: auto;
    margin-inline: auto;
  }
</style>
