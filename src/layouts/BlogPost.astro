---
import type { MarkdownHeading } from 'astro'
import type { CollectionEntry } from 'astro:content'

// Plugin styles
import 'katex/dist/katex.min.css'

import config from 'virtual:config'
import { projects } from '@/data/projects'
import { getProjectsForStory } from '@/data/project-stories'

import { MediumZoom } from 'astro-pure/advanced'
import { Copyright, TOC } from 'astro-pure/components/pages'
import PageLayout from '@/layouts/ContentLayout.astro'
import LanguageBadge from '@/components/blog/LanguageBadge.astro'
import ArticleHero from '@/components/blog/ArticleHero.astro'
import ArticleFieldNote from '@/components/blog/ArticleFieldNote.astro'
import RelatedReading from '@/components/blog/RelatedReading.astro'
import agentRunbookMargin from '@/assets/field-notes/expansion-2/agent-runbook-margin.webp'
import mediaWorkbenchMargin from '@/assets/field-notes/expansion-2/media-workbench-margin.webp'
import sandboxSpecimenSlip from '@/assets/field-notes/expansion-2/sandbox-specimen-slip.webp'
import shipLogFragment from '@/assets/field-notes/expansion-2/ship-log-fragment.webp'
import { Comment, PageInfo } from '@/components/waline'

interface Props {
  post: CollectionEntry<'blog'>
  posts: CollectionEntry<'blog'>[]
  headings: MarkdownHeading[]
  remarkPluginFrontmatter: Record<string, unknown>
  basePath?: string
  lang?: string
}

const {
  post: { id, data },
  posts,
  headings,
  remarkPluginFrontmatter,
  basePath = '/blog',
  lang = data.language
} = Astro.props

const {
  description,
  heroImage,
  publishDate,
  title,
  updatedDate,
  draft: isDraft,
  comment: enableComment
} = data

const socialImage = heroImage
  ? typeof heroImage.src === 'string'
    ? heroImage.src
    : heroImage.src.src
  : config.socialCard
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString()
// Root-relative source paths are prefixed exactly once by the post-build GitHub Pages pass.
const blogBase = `${basePath.replace(/\/$/, '')}/`
const canonicalUrl = new URL(Astro.url.pathname, Astro.site)
const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site)
const blogIndexUrl = new URL(
  `${import.meta.env.BASE_URL.replace(/\/$/, '')}${blogBase}`,
  Astro.site
)
const socialImageUrl = new URL(socialImage, Astro.url).href
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  inLanguage: lang || 'zh-CN',
  datePublished: publishDate.toISOString(),
  dateModified: articleDate,
  image: socialImageUrl,
  keywords: data.tags,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl.href },
  author: { '@type': 'Person', name: config.author, url: siteUrl.href },
  publisher: { '@type': 'Person', name: config.author, url: siteUrl.href },
  isPartOf: { '@type': 'Blog', name: 'Writing', url: blogIndexUrl.href },
  url: canonicalUrl.href
}
const breadcrumbLabels = lang === 'en-US' ? { home: 'Home', writing: 'Writing' } : { home: '首页', writing: '写作' }
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: breadcrumbLabels.home, item: siteUrl.href },
    { '@type': 'ListItem', position: 2, name: breadcrumbLabels.writing, item: blogIndexUrl.href },
    { '@type': 'ListItem', position: 3, name: title, item: canonicalUrl.href }
  ]
}
const articleJsonLdText = JSON.stringify(articleJsonLd).replace(/</g, '\\u003c')
const breadcrumbJsonLdText = JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')
const primaryColor = data.heroImage?.color ?? 'hsl(var(--primary) / var(--un-text-opacity))'
const postIndex = posts.findIndex((entry) => entry.id === id)
const previousPost = posts[postIndex - 1]
const nextPost = posts[postIndex + 1]
const linkedRepositories = getProjectsForStory(`${blogBase}${id}`)
const linkedProjects = projects.filter((project) => linkedRepositories.includes(project.repository))
const denseToc = headings.length > 36
const articleFieldNote = {
  'eve-agent': {
    image: agentRunbookMargin,
    label: 'Agent runbook',
    caption: 'A small field note from the systems, tools, and handoffs behind the article.'
  },
  'loop-engineering-harness': {
    image: agentRunbookMargin,
    label: 'Agent runbook',
    caption: 'A small field note from the systems, tools, and handoffs behind the article.'
  },
  'hermes-minimax-media': {
    image: mediaWorkbenchMargin,
    label: 'Media workbench',
    caption: 'A material note on the assets, queues, and tool surfaces discussed in this build.'
  },
  'hermes-stepfun-imagegen': {
    image: mediaWorkbenchMargin,
    label: 'Media workbench',
    caption: 'A material note on the assets, queues, and tool surfaces discussed in this build.'
  },
  sandbox: {
    image: sandboxSpecimenSlip,
    label: 'Sandbox specimen',
    caption: 'An archival cue for isolation boundaries, access checks, and careful execution.'
  },
  wishlive: {
    image: shipLogFragment,
    label: 'Shipping log',
    caption: 'A quiet trace of the build, release, and runtime decisions in this story.'
  },
  newtube: {
    image: shipLogFragment,
    label: 'Shipping log',
    caption: 'A quiet trace of the build, release, and runtime decisions in this story.'
  }
}[id]
---

<PageLayout
  meta={{ articleDate, description, ogImage: socialImage, title }}
  articlePublishedAt={publishDate.toISOString()}
  articleModifiedAt={updatedDate?.toISOString()}
  highlightColor={primaryColor}
  back={basePath}
  lang={lang}
  showSidebar={!!headings.length}
>
  <Fragment slot='head'>
    <script is:inline type='application/ld+json' set:html={articleJsonLdText} />
    <script is:inline type='application/ld+json' set:html={breadcrumbJsonLdText} />
  </Fragment>

  {!!headings.length && (
    denseToc ? (
      <details class='article-toc-condensed' slot='sidebar'>
        <summary>
          <span>Document map</span>
          <small>{headings.length} sections</small>
        </summary>
        <TOC {headings} />
      </details>
    ) : <TOC {headings} slot='sidebar' />
  )}

  <ArticleHero {data} {remarkPluginFrontmatter} slot='header'>
    <Fragment slot='description'>
      <div class='mt-3 flex items-center gap-2 not-italic'>
        <LanguageBadge language={data.language} />
        <span class='text-xs text-muted-foreground'>
          {data.language === 'en-US' ? 'Article in English' : '中文长文'}
        </span>
      </div>
      {!isDraft && enableComment && config.integ.waline.enable && <PageInfo comment class='mt-1' />}
    </Fragment>
  </ArticleHero>

  <slot />

  <Fragment slot='bottom'>
    {/* Copyright */}
    <Copyright {data} />
    {
      linkedProjects.length > 0 && (
        <aside class='build-context' aria-labelledby='build-context-title'>
          <p class='build-context-eyebrow'>Build context</p>
          <h2 id='build-context-title'>This article is part of the project trail.</h2>
          <div class='build-context-list'>
            {linkedProjects.map((project) => (
              <a href={`/projects#${project.repository}`} data-interaction='article_project_link'>
                <span>{project.source === 'ACAMLab' ? 'ACAMLab' : 'lora-sys'}</span>
                {project.title}
                <span aria-hidden='true'>↗</span>
              </a>
            ))}
          </div>
        </aside>
      )
    }
      {articleFieldNote && <ArticleFieldNote {...articleFieldNote} />}
      <RelatedReading post={Astro.props.post} {posts} />
    <nav
      aria-label='Adjacent articles'
      class='mt-3 flex gap-3 max-sm:flex-col sm:mt-6 sm:justify-between'
    >
      {
        previousPost ? (
          <a
            class='rounded-xl px-4 py-2 no-underline transition-colors hover:bg-muted'
            href={`${blogBase}${previousPost.id}`}
          >
            ← {previousPost.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        nextPost && (
          <a
            class='rounded-xl px-4 py-2 text-right no-underline transition-colors hover:bg-muted'
            href={`${blogBase}${nextPost.id}`}
          >
            {nextPost.data.title} →
          </a>
        )
      }
    </nav>
    {
      /* Comment */
      !isDraft && enableComment && config.integ.waline.enable && <Comment class='mt-3 sm:mt-6' />
    }
  </Fragment>

  <slot name='bottom-sidebar' slot='bottom-sidebar' />
</PageLayout>

{config.integ.mediumZoom.enable && <MediumZoom />}

<script>
  const mermaidSelector = '[data-language="mermaid"] pre code, code.language-mermaid'
  let mermaidLoader: Promise<(typeof import('mermaid'))['default']> | undefined

  const loadMermaid = () => {
    mermaidLoader ??= import('mermaid').then(({ default: mermaid }) => {
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: document.documentElement.classList.contains('dark') ? 'dark' : 'default'
      })
      return mermaid
    })
    return mermaidLoader
  }

  const renderMermaidDiagram = async (block: HTMLElement, index: number) => {
    if (block.dataset.mermaidRendered === 'true') return
    block.dataset.mermaidRendered = 'true'
    const container = block.closest('[data-language="mermaid"]') ?? block.closest('pre') ?? block
    // Read Shiki's source lines only. Its language label and collapse-button
    // text live in the same outer container and are not Mermaid syntax.
    const lines = block.querySelectorAll<HTMLElement>('.line')
    const source = lines.length
      ? Array.from(lines, (line) => line.textContent ?? '')
          .join('\n')
          .trim()
      : block.textContent?.trim()
    if (!source) return

    try {
      const mermaid = await loadMermaid()
      const { svg, bindFunctions } = await mermaid.render(`mermaid-${index}`, source)
      const figure = document.createElement('figure')
      figure.className = 'mermaid-diagram not-prose'
      figure.setAttribute('aria-label', 'Architecture diagram')
      figure.innerHTML = svg
      container.replaceWith(figure)
      bindFunctions?.(figure)
    } catch (error) {
      delete block.dataset.mermaidRendered
      console.error('Unable to render Mermaid diagram', error)
    }
  }

  const observeMermaidDiagrams = () => {
    const blocks = Array.from(document.querySelectorAll<HTMLElement>(mermaidSelector))
    if (!blocks.length) return

    if (!('IntersectionObserver' in window)) {
      blocks.forEach((block, index) => void renderMermaidDiagram(block, index))
      return
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return
          const block = entry.target as HTMLElement
          observer.unobserve(block)
          const index = blocks.indexOf(block)
          void renderMermaidDiagram(block, index)
        })
      },
      { rootMargin: '360px 0px', threshold: 0.01 }
    )
    blocks.forEach((block) => observer.observe(block))
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', observeMermaidDiagrams, { once: true })
  } else {
    observeMermaidDiagrams()
  }
</script>

<style is:global>
  .article-toc-condensed {
    border-block: 1px solid hsl(var(--border));
    padding-block: 0.55rem;
  }

  .article-toc-condensed summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    cursor: pointer;
    color: hsl(var(--foreground));
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    list-style: none;
    text-transform: uppercase;
  }

  .article-toc-condensed summary::-webkit-details-marker {
    display: none;
  }

  .article-toc-condensed summary::after {
    content: '+';
    color: hsl(var(--muted-foreground));
    font-size: 1rem;
    font-weight: 400;
  }

  .article-toc-condensed[open] summary::after {
    content: '−';
  }

  .article-toc-condensed summary small {
    margin-left: auto;
    color: hsl(var(--muted-foreground));
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: none;
  }

  .article-toc-condensed :global(nav) {
    max-height: min(62vh, 36rem);
    margin-top: 0.65rem;
    overflow: auto;
    overscroll-behavior: contain;
  }

  .article-toc-condensed summary:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 4px;
  }

  .build-context {
    margin-block: 2rem;
    border-block: 1px solid hsl(var(--border));
    padding-block: 1.2rem;
  }

  .build-context-eyebrow {
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.65rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .build-context h2 {
    margin: 0.45rem 0 0.8rem;
    font-size: clamp(1.25rem, 3vw, 1.7rem);
    font-weight: 560;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .build-context-list {
    display: grid;
    gap: 0.45rem;
  }

  .build-context-list a {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: hsl(var(--foreground));
    font-size: 0.82rem;
    text-decoration: none;
  }

  .build-context-list a:hover,
  .build-context-list a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .build-context-list a span:first-child {
    color: hsl(var(--muted-foreground));
    font-size: 0.62rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mermaid-diagram {
    margin-block: 2rem;
    overflow-x: auto;
    border: 1px solid hsl(var(--border));
    border-radius: 0.75rem;
    background: hsl(var(--card));
    padding: 1rem;
  }

  .mermaid-diagram svg {
    display: block;
    width: 100%;
    min-width: 36rem;
    height: auto;
    margin-inline: auto;
  }
</style>
