---
import type { MarkdownHeading } from 'astro'

import { TOC } from 'astro-pure/components/pages'
import PageLayout from '@/layouts/ContentLayout.astro'
import { Comment, PageInfo } from '@/components/waline'

interface Props {
  title: string
  /** 页面 h1；缺省回退 title，供浏览器标签保留英文页面名而正文用中文标题。 */
  heading?: string
  description?: string
  headings?: MarkdownHeading[]
  view?: boolean
  comment?: boolean
}

const { title, heading, description, headings, view, comment: enableComment, ...props } = Astro.props
---

<PageLayout meta={{ title, description }} showSidebar={!!headings?.length} {...props}>
  <slot name='head' slot='head' />
  {!!headings?.length && <TOC title='目录' headings={headings} slot='sidebar' />}

  <Fragment slot='header'>
    <h1 class='text-2xl font-medium sm:mb-2 sm:text-3xl'>{heading ?? title}</h1>
    {(view || enableComment) && <PageInfo {view} comment={enableComment} class='italic' />}
  </Fragment>

  <slot />

  <slot name='bottom' slot='bottom'>
    {enableComment && <Comment class='mt-3 sm:mt-6' />}
  </slot>

  <slot name='bottom-sidebar' slot='bottom-sidebar' />
</PageLayout>
