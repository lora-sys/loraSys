{
  "name": "lorasys",
  "type": "module",
  "version": "4.1.4",
  "packageManager": "bun@1.3.5",
  "scripts": {
    "dev": "astro dev",
    "dev:check": "astro check --watch & astro dev",
    "build": "astro-pure check && astro check && astro build && node scripts/prefix-base.mjs && node scripts/audit-release.mjs",
    "sync:github": "bun scripts/fetch-contributions.mjs && bun scripts/fetch-github-projects.mjs && bun scripts/fetch-external-contributions.mjs && bun run validate:sync && bun run report:sync",
    "validate:sync": "bun scripts/validate-sync-data.mjs",
    "report:sync": "bun scripts/generate-sync-report.mjs",
    "article:import": "bun scripts/import-article-html.mjs",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "astro check",
    "astro": "astro",
    "pure": "astro-pure",
    "format": "prettier --write  '**/*.{js,jsx,ts,tsx,md,mdx,astro}'",
    "lint": "eslint --fix 'src/**/*.{js,ts,jsx,tsx,astro}'",
    "yijiansilian": "bun lint && bun sync && bun check && bun format",
    "clean": "rm -rf .astro .vercel dist",
    "cache:avatars": "tsx preset/scripts/cacheAvatars.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/rss": "^4.0.15",
    "@unocss/astro": "^66.5.10",
    "@waline/client": "^3.12.2",
    "astro": "5.17.3",
    "astro-pure": "file:packages/pure",
    "katex": "^0.16.33",
    "medium-zoom": "1.1.0",
    "mermaid": "^11.16.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.9.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^9.39.3",
    "eslint-plugin-astro": "^1.6.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1"
  }
}
