---
import config from 'virtual:config'

import { Icon } from '../user'
---

<header-component
  class='group sticky top-4 z-50 max-md:z-30 mb-12 flex items-center justify-between rounded-xl border border-transparent max-sm:py-1 sm:rounded-2xl'
>
  <a
    class='z-30 text-xl font-medium group-[.not-top]:ms-2 sm:group-[.not-top]:ms-3'
    style='transition:margin-inline 0.3s'
    href='/'
    aria-label='Brand'>{config.title}</a
  >

  <div class='flex items-center gap-x-2'>
    {/* Menu links */}
    <nav
      id='headerExpandContent'
      aria-hidden='true'
      aria-label='Primary navigation'
      class='header-expand-content end-0 start-0 top-12 grid border border-transparent group-[.not-top]:rounded-xl group-[.expanded]:opacity-100 dark:group-[.expanded.not-top]:bg-muted'
    >
      <div class='header-nav-content flex flex-col items-center justify-center overflow-hidden'>
        {
          config.header.menu.map((item) => (
            <a
              href={item.link}
              class='header-nav-link w-full flex-none grow py-2 text-right font-medium transition-none hover:text-primary'
              aria-label='Nav menu item'
            >
              {item.title}
            </a>
          ))
        }
        <div class='header-search flex w-full grow flex-row justify-end gap-x-3'>
          <a class='header-search-link px-1 py-2 transition-none' href='/search' title='Search'>
            <span class='sr-only'>Search</span>
            <Icon name='search' class='size-5' />
          </a>
        </div>
      </div>
    </nav>

    {/* buttons */}
    <div class='z-30 flex gap-x-4 group-[.not-top]:gap-x-2' style='transition:gap 0.3s'>
      <button
        id='toggleDarkMode'
        class='group/dark box-content size-5 rounded-md border p-1.5 transition-colors hover:bg-border sm:group-[.not-top]:rounded-xl'
      >
        <span class='sr-only'>Dark Theme</span>
        <Icon class='system size-5 group-hover/dark:text-primary' name='computer' />
        <Icon class='light hidden size-5 group-hover/dark:text-primary' name='sun' />
        <Icon class='dark hidden size-5 group-hover/dark:text-primary' name='moon' />
      </button>
      <button
        id='toggleMenu'
        aria-expanded='false'
        aria-controls='headerExpandContent'
        class='header-menu-toggle rounded-md border p-1.5 transition-colors hover:bg-border group-[.not-top]:rounded-xl'
      >
        <span class='sr-only'>Menu</span>
        <Icon class='size-5' name='menu' />
      </button>
    </div>
  </div>
</header-component>

{/* Use inline to load icon quicker firstly */}
<script is:inline>
  const toggleDarkModeElement = document.getElementById('toggleDarkMode')
  if (toggleDarkModeElement) {
    toggleDarkModeElement.dataset.theme = localStorage.getItem('theme') || 'system'
  }
</script>
<script>
  import { setTheme, showToast } from '../../utils'

  class HeaderComponent extends HTMLElement {
    connectedCallback() {
      // Header
      let preScrollY = window.scrollY
      this.classList.toggle('not-top', preScrollY > 20)
      window.addEventListener('scroll', () => {
        this.classList.toggle('not-top', window.scrollY > 20)
        this.dataset.show = (window.scrollY < 350 || window.scrollY < preScrollY).toString()
        preScrollY = window.scrollY
      })

      // Dark Mode
      const darkModeBtn = this.querySelector('#toggleDarkMode') as HTMLElement
      darkModeBtn.addEventListener('click', () => {
        // Old way: dispatch event
        // const toggleDarkModeEvent = new CustomEvent('theme-change', {
        //   detail: { theme: localStorage.getItem('theme') === 'light' ? 'dark' : 'light' }
        // })
        // document.dispatchEvent(toggleDarkModeEvent)
        const newTheme = setTheme(undefined, true)
        darkModeBtn.dataset.theme = newTheme
        showToast({ message: `Set theme to ${newTheme}` })
      })

      // Menu
      this.querySelector('#toggleMenu')?.addEventListener('click', () => {
        this.classList.toggle('expanded')
        this.syncMenu()
      })
      this.syncMenu()
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && this.classList.contains('expanded')) {
          this.classList.remove('expanded')
          this.syncMenu()
          ;(this.querySelector('#toggleMenu') as HTMLElement)?.focus()
        }
      })
    }
    syncMenu() {
      const expanded = this.classList.contains('expanded')
      const content = this.querySelector('#headerExpandContent') as HTMLElement
      const toggle = this.querySelector('#toggleMenu') as HTMLElement
      toggle?.setAttribute('aria-expanded', expanded.toString())
      if (matchMedia('(max-width:1023px)').matches) {
        content?.setAttribute('aria-hidden', (!expanded).toString())
        if (content) content.inert = !expanded
      } else {
        content?.setAttribute('aria-hidden', 'false')
        if (content) content.inert = false
      }
    }
  }

  customElements.define('header-component', HeaderComponent)
</script>

<style>
  header-component {
    transition:
      padding 0.3s,
      transform 0.3s,
      margin-inline 0.3s,
      border 0.15s,
      background-color 0.15s;

    &.not-top {
      --un-border-opacity: 1;
      border-color: hsl(var(--border) / var(--un-border-opacity));
      --un-bg-opacity: 1;
      background-color: hsl(var(--background) / var(--un-bg-opacity));
      padding-left: 0.375rem;
      padding-right: 0.375rem;
      box-shadow:
        rgb(255, 255, 255) 0px 0px 0px 0px,
        rgba(24, 24, 27, 0.08) 0px 0px 0px 1px,
        rgba(39, 39, 42, 0.08) 0px 10px 15px -3px,
        rgba(39, 39, 42, 0.08) 0px 4px 6px -4px;
    }
    &[data-show='false']:not(.expanded) {
      transform: translateY(-5rem);
    }
  }
  @media (min-width: 1024px) {
    header-component.not-top {
      margin-inline: 8%;
    }
  }
  :global(.dark) header-component.not-top {
    background-color: hsl(var(--muted) / var(--un-bg-opacity));
  }

  /* header menu */
  @media (max-width: 1023px) {
    .header-expand-content {
      position: absolute;
      grid-template-rows: 0fr;
      opacity: 0;
      transition:
        opacity 0.3s,
        padding 0.3s,
        border-color 0.15s,
        grid-template-rows 0.3s;
    }
    header-component.not-top .header-expand-content {
      border-color: hsl(var(--border));
      padding: 0.5rem 1rem;
    }
    header-component.expanded.not-top .header-expand-content {
      background-color: hsl(var(--background));
    }
    :global(.dark) header-component.expanded.not-top .header-expand-content {
      background-color: hsl(var(--muted));
    }
    .header-nav-content {
      flex-direction: column;
    }
    .header-nav-link,
    .header-search {
      width: 100%;
    }
    .header-nav-link {
      padding-inline: 0;
    }
    .header-search {
      gap: 0.75rem;
    }
    .header-search-link {
      padding-inline: 0.25rem;
    }
    .header-menu-toggle {
      display: block;
    }
    .expanded #headerExpandContent {
      grid-template-rows: 1fr;
    }
    .expanded.not-top #headerExpandContent {
      box-shadow:
        rgb(255, 255, 255) 0px 0px 0px 0px,
        rgba(24, 24, 27, 0.08) 0px 0px 0px 1px,
        rgba(39, 39, 42, 0.08) 0px 10px 15px -3px,
        rgba(39, 39, 42, 0.08) 0px 4px 6px -4px;
    }

    /* header component after */
    header-component #headerExpandContent::after {
      box-sizing: content-box;
      content: '';
      position: absolute;
      inset-inline: calc(-1rem - 1px);
      bottom: 0;
      top: -5rem;
      z-index: -1;
      transition: 0.3s;
      visibility: hidden;
      opacity: 0;
      border-bottom: 1px solid transparent;
    }
    header-component:not(.not-top) #headerExpandContent::after {
      visibility: visible;
      bottom: -1rem;
      opacity: 1;
      background-color: hsl(var(--muted) / var(--un-bg-opacity, 1));
      border-bottom-color: hsl(var(--border) / var(--un-border-opacity, 1));
    }
  }

  @media (min-width: 1024px) {
    .header-expand-content {
      position: static;
      grid-template-rows: 1fr;
      opacity: 1;
    }
    .header-nav-content {
      flex-direction: row;
    }
    .header-nav-link {
      width: fit-content;
      padding-inline: 0.75rem;
    }
    .header-search {
      width: fit-content;
      gap: 1.25rem;
    }
    .header-search-link {
      padding-inline: 0.5rem;
    }
    .header-menu-toggle {
      display: none;
    }
  }

  /* dark light mode toggle */
  #toggleDarkMode {
    &[data-theme='dark'] {
      & .system {
        display: none;
      }
      & .dark {
        display: block;
      }
    }
    &[data-theme='light'] {
      & .system {
        display: none;
      }
      .light {
        display: block;
      }
    }
  }
</style>
