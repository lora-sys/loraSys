---
import type { HTMLAttributes } from 'astro/types'

import { cn, getFormattedDate } from '../../utils'

type Props = HTMLAttributes<'time'> & {
  date: Date
  locale?: string
  dateTimeOptions?: Intl.DateTimeFormatOptions
  class?: string
}

const { date, locale, dateTimeOptions, class: className, ...attrs } = Astro.props

const postDate = locale ? new Intl.DateTimeFormat(locale, { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC', ...dateTimeOptions }).format(date) : getFormattedDate(date, dateTimeOptions)
---

<span class={cn('text-muted-foreground font-mono', className)} {...attrs}>
  <time datetime={date.toISOString()}>
    {postDate}
  </time>
</span>
