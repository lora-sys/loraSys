---
import { cn } from '../../utils'

const { class: className } = Astro.props
---

<quote-component class={cn('not-prose inline-block', className)}>
  <div class='flex flex-row items-center gap-x-3 rounded-full border px-4 py-2 text-sm shadow-sm'>
    <span class='relative flex items-center justify-center'>
      <span
        class='absolute size-2 animate-ping rounded-full border border-green-400 bg-green-400 opacity-75'
      ></span>
      <span class='size-2 rounded-full bg-green-400'></span>
    </span>
    <p id='quote-sentence' class='font-medium text-muted-foreground'>Loading...</p>
  </div>
</quote-component>

<script>
  import config from 'virtual:config'

  const { quote } = config.integ

  class Quote extends HTMLElement {
    render(sentence: string) {
      const quoteEl = this.querySelector('#quote-sentence') as HTMLElement
      if (!quoteEl) return
      quoteEl.innerText = sentence
    }

    connectedCallback() {
      if (!quote) {
        this.remove()
        return
      }
      // virtual:config serializes the selector as text. Support the safe
      // property-access form used by this site instead of executing configuration.
      const match = quote.target.trim().match(/^\(?\s*data\s*\)?\s*=>\s*data((?:\.[A-Za-z_$][\w$]*)+)$/)
      if (!match) throw new Error('Quote target must be a simple data property selector')
      const keys = match[1].slice(1).split('.')
      fetch(quote.server)
        .then((response) => response.json())
        .then((data) => keys.reduce((value, key) => value?.[key], data))
        .then((sentence) => {
          if (typeof sentence === 'string') this.render(sentence)
        })
    }
  }
  customElements.define('quote-component', Quote)
</script>
